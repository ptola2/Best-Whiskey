        }
      }
    },
    "study.goldhamer.finding": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "وصل 89% إلى قراءة أقل من 140/90 mmHg. وانخفض الضغط لدى من بدأوا بقراءة أعلى من 180/110 بمقدار 37/13 mmHg في المتوسط. وتوقف جميع من كانوا يتناولون أدوية ضغط الدم عن تناولها أثناء الصيام دون حدوث ارتداد."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "89 % erreichten einen Wert unter 140/90 mmHg. Bei Personen mit Ausgangswerten über 180/110 sank der Blutdruck durchschnittlich um 37/13 mmHg. Alle, die Blutdruckmedikamente nahmen, setzten sie während des Fastens ohne erneuten Anstieg ab."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "89% reached a reading under 140/90 mmHg. People starting above 180/110 dropped 37/13 mmHg on average. Everyone on blood pressure medicine stopped it during the fast with no rebound."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El 89 % alcanzó una lectura inferior a 140/90 mmHg. Quienes empezaron por encima de 180/110 bajaron 37/13 mmHg de media. Todas las personas que tomaban medicamentos para la presión arterial los dejaron durante el ayuno sin efecto rebote."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "89 % ont atteint une mesure inférieure à 140/90 mmHg. Les personnes au-dessus de 180/110 au départ ont baissé de 37/13 mmHg en moyenne. Toutes les personnes sous médicament contre la tension l’ont arrêté pendant le jeûne, sans effet rebond."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "89% की रीडिंग 140/90 mmHg से नीचे आ गई। 180/110 से ऊपर से शुरू करने वालों में औसतन 37/13 mmHg की गिरावट आई। ब्लड प्रेशर की दवा लेने वाले सभी लोगों ने उपवास के दौरान दवा बंद कर दी, और प्रेशर दोबारा नहीं बढ़ा।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "89% mencapai hasil pengukuran di bawah 140/90 mmHg. Orang yang awalnya di atas 180/110 mengalami penurunan rata-rata 37/13 mmHg. Semua yang mengonsumsi obat tekanan darah menghentikannya selama puasa tanpa lonjakan balik."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'89% ha raggiunto un valore sotto 140/90 mmHg. Chi partiva da oltre 180/110 è sceso in media di 37/13 mmHg. Tutti coloro che assumevano farmaci per la pressione li hanno sospesi durante il digiuno senza effetto rimbalzo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "89%が140/90 mmHg未満の値に達しました。開始時に180/110を超えていた人は、平均で37/13 mmHg低下しました。血圧の薬を服用していた人は全員、断食中に服用を中止し、リバウンドはありませんでした。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "89%가 140/90 mmHg 미만에 도달했어요. 시작 시 180/110을 넘었던 사람들은 평균 37/13 mmHg 떨어졌어요. 혈압약을 먹던 모든 사람이 단식 중 약을 끊었고, 반동 상승은 없었어요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "89% mencapai bacaan bawah 140/90 mmHg. Mereka yang bermula melebihi 180/110 mengalami penurunan purata 37/13 mmHg. Semua yang mengambil ubat tekanan darah menghentikannya semasa puasa tanpa kesan lantunan."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "89% bereikte een meting onder 140/90 mmHg. Bij mensen die boven 180/110 begonnen, daalde de bloeddruk gemiddeld 37/13 mmHg. Iedereen die bloeddrukmedicatie gebruikte, stopte daarmee tijdens het vasten, zonder reboundeffect."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "89% osiągnęło wynik poniżej 140/90 mmHg. U osób zaczynających z ciśnieniem powyżej 180/110 spadło ono średnio o 37/13 mmHg. Wszyscy przyjmujący leki na ciśnienie odstawili je podczas postu bez efektu odbicia."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "89% chegaram a uma leitura abaixo de 140/90 mmHg. Quem começou acima de 180/110 teve queda média de 37/13 mmHg. Todos que tomavam remédio para pressão o suspenderam durante o jejum, sem efeito rebote."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "У 89% давление снизилось ниже 140/90 мм рт. ст. У людей с исходным давлением выше 180/110 оно снизилось в среднем на 37/13 мм рт. ст. Все, кто принимал препараты от давления, прекратили их приём во время голодания без последующего скачка давления."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "89 % nådde ett värde under 140/90 mmHg. Personer som började över 180/110 sjönk i genomsnitt 37/13 mmHg. Alla som tog blodtrycksmedicin slutade med den under fastan utan reboundeffekt."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "89% walifikia kipimo cha chini ya 140/90 mmHg. Walioanza juu ya 180/110 walishuka kwa wastani wa 37/13 mmHg. Kila aliyekuwa akitumia dawa ya shinikizo la damu aliiacha wakati wa mfungo bila shinikizo kurudi juu ghafla."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "89% มีค่าความดันต่ำกว่า 140/90 mmHg ผู้ที่เริ่มต้นสูงกว่า 180/110 มีความดันลดลงเฉลี่ย 37/13 mmHg ทุกคนที่ใช้ยาลดความดันโลหิตหยุดยาได้ระหว่างการอดอาหารโดยไม่มีการดีดกลับ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%89'u 140/90 mmHg altında bir değere ulaştı. 180/110'un üzerinde başlayanlarda kan basıncı ortalama 37/13 mmHg düştü. Kan basıncı ilacı kullanan herkes oruç sırasında ilacı bıraktı ve geri tepme (rebound) görülmedi."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "89% đạt chỉ số dưới 140/90 mmHg. Những người có huyết áp ban đầu trên 180/110 giảm trung bình 37/13 mmHg. Tất cả những người dùng thuốc huyết áp đều ngừng thuốc trong đợt nhịn ăn mà không bị tăng huyết áp trở lại."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "89% 的人血压读数降到 140/90 mmHg 以下。起始血压高于 180/110 的人平均下降 37/13 mmHg。所有服用降压药的人都在断食期间停了药，且没有出现反弹。"
          }
        }
      }
    },
    "study.oglodek.cohort": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
