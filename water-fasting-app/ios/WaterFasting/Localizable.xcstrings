            "state": "translated",
            "value": "Bu oruç bitirilsin mi?"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kết thúc đợt nhịn ăn này?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "结束本次断食？"
          }
        }
      }
    },
    "fast.target_reached.body": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تُنهي العيادات الخاضعة للإشراف الصيام بمجرد تحقيق هدفه. أنهِ الصيام أدناه لتحصل على خطة إعادة التغذية."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kliniken mit medizinischer Aufsicht beenden ein Fasten, sobald sein Ziel erreicht ist. Beenden Sie das Fasten unten, um Ihren Kostaufbauplan zu erhalten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Supervised clinics end a fast once its goal is met. End the fast below to get your refeeding plan."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las clínicas supervisadas terminan el ayuno en cuanto se cumple su objetivo. Termina el ayuno aquí abajo para obtener tu plan de realimentación."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les cliniques avec suivi médical arrêtent un jeûne dès que son objectif est atteint. Terminez le jeûne ci-dessous pour obtenir votre plan de réalimentation."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "निगरानी वाले क्लिनिक लक्ष्य पूरा होते ही उपवास खत्म कर देते हैं। दोबारा खाने की अपनी योजना पाने के लिए नीचे उपवास खत्म करें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Klinik dengan pengawasan mengakhiri puasa begitu tujuannya tercapai. Akhiri puasa di bawah ini untuk mendapatkan rencana makan kembali Anda."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le cliniche specializzate terminano il digiuno quando l'obiettivo è raggiunto. Termina il digiuno qui sotto per ottenere il piano di rialimentazione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "医療管理下のクリニックでは、目標に達した時点で断食を終了します。下で断食を終了すると、回復食プランを確認できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "의료진 감독 클리닉에서는 목표를 달성하면 단식을 끝내요. 아래에서 단식을 종료하고 보식 계획을 받으세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Klinik berpengawasan menamatkan puasa sebaik sahaja matlamatnya dicapai. Tamatkan puasa di bawah untuk mendapatkan pelan pemakanan semula anda."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Klinieken met toezicht beëindigen een vasten zodra het doel is bereikt. Beëindig het vasten hieronder om je opbouwschema te krijgen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nadzorowane kliniki kończą post, gdy jego cel zostanie osiągnięty. Zakończ post poniżej, aby otrzymać plan wychodzenia z postu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Clínicas com supervisão encerram o jejum quando a meta é atingida. Encerre o jejum abaixo para receber seu plano de realimentação."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В клиниках с медицинским наблюдением голодание завершают, как только цель достигнута. Завершите голодание ниже, чтобы получить план выхода из голодания."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Kliniker med övervakning avslutar en fasta när målet är nått. Avsluta fastan nedan för att få din uppbyggnadsplan."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Kliniki zinazosimamia mifungo humaliza mfungo mara lengo lake linapofikiwa. Maliza mfungo hapa chini ili upate mpango wako wa kurejea kula."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คลินิกที่มีการดูแลทางการแพทย์จะสิ้นสุดการอดอาหารเมื่อบรรลุเป้าหมาย สิ้นสุดการอดอาหารด้านล่างเพื่อรับแผนการกลับมากินอาหาร"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gözetimli klinikler, hedefine ulaşan orucu bitirir. Yeniden beslenme planınızı almak için orucu aşağıdan bitirin."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Các phòng khám có giám sát kết thúc đợt nhịn ăn khi đã đạt mục tiêu. Hãy kết thúc đợt nhịn ăn bên dưới để nhận kế hoạch ăn lại."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "有医疗监护的诊所会在达成目标后结束断食。请在下方结束断食，获取你的复食计划。"
          }
        }
      }
    },
