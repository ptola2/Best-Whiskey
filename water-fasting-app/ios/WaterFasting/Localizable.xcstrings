    "protocol.buchinger.setting": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إقامة داخلية أو عيادات خارجية، بإدارة معالجين معتمدين"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Stationär oder ambulant, geleitet von zertifizierten Therapeutinnen und Therapeuten"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Residential or outpatient, run by certified therapists"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Residencial o ambulatorio, dirigido por terapeutas certificados"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "En établissement avec hébergement ou en ambulatoire, encadré par des thérapeutes certifiés"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आवासीय या बाह्य रोगी (OPD), प्रमाणित थेरेपिस्ट द्वारा संचालित"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Menginap atau rawat jalan, dipandu terapis bersertifikat"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Residenziale o ambulatoriale, gestito da terapisti certificati"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "入所型または通院、認定セラピストが実施"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "입소형 또는 외래, 공인 치료사가 진행"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tinggal di pusat rawatan atau pesakit luar, dikendalikan oleh ahli terapi bertauliah"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Met verblijf of poliklinisch, begeleid door gecertificeerde therapeuten"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Stacjonarnie lub ambulatoryjnie, prowadzony przez certyfikowanych terapeutów"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Em regime de internação ou ambulatorial, conduzido por terapeutas certificados"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Стационарно или амбулаторно, под руководством сертифицированных специалистов"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "På klinik med boende eller polikliniskt, lett av certifierade terapeuter"
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Kukaa kituoni au bila kulazwa, unaoendeshwa na watibabu waliothibitishwa"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "พักในสถานพยาบาลหรือแบบผู้ป่วยนอก ดำเนินการโดยนักบำบัดที่ได้รับการรับรอง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sertifikalı terapistlerin yürüttüğü, yatılı veya ayakta"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nội trú hoặc ngoại trú, do chuyên viên trị liệu có chứng chỉ thực hiện"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "住院或门诊，由认证治疗师主持"
          }
        }
      }
    },
