    "profile.safety.relative.hint": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الإجابة بـ«نعم» تعني أنه يجب إشراك الطبيب أولًا."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Ja bedeutet, dass zuerst eine Ärztin oder ein Arzt einbezogen werden muss."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A yes means a doctor must be involved first."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un «sí» significa que primero debe intervenir un médico."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un oui signifie qu’un médecin doit d’abord être impliqué."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "हाँ का मतलब है कि पहले डॉक्टर को शामिल करना ज़रूरी है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Jawaban ya berarti dokter harus dilibatkan terlebih dahulu."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un sì significa che prima deve essere coinvolto un medico."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「はい」の場合は、まず医師の関与が必要です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "‘예’가 있으면 먼저 반드시 의사가 관여해야 해요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Jawapan ya bermakna doktor mesti terlibat terlebih dahulu."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bij een ja-antwoord moet er eerst een arts bij betrokken worden."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Odpowiedź „tak” oznacza, że najpierw musi się tym zająć lekarz."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um “sim” significa que um médico precisa ser envolvido antes."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ответ «да» означает, что сначала нужно привлечь врача."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ett ja innebär att en läkare måste vara involverad först."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Jibu la ndiyo linamaanisha daktari lazima ahusishwe kwanza."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "หากตอบใช่ ต้องให้แพทย์เข้ามาดูแลก่อน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "“Evet” yanıtı, önce bir doktorun sürece dahil olması gerektiği anlamına gelir."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Trả lời “Có” nghĩa là phải có bác sĩ tham gia trước."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "回答“是”表示必须先让医生参与。"
          }
        }
      }
    },
