          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Jejum de 5 a 7 dias, ou IMC de 16 a 18,5."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Голодание от 5 до 7 дней или ИМТ от 16 до 18,5."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Fasta på 5 till 7 dagar, eller BMI 16 till 18,5."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Mfungo wa siku 5 hadi 7, au BMI 16 hadi 18.5."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "อดอาหาร 5 ถึง 7 วัน หรือดัชนีมวลกาย 16 ถึง 18.5"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "5 ila 7 günlük oruç veya VKİ 16 ila 18,5."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nhịn ăn 5 đến 7 ngày, hoặc BMI 16 đến 18,5."
          }
        },
        "zh-Hans": {
          "stringUnit": {
