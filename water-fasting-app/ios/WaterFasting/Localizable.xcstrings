          "stringUnit": {
            "state": "translated",
            "value": "당뇨병이 없는 비만 성인, 17일 물 단식"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Orang dewasa dengan obesiti, tanpa diabetes, puasa air 17 hari"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Volwassenen met obesitas, zonder diabetes, watervasten van 17 dagen"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dorośli z otyłością, bez cukrzycy, 17-dniowy post wodny"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Adultos com obesidade, sem diabetes, jejum de água de 17 dias"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Взрослые с ожирением без диабета, 17-дневное голодание на воде"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Vuxna med fetma, utan diabetes, vattenfasta i 17 dagar"
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Watu wazima wenye unene uliokithiri, wasio na kisukari, mfungo wa maji wa siku 17"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ผู้ใหญ่ที่เป็นโรคอ้วนและไม่เป็นเบาหวาน อดอาหารแบบดื่มน้ำเปล่า 17 วัน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Obeziteli, diyabeti olmayan yetişkinler, 17 günlük su orucu"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Người trưởng thành bị béo phì, không bị đái tháo đường, nhịn ăn chỉ uống nước 17 ngày"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无糖尿病的肥胖成人，17 天纯水断食"
          }
        }
      }
    },
    "study.scharf.finding": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "انخفض وزن الجسم بنسبة 10.2%. وانخفض ضغط الدم، وجلوكوز الصيام، والإنسولين، ومقاومة الإنسولين (HOMA-IR). وارتفعت الدهون الثلاثية لفترة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Körpergewicht sank um 10,2 %. Blutdruck, Nüchternblutzucker, Insulin und Insulinresistenz (HOMA-IR) sanken. Die Triglyceride stiegen vorübergehend."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Body weight fell 10.2%. Blood pressure, fasting glucose, insulin and insulin resistance (HOMA-IR) fell. Triglycerides rose for a while."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El peso corporal bajó un 10,2 %. Bajaron la presión arterial, la glucosa en ayunas, la insulina y la resistencia a la insulina (HOMA-IR). Los triglicéridos subieron durante un tiempo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le poids corporel a baissé de 10,2 %. La tension artérielle, la glycémie à jeun, l’insuline et la résistance à l’insuline (HOMA-IR) ont baissé. Les triglycérides ont augmenté pendant un temps."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "शरीर का वज़न 10.2% घटा। ब्लड प्रेशर, फ़ास्टिंग ग्लूकोज़, इंसुलिन और इंसुलिन रेज़िस्टेंस (HOMA-IR) घटे। ट्राइग्लिसराइड कुछ समय के लिए बढ़े।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Berat badan turun 10,2%. Tekanan darah, glukosa puasa, insulin, dan resistansi insulin (HOMA-IR) turun. Trigliserida sempat naik untuk sementara."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il peso corporeo è sceso del 10,2%. Pressione, glicemia a digiuno, insulina e insulino-resistenza (HOMA-IR) sono diminuite. I trigliceridi sono aumentati per un certo periodo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "体重は10.2%減少しました。血圧、空腹時血糖、インスリン、インスリン抵抗性（HOMA-IR）が低下しました。中性脂肪は一時的に上昇しました。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "체중이 10.2% 줄었어요. 혈압, 공복 혈당, 인슐린, 인슐린 저항성(HOMA-IR)이 낮아졌어요. 중성지방은 일시적으로 올라갔어요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Berat badan turun 10.2%. Tekanan darah, glukosa puasa, insulin dan rintangan insulin (HOMA-IR) menurun. Trigliserida meningkat buat seketika."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het lichaamsgewicht daalde met 10,2%. Bloeddruk, nuchtere glucose, insuline en insulineresistentie (HOMA-IR) daalden. Triglyceriden stegen een tijdlang."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Masa ciała spadła o 10,2%. Spadły ciśnienie krwi, glukoza na czczo, insulina i insulinooporność (HOMA-IR). Triglicerydy przez pewien czas rosły."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O peso corporal caiu 10,2%. A pressão arterial, a glicemia de jejum, a insulina e a resistência à insulina (HOMA-IR) caíram. Os triglicerídeos subiram temporariamente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Масса тела снизилась на 10,2%. Снизились давление, глюкоза натощак, инсулин и инсулинорезистентность (HOMA-IR). Уровень триглицеридов временно повысился."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Kroppsvikten minskade med 10,2 %. Blodtryck, fasteglukos, insulin och insulinresistens (HOMA-IR) sjönk. Triglyceriderna steg tillfälligt."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Uzito wa mwili ulishuka kwa 10.2%. Shinikizo la damu, glukosi ya kufunga, insulini na ukinzani wa insulini (HOMA-IR) vilishuka. Trigliseridi zilipanda kwa muda."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "น้ำหนักตัวลดลง 10.2% ความดันโลหิต กลูโคสขณะอดอาหาร อินซูลิน และภาวะดื้ออินซูลิน (HOMA-IR) ลดลง ไตรกลีเซอไรด์เพิ่มขึ้นชั่วคราว"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vücut ağırlığı %10,2 azaldı. Kan basıncı, açlık glukozu, insülin ve insülin direnci (HOMA-IR) düştü. Trigliseritler bir süre yükseldi."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cân nặng giảm 10,2%. Huyết áp, đường huyết lúc đói, insulin và tình trạng kháng insulin (HOMA-IR) giảm. Triglycerid tăng trong một thời gian."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "体重下降 10.2%。血压、空腹血糖、胰岛素和胰岛素抵抗（HOMA-IR）下降。甘油三酯曾短暂升高。"
          }
        }
      }
    },
