    "refeed.plan.needs_clinician": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This refeed needs a clinician."
          }
        }
      }
    },
    "refeed.plan.needs_clinician.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Significant-risk refeeding uses prescribed thiamine and daily blood tests."
          }
        }
      }
    },
    "refeed.plan.no_salt": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Throughout: no added salt or salty seasonings. Insulin makes the kidneys hold sodium and water after a fast, which can cause swelling and strain the heart."
          }
        }
      }
    },
    "refeed.plan.risk_title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Refeeding risk"
          }
        }
      }
    },
    "refeed.plan.source": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ranges come from ASPEN and NICE refeeding guidance. Your clinician sets the final numbers."
          }
        }
      }
    },
    "refeed.plan.today": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "today"
          }
        }
      }
    },
    "refeed.planner.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Coming off a fast is the riskiest part. Eating too much too fast can drive phosphate, potassium and magnesium into cells all at once (refeeding syndrome), and salt can make the body hold fluid. Plan the way back before you start."
          }
        }
      }
    },
    "refeed.planner.eyebrow": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Refeeding planner"
          }
        }
      }
    },
    "refeed.planner.invalid": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enter a fast length between 1 and 40 days."
          }
        }
      }
    },
    "refeed.planner.length": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Fast length"
          }
        }
      }
    },
    "refeed.planner.prefilled": {
      "extractionState": "manual",
      "localizations": {
