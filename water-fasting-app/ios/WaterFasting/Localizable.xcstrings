    "refeed_today.no_salt.body": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "بعد الصيام، يجعل الإنسولين الكليتين تحتفظان بالصوديوم والماء. وقد يسبب تناول الملح الآن تورمًا ويُجهد القلب."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nach dem Fasten bringt Insulin die Nieren dazu, Natrium und Wasser zurückzuhalten. Salz kann jetzt Schwellungen verursachen und das Herz belasten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "After a fast, insulin makes the kidneys hold on to sodium and water. Salt now can cause swelling and strain the heart."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Después de un ayuno, la insulina hace que los riñones retengan sodio y agua. Tomar sal ahora puede causar hinchazón y sobrecargar el corazón."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Après un jeûne, l’insuline pousse les reins à retenir le sodium et l’eau. Du sel maintenant peut provoquer un gonflement et fatiguer le cœur."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "उपवास के बाद इंसुलिन की वजह से गुर्दे सोडियम और पानी रोककर रखते हैं। इस समय नमक से सूजन हो सकती है और दिल पर दबाव पड़ सकता है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Setelah puasa, insulin membuat ginjal menahan natrium dan air. Garam saat ini dapat menyebabkan pembengkakan dan membebani jantung."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Dopo un digiuno, l'insulina fa trattenere ai reni sodio e acqua. Il sale ora può causare gonfiore e affaticare il cuore."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "断食後は、インスリンの働きで腎臓がナトリウムと水分をため込みます。今塩分をとると、むくみが生じ、心臓に負担がかかるおそれがあります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "단식 후에는 인슐린 때문에 신장이 나트륨과 수분을 붙잡아 둬요. 지금 소금을 먹으면 부기가 생기고 심장에 부담이 갈 수 있어요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Selepas berpuasa, insulin menyebabkan buah pinggang menahan natrium dan air. Garam pada masa ini boleh menyebabkan bengkak dan membebankan jantung."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Na het vasten zorgt insuline ervoor dat de nieren natrium en water vasthouden. Zout kan nu zwelling veroorzaken en het hart belasten."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Po poście insulina sprawia, że nerki zatrzymują sód i wodę. Sól teraz może wywołać obrzęki i obciążyć serce."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Depois de um jejum, a insulina faz os rins reterem sódio e água. Sal agora pode causar inchaço e sobrecarregar o coração."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "После голодания инсулин заставляет почки удерживать натрий и воду. Соль сейчас может вызвать отёки и нагрузку на сердце."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Efter en fasta får insulin njurarna att hålla kvar natrium och vatten. Salt nu kan orsaka svullnad och belasta hjärtat."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Baada ya mfungo, insulini hufanya figo zibakize sodiamu na maji. Chumvi sasa inaweza kusababisha uvimbe na kuulemea moyo."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "หลังการอดอาหาร อินซูลินทำให้ไตเก็บกักโซเดียมและน้ำไว้ การกินเกลือในตอนนี้อาจทำให้เกิดอาการบวมและเพิ่มภาระให้หัวใจ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Oruçtan sonra insülin, böbreklerin sodyumu ve suyu tutmasına neden olur. Şu anda tuz almak şişliğe yol açabilir ve kalbi zorlayabilir."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Sau khi nhịn ăn, insulin khiến thận giữ lại natri và nước. Ăn muối lúc này có thể gây phù và tạo gánh nặng cho tim."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "断食后，胰岛素会使肾脏潴留钠和水。此时摄入盐可能引起肿胀，并加重心脏负担。"
          }
        }
      }
    },
