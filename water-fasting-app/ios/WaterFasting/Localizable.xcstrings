          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nam giới khỏe mạnh, cân nặng bình thường, nhịn ăn chỉ uống nước 8 ngày"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "健康、体重正常的男性，8 天纯水断食"
          }
        }
      }
    },
    "study.oglodek.finding": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "انخفاض ضغط الدم والوزن ومؤشر كتلة الجسم والكتلة الخالية من الدهون وماء الجسم. وحدث انخفاض في الصوديوم (أقل من 136 mmol/L)، وتراجعت تصفية حمض اليوريك."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Niedrigere Werte bei Blutdruck, Gewicht, BMI, fettfreier Masse und Körperwasser. Es entwickelte sich ein niedriger Natriumspiegel (unter 136 mmol/L), und die Harnsäureausscheidung sank."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Lower blood pressure, weight, BMI, fat-free mass and body water. Low sodium (under 136 mmol/L) developed, and uric acid clearance fell."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Bajaron la presión arterial, el peso, el IMC, la masa libre de grasa y el agua corporal. Apareció sodio bajo (menos de 136 mmol/L) y disminuyó la eliminación de ácido úrico."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Baisse de la tension artérielle, du poids, de l’IMC, de la masse non grasse et de l’eau corporelle. Un sodium bas (inférieur à 136 mmol/L) est apparu, et l’élimination de l’acide urique a diminué."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "ब्लड प्रेशर, वज़न, BMI, फ़ैट-फ़्री मास और शरीर का पानी कम हुआ। कम सोडियम (136 mmol/L से कम) हुआ, और यूरिक एसिड का निकलना घटा।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tekanan darah, berat badan, IMT, massa bebas lemak, dan air tubuh menurun. Terjadi natrium rendah (di bawah 136 mmol/L), dan pembuangan asam urat menurun."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Riduzione di pressione, peso, BMI, massa magra e acqua corporea. Si è sviluppato sodio basso (sotto 136 mmol/L) e l'eliminazione dell'acido urico è diminuita."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "血圧、体重、BMI、除脂肪量、体水分量が低下しました。低ナトリウム（136 mmol/L未満）が生じ、尿酸のクリアランスが低下しました。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "혈압, 체중, BMI, 제지방량, 체수분이 감소했어요. 저나트륨(136 mmol/L 미만)이 나타났고, 요산 청소율이 떨어졌어요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tekanan darah, berat badan, BMI, jisim bebas lemak dan air badan lebih rendah. Natrium rendah (bawah 136 mmol/L) berlaku, dan penyingkiran asid urik menurun."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Lagere bloeddruk, gewicht, BMI, vetvrije massa en lichaamswater. Er ontstond een laag natrium (onder 136 mmol/L) en de uitscheiding van urinezuur daalde."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Niższe ciśnienie krwi, masa ciała, BMI, beztłuszczowa masa ciała i zawartość wody w organizmie. Rozwinął się niski poziom sodu (poniżej 136 mmol/L), a wydalanie kwasu moczowego spadło."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Redução da pressão arterial, do peso, do IMC, da massa livre de gordura e da água corporal. Surgiu sódio baixo (abaixo de 136 mmol/L), e a eliminação de ácido úrico diminuiu."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Снизились давление, вес, ИМТ, безжировая масса и количество воды в организме. Развился низкий уровень натрия (ниже 136 ммоль/л), и снизилось выведение мочевой кислоты."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Lägre blodtryck, vikt, BMI, fettfri massa och kroppsvatten. Lågt natrium (under 136 mmol/L) uppstod, och utsöndringen av urinsyra minskade."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Shinikizo la damu, uzito, BMI, uzito usio na mafuta na maji ya mwili vilipungua. Sodiamu ya chini (chini ya 136 mmol/L) ilijitokeza, na uondoaji wa asidi ya uriki ulipungua."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ความดันโลหิต น้ำหนัก ดัชนีมวลกาย มวลไร้ไขมัน และปริมาณน้ำในร่างกายลดลง เกิดภาวะโซเดียมต่ำ (ต่ำกว่า 136 mmol/L) และการขับกรดยูริกลดลง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kan basıncı, kilo, VKİ, yağsız kütle ve vücut suyu azaldı. Düşük sodyum (136 mmol/L'nin altında) gelişti ve ürik asit atılımı azaldı."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Huyết áp, cân nặng, BMI, khối không mỡ và lượng nước trong cơ thể đều giảm. Xuất hiện natri thấp (dưới 136 mmol/L), và khả năng đào thải acid uric giảm."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "血压、体重、BMI、去脂体重和身体水分下降。出现了低钠（低于 136 mmol/L），尿酸清除率下降。"
          }
        }
      }
    },
