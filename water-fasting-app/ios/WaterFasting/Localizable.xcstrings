        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Hartziekte of een hartritmeprobleem"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Choroba serca lub zaburzenia rytmu serca"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Doença cardíaca ou problema de ritmo cardíaco"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Болезнь сердца или нарушение сердечного ритма"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Hjärtsjukdom eller hjärtrytmrubbning"
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Ugonjwa wa moyo au tatizo la mdundo wa moyo"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "โรคหัวใจหรือปัญหาหัวใจเต้นผิดจังหวะ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kalp hastalığı veya kalp ritmi bozukluğu"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bệnh tim hoặc rối loạn nhịp tim"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "心脏病或心律问题"
          }
        }
      }
    },
    "screen.heart.why": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "قد يؤدي فقدان الإلكتروليتات إلى اضطرابات في النظم، وقد تُثقل إعادة التغذية القلب بالملح والسوائل."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Elektrolytverluste können Rhythmusstörungen auslösen, und der Kostaufbau kann das Herz mit Salz und Flüssigkeit überlasten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Electrolyte losses can trigger rhythm problems, and refeeding can overload the heart with salt and fluid."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La pérdida de electrolitos puede desencadenar problemas del ritmo, y la realimentación puede sobrecargar el corazón con sal y líquidos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les pertes d’électrolytes peuvent déclencher des troubles du rythme, et la réalimentation peut surcharger le cœur en sel et en liquide."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इलेक्ट्रोलाइट की कमी से धड़कन की समस्याएँ शुरू हो सकती हैं, और दोबारा खाने से दिल पर नमक और तरल का ज़्यादा बोझ पड़ सकता है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kehilangan elektrolit dapat memicu gangguan irama, dan makan kembali dapat membebani jantung dengan garam dan cairan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La perdita di elettroliti può scatenare disturbi del ritmo, e la rialimentazione può sovraccaricare il cuore di sale e liquidi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "電解質が失われると不整脈が起こることがあり、回復食によって塩分と水分が心臓に過剰な負担をかけることがあります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "전해질 손실은 리듬 이상을 일으킬 수 있고, 보식은 심장에 소금과 수분 과부하를 줄 수 있어요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Kehilangan elektrolit boleh mencetuskan masalah irama jantung, dan pemakanan semula boleh membebankan jantung dengan garam dan cecair."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Elektrolytverlies kan ritmeproblemen uitlokken, en het opbouwen kan het hart overbelasten met zout en vocht."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Utrata elektrolitów może wywołać zaburzenia rytmu, a ponowne odżywianie może przeciążyć serce solą i płynami."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As perdas de eletrólitos podem desencadear problemas de ritmo, e a realimentação pode sobrecarregar o coração com sal e líquido."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Потеря электролитов может спровоцировать нарушения ритма, а при возобновлении питания соль и жидкость могут перегрузить сердце."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Förluster av elektrolyter kan utlösa rytmrubbningar, och uppbyggnaden kan överbelasta hjärtat med salt och vätska."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Upotevu wa elektroliti unaweza kuchochea matatizo ya mdundo wa moyo, na kurejea kula kunaweza kuulemea moyo kwa chumvi na maji."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การสูญเสียเกลือแร่อาจกระตุ้นให้หัวใจเต้นผิดจังหวะ และการกลับมากินอาหารอาจทำให้หัวใจรับภาระเกลือและของเหลวมากเกินไป"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Elektrolit kayıpları ritim sorunlarını tetikleyebilir ve yeniden beslenme kalbe tuz ve sıvı yükü bindirebilir."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mất chất điện giải có thể gây rối loạn nhịp, và ăn lại có thể khiến tim quá tải do muối và dịch."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "电解质流失可能诱发心律问题，而复食可能因盐和液体过多使心脏超负荷。"
          }
        }
      }
    },
    "screen.lithium.action": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يحتاج إلى مراقبة دقيقة من الطبيب الذي وصف الدواء."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erfordert eine engmaschige Überwachung durch die verschreibende Ärztin oder den verschreibenden Arzt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Needs close monitoring by your prescriber."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Requiere un seguimiento estrecho por parte de quien te lo recetó."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nécessite une surveillance étroite par le médecin qui vous le prescrit."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "दवा लिखने वाले डॉक्टर द्वारा करीबी निगरानी ज़रूरी है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Memerlukan pemantauan ketat oleh dokter yang meresepkan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Serve uno stretto monitoraggio da parte del medico che te lo prescrive."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "処方医による綿密な監視が必要です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "처방한 의사의 면밀한 모니터링이 필요해요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Memerlukan pemantauan rapi oleh doktor yang mempreskripsikannya."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vereist nauwkeurige controle door de arts die het voorschrijft."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wymaga ścisłego monitorowania przez lekarza, który przepisał lek."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Exige monitoramento rigoroso por quem prescreveu o medicamento."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Требуется тщательное наблюдение врача, который назначил препарат."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Kräver noggrann uppföljning av den som skrivit ut läkemedlet."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Inahitaji ufuatiliaji wa karibu na daktari aliyekuandikia dawa."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ต้องได้รับการติดตามอย่างใกล้ชิดจากแพทย์ผู้สั่งยา"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İlacı yazan hekimin yakın izlemi gerekir."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cần được bác sĩ kê đơn theo dõi chặt chẽ."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "需要由开具处方的医生密切监测。"
          }
        }
      }
    },
    "screen.lithium.question": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تناول الليثيوم أو دواء نفسي آخر ذي نطاق أمان ضيق"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Einnahme von Lithium oder einem anderen Psychopharmakon mit engem therapeutischem Bereich"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Taking lithium or another psychiatric medicine with a narrow safe range"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tomar litio u otro medicamento psiquiátrico con un margen de seguridad estrecho"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Prise de lithium ou d’un autre médicament psychiatrique dont la marge de sécurité est étroite"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "लिथियम या कोई और मनोरोग दवा लेना, जिसकी सुरक्षित सीमा बहुत छोटी हो"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Mengonsumsi litium atau obat psikiatri lain dengan rentang aman yang sempit"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Assumi litio o un altro farmaco psichiatrico con un margine di sicurezza ristretto"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "リチウム、または安全域の狭いほかの精神科の薬を服用している"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "리튬 또는 안전 범위가 좁은 다른 정신과 약 복용 중"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Mengambil litium atau ubat psikiatri lain yang mempunyai julat selamat yang sempit"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gebruik van lithium of een ander psychiatrisch medicijn met een smalle veilige marge"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przyjmowanie litu lub innego leku psychiatrycznego o wąskim zakresie bezpiecznego dawkowania"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Uso de lítio ou outro medicamento psiquiátrico com margem de segurança estreita"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Приём лития или другого психиатрического препарата с узким диапазоном безопасных доз"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Tar litium eller ett annat psykiatriskt läkemedel med smalt terapeutiskt intervall"
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Unatumia lithiamu au dawa nyingine ya magonjwa ya akili yenye kiwango finyu cha usalama"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ใช้ลิเทียมหรือยาจิตเวชอื่นที่มีช่วงระดับยาที่ปลอดภัยแคบ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lityum veya güvenli aralığı dar olan başka bir psikiyatrik ilaç kullanımı"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đang dùng lithi hoặc thuốc tâm thần khác có khoảng an toàn hẹp"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在服用锂盐或其他安全范围窄的精神科药物"
          }
        }
      }
    },
    "screen.lithium.why": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يؤدي الجفاف وتغيرات الصوديوم إلى إبطاء تخلص الجسم من الليثيوم وزيادة خطر التسمم."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dehydrierung und Natriumschwankungen verlangsamen die Ausscheidung von Lithium und erhöhen das Risiko einer Vergiftung."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Dehydration and sodium changes slow lithium clearance and raise the risk of toxicity."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La deshidratación y los cambios de sodio ralentizan la eliminación del litio y aumentan el riesgo de toxicidad."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La déshydratation et les variations de sodium ralentissent l’élimination du lithium et augmentent le risque de toxicité."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पानी की कमी और सोडियम में बदलाव से लिथियम शरीर से धीरे निकलता है, जिससे विषाक्तता का खतरा बढ़ता है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Dehidrasi dan perubahan natrium memperlambat pembuangan litium dan meningkatkan risiko keracunan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La disidratazione e le variazioni del sodio rallentano l'eliminazione del litio e aumentano il rischio di tossicità."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "脱水やナトリウムの変化によってリチウムの排出が遅くなり、中毒のリスクが高まります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "탈수와 나트륨 변화로 리튬 배출이 느려져 독성 위험이 높아져요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Dehidrasi dan perubahan natrium melambatkan penyingkiran litium dan meningkatkan risiko ketoksikan."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Uitdroging en veranderingen in natrium vertragen de uitscheiding van lithium en verhogen het risico op vergiftiging."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Odwodnienie i zmiany poziomu sodu spowalniają wydalanie litu i zwiększają ryzyko zatrucia."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A desidratação e as alterações de sódio retardam a eliminação do lítio e aumentam o risco de toxicidade."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Обезвоживание и изменения уровня натрия замедляют выведение лития и повышают риск отравления."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Uttorkning och förändringar i natrium gör att litium utsöndras långsammare och ökar risken för förgiftning."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Upungufu wa maji mwilini na mabadiliko ya sodiamu hupunguza kasi ya kuondolewa kwa lithiamu na kuongeza hatari ya sumu."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ภาวะขาดน้ำและการเปลี่ยนแปลงของโซเดียมทำให้ร่างกายขับลิเทียมได้ช้าลง และเพิ่มความเสี่ยงต่อพิษจากยา"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sıvı kaybı ve sodyum değişiklikleri lityumun atılımını yavaşlatır ve zehirlenme riskini artırır."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mất nước và thay đổi natri làm chậm đào thải lithi và tăng nguy cơ ngộ độc."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "脱水和血钠变化会减慢锂的清除，增加中毒风险。"
          }
        }
      }
    },
    "screen.liver.question": {
