    "tier.high.monitoring": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تحاليل دم يومية (الإلكتروليتات، والمغنيسيوم، والفوسفور) لمدة 3 إلى 5 أيام."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tägliche Blutuntersuchungen (Elektrolyte, Magnesium, Phosphor) über 3 bis 5 Tage."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Daily blood tests (electrolytes, magnesium, phosphorus) for 3 to 5 days."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Análisis de sangre diarios (electrolitos, magnesio, fósforo) durante 3 a 5 días."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Analyses de sang quotidiennes (électrolytes, magnésium, phosphore) pendant 3 à 5 jours."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "3 से 5 दिनों तक रोज़ खून की जाँच (इलेक्ट्रोलाइट, मैग्नीशियम, फ़ॉस्फ़ोरस)।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tes darah harian (elektrolit, magnesium, fosfor) selama 3 sampai 5 hari."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Esami del sangue quotidiani (elettroliti, magnesio, fosforo) per 3-5 giorni."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "3〜5日間、毎日血液検査（電解質、マグネシウム、リン）を行います。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "3~5일 동안 매일 혈액 검사(전해질, 마그네슘, 인)."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Ujian darah setiap hari (elektrolit, magnesium, fosforus) selama 3 hingga 5 hari."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dagelijks bloedonderzoek (elektrolyten, magnesium, fosfor) gedurende 3 tot 5 dagen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Codzienne badania krwi (elektrolity, magnez, fosfor) przez 3 do 5 dni."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Exames de sangue diários (eletrólitos, magnésio, fósforo) por 3 a 5 dias."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ежедневные анализы крови (электролиты, магний, фосфор) в течение 3–5 дней."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Dagliga blodprover (elektrolyter, magnesium, fosfor) i 3 till 5 dagar."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Vipimo vya damu kila siku (elektroliti, magnesiamu, fosforasi) kwa siku 3 hadi 5."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ตรวจเลือดทุกวัน (เกลือแร่ แมกนีเซียม ฟอสฟอรัส) เป็นเวลา 3 ถึง 5 วัน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "3 ila 5 gün boyunca günlük kan tahlilleri (elektrolitler, magnezyum, fosfor)."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Xét nghiệm máu hằng ngày (chất điện giải, magie, phospho) trong 3 đến 5 ngày."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "连续 3 至 5 天每天验血（电解质、镁、磷）。"
          }
        }
      }
    },
    "tier.low.criteria": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "صيام أقل من 5 أيام، وإلكتروليتات طبيعية، ومؤشر كتلة جسم صحي."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fasten unter 5 Tagen, normale Elektrolyte und ein gesunder BMI."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Fast under 5 days, normal electrolytes and a healthy BMI."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ayuno de menos de 5 días, electrolitos normales e IMC saludable."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeûne de moins de 5 jours, électrolytes normaux et IMC dans la norme."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "5 दिन से कम का उपवास, सामान्य इलेक्ट्रोलाइट और स्वस्थ BMI।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Puasa kurang dari 5 hari, elektrolit normal, dan IMT sehat."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Digiuno sotto i 5 giorni, elettroliti normali e BMI nella norma."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "5日未満の断食で、電解質が正常、BMIが健康的な範囲。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "5일 미만 단식, 정상 전해질, 건강한 BMI."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Puasa kurang daripada 5 hari, elektrolit normal dan BMI yang sihat."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vasten korter dan 5 dagen, normale elektrolyten en een gezonde BMI."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Post krótszy niż 5 dni, prawidłowe elektrolity i zdrowe BMI."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Jejum de menos de 5 dias, eletrólitos normais e IMC saudável."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Голодание менее 5 дней, нормальный уровень электролитов и здоровый ИМТ."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Fasta under 5 dagar, normala elektrolyter och ett hälsosamt BMI."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Mfungo wa chini ya siku 5, elektroliti za kawaida na BMI yenye afya."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "อดอาหารน้อยกว่า 5 วัน เกลือแร่ปกติ และดัชนีมวลกายอยู่ในเกณฑ์ปกติ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "5 günden kısa oruç, normal elektrolitler ve sağlıklı bir VKİ."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nhịn ăn dưới 5 ngày, chất điện giải bình thường và BMI khỏe mạnh."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "断食少于 5 天、电解质正常且 BMI 健康。"
          }
        }
      }
    },
    "tier.low.fluids": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اشرب حسب شعورك بالعطش. امتنع عن إضافة الملح في البداية، ثم أعد إدخاله ببطء."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nach Durst trinken. Zunächst kein zusätzliches Salz, dann langsam wieder einführen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Drink to thirst. Keep added salt out at first, then bring it back slowly."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Bebe según tu sed. Al principio no añadas sal y después reintrodúcela poco a poco."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Buvez selon votre soif. Évitez le sel ajouté au début, puis réintroduisez-le lentement."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "प्यास के अनुसार पिएँ। शुरुआत में ऊपर से नमक न डालें, फिर धीरे-धीरे वापस लाएँ।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Minum sesuai rasa haus. Jangan tambahkan garam pada awalnya, lalu perkenalkan kembali secara perlahan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Bevi secondo la sete. All'inizio niente sale aggiunto, poi reintroducilo lentamente."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "のどの渇きに応じて飲んでください。最初は塩を加えず、その後ゆっくり戻していきます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "목마를 때 마시세요. 처음에는 소금을 넣지 말고, 그다음 천천히 다시 늘리세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Minum mengikut rasa dahaga. Jangan tambah garam pada mulanya, kemudian perkenalkan semula secara perlahan."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Drink op dorst. Voeg eerst geen zout toe en breng het daarna langzaam terug."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pij zgodnie z pragnieniem. Na początku nie dodawaj soli, a potem wprowadzaj ją powoli."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Beba conforme a sede. Não adicione sal no início e depois reintroduza-o aos poucos."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Пейте по жажде. Сначала не добавляйте соль, затем возвращайте её постепенно."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Drick efter törst. Håll tillsatt salt borta i början och för sedan tillbaka det långsamt."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Kunywa kulingana na kiu. Usiongeze chumvi mwanzoni, kisha uirudishe taratibu."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ดื่มน้ำตามความกระหาย งดเติมเกลือในช่วงแรก แล้วค่อยๆ กลับมาเติม"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Susadıkça için. Başta tuz eklemeyin, sonra yavaş yavaş yeniden ekleyin."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Uống khi khát. Lúc đầu không thêm muối, sau đó đưa muối trở lại từ từ."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "口渴就喝。起初不额外加盐，之后再慢慢恢复。"
          }
        }
      }
    },
