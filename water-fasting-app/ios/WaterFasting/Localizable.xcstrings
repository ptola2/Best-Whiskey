    "learn.autophagy": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الالتهام الذاتي: بمجرد توقف نشاط mTORC1، تبدأ الخلايا في تفكيك البروتينات والميتوكوندريا التالفة وإعادة تدويرها. كما يرفع الصيام مستوى السبيرميدين، الذي يحافظ على استمرار إعادة التدوير هذه."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Autophagie: Sobald mTORC1 abschaltet, beginnen Zellen, beschädigte Proteine und Mitochondrien abzubauen und wiederzuverwerten. Fasten erhöht außerdem Spermidin, das diese Wiederverwertung in Gang hält."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Autophagy: once mTORC1 switches off, cells start breaking down and recycling damaged proteins and mitochondria. Fasting also raises spermidine, which keeps this recycling going."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Autofagia: cuando mTORC1 se desactiva, las células empiezan a descomponer y reciclar proteínas y mitocondrias dañadas. El ayuno también aumenta la espermidina, que mantiene activo este reciclaje."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Autophagie : une fois mTORC1 désactivé, les cellules commencent à dégrader et à recycler les protéines et les mitochondries endommagées. Le jeûne augmente aussi la spermidine, qui entretient ce recyclage."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "ऑटोफैजी: mTORC1 बंद होने पर कोशिकाएँ खराब प्रोटीन और माइटोकॉन्ड्रिया को तोड़कर रीसायकल करने लगती हैं। उपवास से स्पर्मिडीन भी बढ़ता है, जो इस रीसाइक्लिंग को जारी रखता है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Autofagi: setelah mTORC1 nonaktif, sel mulai memecah dan mendaur ulang protein dan mitokondria yang rusak. Puasa juga meningkatkan spermidin, yang membuat proses daur ulang ini terus berjalan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Autofagia: quando mTORC1 si spegne, le cellule iniziano a demolire e riciclare proteine e mitocondri danneggiati. Il digiuno aumenta anche la spermidina, che mantiene attivo questo riciclo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "オートファジー：mTORC1がオフになると、細胞は損傷したたんぱく質やミトコンドリアの分解とリサイクルを始めます。断食はスペルミジンも増やし、このリサイクルを持続させます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "자가포식: mTORC1이 꺼지면 세포는 손상된 단백질과 미토콘드리아를 분해하고 재활용하기 시작해요. 단식은 스페르미딘도 늘려 이 재활용이 계속되게 해요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Autofagi: sebaik sahaja mTORC1 dimatikan, sel mula memecahkan dan mengitar semula protein dan mitokondria yang rosak. Puasa juga meningkatkan spermidina, yang mengekalkan proses kitar semula ini."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Autofagie: zodra mTORC1 uitschakelt, beginnen cellen beschadigde eiwitten en mitochondriën af te breken en te recyclen. Vasten verhoogt ook spermidine, waardoor deze recycling doorgaat."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Autofagia: gdy mTORC1 się wyłącza, komórki zaczynają rozkładać i przetwarzać uszkodzone białka i mitochondria. Post zwiększa też poziom spermidyny, która podtrzymuje ten recykling."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Autofagia: quando o mTORC1 é desligado, as células começam a degradar e reciclar proteínas e mitocôndrias danificadas. O jejum também aumenta a espermidina, que mantém essa reciclagem em andamento."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Аутофагия: после отключения mTORC1 клетки начинают расщеплять и перерабатывать повреждённые белки и митохондрии. Голодание также повышает уровень спермидина, который поддерживает эту переработку."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Autofagi: när mTORC1 stängs av börjar cellerna bryta ned och återvinna skadade proteiner och mitokondrier. Fasta höjer också nivån av spermidin, som håller igång återvinningen."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Autofaji (autophagy): mara mTORC1 inapozimika, seli huanza kuvunja na kutumia upya protini zilizoharibika na mitokondria. Kufunga pia huongeza spermidini (spermidine), ambayo hufanya mchakato huu wa kutumia upya uendelee."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ออโตฟาจี: เมื่อ mTORC1 หยุดทำงาน เซลล์จะเริ่มย่อยสลายและนำโปรตีนและไมโทคอนเดรียที่เสียหายกลับมาใช้ใหม่ การอดอาหารยังเพิ่มสเปอร์มิดีน ซึ่งช่วยให้กระบวนการรีไซเคิลนี้ดำเนินต่อไป"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Otofaji: mTORC1 devre dışı kaldığında hücreler hasarlı proteinleri ve mitokondrileri parçalayıp geri dönüştürmeye başlar. Oruç ayrıca bu geri dönüşümün sürmesini sağlayan spermidin düzeyini artırır."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tự thực bào: khi mTORC1 tắt, tế bào bắt đầu phân hủy và tái chế các protein và ty thể bị hư hỏng. Nhịn ăn cũng làm tăng spermidin, chất giúp duy trì quá trình tái chế này."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "自噬：一旦 mTORC1 关闭，细胞就开始分解并回收受损的蛋白质和线粒体。断食还会提高亚精胺水平，使这种回收持续进行。"
          }
        }
      }
    },
    "learn.benefits_fade": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الفوائد تتلاشى: بعد 3 إلى 4 أشهر، يعود ضغط الدم والجلوكوز ودهون الدم عادةً إلى ما يقارب مستوياتها الأولى، ما لم تتغير عادات الأكل بشكل دائم. فالصيام يعمل كإعادة ضبط قصيرة، لا كعلاج شافٍ."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Vorteile lassen nach: 3 bis 4 Monate später sind Blutdruck, Glukose und Blutfette meist wieder nahe den Ausgangswerten, wenn sich die Essgewohnheiten nicht dauerhaft ändern. Ein Fasten wirkt als kurzer Neustart, nicht als Heilung."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The benefits fade: 3 to 4 months later, blood pressure, glucose and blood fats are usually back near where they started unless eating habits change for good. A fast works as a short reset, not a cure."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los beneficios se desvanecen: de 3 a 4 meses después, la presión arterial, la glucosa y las grasas en sangre suelen volver a valores cercanos a los iniciales, salvo que los hábitos alimentarios cambien de forma definitiva. Un ayuno funciona como un reinicio breve, no como una cura."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les bénéfices s’estompent : 3 à 4 mois plus tard, la tension artérielle, la glycémie et les graisses sanguines sont généralement revenues près de leurs valeurs de départ, sauf si les habitudes alimentaires changent durablement. Un jeûne agit comme une remise à zéro temporaire, pas comme un remède."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "फ़ायदे घटते जाते हैं: 3 से 4 महीने बाद ब्लड प्रेशर, ग्लूकोज़ और खून की वसा आमतौर पर लगभग शुरुआती स्तर पर लौट आते हैं, जब तक खाने की आदतें हमेशा के लिए न बदलें। उपवास एक छोटा रीसेट है, इलाज नहीं।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Manfaatnya memudar: 3 sampai 4 bulan kemudian, tekanan darah, glukosa, dan lemak darah biasanya kembali mendekati kondisi awal, kecuali kebiasaan makan berubah secara permanen. Puasa berfungsi sebagai penyegaran singkat, bukan obat."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I benefici svaniscono: 3-4 mesi dopo, pressione, glicemia e grassi nel sangue di solito tornano vicini ai valori di partenza, a meno che le abitudini alimentari non cambino in modo definitivo. Un digiuno funziona come un breve riavvio, non come una cura."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "効果は薄れていきます：食習慣をずっと変え続けない限り、3〜4か月後には血圧、血糖、血中脂質はたいてい元の水準近くに戻ります。断食は一時的なリセットであり、治療法ではありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "효과는 오래가지 않아요. 식습관을 영구적으로 바꾸지 않으면 3~4개월 후 혈압, 포도당, 혈중 지질은 보통 처음 수준 가까이로 돌아가요. 단식은 치료법이 아니라 짧은 재설정이에요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Manfaatnya pudar: 3 hingga 4 bulan kemudian, tekanan darah, glukosa dan lemak darah biasanya kembali hampir ke paras asal melainkan tabiat pemakanan berubah secara kekal. Puasa berfungsi sebagai tetapan semula jangka pendek, bukan penawar."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De voordelen verdwijnen: 3 tot 4 maanden later zijn bloeddruk, glucose en bloedvetten meestal weer ongeveer terug op hun beginwaarde, tenzij het eetpatroon blijvend verandert. Vasten werkt als een korte reset, niet als genezing."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Korzyści przemijają: po 3 do 4 miesiącach ciśnienie krwi, poziom glukozy i tłuszczów we krwi zwykle wracają w pobliże wartości wyjściowych, chyba że nawyki żywieniowe zmienią się na stałe. Post działa jak krótki reset, a nie lekarstwo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os benefícios se perdem com o tempo: 3 a 4 meses depois, a pressão arterial, a glicose e as gorduras no sangue geralmente voltam para perto dos níveis iniciais, a menos que os hábitos alimentares mudem de vez. Um jejum funciona como um recomeço breve, não como uma cura."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Польза со временем проходит: через 3–4 месяца давление, уровень глюкозы и жиров в крови обычно возвращаются примерно к исходным значениям, если привычки питания не изменились навсегда. Голодание работает как кратковременная перезагрузка, а не как лечение."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Fördelarna avtar: 3 till 4 månader senare är blodtryck, glukos och blodfetter oftast tillbaka nära utgångsläget, om inte matvanorna ändras för gott. En fasta fungerar som en kort omstart, inte som ett botemedel."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Faida hupungua: miezi 3 hadi 4 baadaye, shinikizo la damu, glukosi na mafuta ya damu kwa kawaida huwa yamerudi karibu na yalipoanzia isipokuwa tabia za ulaji zibadilike kabisa. Mfungo hufanya kazi kama mwanzo mpya wa muda mfupi, si tiba."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ประโยชน์จะค่อยๆ หายไป: 3 ถึง 4 เดือนต่อมา ความดันโลหิต กลูโคส และไขมันในเลือดมักกลับไปใกล้ค่าเริ่มต้น เว้นแต่จะเปลี่ยนพฤติกรรมการกินอย่างถาวร การอดอาหารเป็นเพียงการรีเซ็ตระยะสั้น ไม่ใช่การรักษาให้หายขาด"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Faydalar azalır: beslenme alışkanlıkları kalıcı olarak değişmedikçe, 3 ila 4 ay sonra kan basıncı, glukoz ve kan yağları genellikle başlangıç düzeylerine yakın bir noktaya döner. Oruç bir tedavi değil, kısa bir sıfırlama işlevi görür."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lợi ích sẽ mất dần: 3 đến 4 tháng sau, huyết áp, đường huyết và mỡ máu thường quay về gần mức ban đầu, trừ khi thói quen ăn uống thay đổi lâu dài. Nhịn ăn có tác dụng như một lần thiết lập lại ngắn hạn, không phải cách chữa khỏi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "益处会逐渐消退：除非饮食习惯永久改变，否则 3 至 4 个月后，血压、血糖和血脂通常会回到接近起始的水平。断食只是一次短期重置，而不是治愈。"
          }
        }
      }
    },
    "learn.bp_why": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لماذا ينخفض ضغط الدم: انخفاض الإنسولين يجعل الكليتين تطرحان الصوديوم والماء. وبعد 48 إلى 72 ساعة يهدأ الجهاز العصبي (نشاط ودي أقل ونشاط نظير ودي أكبر). كما يُرخي BHB جدران الشرايين عبر أكسيد النيتريك وقنوات البوتاسيوم."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Warum der Blutdruck sinkt: Niedriges Insulin lässt die Nieren Natrium und Wasser ausscheiden. Nach 48 bis 72 Stunden beruhigt sich das Nervensystem (weniger Sympathikus-, mehr Parasympathikustonus). BHB entspannt außerdem die Arterienwände über Stickstoffmonoxid und Kaliumkanäle."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Why blood pressure falls: low insulin makes the kidneys shed sodium and water. After 48 to 72 hours the nervous system calms (less sympathetic, more parasympathetic tone). BHB also relaxes artery walls through nitric oxide and potassium channels."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Por qué baja la presión arterial: con la insulina baja, los riñones eliminan sodio y agua. Tras 48 a 72 horas, el sistema nervioso se calma (menos tono simpático y más tono parasimpático). El BHB también relaja las paredes de las arterias a través del óxido nítrico y los canales de potasio."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pourquoi la tension artérielle baisse : un faible taux d’insuline pousse les reins à éliminer le sodium et l’eau. Après 48 à 72 heures, le système nerveux s’apaise (moins de tonus sympathique, plus de tonus parasympathique). Le BHB détend aussi les parois des artères via le monoxyde d’azote et les canaux potassiques."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "ब्लड प्रेशर क्यों गिरता है: कम इंसुलिन की वजह से गुर्दे सोडियम और पानी बाहर निकालते हैं। 48 से 72 घंटे बाद तंत्रिका तंत्र शांत होता है (सिम्पैथेटिक टोन कम, पैरासिम्पैथेटिक टोन ज़्यादा)। BHB नाइट्रिक ऑक्साइड और पोटैशियम चैनलों के ज़रिए धमनियों की दीवारों को भी ढीला करता है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Mengapa tekanan darah turun: insulin yang rendah membuat ginjal membuang natrium dan air. Setelah 48 sampai 72 jam, sistem saraf menjadi lebih tenang (tonus simpatis berkurang, tonus parasimpatis meningkat). BHB juga melemaskan dinding arteri melalui oksida nitrat dan kanal kalium."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Perché la pressione scende: l'insulina bassa fa eliminare ai reni sodio e acqua. Dopo 48-72 ore il sistema nervoso si calma (meno tono simpatico, più tono parasimpatico). Il BHB rilassa anche le pareti delle arterie tramite l'ossido nitrico e i canali del potassio."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "血圧が下がる理由：インスリンが低いと、腎臓はナトリウムと水分を排出します。48〜72時間たつと神経系が落ち着きます（交感神経の働きが弱まり、副交感神経の働きが強まる）。BHBも、一酸化窒素とカリウムチャネルを介して動脈の壁をゆるめます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "혈압이 떨어지는 이유: 인슐린이 낮아지면 신장이 나트륨과 수분을 배출해요. 48~72시간이 지나면 신경계가 안정돼요(교감신경 긴장도는 낮아지고 부교감신경 긴장도는 높아져요). BHB도 산화질소와 칼륨 채널을 통해 동맥벽을 이완시켜요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Mengapa tekanan darah turun: insulin yang rendah menyebabkan buah pinggang membuang natrium dan air. Selepas 48 hingga 72 jam, sistem saraf menjadi lebih tenang (kurang tonus simpatetik, lebih tonus parasimpatetik). BHB juga mengendurkan dinding arteri melalui nitrik oksida dan saluran kalium."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Waarom de bloeddruk daalt: door een lage insuline scheiden de nieren natrium en water uit. Na 48 tot 72 uur komt het zenuwstelsel tot rust (minder sympathische, meer parasympathische activiteit). BHB ontspant ook de vaatwanden via stikstofmonoxide en kaliumkanalen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dlaczego ciśnienie krwi spada: niski poziom insuliny sprawia, że nerki wydalają sód i wodę. Po 48 do 72 godzinach układ nerwowy się uspokaja (mniejsze napięcie współczulne, większe przywspółczulne). BHB rozluźnia też ściany tętnic za pośrednictwem tlenku azotu i kanałów potasowych."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Por que a pressão arterial cai: a insulina baixa faz os rins eliminarem sódio e água. Após 48 a 72 horas, o sistema nervoso se acalma (menos tônus simpático, mais tônus parassimpático). O BHB também relaxa as paredes das artérias por meio do óxido nítrico e dos canais de potássio."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Почему снижается давление: низкий уровень инсулина заставляет почки выводить натрий и воду. Через 48–72 часа нервная система успокаивается (симпатический тонус снижается, парасимпатический повышается). BHB также расслабляет стенки артерий через оксид азота и калиевые каналы."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Varför blodtrycket sjunker: lågt insulin får njurarna att göra sig av med natrium och vatten. Efter 48 till 72 timmar lugnar sig nervsystemet (mindre sympatisk och mer parasympatisk tonus). BHB får också artärväggarna att slappna av via kväveoxid och kaliumkanaler."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Kwa nini shinikizo la damu hushuka: insulini ya chini hufanya figo zitoe sodiamu na maji. Baada ya saa 48 hadi 72 mfumo wa neva hutulia (mfumo wa simpathetiki hupungua, wa parasimpathetiki huongezeka). BHB pia hulegeza kuta za ateri kupitia oksidi ya nitriki (nitric oxide) na njia za potasiamu."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ทำไมความดันโลหิตจึงลดลง: อินซูลินที่ต่ำทำให้ไตขับโซเดียมและน้ำออก หลัง 48 ถึง 72 ชั่วโมง ระบบประสาทจะสงบลง (ระบบประสาทซิมพาเทติกทำงานน้อยลง พาราซิมพาเทติกทำงานมากขึ้น) BHB ยังช่วยให้ผนังหลอดเลือดแดงคลายตัวผ่านไนตริกออกไซด์และช่องโพแทสเซียม"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kan basıncı neden düşer: düşük insülin, böbreklerin sodyum ve su atmasına neden olur. 48 ila 72 saat sonra sinir sistemi sakinleşir (daha az sempatik, daha fazla parasempatik etkinlik). BHB ayrıca nitrik oksit ve potasyum kanalları aracılığıyla atardamar duvarlarını gevşetir."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Vì sao huyết áp giảm: insulin thấp khiến thận thải natri và nước. Sau 48 đến 72 giờ, hệ thần kinh dịu lại (giảm trương lực giao cảm, tăng trương lực phó giao cảm). BHB cũng làm giãn thành động mạch thông qua oxit nitric và các kênh kali."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "血压为何下降：胰岛素水平低会使肾脏排出钠和水。48 至 72 小时后，神经系统趋于平静（交感神经张力降低，副交感神经张力升高）。BHB 还会通过一氧化氮和钾通道使动脉壁舒张。"
          }
        }
      }
    },
    "learn.eyebrow": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الجانب العلمي"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Wissenschaft"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The science"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La ciencia"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La science"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "विज्ञान"
          }
        },
        "id": {
