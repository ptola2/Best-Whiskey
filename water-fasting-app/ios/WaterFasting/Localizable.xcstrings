    "profile.reminders.body": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تذكيرات بتسجيل الحالة عند 9:00 و21:00 أثناء الصيام، إضافة إلى تنبيهات عند مرور 12 و36 و72 ساعة، وفي اليوم 7، وعند بلوغ هدفك."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erinnerungen an Kontrollen um 9:00 und 21:00 Uhr während eines Fastens, dazu Hinweise bei 12 Std., 36 Std., 72 Std., an Tag 7 und beim Erreichen Ihres Ziels."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Check-in prompts at 9:00 and 21:00 during a fast, plus alerts at 12 h, 36 h, 72 h, day 7 and your target."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Avisos para hacer tu registro a las 9:00 y a las 21:00 durante un ayuno, más alertas a las 12 h, 36 h y 72 h, el día 7 y al llegar a tu objetivo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rappels de bilan à 9 h et à 21 h pendant un jeûne, ainsi que des alertes au bout de 12 h, 36 h et 72 h, au jour 7 et à votre objectif."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "उपवास के दौरान 9:00 और 21:00 बजे चेक-इन की याद, साथ ही 12 घंटे, 36 घंटे, 72 घंटे, दिन 7 और आपके लक्ष्य पर अलर्ट।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pengingat cek kondisi pada pukul 09.00 dan 21.00 selama puasa, ditambah pemberitahuan pada 12 jam, 36 jam, 72 jam, hari ke-7, dan saat target Anda tercapai."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Promemoria per le rilevazioni alle 9:00 e alle 21:00 durante un digiuno, più avvisi a 12 h, 36 h, 72 h, al giorno 7 e al raggiungimento dell'obiettivo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "断食中は9:00と21:00にチェックインの通知が届きます。さらに、12時間、36時間、72時間、7日目、目標達成時にもお知らせします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "단식 중 9:00 및 21:00에 체크인 알림을 보내고, 12시간, 36시간, 72시간, 7일차, 목표 시점에도 알려 드려요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Peringatan pemeriksaan pada 9:00 dan 21:00 semasa berpuasa, serta makluman pada 12 jam, 36 jam, 72 jam, hari 7 dan sasaran anda."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Herinneringen om in te checken om 9:00 en 21:00 tijdens het vasten, plus meldingen na 12 uur, 36 uur en 72 uur, op dag 7 en bij je doel."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przypomnienia o kontroli o 9:00 i 21:00 podczas postu oraz powiadomienia po 12 h, 36 h i 72 h, w 7. dniu i po osiągnięciu celu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Lembretes de registro às 9:00 e às 21:00 durante o jejum, além de alertas em 12 h, 36 h, 72 h, no dia 7 e na sua meta."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Напоминания о проверке в 9:00 и 21:00 во время голодания, а также уведомления через 12 ч, 36 ч, 72 ч, на 7-й день и при достижении цели."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Påminnelser om incheckning kl. 9.00 och 21.00 under en fasta, plus aviseringar vid 12 h, 36 h, 72 h, dag 7 och ditt mål."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Vikumbusho vya ukaguzi mnamo 9:00 na 21:00 wakati wa mfungo, pamoja na arifa baada ya saa 12, saa 36, saa 72, siku ya 7 na unapofikia lengo lako."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แจ้งเตือนให้เช็กอินเวลา 9:00 และ 21:00 ระหว่างการอดอาหาร รวมถึงแจ้งเตือนเมื่อครบ 12 ชม. 36 ชม. 72 ชม. วันที่ 7 และเมื่อถึงเป้าหมายของคุณ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Oruç sırasında 09:00 ve 21:00'de kontrol hatırlatmaları, ayrıca 12. saatte, 36. saatte, 72. saatte, 7. günde ve hedefinize ulaştığınızda uyarılar."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nhắc ghi nhận lúc 9:00 và 21:00 trong khi nhịn ăn, cùng các thông báo ở mốc 12 giờ, 36 giờ, 72 giờ, ngày 7 và khi đạt mục tiêu."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "断食期间在 9:00 和 21:00 提醒你自查，并在 12 小时、36 小时、72 小时、第 7 天及达到目标时发出提醒。"
          }
        }
      }
    },
