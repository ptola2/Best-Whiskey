{
  "sourceLanguage": "en",
  "strings": {
    "assess.action.fast": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أنهِ الصيام وتواصل مع طبيبك المعالج الآن."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beenden Sie das Fasten und wenden Sie sich sofort an Ihr Behandlungsteam."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "End the fast and contact your clinician now."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Termina el ayuno y ponte en contacto ahora mismo con tu profesional de la salud."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Arrêtez le jeûne et contactez votre professionnel de santé dès maintenant."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "उपवास खत्म करें और अभी अपने चिकित्सक से संपर्क करें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Akhiri puasa dan segera hubungi tenaga medis Anda."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Interrompi il digiuno e contatta subito il tuo medico."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "断食を終了し、今すぐ担当医に連絡してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "단식을 끝내고 지금 담당 의료진에게 연락하세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tamatkan puasa dan hubungi pengamal perubatan anda sekarang."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Stop met vasten en neem nu contact op met je zorgverlener."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zakończ post i skontaktuj się teraz z lekarzem prowadzącym."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Encerre o jejum e entre em contato com seu profissional de saúde agora."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Прекратите голодание и немедленно свяжитесь с врачом."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Avsluta fastan och kontakta din vårdkontakt nu."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Maliza mfungo na uwasiliane na mtaalamu wako wa afya sasa."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "สิ้นสุดการอดอาหารและติดต่อแพทย์ผู้ดูแลของคุณทันที"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Orucu bitirin ve hemen sağlık uzmanınızla iletişime geçin."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hãy kết thúc đợt nhịn ăn và liên hệ ngay với nhân viên y tế của bạn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请结束断食，并立即联系你的医生。"
          }
        }
      }
    },
    "assess.action.refeed": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تواصل مع طبيبك المعالج الآن. فقد تكون هذه علامات على متلازمة إعادة التغذية أو تورم إعادة التغذية."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenden Sie sich sofort an Ihr Behandlungsteam. Dies können Anzeichen eines Refeeding-Syndroms oder von Schwellungen beim Kostaufbau sein."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Contact your clinician now. These can be signs of refeeding syndrome or refeeding swelling."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ponte en contacto ahora mismo con tu profesional de la salud. Pueden ser señales del síndrome de realimentación o de la hinchazón por realimentación."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Contactez votre professionnel de santé dès maintenant. Il peut s’agir de signes d’un syndrome de renutrition inappropriée ou d’un gonflement de réalimentation."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अभी अपने चिकित्सक से संपर्क करें। ये रीफ़ीडिंग सिंड्रोम या रीफ़ीडिंग सूजन के संकेत हो सकते हैं।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Segera hubungi tenaga medis Anda. Ini bisa menjadi tanda sindrom refeeding atau pembengkakan saat makan kembali."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Contatta subito il tuo medico. Possono essere segni di sindrome da rialimentazione o di gonfiore da rialimentazione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "今すぐ担当医に連絡してください。リフィーディング症候群や、回復食によるむくみの兆候である可能性があります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "지금 담당 의료진에게 연락하세요. 재급식 증후군이나 재급식 부기의 징후일 수 있어요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Hubungi pengamal perubatan anda sekarang. Ini boleh menjadi tanda sindrom pemakanan semula atau bengkak akibat pemakanan semula."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Neem nu contact op met je zorgverlener. Dit kunnen tekenen zijn van het refeedingsyndroom of van vochtophoping bij het opbouwen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Skontaktuj się teraz z lekarzem prowadzącym. To mogą być objawy zespołu ponownego odżywienia lub obrzęków po ponownym odżywieniu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Entre em contato com seu profissional de saúde agora. Podem ser sinais de síndrome de realimentação ou de inchaço de realimentação."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Немедленно свяжитесь с врачом. Это могут быть признаки синдрома возобновления питания или отёков при возобновлении питания."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Kontakta din vårdkontakt nu. Det kan vara tecken på refeedingsyndrom eller refeedingödem (svullnad)."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Wasiliana na mtaalamu wako wa afya sasa. Hizi zinaweza kuwa dalili za sindromu ya kurejea kula (refeeding syndrome) au uvimbe wa kurejea kula."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ติดต่อแพทย์ผู้ดูแลของคุณทันที อาการเหล่านี้อาจเป็นสัญญาณของกลุ่มอาการรีฟีดดิงหรืออาการบวมจากการกลับมากินอาหาร"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hemen sağlık uzmanınızla iletişime geçin. Bunlar yeniden beslenme sendromunun veya yeniden beslenmeye bağlı şişliğin belirtileri olabilir."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hãy liên hệ ngay với nhân viên y tế của bạn. Đây có thể là dấu hiệu của hội chứng nuôi ăn lại hoặc phù khi ăn lại."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请立即联系你的医生。这些可能是再喂养综合征或再喂养水肿的迹象。"
          }
        }
      }
    },
    "assess.bhb.brain": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مستوى BHB لديك %@ mmol/L: عند تجاوز 2.0 تصل الكيتونات إلى الدماغ وتغطي جزءًا كبيرًا من حاجته إلى الوقود."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "BHB von %@ mmol/L: Oberhalb von 2,0 erreichen Ketone das Gehirn und decken einen Großteil seines Energiebedarfs."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "BHB of %@ mmol/L: above 2.0, ketones are reaching the brain and covering much of its fuel."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "BHB de %@ mmol/L: por encima de 2,0, las cetonas llegan al cerebro y aportan gran parte de su combustible."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "BHB de %@ mmol/L : au-delà de 2,0, les cétones atteignent le cerveau et couvrent une grande partie de ses besoins en carburant."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "BHB %@ mmol/L: 2.0 से ऊपर, कीटोन दिमाग तक पहुँच रहे हैं और उसके ईंधन का बड़ा हिस्सा पूरा कर रहे हैं।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "BHB %@ mmol/L: di atas 2,0, keton mencapai otak dan memenuhi sebagian besar kebutuhan bahan bakarnya."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "BHB di %@ mmol/L: sopra 2,0 i chetoni raggiungono il cervello e coprono buona parte del suo fabbisogno energetico."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "BHB %@ mmol/L：2.0を超えると、ケトン体が脳に届き、脳の燃料の多くをまかなうようになります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "BHB %@ mmol/L: 2.0을 넘으면 케톤이 뇌에 도달해 뇌 연료의 상당 부분을 충당해요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "BHB %@ mmol/L: melebihi 2.0, keton sampai ke otak dan membekalkan sebahagian besar sumber tenaganya."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "BHB van %@ mmol/L: boven 2,0 bereiken ketonen de hersenen en leveren ze een groot deel van hun brandstof."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "BHB %@ mmol/L: powyżej 2,0 ciała ketonowe docierają do mózgu i pokrywają znaczną część jego zapotrzebowania na paliwo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "BHB de %@ mmol/L: acima de 2,0, as cetonas chegam ao cérebro e cobrem grande parte do combustível que ele usa."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "BHB %@ ммоль/л: при уровне выше 2,0 кетоны поступают в мозг и покрывают значительную часть его потребности в энергии."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "BHB på %@ mmol/L: över 2,0 når ketonerna hjärnan och står för en stor del av dess bränsle."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "BHB ya %@ mmol/L: juu ya 2.0, ketoni zinafika kwenye ubongo na kutoa sehemu kubwa ya nishati yake."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "BHB %@ mmol/L: เมื่อสูงกว่า 2.0 คีโตนจะเข้าถึงสมองและเป็นเชื้อเพลิงให้สมองได้เป็นสัดส่วนมาก"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "BHB değeri %@ mmol/L: 2,0'ın üzerinde ketonlar beyne ulaşır ve beynin yakıt ihtiyacının büyük kısmını karşılar."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "BHB %@ mmol/L: trên 2,0, thể ceton đang đến não và cung cấp phần lớn nhiên liệu cho não."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "BHB 为 %@ mmol/L：超过 2.0 时，酮体会进入大脑，提供其大部分燃料。"
          }
        }
      }
    },
    "assess.bhb.high": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مستوى BHB لديك %@ mmol/L، وهو أعلى من نطاق 3.0 إلى 7.0 الذي يُلاحظ عادةً بحلول الأيام من 5 إلى 10. أطلع طبيبك المعالج على هذه القراءة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "BHB von %@ mmol/L liegt über dem Bereich von 3,0 bis 7,0, der an Tag 5 bis 10 üblicherweise erreicht wird. Teilen Sie den Wert Ihrem Behandlungsteam mit."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "BHB of %@ mmol/L is above the 3.0 to 7.0 range usually seen by days 5 to 10. Share the reading with your clinician."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un BHB de %@ mmol/L está por encima del rango de 3,0 a 7,0 que suele verse entre los días 5 y 10. Comparte la lectura con tu profesional de la salud."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un BHB de %@ mmol/L dépasse la plage de 3,0 à 7,0 habituellement observée aux jours 5 à 10. Communiquez cette valeur à votre professionnel de santé."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "BHB %@ mmol/L है, जो दिन 5 से 10 तक आमतौर पर दिखने वाली 3.0 से 7.0 की सीमा से ज़्यादा है। यह रीडिंग अपने चिकित्सक को बताएँ।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "BHB %@ mmol/L berada di atas kisaran 3,0 sampai 7,0 yang biasa terlihat pada hari ke-5 sampai ke-10. Sampaikan hasil ini kepada tenaga medis Anda."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un BHB di %@ mmol/L supera l'intervallo da 3,0 a 7,0 che si osserva di solito tra il giorno 5 e il giorno 10. Condividi il valore con il tuo medico."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "BHB %@ mmol/Lは、通常5〜10日目までに見られる3.0〜7.0の範囲を上回っています。この測定値を担当医に伝えてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "BHB %@ mmol/L: 보통 5~10일차까지 나타나는 3.0~7.0 범위보다 높아요. 담당 의료진에게 측정값을 알리세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "BHB %@ mmol/L melebihi julat 3.0 hingga 7.0 yang biasanya dilihat menjelang hari 5 hingga 10. Kongsikan bacaan ini dengan pengamal perubatan anda."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een BHB van %@ mmol/L ligt boven het bereik van 3,0 tot 7,0 dat op dag 5 tot 10 meestal wordt gezien. Deel de meting met je zorgverlener."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "BHB %@ mmol/L przekracza zakres od 3,0 do 7,0 obserwowany zwykle w dniach od 5 do 10. Przekaż ten wynik lekarzowi prowadzącemu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "BHB de %@ mmol/L está acima da faixa de 3,0 a 7,0 geralmente observada por volta dos dias 5 a 10. Compartilhe a leitura com seu profissional de saúde."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "BHB %@ ммоль/л: это выше диапазона от 3,0 до 7,0, который обычно наблюдается к 5–10-му дню. Сообщите этот результат врачу."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "BHB på %@ mmol/L ligger över intervallet 3,0 till 7,0 som brukar ses dag 5 till 10. Visa värdet för din vårdkontakt."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "BHB ya %@ mmol/L iko juu ya kiwango cha 3.0 hadi 7.0 kinachoonekana kwa kawaida kufikia siku ya 5 hadi 10. Mwonyeshe mtaalamu wako wa afya kipimo hiki."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "BHB %@ mmol/L สูงกว่าช่วง 3.0 ถึง 7.0 ที่มักพบภายในวันที่ 5 ถึง 10 แจ้งค่านี้กับแพทย์ผู้ดูแลของคุณ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "BHB değeri %@ mmol/L; bu, genellikle 5. ila 10. günlerde görülen 3,0 ila 7,0 aralığının üzerindedir. Ölçümü sağlık uzmanınızla paylaşın."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "BHB %@ mmol/L cao hơn khoảng 3,0 đến 7,0 thường thấy vào ngày 5 đến 10. Hãy chia sẻ kết quả đo với nhân viên y tế của bạn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "BHB 为 %@ mmol/L，高于第 5 至 10 天通常可见的 3.0 至 7.0 范围。请把这个读数告诉你的医生。"
          }
        }
      }
    },
    "assess.bhb.low": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مستوى BHB لديك %@ mmol/L. تبدأ الكيتونات في الوصول إلى الدماغ بكميات كبيرة عند تجاوز 2.0 mmol/L."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "BHB von %@ mmol/L. Ketone gelangen erst oberhalb von 2,0 mmol/L in nennenswerter Menge ins Gehirn."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "BHB of %@ mmol/L. Ketones start reaching the brain in quantity above 2.0 mmol/L."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "BHB de %@ mmol/L. Por encima de 2,0 mmol/L, las cetonas empiezan a llegar al cerebro en cantidad."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "BHB de %@ mmol/L. Les cétones commencent à atteindre le cerveau en quantité au-delà de 2,0 mmol/L."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "BHB %@ mmol/L। 2.0 mmol/L से ऊपर कीटोन बड़ी मात्रा में दिमाग तक पहुँचने लगते हैं।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "BHB %@ mmol/L. Keton mulai mencapai otak dalam jumlah besar di atas 2,0 mmol/L."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "BHB di %@ mmol/L. I chetoni iniziano a raggiungere il cervello in quantità sopra 2,0 mmol/L."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "BHB %@ mmol/L。ケトン体が脳に多く届き始めるのは2.0 mmol/Lを超えてからです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "BHB %@ mmol/L. 케톤은 2.0 mmol/L를 넘어야 뇌에 많은 양이 도달하기 시작해요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "BHB %@ mmol/L. Keton mula sampai ke otak dalam kuantiti yang banyak apabila melebihi 2.0 mmol/L."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "BHB van %@ mmol/L. Boven 2,0 mmol/L bereiken ketonen de hersenen in grote hoeveelheden."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "BHB %@ mmol/L. Ciała ketonowe zaczynają docierać do mózgu w dużych ilościach powyżej 2,0 mmol/L."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "BHB de %@ mmol/L. As cetonas começam a chegar ao cérebro em quantidade acima de 2,0 mmol/L."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "BHB %@ ммоль/л. В значительном количестве кетоны начинают поступать в мозг при уровне выше 2,0 ммоль/л."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "BHB på %@ mmol/L. Ketoner börjar nå hjärnan i större mängd över 2,0 mmol/L."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "BHB ya %@ mmol/L. Ketoni huanza kufika kwenye ubongo kwa wingi juu ya 2.0 mmol/L."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "BHB %@ mmol/L คีโตนจะเริ่มเข้าถึงสมองในปริมาณมากเมื่อสูงกว่า 2.0 mmol/L"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "BHB değeri %@ mmol/L. Ketonlar 2,0 mmol/L'nin üzerinde beyne önemli miktarda ulaşmaya başlar."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "BHB %@ mmol/L. Thể ceton bắt đầu đến não với lượng đáng kể khi trên 2,0 mmol/L."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "BHB 为 %@ mmol/L。超过 2.0 mmol/L 时，酮体才开始大量进入大脑。"
          }
        }
      }
    },
    "assess.bp_drop": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "انخفض ضغط دمك بمقدار %1$lld/%2$lld mmHg عند الوقوف. يُعدّ الانخفاض بمقدار 20/10 أو أكثر انخفاضًا انتصابيًا في ضغط الدم. أطلع طبيبك المعالج على ذلك، وتجنب التغيير المفاجئ في وضعية جسمك."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ihr Blutdruck ist beim Aufstehen um %1$lld/%2$lld mmHg gefallen. Ein Abfall um 20/10 oder mehr gilt als orthostatische Hypotonie. Teilen Sie dies Ihrem Behandlungsteam mit und vermeiden Sie plötzliche Lagewechsel."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Blood pressure fell %1$lld/%2$lld mmHg when you stood up. A drop of 20/10 or more counts as orthostatic hypotension. Share it with your clinician and avoid sudden position changes."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu presión arterial bajó %1$lld/%2$lld mmHg al ponerte de pie. Una bajada de 20/10 o más se considera hipotensión ortostática. Compártelo con tu profesional de la salud y evita los cambios bruscos de postura."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre tension artérielle a baissé de %1$lld/%2$lld mmHg au passage en position debout. Une baisse de 20/10 ou plus correspond à une hypotension orthostatique. Signalez-le à votre professionnel de santé et évitez les changements de position brusques."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "खड़े होने पर आपका ब्लड प्रेशर %1$lld/%2$lld mmHg गिर गया। 20/10 या उससे ज़्यादा की गिरावट को ऑर्थोस्टैटिक हाइपोटेंशन माना जाता है। इसे अपने चिकित्सक को बताएँ और अचानक स्थिति बदलने से बचें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tekanan darah Anda turun %1$lld/%2$lld mmHg saat Anda berdiri. Penurunan 20/10 atau lebih tergolong hipotensi ortostatik. Sampaikan hal ini kepada tenaga medis Anda dan hindari perubahan posisi yang mendadak."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La pressione è scesa di %1$lld/%2$lld mmHg al momento di alzarti. Un calo di 20/10 o più si considera ipotensione ortostatica. Comunicalo al tuo medico ed evita cambi di posizione bruschi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "立ち上がったときに血圧が%1$lld/%2$lld mmHg下がりました。20/10以上の低下は起立性低血圧とされます。担当医に伝え、急な姿勢の変化を避けてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "일어섰을 때 혈압이 %1$lld/%2$lld mmHg 떨어졌어요. 20/10 이상 떨어지면 기립성 저혈압에 해당해요. 담당 의료진에게 알리고 갑작스러운 자세 변화를 피하세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tekanan darah anda turun %1$lld/%2$lld mmHg apabila anda berdiri. Penurunan 20/10 atau lebih dikira sebagai hipotensi ortostatik. Kongsikan dengan pengamal perubatan anda dan elakkan perubahan kedudukan secara mengejut."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je bloeddruk daalde %1$lld/%2$lld mmHg toen je opstond. Een daling van 20/10 of meer geldt als orthostatische hypotensie. Bespreek het met je zorgverlener en vermijd plotselinge houdingsveranderingen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Po wstaniu ciśnienie krwi spadło o %1$lld/%2$lld mmHg. Spadek o 20/10 lub więcej oznacza hipotensję ortostatyczną. Przekaż to lekarzowi prowadzącemu i unikaj gwałtownych zmian pozycji."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sua pressão arterial caiu %1$lld/%2$lld mmHg quando você ficou de pé. Uma queda de 20/10 ou mais é considerada hipotensão ortostática. Informe seu profissional de saúde e evite mudanças bruscas de posição."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Когда вы встали, давление снизилось на %1$lld/%2$lld мм рт. ст. Снижение на 20/10 и более считается ортостатической гипотензией. Сообщите об этом врачу и избегайте резкой смены положения тела."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Blodtrycket sjönk %1$lld/%2$lld mmHg när du reste dig. En sänkning på 20/10 eller mer räknas som ortostatisk hypotension. Berätta det för din vårdkontakt och undvik snabba lägesändringar."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Shinikizo la damu lilishuka %1$lld/%2$lld mmHg uliposimama. Kushuka kwa 20/10 au zaidi huhesabiwa kuwa shinikizo la damu kushuka unaposimama (orthostatic hypotension). Mweleze mtaalamu wako wa afya na uepuke kubadilisha mkao ghafla."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ความดันโลหิตลดลง %1$lld/%2$lld mmHg เมื่อคุณลุกยืน การลดลงตั้งแต่ 20/10 ขึ้นไปถือเป็นภาวะความดันโลหิตต่ำขณะเปลี่ยนท่า แจ้งค่านี้กับแพทย์ผู้ดูแลของคุณและหลีกเลี่ยงการเปลี่ยนท่าทางอย่างกะทันหัน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ayağa kalktığınızda kan basıncınız %1$lld/%2$lld mmHg düştü. 20/10 veya daha fazla düşüş ortostatik hipotansiyon sayılır. Bunu sağlık uzmanınızla paylaşın ve ani pozisyon değişikliklerinden kaçının."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Huyết áp giảm %1$lld/%2$lld mmHg khi bạn đứng dậy. Mức giảm từ 20/10 trở lên được xem là hạ huyết áp tư thế đứng. Hãy báo cho nhân viên y tế của bạn và tránh thay đổi tư thế đột ngột."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "站起时你的血压下降了 %1$lld/%2$lld mmHg。下降 20/10 或以上即属于直立性低血压。请告知你的医生，并避免突然改变体位。"
          }
        }
      }
    },
    "assess.common": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "آثار جانبية شائعة وخفيفة في الغالب. في 768 حالة صيام خاضعة للإشراف، ظهر لدى 90% من الأشخاص أثر واحد منها على الأقل بحلول اليوم 5."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Häufige, meist leichte Nebenwirkungen. Bei 768 medizinisch überwachten Fastenperioden hatten 90 % der Personen bis Tag 5 mindestens eine davon."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Common, mostly mild side effects. In 768 supervised fasts, 90% of people had at least one by day 5."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Efectos secundarios frecuentes y en su mayoría leves. En 768 ayunos supervisados, el 90 % de las personas tuvo al menos uno al llegar al día 5."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Effets secondaires fréquents, le plus souvent légers. Sur 768 jeûnes sous surveillance médicale, 90 % des personnes en avaient eu au moins un au jour 5."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आम, ज़्यादातर हल्के दुष्प्रभाव। निगरानी में हुए 768 उपवासों में, दिन 5 तक 90% लोगों को कम से कम एक दुष्प्रभाव हुआ।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Efek samping umum, sebagian besar ringan. Dalam 768 puasa dengan pengawasan, 90% orang mengalami setidaknya satu efek samping hingga hari ke-5."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Effetti collaterali comuni, per lo più lievi. In 768 digiuni sotto supervisione medica, il 90% delle persone ne ha avuto almeno uno entro il giorno 5."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "よく見られる、主に軽い副作用です。医療管理下で行われた768件の断食では、5日目までに90%の人に少なくとも1つの副作用が見られました。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "흔하며 대체로 가벼운 부작용이에요. 의료진 감독하에 진행된 768건의 단식에서 5일차까지 90%의 사람이 적어도 한 가지를 겪었어요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Kesan sampingan biasa, kebanyakannya ringan. Dalam 768 puasa berpengawasan, 90% orang mengalami sekurang-kurangnya satu kesan menjelang hari 5."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Veelvoorkomende, meestal milde bijwerkingen. Bij 768 vastenperiodes onder toezicht had 90% van de mensen er tegen dag 5 minstens één."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Częste, przeważnie łagodne skutki uboczne. W 768 nadzorowanych postach 90% osób miało co najmniej jeden z nich do 5. dnia."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Efeitos colaterais comuns, em geral leves. Em 768 jejuns supervisionados, 90% das pessoas tiveram pelo menos um até o dia 5."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Частые, в основном лёгкие побочные эффекты. В 768 голоданиях под медицинским наблюдением у 90% людей к 5-му дню был хотя бы один из них."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Vanliga, oftast lindriga biverkningar. I 768 övervakade fastor hade 90 % av deltagarna minst en av dem senast dag 5."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Madhara ya kawaida, mengi yakiwa madogo. Katika mifungo 768 yenye usimamizi, 90% ya watu walipata angalau dhara moja kufikia siku ya 5."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ผลข้างเคียงที่พบบ่อยและส่วนใหญ่ไม่รุนแรง จากการอดอาหารภายใต้การดูแลทางการแพทย์ 768 ครั้ง ผู้อดอาหาร 90% มีอาการอย่างน้อยหนึ่งอย่างภายในวันที่ 5"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yaygın, çoğunlukla hafif yan etkiler. Gözetim altındaki 768 oruçta, kişilerin %90'ında 5. güne kadar en az biri görüldü."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tác dụng phụ thường gặp, phần lớn nhẹ. Trong 768 đợt nhịn ăn có giám sát, 90% người gặp ít nhất một tác dụng phụ tính đến ngày 5."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "常见的副作用，大多轻微。在 768 次有医疗监护的断食中，90% 的人到第 5 天时至少出现过一种。"
          }
        }
      }
    },
    "assess.dizzy": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الدوخة عند الوقوف شائعة في الأيام من 2 إلى 5 مع انخفاض حجم الدم. انهض ببطء واسترح. إذا أُغمي عليك أو كدت تفقد الوعي، فأوقف الصيام."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Benommenheit beim Aufstehen ist an Tag 2 bis 5 häufig, weil das Blutvolumen sinkt. Stehen Sie langsam auf und ruhen Sie sich aus. Wenn Sie ohnmächtig werden oder kurz davor sind, beenden Sie das Fasten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Lightheadedness on standing is common on days 2 to 5 as blood volume drops. Get up slowly and rest. If you faint or nearly faint, stop the fast."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El mareo al ponerse de pie es frecuente entre los días 2 y 5, porque baja el volumen de sangre. Levántate despacio y descansa. Si te desmayas o casi te desmayas, interrumpe el ayuno."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les étourdissements en position debout sont fréquents du jour 2 au jour 5, à mesure que le volume sanguin diminue. Levez-vous lentement et reposez-vous. Si vous vous évanouissez ou êtes sur le point de vous évanouir, arrêtez le jeûne."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "दिन 2 से 5 में खड़े होने पर हल्का चक्कर आना आम है, क्योंकि खून की मात्रा घटती है। धीरे से उठें और आराम करें। अगर आप बेहोश हो जाएँ या लगभग बेहोश हो जाएँ, तो उपवास रोक दें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kepala terasa melayang saat berdiri umum terjadi pada hari ke-2 sampai ke-5 karena volume darah turun. Bangunlah perlahan dan beristirahatlah. Jika Anda pingsan atau hampir pingsan, hentikan puasa."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sentire la testa leggera quando ti alzi è comune dal giorno 2 al giorno 5, perché il volume del sangue diminuisce. Alzati lentamente e riposa. Se svieni o stai per svenire, interrompi il digiuno."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "血液量が減るため、2〜5日目には立ち上がったときの立ちくらみがよく起こります。ゆっくり立ち上がり、休んでください。失神した場合や失神しそうになった場合は、断食を中止してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "2~5일차에는 혈액량이 줄면서 일어설 때 어지러운 증상이 흔해요. 천천히 일어나고 쉬세요. 실신하거나 실신할 것 같으면 단식을 중단하세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Rasa pening apabila berdiri adalah biasa pada hari 2 hingga 5 kerana isipadu darah menurun. Bangun perlahan-lahan dan berehat. Jika anda pengsan atau hampir pengsan, hentikan puasa."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Licht in het hoofd zijn bij het opstaan komt vaak voor op dag 2 tot 5, doordat het bloedvolume daalt. Sta langzaam op en rust. Als je flauwvalt of bijna flauwvalt, stop dan met vasten."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zawroty głowy przy wstawaniu są częste w dniach od 2 do 5, gdy spada objętość krwi. Wstawaj powoli i odpoczywaj. Jeśli zemdlejesz lub prawie zemdlejesz, przerwij post."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Tontura ao ficar de pé é comum entre os dias 2 e 5, à medida que o volume de sangue diminui. Levante-se devagar e descanse. Se você desmaiar ou quase desmaiar, interrompa o jejum."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Головокружение при вставании часто бывает со 2-го по 5-й день, так как снижается объём крови. Вставайте медленно и отдыхайте. Если вы потеряли сознание или были близки к обмороку, прекратите голодание."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Yrsel när du reser dig är vanligt dag 2 till 5, när blodvolymen minskar. Res dig långsamt och vila. Om du svimmar eller nästan svimmar ska du avbryta fastan."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Kizunguzungu unaposimama ni kawaida siku ya 2 hadi 5 kwa sababu kiasi cha damu hupungua. Inuka polepole na upumzike. Ukizimia au ukikaribia kuzimia, acha mfungo."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "อาการหน้ามืดเมื่อลุกยืนพบบ่อยในวันที่ 2 ถึง 5 เนื่องจากปริมาณเลือดลดลง ค่อยๆ ลุกขึ้นและพักผ่อน หากคุณเป็นลมหรือเกือบเป็นลม ให้หยุดอดอาหาร"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ayağa kalkınca sersemlik, kan hacmi azaldıkça 2. ila 5. günlerde sık görülür. Yavaşça kalkın ve dinlenin. Bayılırsanız veya bayılacak gibi olursanız orucu bırakın."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Choáng váng khi đứng dậy thường gặp vào ngày 2 đến 5 do thể tích máu giảm. Hãy đứng dậy từ từ và nghỉ ngơi. Nếu bạn ngất hoặc suýt ngất, hãy dừng nhịn ăn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "第 2 至 5 天，随着血容量下降，站起时头晕很常见。请慢慢起身并休息。如果你晕倒或几乎晕倒，请停止断食。"
          }
        }
      }
    },
    "assess.joint": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "غالبًا ما يكون المفصل الساخن المتورم أثناء الصيام علامة على النقرس: فالكيتونات تعيق تخلّص الجسم من حمض اليوريك. والنوبة الحادة سبب لإنهاء الصيام."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein heißes, geschwollenes Gelenk während des Fastens ist oft Gicht: Ketone behindern die Ausscheidung von Harnsäure. Ein akuter Schub ist ein Grund, das Fasten zu beenden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A hot, swollen joint during a fast is often gout: ketones block uric acid clearance. An acute flare is a reason to end the fast."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una articulación caliente e hinchada durante un ayuno suele ser gota: las cetonas bloquean la eliminación del ácido úrico. Una crisis aguda es motivo para terminar el ayuno."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une articulation chaude et gonflée pendant un jeûne est souvent une crise de goutte : les cétones bloquent l’élimination de l’acide urique. Une crise aiguë est une raison d’arrêter le jeûne."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "उपवास के दौरान गर्म, सूजा हुआ जोड़ अक्सर गाउट होता है: कीटोन यूरिक एसिड को शरीर से बाहर निकलने से रोकते हैं। गाउट का तीव्र दौरा उपवास खत्म करने का कारण है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Sendi yang panas dan bengkak selama puasa sering kali merupakan gout: keton menghambat pembuangan asam urat. Serangan akut adalah alasan untuk mengakhiri puasa."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un'articolazione calda e gonfia durante il digiuno è spesso gotta: i chetoni ostacolano l'eliminazione dell'acido urico. Un attacco acuto è un motivo per interrompere il digiuno."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "断食中に関節が熱をもって腫れる場合、多くは痛風です。ケトン体が尿酸の排出を妨げるためです。急性の発作は断食を終了する理由になります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "단식 중 관절이 뜨겁고 부어오르면 통풍인 경우가 많아요. 케톤이 요산 배출을 막기 때문이에요. 급성 발작이 생기면 단식을 끝내야 해요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Sendi yang panas dan bengkak semasa berpuasa selalunya gout: keton menyekat penyingkiran asid urik. Serangan akut ialah sebab untuk menamatkan puasa."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een warm, gezwollen gewricht tijdens het vasten is vaak jicht: ketonen remmen de afvoer van urinezuur. Een acute aanval is een reden om te stoppen met vasten."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gorący, obrzęknięty staw podczas postu to często dna moczanowa: ciała ketonowe blokują wydalanie kwasu moczowego. Ostry napad to powód, by zakończyć post."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma articulação quente e inchada durante o jejum costuma ser gota: as cetonas bloqueiam a eliminação do ácido úrico. Uma crise aguda é motivo para encerrar o jejum."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Горячий опухший сустав во время голодания часто означает подагру: кетоны мешают выведению мочевой кислоты. Острый приступ является поводом прекратить голодание."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "En varm, svullen led under en fasta är ofta gikt: ketoner hindrar utsöndringen av urinsyra. Ett akut giktanfall är ett skäl att avsluta fastan."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Kiungo chenye joto na kilichovimba wakati wa mfungo mara nyingi ni gauti: ketoni huzuia figo kuondoa asidi ya uriki. Shambulio kali la ghafla ni sababu ya kumaliza mfungo."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ข้อที่ร้อนและบวมระหว่างการอดอาหารมักเป็นโรคเกาต์ เพราะคีโตนขัดขวางการขับกรดยูริก หากเกาต์กำเริบเฉียบพลัน ถือเป็นเหตุผลให้สิ้นสุดการอดอาหาร"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Oruç sırasında sıcak, şiş bir eklem çoğu zaman gut belirtisidir: ketonlar ürik asidin atılmasını engeller. Akut bir gut atağı, orucu bitirmek için bir nedendir."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Khớp nóng, sưng trong lúc nhịn ăn thường là bệnh gút: thể ceton cản trở việc đào thải acid uric. Cơn gút cấp là lý do để kết thúc đợt nhịn ăn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "断食期间关节发热、肿胀，通常是痛风：酮体会阻碍尿酸排出。急性发作是结束断食的理由。"
          }
        }
      }
    },
    "assess.low_systolic": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ضغطك الانقباضي في وضعية الاستلقاء %lld mmHg، وهو منخفض. استرح وأبلغ طبيبك المعالج."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein systolischer Blutdruck von %lld mmHg im Liegen ist niedrig. Ruhen Sie sich aus und informieren Sie Ihr Behandlungsteam."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A lying systolic pressure of %lld mmHg is low. Rest and tell your clinician."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una presión sistólica de %lld mmHg en posición acostada es baja. Descansa y díselo a tu profesional de la salud."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une pression systolique de %lld mmHg en position couchée est basse. Reposez-vous et prévenez votre professionnel de santé."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "लेटे हुए %lld mmHg का सिस्टोलिक प्रेशर कम है। आराम करें और अपने चिकित्सक को बताएँ।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tekanan sistolik %lld mmHg saat berbaring tergolong rendah. Beristirahatlah dan beri tahu tenaga medis Anda."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Una pressione sistolica da sdraiati di %lld mmHg è bassa. Riposa e avvisa il tuo medico."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "横になった状態での収縮期血圧%lld mmHgは低い値です。休息をとり、担当医に伝えてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "누운 자세의 수축기 혈압이 낮아요(%lld mmHg). 쉬면서 담당 의료진에게 알리세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tekanan sistolik %lld mmHg semasa berbaring adalah rendah. Berehat dan beritahu pengamal perubatan anda."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een systolische bloeddruk van %lld mmHg in liggende houding is laag. Rust en vertel het je zorgverlener."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ciśnienie skurczowe na leżąco %lld mmHg jest niskie. Odpocznij i powiedz o tym lekarzowi prowadzącemu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma pressão sistólica de %lld mmHg na posição deitada é baixa. Descanse e avise seu profissional de saúde."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Систолическое давление лёжа %lld мм рт. ст.: это низкое значение. Отдохните и сообщите врачу."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ett systoliskt tryck på %lld mmHg i liggande är lågt. Vila och berätta det för din vårdkontakt."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Shinikizo la juu (systolic) la %lld mmHg ukiwa umelala ni la chini. Pumzika na umweleze mtaalamu wako wa afya."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ความดันตัวบนขณะนอน %lld mmHg ถือว่าต่ำ พักผ่อนและแจ้งแพทย์ผู้ดูแลของคุณ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yatarken ölçülen %lld mmHg sistolik basınç düşüktür. Dinlenin ve sağlık uzmanınıza haber verin."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Huyết áp tâm thu khi nằm %lld mmHg là thấp. Hãy nghỉ ngơi và báo cho nhân viên y tế của bạn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "平躺时收缩压为 %lld mmHg，偏低。请休息，并告诉你的医生。"
          }
        }
      }
    },
    "assess.none": {
