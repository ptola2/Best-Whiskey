    "profile.clinician.body": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تظهر بياناته على شاشة «اليوم» أثناء الصيام مع زر اتصال، لتكون في متناول يدك."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wird während eines Fastens auf dem Bildschirm „Heute“ mit einer Anruftaste angezeigt, damit es schnell erreichbar ist."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Shown on the Today screen during a fast, with a call button, so it is close at hand."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aparece en la pantalla Hoy durante un ayuno, con un botón para llamar, para que lo tengas a mano."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Affiché sur l’écran Aujourd’hui pendant un jeûne, avec un bouton d’appel, pour l’avoir à portée de main."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "उपवास के दौरान “आज” स्क्रीन पर कॉल बटन के साथ दिखाया जाता है, ताकि संपर्क हाथ के पास रहे।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ditampilkan di layar Hari Ini selama puasa, dengan tombol telepon, agar mudah dijangkau."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Viene mostrato nella schermata Oggi durante un digiuno, con un pulsante per chiamare, così lo hai sempre a portata di mano."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "断食中は「今日」画面に電話ボタン付きで表示されるので、すぐに連絡できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "단식 중 오늘 화면에 전화 버튼과 함께 표시되어 바로 연락할 수 있어요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Dipaparkan pada skrin Hari Ini semasa berpuasa, dengan butang panggilan, supaya mudah dicapai."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wordt tijdens het vasten getoond op het scherm Vandaag, met een belknop, zodat je deze gegevens bij de hand hebt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wyświetlany podczas postu na ekranie Dziś, z przyciskiem połączenia, aby był pod ręką."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Aparece na tela Hoje durante o jejum, com um botão de ligação, para ficar sempre à mão."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Во время голодания показывается на экране «Сегодня» с кнопкой вызова, чтобы контакт всегда был под рукой."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Visas på skärmen Idag under en fasta, med en ringknapp, så att den finns nära till hands."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Huonyeshwa kwenye skrini ya Leo wakati wa mfungo, pamoja na kitufe cha kupiga simu, ili mawasiliano yawe karibu."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แสดงบนหน้าจอ “วันนี้” ระหว่างการอดอาหาร พร้อมปุ่มโทร เพื่อให้ติดต่อได้สะดวก"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Oruç sırasında Bugün ekranında bir arama düğmesiyle gösterilir; böylece her zaman elinizin altında olur."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hiển thị trên màn hình Hôm nay trong khi nhịn ăn, kèm nút gọi, để luôn sẵn trong tầm tay."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "断食期间会显示在“今天”页面上，并附有拨号按钮，方便随时联系。"
          }
        }
      }
    },
