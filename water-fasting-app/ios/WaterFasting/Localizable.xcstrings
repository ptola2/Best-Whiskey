    "health.import.none": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا توجد قراءات للوزن أو ضغط الدم في Apple Health خلال آخر 24 ساعة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Keine Werte für Gewicht oder Blutdruck aus den letzten 24 Stunden in Apple Health."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No weight or blood pressure in Apple Health from the last 24 hours."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No hay mediciones de peso ni de presión arterial en Apple Health de las últimas 24 horas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucune mesure de poids ou de tension artérielle dans Apple Health au cours des dernières 24 heures."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "No weight or blood pressure in Apple Health from the last 24 hours."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tidak ada data berat badan atau tekanan darah di Apple Health dalam 24 jam terakhir."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessun valore di peso o pressione in Apple Health nelle ultime 24 ore."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "過去24時間の体重や血圧のデータがApple Healthにありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "지난 24시간 동안 Apple Health에 기록된 체중이나 혈압이 없어요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tiada bacaan berat badan atau tekanan darah dalam Apple Health bagi tempoh 24 jam yang lalu."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Geen gewicht of bloeddruk in Apple Health van de afgelopen 24 uur."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Brak pomiarów masy ciała ani ciśnienia krwi w Apple Health z ostatnich 24 godzin."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nenhum peso ou pressão arterial no Apple Health nas últimas 24 horas."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В Apple Health нет данных о весе или давлении за последние 24 часа."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Inga vikt- eller blodtrycksvärden i Apple Health från de senaste 24 timmarna."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Hakuna uzito wala shinikizo la damu kwenye Apple Health katika saa 24 zilizopita."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไม่มีข้อมูลน้ำหนักหรือความดันโลหิตใน Apple Health ในช่วง 24 ชั่วโมงที่ผ่านมา"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Health'te son 24 saate ait kilo veya kan basıncı kaydı yok."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Health không có dữ liệu cân nặng hay huyết áp nào trong 24 giờ qua."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Health 中没有过去 24 小时内的体重或血压数据。"
          }
        }
      }
    },
