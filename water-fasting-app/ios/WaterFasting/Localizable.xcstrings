    "notify.past_target.body": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "صيامك ما زال مستمرًا. أنهِه في Waterline لتحصل على خطة إعادة التغذية، أو سجّل حالتك."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ihr Fasten läuft noch. Beenden Sie es in Waterline, um Ihren Kostaufbauplan zu erhalten, oder tragen Sie eine Kontrolle ein."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your fast is still running. End it in Waterline to get your refeeding plan, or check in."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu ayuno sigue en marcha. Termínalo en Waterline para obtener tu plan de realimentación, o haz un registro."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre jeûne est toujours en cours. Terminez-le dans Waterline pour obtenir votre plan de réalimentation, ou faites un bilan."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपका उपवास अभी भी चल रहा है। दोबारा खाने की अपनी योजना पाने के लिए इसे Waterline में खत्म करें, या चेक-इन करें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Puasa Anda masih berjalan. Akhiri di Waterline untuk mendapatkan rencana makan kembali Anda, atau lakukan cek kondisi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il digiuno è ancora in corso. Terminalo in Waterline per ottenere il piano di rialimentazione, oppure fai una rilevazione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "断食はまだ続いています。Waterlineで断食を終了して回復食プランを確認するか、チェックインしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "단식이 아직 진행 중이에요. Waterline에서 단식을 종료하고 보식 계획을 받거나, 체크인하세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Puasa anda masih berjalan. Tamatkannya dalam Waterline untuk mendapatkan pelan pemakanan semula anda, atau buat pemeriksaan."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je vasten loopt nog. Beëindig het in Waterline om je opbouwschema te krijgen, of check in."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Twój post nadal trwa. Zakończ go w aplikacji Waterline, aby otrzymać plan wychodzenia z postu, albo zrób kontrolę."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Seu jejum continua em andamento. Encerre-o no Waterline para receber seu plano de realimentação ou faça um registro."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Голодание всё ещё продолжается. Завершите его в Waterline, чтобы получить план выхода из голодания, или пройдите проверку."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Din fasta pågår fortfarande. Avsluta den i Waterline för att få din uppbyggnadsplan, eller checka in."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Mfungo wako bado unaendelea. Umalize katika Waterline ili upate mpango wako wa kurejea kula, au fanya ukaguzi."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การอดอาหารของคุณยังดำเนินอยู่ สิ้นสุดการอดอาหารใน Waterline เพื่อรับแผนการกลับมากินอาหาร หรือเช็กอิน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Orucunuz hâlâ devam ediyor. Yeniden beslenme planınızı almak için orucu Waterline uygulamasında bitirin ya da kontrol yapın."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đợt nhịn ăn của bạn vẫn đang tiếp diễn. Hãy kết thúc trong Waterline để nhận kế hoạch ăn lại, hoặc ghi nhận tình trạng."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你的断食仍在进行。请在 Waterline 中结束断食以获取复食计划，或进行一次自查。"
          }
        }
      }
    },
    "notify.past_target.title": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مرت 12 ساعة بعد بلوغ هدفك"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "12 Stunden über Ihrem Ziel"
          }
        },
        "en": {
