    "complication.sodium.response": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مراقبة كمية السوائل؛ وأحيانًا ملح عن طريق الفم"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Flüssigkeitszufuhr beobachten; manchmal Salz zum Einnehmen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Watch fluid intake; sometimes oral salt"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Vigilar la ingesta de líquidos; a veces sal por vía oral"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Surveiller les apports en liquides ; parfois du sel par voie orale"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पानी की मात्रा पर नज़र; कभी-कभी मुँह से नमक"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pantau asupan cairan; terkadang garam oral"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Controllare l'apporto di liquidi; talvolta sale per bocca"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "水分摂取量に注意、場合により塩を経口摂取"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "수분 섭취 관찰, 때로 경구 염분 보충"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Pantau pengambilan cecair; kadangkala garam secara oral"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vochtinname bewaken; soms zout via de mond"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kontrola ilości płynów; czasem sól doustnie"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Controlar a ingestão de líquidos; às vezes sal por via oral"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Следить за потреблением жидкости; иногда соль внутрь"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Håll koll på vätskeintaget; ibland salt via munnen"
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Fuatilia kiasi cha maji unachokunywa; wakati mwingine chumvi kwa mdomo"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เฝ้าดูปริมาณน้ำที่ดื่ม บางครั้งให้เกลือทางปาก"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sıvı alımı izlenir; bazen ağızdan tuz verilir"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Theo dõi lượng dịch nạp vào; đôi khi bổ sung muối đường uống"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "关注液体摄入量；有时口服补盐"
          }
        }
      }
    },
    "complication.sodium.signs": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تقلصات، خمول، صداع، دوار عند الوقوف"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Krämpfe, Trägheit, Kopfschmerzen, Schwindel beim Aufstehen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cramps, sluggishness, headache, dizziness on standing"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Calambres, decaimiento, dolor de cabeza, mareo al ponerse de pie"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Crampes, torpeur, maux de tête, vertiges en position debout"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "ऐंठन, सुस्ती, सिरदर्द, खड़े होने पर चक्कर"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kram, lesu, sakit kepala, pusing saat berdiri"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Crampi, fiacchezza, mal di testa, capogiri quando ti alzi"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "筋肉のけいれん、だるさ、頭痛、立ったときのめまい"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "근육 경련, 무기력감, 두통, 일어설 때 어지러움"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Kekejangan otot, lesu, sakit kepala, pening apabila berdiri"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Krampen, lusteloosheid, hoofdpijn, duizeligheid bij opstaan"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Skurcze, ospałość, ból głowy, zawroty głowy przy wstawaniu"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Cãibras, lentidão, dor de cabeça, tontura ao ficar de pé"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Судороги, вялость, головная боль, головокружение при вставании"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Kramper, slöhet, huvudvärk, yrsel när du reser dig"
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Mkakamao wa misuli, ulegevu, maumivu ya kichwa, kizunguzungu unaposimama"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ตะคริว ซึม ปวดศีรษะ เวียนศีรษะเมื่อลุกยืน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kramplar, uyuşukluk, baş ağrısı, ayağa kalkınca baş dönmesi"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chuột rút, uể oải, đau đầu, chóng mặt khi đứng"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "抽筋、倦怠、头痛、站起时头晕"
          }
        }
      }
    },
