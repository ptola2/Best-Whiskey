    "welcome.disclaimer.body": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "Waterline أداة تثقيفية. والأبحاث التي يستند إليها تقصر الصيام الذي يتجاوز 72 ساعة على البيئات الخاضعة لإشراف طبي."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Waterline ist ein Informationsangebot. Die Forschung, auf der es beruht, beschränkt Fastenperioden über 72 Stunden auf Umgebungen mit medizinischer Aufsicht."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Waterline is an educational tool. The research it draws on restricts fasts longer than 72 hours to medically supervised settings."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Waterline es una herramienta educativa. La investigación en la que se basa limita los ayunos de más de 72 horas a entornos con supervisión médica."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Waterline est un outil éducatif. La recherche sur laquelle il s’appuie réserve les jeûnes de plus de 72 heures à un cadre sous surveillance médicale."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Waterline एक शैक्षिक साधन है। जिस शोध पर यह आधारित है, वह 72 घंटे से लंबे उपवास को केवल चिकित्सकीय निगरानी वाली जगहों तक सीमित रखता है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Waterline adalah alat edukasi. Penelitian yang menjadi dasarnya membatasi puasa lebih dari 72 jam hanya di lingkungan dengan pengawasan medis."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Waterline è uno strumento educativo. La ricerca su cui si basa limita i digiuni oltre le 72 ore a contesti con supervisione medica."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Waterlineは教育用ツールです。参照している研究では、72時間を超える断食は医療管理下の環境に限定されています。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Waterline은 교육용 도구예요. 이 앱이 참고하는 연구에서는 72시간을 넘는 단식을 의료진의 감독이 있는 환경으로 제한해요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Waterline ialah alat pendidikan. Penyelidikan yang dirujuknya mengehadkan puasa melebihi 72 jam kepada persekitaran di bawah pengawasan perubatan."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Waterline is een educatief hulpmiddel. Het onderzoek waarop het steunt, beperkt vasten van langer dan 72 uur tot situaties met medisch toezicht."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Waterline to narzędzie edukacyjne. Badania, na których się opiera, dopuszczają posty dłuższe niż 72 godziny wyłącznie pod nadzorem medycznym."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Waterline é uma ferramenta educativa. A pesquisa em que ele se baseia restringe jejuns de mais de 72 horas a ambientes com supervisão médica."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Waterline создан как образовательный инструмент. Исследования, на которые он опирается, допускают голодание дольше 72 часов только под медицинским наблюдением."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Waterline är ett utbildningsverktyg. Forskningen som appen bygger på begränsar fastor längre än 72 timmar till miljöer med medicinsk övervakning."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Waterline ni zana ya kielimu. Tafiti inazotegemea zinaruhusu mifungo inayozidi saa 72 ifanyike tu katika mazingira yenye usimamizi wa kitabibu."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "Waterline เป็นเครื่องมือเพื่อการศึกษา งานวิจัยที่แอปนี้อ้างอิงจำกัดการอดอาหารที่นานกว่า 72 ชั่วโมงไว้เฉพาะในสถานที่ที่มีการดูแลทางการแพทย์"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Waterline bir eğitim aracıdır. Dayandığı araştırmalar, 72 saatten uzun oruçları tıbbi gözetim altındaki ortamlarla sınırlar."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Waterline là công cụ giáo dục. Các nghiên cứu mà ứng dụng dựa vào chỉ cho phép nhịn ăn dài hơn 72 giờ trong môi trường có giám sát y tế."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Waterline 是一款教育工具。它所依据的研究将超过 72 小时的断食限定在有医疗监护的环境中进行。"
          }
        }
      }
    },
