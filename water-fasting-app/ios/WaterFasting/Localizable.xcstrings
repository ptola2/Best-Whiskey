    "screen.heart.question": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مرض قلبي أو اضطراب في نظم القلب"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Herzerkrankung oder Herzrhythmusstörung"
          }
        },
        "en": {
          "stringUnit": {
