    "weight.expected": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Expected: 0.9 to 1.5 kg a day over the first 3 days, slowing to 0.25 to 0.40 kg a day by days 7 to 10. Across 5 to 20 day fasts about two-thirds of the loss is lean mass, mostly glycogen and water that return within 3 to 5 days of eating. The fat loss stays."
          }
        }
      }
    },
