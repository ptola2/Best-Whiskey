    "complication.bone.cause": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تُطلق العظام أملاح الكالسيوم لمعادلة الأحماض"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Knochen geben Calciumsalze ab, um Säure abzupuffern"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Bone releases calcium salts to buffer acid"
          }
        },
        "es": {
