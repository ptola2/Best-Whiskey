    "plan.doctor_reviewed": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "راجع طبيبي هذا الصيام والأدوية التي أتناولها."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Meine Ärztin oder mein Arzt hat dieses Fasten und meine Medikamente geprüft."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "My doctor has reviewed this fast and my medicines."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mi médico ha revisado este ayuno y mis medicamentos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mon médecin a examiné ce jeûne et mes médicaments."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "मेरे डॉक्टर ने इस उपवास और मेरी दवाओं की समीक्षा की है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Dokter saya telah meninjau puasa ini dan obat-obatan saya."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il mio medico ha valutato questo digiuno e i miei farmaci."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "医師がこの断食と私の服用薬を確認しました。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "의사가 이 단식과 제가 먹는 약을 검토했어요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Doktor saya telah menyemak puasa ini dan ubat-ubatan saya."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Mijn arts heeft dit vasten en mijn medicijnen beoordeeld."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ten post i moje leki zostały skonsultowane z lekarzem."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Meu médico revisou este jejum e meus medicamentos."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Мой врач оценил это голодание и мои лекарства."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Min läkare har gått igenom den här fastan och mina läkemedel."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Daktari wangu amekagua mfungo huu na dawa zangu."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แพทย์ของฉันได้ตรวจสอบการอดอาหารครั้งนี้และยาที่ฉันใช้แล้ว"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Doktorum bu orucu ve ilaçlarımı inceledi."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bác sĩ của tôi đã xem xét đợt nhịn ăn này và các loại thuốc tôi dùng."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "我的医生已审核过这次断食和我的用药。"
          }
        }
      }
    },
    "plan.error.future": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "وقت البدء في المستقبل. أوقف خيار «بدأتُ في وقت سابق» للبدء الآن."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Startzeitpunkt liegt in der Zukunft. Schalten Sie „Ich habe früher begonnen“ aus, um jetzt zu starten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The start time is in the future. Turn off “I started earlier” to start now."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La hora de inicio es en el futuro. Desactiva «Empecé antes» para empezar ahora."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’heure de début est dans le futur. Désactivez « J’ai commencé plus tôt » pour commencer maintenant."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "शुरू होने का समय भविष्य में है। अभी शुरू करने के लिए “मैंने पहले शुरू किया था” बंद करें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Waktu mulai ada di masa depan. Matikan “Saya sudah mulai lebih awal” untuk mulai sekarang."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'ora di inizio è nel futuro. Disattiva «Ho iniziato prima» per iniziare adesso."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "開始時刻が未来になっています。今すぐ開始するには「すでに始めている」をオフにしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "시작 시간이 미래로 되어 있어요. 지금 시작하려면 “이미 시작했어요”를 끄세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Masa mula berada pada masa hadapan. Matikan “Saya mula lebih awal” untuk bermula sekarang."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De starttijd ligt in de toekomst. Zet „Ik ben eerder begonnen” uit om nu te starten."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Godzina rozpoczęcia jest w przyszłości. Wyłącz „Post zaczął się wcześniej”, aby zacząć teraz."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O horário de início está no futuro. Desative “Comecei antes” para começar agora."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Время начала находится в будущем. Выключите «Начато раньше», чтобы начать сейчас."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Starttiden ligger i framtiden. Stäng av ”Jag började tidigare” för att starta nu."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Muda wa kuanza uko katika siku zijazo. Zima “Nilianza mapema” ili uanze sasa."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เวลาเริ่มต้นอยู่ในอนาคต ปิด “ฉันเริ่มก่อนหน้านี้แล้ว” เพื่อเริ่มตอนนี้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Başlangıç zamanı ileri bir tarihte. Şimdi başlamak için “Daha önce başladım” seçeneğini kapatın."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thời điểm bắt đầu nằm trong tương lai. Hãy tắt “Tôi đã bắt đầu từ trước” để bắt đầu ngay."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "开始时间在未来。关闭“我已在此前开始”即可从现在开始。"
          }
        }
      }
    },
    "plan.error.too_old": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "وقت البدء قبل أكثر من 7 أيام. اختر وقتًا أحدث."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Startzeitpunkt liegt mehr als 7 Tage zurück. Wählen Sie einen späteren Zeitpunkt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The start time is more than 7 days ago. Pick a later time."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La hora de inicio es de hace más de 7 días. Elige una hora posterior."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’heure de début remonte à plus de 7 jours. Choisissez une heure plus récente."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "शुरू होने का समय 7 दिन से ज़्यादा पहले का है। बाद का कोई समय चुनें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Waktu mulai lebih dari 7 hari yang lalu. Pilih waktu yang lebih baru."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'ora di inizio risale a più di 7 giorni fa. Scegli un orario più recente."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "開始時刻が7日以上前です。もっと後の時刻を選んでください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "시작 시간이 7일보다 더 이전이에요. 더 나중 시간을 선택하세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Masa mula adalah lebih daripada 7 hari yang lalu. Pilih masa yang lebih lewat."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De starttijd ligt meer dan 7 dagen terug. Kies een later tijdstip."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Godzina rozpoczęcia przypada ponad 7 dni temu. Wybierz późniejszą godzinę."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O horário de início foi há mais de 7 dias. Escolha um horário mais recente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Время начала больше 7 дней назад. Выберите более позднее время."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Starttiden ligger mer än 7 dagar bakåt i tiden. Välj en senare tid."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Muda wa kuanza ni zaidi ya siku 7 zilizopita. Chagua muda wa baadaye."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เวลาเริ่มต้นนานกว่า 7 วันที่แล้ว โปรดเลือกเวลาที่หลังกว่านี้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Başlangıç zamanı 7 günden daha eski. Daha geç bir zaman seçin."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thời điểm bắt đầu đã cách đây hơn 7 ngày. Hãy chọn thời điểm muộn hơn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "开始时间距今已超过 7 天。请选择更晚的时间。"
          }
        }
      }
    },
