    "notify.d7.body": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يتباطأ فقدان الوزن وتحتفظ الكليتان بالصوديوم. واصل تسجيل حالتك مرتين يوميًا."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Gewichtsverlust verlangsamt sich und die Nieren halten Natrium zurück. Tragen Sie weiterhin zweimal täglich eine Kontrolle ein."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Weight loss is slowing and the kidneys are saving sodium. Keep checking in twice a day."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La pérdida de peso se ralentiza y los riñones están ahorrando sodio. Sigue haciendo tus registros dos veces al día."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La perte de poids ralentit et les reins économisent le sodium. Continuez à faire un bilan deux fois par jour."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "वज़न घटने की रफ़्तार धीमी हो रही है और गुर्दे सोडियम बचा रहे हैं। दिन में दो बार चेक-इन करते रहें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Penurunan berat badan melambat dan ginjal menghemat natrium. Tetap lakukan cek kondisi dua kali sehari."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La perdita di peso rallenta e i reni trattengono il sodio. Continua a fare le rilevazioni due volte al giorno."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "体重減少のペースが落ち、腎臓がナトリウムを保持するようになっています。1日2回のチェックインを続けてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "체중 감소가 느려지고 신장이 나트륨을 아끼고 있어요. 하루 두 번 체크인을 계속하세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Penurunan berat badan semakin perlahan dan buah pinggang menjimatkan natrium. Teruskan pemeriksaan dua kali sehari."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het gewichtsverlies vertraagt en de nieren houden natrium vast. Blijf twee keer per dag inchecken."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Spadek masy ciała zwalnia, a nerki oszczędzają sód. Nadal rób kontrolę dwa razy dziennie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A perda de peso está diminuindo e os rins estão poupando sódio. Continue fazendo registros duas vezes ao dia."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Потеря веса замедляется, а почки начинают удерживать натрий. Продолжайте проходить проверку дважды в день."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Viktnedgången avtar och njurarna sparar natrium. Fortsätt checka in två gånger om dagen."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Kupungua uzito kunapungua kasi na figo zinahifadhi sodiamu. Endelea kufanya ukaguzi mara mbili kwa siku."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "น้ำหนักลดช้าลงและไตกำลังเก็บรักษาโซเดียม เช็กอินต่อไปวันละ 2 ครั้ง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kilo kaybı yavaşlıyor ve böbrekler sodyumu tutuyor. Günde iki kez kontrol yapmaya devam edin."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tốc độ giảm cân đang chậm lại và thận đang giữ lại natri. Hãy tiếp tục ghi nhận hai lần mỗi ngày."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "体重下降正在放缓，肾脏正在保钠。请继续每天自查两次。"
          }
        }
      }
    },
