    "profile.safety.absolute": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هل ينطبق عليك أيٌّ مما يلي؟"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Trifft etwas davon auf Sie zu?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Do any of these apply to you?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Te afecta alguna de estas situaciones?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’un de ces points vous concerne-t-il ?"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "क्या इनमें से कोई बात आप पर लागू होती है?"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Apakah salah satu dari ini berlaku untuk Anda?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ti riguarda qualcuna di queste condizioni?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "次のいずれかに当てはまりますか？"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다음 중 해당하는 항목이 있나요?"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Adakah mana-mana perkara ini berkaitan dengan anda?"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Is een van deze op jou van toepassing?"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Czy któreś z poniższych dotyczy ciebie?"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Algum destes itens se aplica a você?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Относится ли к вам что-то из этого?"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Stämmer något av det här in på dig?"
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Je, lolote kati ya haya linakuhusu?"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ข้อใดต่อไปนี้ตรงกับคุณหรือไม่"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bunlardan herhangi biri sizin için geçerli mi?"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bạn có thuộc trường hợp nào dưới đây không?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "以下情况是否适用于你？"
          }
        }
      }
    },
    "profile.safety.absolute.hint": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أي إجابة بـ«نعم» تستبعد الصيام المائي."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jedes Ja schließt Wasserfasten aus."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Any yes rules out water fasting."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cualquier «sí» descarta el ayuno con agua."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un seul oui exclut le jeûne hydrique."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "किसी का भी जवाब हाँ होने पर पानी वाला उपवास नहीं किया जा सकता।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Satu jawaban ya saja berarti puasa air tidak boleh dilakukan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Anche un solo sì esclude il digiuno a sola acqua."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "1つでも「はい」があれば、水断食はできません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "하나라도 ‘예’에 해당하면 물 단식을 할 수 없어요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Sebarang jawapan ya bermakna puasa air tidak boleh dilakukan."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Elk ja-antwoord sluit watervasten uit."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Każde „tak” wyklucza post wodny."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Qualquer “sim” descarta o jejum de água."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Любой ответ «да» исключает голодание на воде."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ett enda ja utesluter vattenfasta."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Jibu lolote la ndiyo linazuia kufunga kwa maji."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "หากตอบใช่ข้อใดข้อหนึ่ง จะไม่สามารถอดอาหารแบบดื่มน้ำเปล่าได้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Herhangi bir “evet” yanıtı su orucunu dışlar."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chỉ cần một câu trả lời “Có” là không được nhịn ăn chỉ uống nước."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "任何一项回答“是”，都不能进行纯水断食。"
          }
        }
      }
    },
