    "screen.bone.why": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يسحب الصيام الطويل المعادن من العظام لمعادلة الأحماض الكيتونية."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lange Fastenperioden entziehen den Knochen Mineralien, um Ketonsäuren abzupuffern."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Long fasts draw minerals from bone to buffer ketone acids."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los ayunos largos extraen minerales de los huesos para neutralizar los ácidos cetónicos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les jeûnes longs puisent des minéraux dans les os pour neutraliser les acides cétoniques."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "लंबे उपवास में कीटोन एसिड को संतुलित करने के लिए हड्डियों से खनिज निकलते हैं।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Puasa panjang menarik mineral dari tulang untuk menetralkan asam keton."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I digiuni lunghi sottraggono minerali alle ossa per tamponare gli acidi chetonici."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "長い断食では、ケトン体による酸を中和するために骨からミネラルが引き出されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "긴 단식은 케톤산을 완충하기 위해 뼈에서 미네랄을 끌어내요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Puasa yang panjang menarik mineral daripada tulang untuk menimbal asid keton."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Lang vasten onttrekt mineralen aan het bot om ketonzuren te bufferen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Podczas długich postów organizm pobiera minerały z kości, aby zbuforować kwasy ketonowe."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Jejuns longos retiram minerais dos ossos para neutralizar os ácidos cetônicos."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "При длительном голодании минералы вымываются из костей для нейтрализации кетокислот."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Långa fastor drar mineraler från skelettet för att buffra ketonsyror."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Mifungo mirefu huchota madini kutoka kwenye mifupa ili kudhibiti asidi za ketoni."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การอดอาหารเป็นเวลานานจะดึงแร่ธาตุจากกระดูกมาใช้ปรับสมดุลกรดคีโตน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Uzun oruçlar, keton asitlerini tamponlamak için kemiklerden mineral çeker."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nhịn ăn dài ngày lấy khoáng chất từ xương để trung hòa acid ceton."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "长时间断食会从骨骼中提取矿物质来缓冲酮酸。"
          }
        }
      }
    },
    "screen.bpmeds.action": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا ينبغي لأحد غير طبيبك أن يخفض جرعات هذه الأدوية أو يوقفها."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nur Ihre Ärztin oder Ihr Arzt sollte diese reduzieren oder absetzen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only your doctor should reduce or stop these."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo tu médico debe reducirlos o suspenderlos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seul votre médecin doit les réduire ou les arrêter."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इन्हें केवल आपके डॉक्टर ही कम या बंद करें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Hanya dokter Anda yang boleh mengurangi atau menghentikan obat ini."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo il tuo medico dovrebbe ridurli o sospenderli."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "減量や中止は必ず医師が行ってください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 약은 반드시 의사만 줄이거나 중단해야 해요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Hanya doktor anda yang patut mengurangkan atau menghentikan ubat ini."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Alleen je arts mag deze verlagen of stoppen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tylko twój lekarz powinien zmniejszać dawki tych leków lub je odstawiać."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Somente seu médico deve reduzir ou suspender esses medicamentos."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Снижать дозу или отменять эти препараты должен только ваш врач."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Bara din läkare ska minska eller sätta ut dem."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Ni daktari wako pekee anayepaswa kupunguza au kusimamisha dawa hizi."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "มีเพียงแพทย์ของคุณเท่านั้นที่ควรลดหรือหยุดยาเหล่านี้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu ilaçların dozunu yalnızca doktorunuz azaltmalı veya ilaçları yalnızca o kesmelidir."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chỉ bác sĩ mới được giảm liều hoặc ngừng các thuốc này."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只有你的医生才能减少或停用这些药物。"
          }
        }
      }
    },
    "screen.bpmeds.question": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تناول دواء لضغط الدم (مثبط الإنزيم المحوّل للأنجيوتنسين، أو حاصر مستقبلات الأنجيوتنسين، أو حاصر قنوات الكالسيوم، أو حاصر بيتا)"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Einnahme von Blutdruckmedikamenten (ACE-Hemmer, Angiotensin-Rezeptor-Blocker, Calciumkanalblocker, Betablocker)"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Taking blood pressure medicine (ACE inhibitor, ARB, calcium channel blocker, beta-blocker)"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tomar medicamentos para la presión arterial (inhibidor de la ECA, ARA II, bloqueador de los canales de calcio, betabloqueante)"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Prise d’un médicament contre la tension artérielle (IEC, sartan, inhibiteur calcique, bêtabloquant)"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "ब्लड प्रेशर की दवा लेना (ACE इनहिबिटर, ARB, कैल्शियम चैनल ब्लॉकर, बीटा-ब्लॉकर)"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Mengonsumsi obat tekanan darah (penghambat ACE, ARB, penghambat kanal kalsium, penyekat beta)"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Assumi farmaci per la pressione (ACE-inibitore, sartano, calcio-antagonista, beta-bloccante)"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "血圧の薬（ACE阻害薬、ARB、カルシウム拮抗薬、β遮断薬）を服用している"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "혈압약 복용 중(ACE 억제제, ARB, 칼슘 통로 차단제, 베타 차단제)"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Mengambil ubat tekanan darah (perencat ACE, penyekat reseptor angiotensin (ARB), penyekat saluran kalsium, penyekat beta)"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gebruik van bloeddrukmedicatie (ACE-remmer, ARB, calciumantagonist, bètablokker)"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przyjmowanie leków na ciśnienie (inhibitor ACE, sartan, antagonista wapnia, beta-bloker)"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Uso de remédio para pressão (inibidor da ECA, BRA, bloqueador dos canais de cálcio, betabloqueador)"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Приём препаратов от давления (ингибитор АПФ, блокатор рецепторов ангиотензина, блокатор кальциевых каналов, бета-блокатор)"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Tar blodtrycksmedicin (ACE-hämmare, ARB, kalciumantagonist, betablockerare)"
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Unatumia dawa ya shinikizo la damu (ACE inhibitor, ARB, calcium channel blocker, beta-blocker)"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ใช้ยาลดความดันโลหิต (ยายับยั้งเอนไซม์เอซีอี ยาปิดกั้นตัวรับแองจิโอเทนซิน ยาปิดกั้นช่องแคลเซียม ยาปิดกั้นเบต้า)"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kan basıncı ilacı kullanımı (ACE inhibitörü, ARB, kalsiyum kanal blokeri, beta bloker)"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đang dùng thuốc huyết áp (thuốc ức chế men chuyển, thuốc chẹn thụ thể angiotensin, thuốc chẹn kênh canxi, thuốc chẹn beta)"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在服用降压药（ACE 抑制剂、ARB、钙通道阻滞剂、β 受体阻滞剂）"
          }
        }
      }
    },
    "screen.bpmeds.why": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الصيام وحده يخفض ضغط الدم. وتناول الجرعات الكاملة فوق ذلك قد يسبب انخفاضًا شديدًا في الضغط، والإغماء، وضعف تدفق الدم إلى الكليتين."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fasten senkt den Blutdruck schon von selbst. Volle Dosen zusätzlich können zu stark niedrigem Blutdruck, Ohnmacht und schlechter Durchblutung der Nieren führen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Fasting lowers blood pressure by itself. Full doses on top can cause severe low pressure, fainting and poor blood flow to the kidneys."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El ayuno ya baja la presión arterial por sí solo. Si además se toman las dosis completas, pueden causar una presión muy baja, desmayos y un riego sanguíneo insuficiente de los riñones."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le jeûne fait baisser la tension artérielle à lui seul. Des doses complètes en plus peuvent provoquer une tension très basse, des évanouissements et une mauvaise irrigation des reins."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "उपवास अपने आप ब्लड प्रेशर कम करता है। ऊपर से पूरी खुराक लेने पर ब्लड प्रेशर बहुत ज़्यादा गिर सकता है, बेहोशी हो सकती है और गुर्दों तक खून का बहाव कम हो सकता है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Puasa sendiri sudah menurunkan tekanan darah. Dosis penuh di atasnya dapat menyebabkan tekanan darah sangat rendah, pingsan, dan aliran darah ke ginjal yang buruk."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il digiuno abbassa già da solo la pressione. Le dosi piene in aggiunta possono causare pressione molto bassa, svenimenti e scarso afflusso di sangue ai reni."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "断食はそれ自体で血圧を下げます。そこに通常量の薬が加わると、重度の低血圧、失神、腎臓への血流不足を引き起こすおそれがあります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "단식만으로도 혈압이 낮아져요. 여기에 약을 평소 용량대로 먹으면 심한 저혈압, 실신, 신장으로 가는 혈류 감소가 생길 수 있어요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Puasa sendiri menurunkan tekanan darah. Dos penuh di samping puasa boleh menyebabkan tekanan darah sangat rendah, pengsan dan aliran darah yang lemah ke buah pinggang."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vasten verlaagt de bloeddruk al vanzelf. Volledige doses daarbovenop kunnen ernstig lage bloeddruk, flauwvallen en een slechte doorbloeding van de nieren veroorzaken."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Post sam w sobie obniża ciśnienie krwi. Dodatkowe przyjmowanie pełnych dawek może wywołać bardzo niskie ciśnienie, omdlenia i słabe ukrwienie nerek."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O jejum, por si só, baixa a pressão arterial. Doses completas somadas a isso podem causar pressão muito baixa, desmaio e pouco fluxo de sangue para os rins."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Голодание само по себе снижает давление. Полные дозы препаратов в дополнение к этому могут вызвать сильное снижение давления, обмороки и плохое кровоснабжение почек."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Fasta sänker blodtrycket i sig. Fulla doser ovanpå det kan orsaka kraftigt lågt blodtryck, svimning och dåligt blodflöde till njurarna."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Kufunga kwenyewe hushusha shinikizo la damu. Dozi kamili juu yake zinaweza kusababisha shinikizo la chini sana, kuzimia na mtiririko duni wa damu kwenda kwenye figo."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การอดอาหารทำให้ความดันโลหิตลดลงอยู่แล้ว การใช้ยาในขนาดเต็มร่วมด้วยอาจทำให้ความดันต่ำรุนแรง เป็นลม และเลือดไปเลี้ยงไตไม่เพียงพอ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Oruç kan basıncını kendiliğinden düşürür. Üstüne tam doz ilaç almak ciddi düşük tansiyona, bayılmaya ve böbreklere giden kan akışının azalmasına neden olabilir."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bản thân nhịn ăn đã làm giảm huyết áp. Dùng thêm liều đầy đủ có thể gây hạ huyết áp nặng, ngất và giảm lưu lượng máu đến thận."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "断食本身就会降低血压。如果同时服用全剂量降压药，可能导致严重低血压、晕厥和肾脏血流不足。"
          }
        }
      }
    },
    "screen.cachexia.question": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هزال شديد في الوزن أو العضلات (الدنف، أو قلة الكتلة العضلية)"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Starker Gewichts- oder Muskelschwund (Kachexie, Sarkopenie)"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Severe weight or muscle wasting (cachexia, sarcopenia)"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pérdida grave de peso o de masa muscular (caquexia, sarcopenia)"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Amaigrissement ou fonte musculaire sévère (cachexie, sarcopénie)"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "वज़न या मांसपेशियों का गंभीर रूप से घटना (कैकेक्सिया, सार्कोपेनिया)"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Penyusutan berat badan atau otot yang parah (kaheksia, sarkopenia)"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Grave deperimento di peso o muscolare (cachessia, sarcopenia)"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "高度な体重減少または筋肉の衰え（悪液質、サルコペニア）"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "심한 체중 감소 또는 근육 소모(악액질, 근감소증)"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Penyusutan berat badan atau otot yang teruk (kakeksia, sarkopenia)"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ernstig gewichts- of spierverlies (cachexie, sarcopenie)"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ciężkie wyniszczenie lub zanik mięśni (kacheksja, sarkopenia)"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Perda grave de peso ou de massa muscular (caquexia, sarcopenia)"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Тяжёлое истощение или потеря мышечной массы (кахексия, саркопения)"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Svår avmagring eller muskelförtvining (kakexi, sarkopeni)"
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Kukonda sana au kupotea kwa misuli kwa kiwango kikubwa (cachexia, sarcopenia)"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "น้ำหนักหรือกล้ามเนื้อลดลงอย่างรุนแรง (ภาวะผอมหนังหุ้มกระดูก ภาวะมวลกล้ามเนื้อน้อย)"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ciddi kilo veya kas kaybı (kaşeksi, sarkopeni)"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Sụt cân hoặc teo cơ nặng (suy mòn, thiểu cơ)"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "严重的体重减轻或肌肉消耗（恶病质、肌少症）"
          }
        }
      }
    },
    "screen.cachexia.why": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "من دون مخزون من الدهون والبروتين، قد يؤدي الصيام إلى هزال عضلة القلب وحدوث اضطرابات قاتلة في نظم القلب."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ohne Fett- und Eiweißreserven kann Fasten den Herzmuskel abbauen und tödliche Herzrhythmusstörungen verursachen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Without fat and protein reserves, fasting can waste heart muscle and cause fatal heart rhythms."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sin reservas de grasa y proteínas, el ayuno puede consumir el músculo cardíaco y causar alteraciones mortales del ritmo cardíaco."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sans réserves de graisse et de protéines, le jeûne peut faire fondre le muscle cardiaque et provoquer des troubles du rythme cardiaque mortels."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "वसा और प्रोटीन भंडार के बिना, उपवास से दिल की मांसपेशी घट सकती है और दिल की धड़कन में जानलेवा गड़बड़ी हो सकती है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tanpa cadangan lemak dan protein, puasa dapat mengikis otot jantung dan menyebabkan irama jantung yang fatal."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Senza riserve di grasso e proteine, il digiuno può consumare il muscolo cardiaco e causare ritmi cardiaci mortali."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "脂肪とたんぱく質の蓄えがないと、断食によって心筋が衰え、命に関わる不整脈が起こるおそれがあります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "지방과 단백질 비축분이 없으면 단식으로 심장 근육이 소모되고 치명적인 심장 리듬 이상이 생길 수 있어요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tanpa rizab lemak dan protein, puasa boleh menyusutkan otot jantung dan menyebabkan irama jantung yang boleh membawa maut."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zonder vet- en eiwitreserves kan vasten de hartspier afbreken en dodelijke hartritmestoornissen veroorzaken."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bez rezerw tłuszczu i białka post może prowadzić do zaniku mięśnia sercowego i śmiertelnych zaburzeń rytmu serca."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sem reservas de gordura e proteína, o jejum pode consumir o músculo cardíaco e causar ritmos cardíacos fatais."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Без запасов жира и белка голодание может разрушать сердечную мышцу и вызывать смертельно опасные нарушения сердечного ритма."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Utan fett- och proteinreserver kan fasta bryta ned hjärtmuskeln och orsaka dödliga hjärtrytmrubbningar."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Bila akiba ya mafuta na protini, kufunga kunaweza kuyeyusha misuli ya moyo na kusababisha midundo ya moyo inayoweza kuua."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "หากไม่มีไขมันและโปรตีนสำรอง การอดอาหารอาจทำให้กล้ามเนื้อหัวใจฝ่อลีบและทำให้หัวใจเต้นผิดจังหวะจนถึงแก่ชีวิต"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yağ ve protein rezervleri olmadan oruç, kalp kasının yıkımına ve ölümcül kalp ritmi bozukluklarına yol açabilir."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Khi không có dự trữ mỡ và protein, nhịn ăn có thể làm hao mòn cơ tim và gây rối loạn nhịp tim gây tử vong."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "没有脂肪和蛋白质储备，断食可能导致心肌消耗，并引发致命的心律失常。"
          }
        }
      }
    },
    "screen.ckd.question": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مرض كلوي متقدم (مرض الكلى المزمن من المرحلة 3b إلى 5، أو غسيل الكلى)"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fortgeschrittene chronische Nierenerkrankung (Stadium 3b bis 5 oder Dialyse)"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Advanced kidney disease (CKD stage 3b to 5, or dialysis)"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Enfermedad renal avanzada (ERC en estadio 3b a 5, o diálisis)"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Maladie rénale avancée (MRC stade 3b à 5, ou dialyse)"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "गुर्दे की बढ़ी हुई (एडवांस) बीमारी (CKD स्टेज 3b से 5, या डायलिसिस)"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Penyakit ginjal lanjut (PGK stadium 3b sampai 5, atau cuci darah)"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Malattia renale avanzata (MRC stadio da 3b a 5, o dialisi)"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "進行した腎臓病（CKDステージ3b〜5、または透析中）"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "진행된 신장 질환(CKD 3b~5기 또는 투석)"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Penyakit buah pinggang kronik tahap lanjut (peringkat 3b hingga 5, atau dialisis)"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gevorderde nierziekte (chronische nierschade stadium 3b tot 5, of dialyse)"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zaawansowana choroba nerek (przewlekła choroba nerek w stadium od 3b do 5 lub dializy)"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Doença renal avançada (DRC estágio 3b a 5, ou diálise)"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Тяжёлое заболевание почек (ХБП стадии от 3б до 5 или диализ)"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Avancerad njursjukdom (CKD stadium 3b till 5, eller dialys)"
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Ugonjwa wa figo uliokithiri (CKD hatua ya 3b hadi 5, au dialisisi)"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "โรคไตระยะลุกลาม (โรคไตเรื้อรังระยะ 3b ถึง 5 หรือฟอกไต)"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İleri evre böbrek hastalığı (kronik böbrek hastalığı evre 3b ila 5 veya diyaliz)"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bệnh thận nặng (bệnh thận mạn giai đoạn 3b đến 5, hoặc đang lọc máu)"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "晚期肾病（慢性肾脏病 3b 至 5 期，或正在透析）"
          }
        }
      }
    },
    "screen.ckd.why": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا تستطيع الكليتان التخلص من عبء الأحماض، مما يعرّض لخطر الحماض الشديد وارتفاع البوتاسيوم."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Nieren können die Säurelast nicht ausscheiden, was das Risiko einer schweren Azidose und eines hohen Kaliumspiegels birgt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The kidneys cannot clear the acid load, which risks severe acidosis and high potassium."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los riñones no pueden eliminar la carga de ácido, lo que conlleva riesgo de acidosis grave y potasio alto."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les reins ne peuvent pas éliminer la charge acide, avec un risque d’acidose sévère et de potassium élevé."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "गुर्दे एसिड का भार बाहर नहीं निकाल पाते, जिससे गंभीर एसिडोसिस और हाई पोटैशियम का खतरा होता है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ginjal tidak dapat membuang beban asam, sehingga berisiko menimbulkan asidosis berat dan kalium tinggi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I reni non riescono a smaltire il carico acido, con il rischio di acidosi grave e potassio alto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "腎臓が酸を処理しきれず、重度のアシドーシスや高カリウム血症の危険があります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "신장이 산 부하를 처리하지 못해 심한 산증과 높은 칼륨 수치의 위험이 있어요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Buah pinggang tidak dapat menyingkirkan beban asid, yang berisiko menyebabkan asidosis teruk dan kalium tinggi."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De nieren kunnen de zuurbelasting niet afvoeren, met risico op ernstige acidose en een hoog kalium."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nerki nie są w stanie usunąć ładunku kwasów, co grozi ciężką kwasicą i wysokim poziomem potasu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os rins não conseguem eliminar a carga de ácido, com risco de acidose grave e potássio alto."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Почки не справляются с выведением кислотной нагрузки, что создаёт риск тяжёлого ацидоза и высокого уровня калия."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Njurarna kan inte göra sig av med syrabelastningen, vilket innebär risk för svår acidos och högt kalium."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Figo haziwezi kuondoa mzigo wa asidi, jambo linalohatarisha asidi kali mwilini (acidosis) na potasiamu ya juu."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไตไม่สามารถขับกรดที่เพิ่มขึ้นได้ ซึ่งเสี่ยงต่อภาวะเลือดเป็นกรดรุนแรงและโพแทสเซียมสูง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Böbrekler asit yükünü atamaz; bu da ciddi asidoz ve yüksek potasyum riski doğurur."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thận không thể đào thải lượng acid, dẫn đến nguy cơ nhiễm toan nặng và kali máu cao."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "肾脏无法清除酸负荷，有发生严重酸中毒和高钾血症的风险。"
          }
        }
      }
    },
    "screen.diuretic.action": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يجب أن يوقفه طبيبك قبل الصيام، ويحتاج الصيام إلى مراقبة داخل المستشفى."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ihre Ärztin oder Ihr Arzt muss es vor dem Fasten absetzen, und das Fasten erfordert eine stationäre Überwachung."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your doctor has to stop it before the fast, and the fast needs inpatient monitoring."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu médico tiene que suspenderlo antes del ayuno, y el ayuno requiere seguimiento con hospitalización."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre médecin doit l’arrêter avant le jeûne, et le jeûne nécessite une surveillance en hospitalisation."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "उपवास से पहले आपके डॉक्टर को इसे बंद करना होगा, और उपवास के दौरान अस्पताल में भर्ती रखकर निगरानी ज़रूरी है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Dokter Anda harus menghentikannya sebelum puasa, dan puasa memerlukan pemantauan rawat inap."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il medico deve sospenderlo prima del digiuno, e il digiuno richiede monitoraggio in regime di ricovero."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "断食前に医師が中止する必要があり、断食中は入院での監視が必要です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "단식 전에 의사가 이 약을 중단해야 하며, 단식 중에는 입원 모니터링이 필요해요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Doktor anda perlu menghentikannya sebelum puasa, dan puasa memerlukan pemantauan sebagai pesakit dalam."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je arts moet het middel vóór het vasten stoppen, en het vasten vereist bewaking tijdens een ziekenhuisopname."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Lekarz musi odstawić ten lek przed postem, a post wymaga monitorowania w warunkach szpitalnych."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Seu médico precisa suspendê-lo antes do jejum, e o jejum precisa de monitoramento com internação."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Врач должен отменить его до начала голодания, а само голодание требует наблюдения в стационаре."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Din läkare måste sätta ut det före fastan, och fastan kräver övervakning inom slutenvården."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Daktari wako lazima aisimamishe kabla ya mfungo, na mfungo unahitaji ufuatiliaji ukiwa umelazwa hospitalini."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แพทย์ต้องหยุดยานี้ก่อนการอดอาหาร และการอดอาหารต้องได้รับการติดตามแบบผู้ป่วยใน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Doktorunuzun bu ilacı oruçtan önce kesmesi gerekir ve oruç, hastanede yatarak izlem gerektirir."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bác sĩ phải ngừng thuốc trước đợt nhịn ăn, và đợt nhịn ăn cần được theo dõi nội trú."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你的医生必须在断食前停用该药，且断食需要住院监测。"
          }
        }
      }
    },
    "screen.diuretic.question": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تناول دواء مدر للبول («حبوب الماء»)"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Einnahme eines Diuretikums („Entwässerungstablette“)"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Taking a diuretic (“water pill”)"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tomar un diurético («pastilla para eliminar líquidos»)"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Prise d’un diurétique (« médicament qui fait uriner »)"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "डाइयूरेटिक (“पानी की गोली”) लेना"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Mengonsumsi diuretik (“obat peluruh kencing”)"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Assumi un diuretico (farmaco che fa eliminare liquidi)"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "利尿薬（いわゆる「尿を出す薬」）を服用している"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이뇨제(소변을 많이 보게 하는 약) 복용 중"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Mengambil diuretik (“pil air”)"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gebruik van een diureticum („plaspil”)"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przyjmowanie leku moczopędnego („tabletka odwadniająca”)"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Uso de diurético (“remédio para eliminar líquidos”)"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Приём диуретика («мочегонного»)"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Tar ett diuretikum (”vätskedrivande tablett”)"
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Unatumia dawa ya kuongeza mkojo (diuretic au “dawa ya maji”)"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ใช้ยาขับปัสสาวะ (“ยาขับน้ำ”)"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Diüretik (“idrar söktürücü”) kullanımı"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đang dùng thuốc lợi tiểu (“thuốc thải nước”)"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在服用利尿剂（“排水药”）"
          }
        }
      }
    },
    "screen.diuretic.why": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تزيد مدرات البول من فقدان الصوديوم الناتج عن الصيام، وقد تسبب هبوطًا حادًا في سوائل الجسم، والإغماء، وانخفاض البوتاسيوم، واضطرابات نظم القلب."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diuretika verstärken den Natriumverlust beim Fasten und können zu Kreislaufkollaps durch Flüssigkeitsverlust, Ohnmacht, niedrigem Kalium und Herzrhythmusstörungen führen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Diuretics add to the sodium loss of fasting and can cause fluid collapse, fainting, low potassium and heart rhythm problems."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los diuréticos se suman a la pérdida de sodio del ayuno y pueden causar un colapso por pérdida de líquidos, desmayos, potasio bajo y problemas del ritmo cardíaco."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les diurétiques s’ajoutent à la perte de sodium due au jeûne et peuvent provoquer une chute brutale du volume de liquides, des évanouissements, un potassium bas et des troubles du rythme cardiaque."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "डाइयूरेटिक उपवास से होने वाली सोडियम की कमी को और बढ़ाते हैं, और इनसे शरीर में तरल की भारी कमी (फ़्लूइड कोलैप्स), बेहोशी, कम पोटैशियम और दिल की धड़कन की समस्याएँ हो सकती हैं।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Diuretik menambah kehilangan natrium akibat puasa dan dapat menyebabkan kolaps akibat kekurangan cairan, pingsan, kalium rendah, dan gangguan irama jantung."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I diuretici si sommano alla perdita di sodio del digiuno e possono causare collasso da perdita di liquidi, svenimenti, potassio basso e problemi del ritmo cardiaco."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "利尿薬は断食によるナトリウムの喪失をさらに強め、体液量の急激な低下による虚脱、失神、低カリウム、不整脈を引き起こすおそれがあります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이뇨제는 단식으로 인한 나트륨 손실을 더 키워 체액 고갈로 인한 허탈, 실신, 저칼륨, 심장 리듬 이상을 일으킬 수 있어요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Diuretik menambah kehilangan natrium akibat puasa dan boleh menyebabkan kolaps akibat kehilangan cecair, pengsan, kalium rendah dan masalah irama jantung."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Diuretica versterken het natriumverlies door het vasten en kunnen leiden tot collaps door vochtverlies, flauwvallen, laag kalium en hartritmeproblemen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Leki moczopędne nasilają utratę sodu podczas postu i mogą prowadzić do zapaści z powodu utraty płynów, omdleń, niskiego poziomu potasu i zaburzeń rytmu serca."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os diuréticos se somam à perda de sódio do jejum e podem causar colapso por perda de líquidos, desmaio, potássio baixo e problemas de ritmo cardíaco."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Диуретики усиливают потерю натрия при голодании и могут вызвать коллапс из-за потери жидкости, обмороки, низкий уровень калия и нарушения сердечного ритма."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Diuretika förstärker natriumförlusten vid fasta och kan orsaka vätskekollaps, svimning, lågt kalium och hjärtrytmrubbningar."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Dawa za kuongeza mkojo huongeza upotevu wa sodiamu unaotokana na kufunga na zinaweza kusababisha kuporomoka kwa kiasi cha maji mwilini, kuzimia, potasiamu ya chini na matatizo ya mdundo wa moyo."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ยาขับปัสสาวะเพิ่มการสูญเสียโซเดียมจากการอดอาหาร และอาจทำให้ขาดสารน้ำอย่างรุนแรงจนระบบไหลเวียนล้มเหลว เป็นลม โพแทสเซียมต่ำ และหัวใจเต้นผิดจังหวะ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Diüretikler orucun neden olduğu sodyum kaybını artırır ve sıvı kaybına bağlı dolaşım çöküşüne, bayılmaya, düşük potasyuma ve kalp ritmi sorunlarına yol açabilir."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thuốc lợi tiểu làm tăng thêm lượng natri mất đi khi nhịn ăn và có thể gây trụy tuần hoàn do mất dịch, ngất, kali thấp và rối loạn nhịp tim."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "利尿剂会加重断食造成的钠流失，可能导致体液骤减而虚脱、晕厥、低血钾和心律问题。"
          }
        }
      }
    },
    "screen.ed.question": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اضطراب أكل حالي أو سابق (فقدان الشهية العصبي، أو الشره المرضي العصبي، أو ARFID)"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine aktuelle oder frühere Essstörung (Anorexie, Bulimie, ARFID)"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A current or past eating disorder (anorexia, bulimia, ARFID)"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un trastorno de la conducta alimentaria actual o pasado (anorexia, bulimia, ARFID)"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un trouble du comportement alimentaire actuel ou passé (anorexie, boulimie, ARFID)"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अभी या पहले कभी ईटिंग डिसऑर्डर (एनोरेक्सिया, बुलिमिया, ARFID)"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Gangguan makan saat ini atau di masa lalu (anoreksia, bulimia, ARFID)"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un disturbo alimentare attuale o passato (anoressia, bulimia, ARFID)"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "現在または過去の摂食障害（拒食症、過食症、ARFID）"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "현재 또는 과거의 섭식장애(신경성 식욕부진증, 신경성 폭식증, ARFID)"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Gangguan makan semasa atau lampau (anoreksia, bulimia, ARFID)"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een huidige of eerdere eetstoornis (anorexia, boulimia, ARFID)"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Obecne lub przebyte zaburzenie odżywiania (anoreksja, bulimia, ARFID)"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Transtorno alimentar atual ou passado (anorexia, bulimia, ARFID)"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Расстройство пищевого поведения сейчас или в прошлом (анорексия, булимия, ARFID)"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "En pågående eller tidigare ätstörning (anorexi, bulimi, ARFID)"
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Ugonjwa wa ulaji wa sasa au wa zamani (anoreksia, bulimia, ARFID)"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เป็นหรือเคยเป็นโรคการกินผิดปกติ (โรคอะนอเร็กเซีย โรคบูลิเมีย หรือ ARFID)"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Şu anda veya geçmişte yeme bozukluğu (anoreksiya, bulimiya, ARFID)"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đang hoặc từng mắc rối loạn ăn uống (chán ăn tâm thần, chứng cuồng ăn, ARFID)"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "目前或过去有进食障碍（神经性厌食症、神经性贪食症、ARFID）"
          }
        }
      }
    },
    "screen.ed.why": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "قد يؤدي الامتناع عن الطعام إلى انتكاسة خطيرة، وينطوي على خطر كبير لحدوث مشكلات قاتلة عند إعادة التغذية. إذا كان الأكل صعبًا عليك الآن، فيمكن لخدمة دعم مختصة باضطرابات الأكل أن تساعدك."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Verzicht auf Nahrung kann einen schweren Rückfall auslösen und birgt ein hohes Risiko tödlicher Probleme beim Kostaufbau. Wenn Ihnen das Essen gerade schwerfällt, kann eine Beratungsstelle für Essstörungen helfen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stopping food can set off a serious relapse and carries a high risk of fatal refeeding problems. If eating feels hard right now, an eating disorder support service can help."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Dejar de comer puede desencadenar una recaída grave y conlleva un alto riesgo de problemas mortales en la realimentación. Si ahora mismo te cuesta comer, un servicio de apoyo para trastornos de la conducta alimentaria puede ayudarte."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Arrêter de manger peut déclencher une rechute grave et comporte un risque élevé de complications mortelles à la réalimentation. Si manger vous semble difficile en ce moment, un service d’aide spécialisé dans les troubles alimentaires peut vous aider."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "खाना बंद करने से बीमारी गंभीर रूप से दोबारा उभर सकती है, और दोबारा खाना शुरू करते समय जानलेवा समस्याओं का जोखिम बहुत ज़्यादा होता है। अगर अभी खाना मुश्किल लग रहा है, तो ईटिंग डिसऑर्डर सहायता सेवा मदद कर सकती है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Berhenti makan dapat memicu kekambuhan yang serius dan membawa risiko tinggi masalah makan kembali yang fatal. Jika makan terasa sulit saat ini, layanan dukungan gangguan makan dapat membantu."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Smettere di mangiare può scatenare una ricaduta grave e comporta un alto rischio di problemi di rialimentazione mortali. Se in questo momento mangiare ti risulta difficile, un servizio di supporto per i disturbi alimentari può aiutarti."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "食事をやめることで深刻な再発を招くおそれがあり、回復食の際に命に関わる問題が起こる危険も高くなります。今、食べることがつらいと感じている場合は、摂食障害の支援窓口が力になってくれます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "음식을 끊으면 심각한 재발이 일어날 수 있고, 치명적인 재급식 문제의 위험이 높아요. 지금 먹는 것이 힘들게 느껴진다면 섭식장애 지원 서비스의 도움을 받을 수 있어요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Berhenti makan boleh mencetuskan keadaan berulang semula yang serius dan membawa risiko tinggi masalah pemakanan semula yang boleh membawa maut. Jika makan terasa sukar sekarang, perkhidmatan sokongan gangguan makan boleh membantu."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Stoppen met eten kan een ernstige terugval uitlokken en geeft een hoog risico op dodelijke problemen als je weer gaat eten. Als eten nu moeilijk voelt, kan een hulpdienst voor eetstoornissen je helpen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Rezygnacja z jedzenia może wywołać poważny nawrót i wiąże się z wysokim ryzykiem śmiertelnych powikłań przy ponownym odżywianiu. Jeśli jedzenie sprawia ci teraz trudność, wsparcia może udzielić organizacja pomagająca osobom z zaburzeniami odżywiania."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Parar de comer pode desencadear uma recaída grave e traz alto risco de problemas fatais na realimentação. Se comer parece difícil agora, um serviço de apoio para transtornos alimentares pode ajudar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отказ от еды может вызвать серьёзный рецидив и несёт высокий риск смертельно опасных осложнений при возобновлении питания. Если вам сейчас трудно с едой, может помочь служба поддержки при расстройствах пищевого поведения."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Att sluta äta kan utlösa ett allvarligt återfall och innebär hög risk för dödliga komplikationer när du börjar äta igen. Om det känns svårt att äta just nu kan en stödverksamhet för ätstörningar hjälpa dig."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Kuacha kula kunaweza kusababisha ugonjwa kurudi kwa kiwango kikubwa na kuna hatari kubwa ya matatizo ya kurejea kula yanayoweza kuua. Ikiwa kula kunakuwa kugumu kwako sasa hivi, huduma ya msaada kwa magonjwa ya ulaji inaweza kukusaidia."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การหยุดกินอาหารอาจกระตุ้นให้อาการกลับมาเป็นซ้ำอย่างรุนแรง และมีความเสี่ยงสูงต่อปัญหาจากการกลับมากินอาหารที่ถึงแก่ชีวิต หากตอนนี้การกินอาหารเป็นเรื่องยากสำหรับคุณ บริการช่วยเหลือด้านโรคการกินผิดปกติสามารถช่วยได้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yemeyi bırakmak ciddi bir nüksü tetikleyebilir ve ölümcül yeniden beslenme sorunları açısından yüksek risk taşır. Şu anda yemek yemek size zor geliyorsa bir yeme bozukluğu destek hizmeti yardımcı olabilir."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ngừng ăn có thể gây tái phát nghiêm trọng và có nguy cơ cao gặp các vấn đề gây tử vong khi ăn lại. Nếu lúc này việc ăn uống với bạn đang khó khăn, một dịch vụ hỗ trợ rối loạn ăn uống có thể giúp bạn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "停止进食可能引发严重复发，并有很高的发生致命再喂养问题的风险。如果你现在觉得进食很困难，进食障碍支持服务可以提供帮助。"
          }
        }
      }
    },
    "screen.gout.action": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اشرب كمية كافية من الماء، واطلب فحص حمض اليوريك أثناء الصيام."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Trinken Sie ausreichend Wasser und lassen Sie die Harnsäure während des Fastens kontrollieren."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Drink enough water and have uric acid checked during the fast."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Bebe suficiente agua y pide que te controlen el ácido úrico durante el ayuno."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Buvez suffisamment d’eau et faites contrôler votre acide urique pendant le jeûne."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पर्याप्त पानी पिएँ और उपवास के दौरान यूरिक एसिड की जाँच करवाएँ।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Minum cukup air dan periksakan asam urat selama puasa."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Bevi acqua a sufficienza e fai controllare l'acido urico durante il digiuno."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "十分な水を飲み、断食中に尿酸値を検査してもらってください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "물을 충분히 마시고, 단식 중 요산 검사를 받으세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Minum air secukupnya dan periksa paras asid urik semasa berpuasa."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Drink genoeg water en laat je urinezuur tijdens het vasten controleren."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pij wystarczająco dużo wody i badaj poziom kwasu moczowego podczas postu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Beba água suficiente e faça a dosagem de ácido úrico durante o jejum."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Пейте достаточно воды и проверяйте уровень мочевой кислоты во время голодания."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Drick tillräckligt med vatten och låt kontrollera urinsyran under fastan."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Kunywa maji ya kutosha na upimwe asidi ya uriki wakati wa mfungo."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ดื่มน้ำให้เพียงพอและตรวจกรดยูริกระหว่างการอดอาหาร"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yeterince su için ve oruç sırasında ürik asit düzeyinizi kontrol ettirin."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Uống đủ nước và kiểm tra acid uric trong đợt nhịn ăn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "充足饮水，并在断食期间检查尿酸。"
          }
        }
      }
    },
    "screen.gout.question": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "النقرس أو ارتفاع حمض اليوريك"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gicht oder erhöhte Harnsäure"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Gout or high uric acid"
          }
        },
        "es": {
