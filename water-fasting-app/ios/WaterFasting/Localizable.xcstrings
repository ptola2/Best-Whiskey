    "phase.6.text": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ينخفض هرمون T3 الحر ويتراجع معدل الأيض لتوفير الطاقة. وتحت الإشراف الطبي، تعرّض نحو 28% من الصائمين لأثر جانبي شديد (الدرجة 3) بحلول اليوم 10، و32% بحلول اليوم 15."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Freies T3 sinkt und der Energieumsatz fällt, um Energie zu sparen. Unter medizinischer Aufsicht hatten etwa 28 % der Fastenden bis Tag 10 eine schwere Nebenwirkung (Grad 3) und 32 % bis Tag 15."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Free T3 falls and metabolic rate drops to save energy. Under medical supervision, about 28% of fasters had a severe (Grade 3) side effect by day 10 and 32% by day 15."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El nivel de T3 libre baja y la tasa metabólica se reduce para ahorrar energía. Con supervisión médica, alrededor del 28 % de las personas en ayuno tuvieron un efecto secundario grave (grado 3) al llegar al día 10, y el 32 % al llegar al día 15."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La T3 libre baisse et le métabolisme ralentit pour économiser l’énergie. Sous surveillance médicale, environ 28 % des personnes qui jeûnaient avaient eu un effet secondaire sévère (grade 3) au jour 10, et 32 % au jour 15."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "फ़्री T3 गिरता है और ऊर्जा बचाने के लिए मेटाबोलिक दर घट जाती है। चिकित्सकीय निगरानी में, उपवास करने वाले लगभग 28% लोगों को दिन 10 तक और 32% को दिन 15 तक गंभीर (ग्रेड 3) दुष्प्रभाव हुआ।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Free T3 turun dan laju metabolisme menurun untuk menghemat energi. Di bawah pengawasan medis, sekitar 28% orang yang berpuasa mengalami efek samping berat (Grade 3) hingga hari ke-10 dan 32% hingga hari ke-15."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il T3 libero cala e il metabolismo rallenta per risparmiare energia. Sotto supervisione medica, circa il 28% di chi digiunava ha avuto un effetto collaterale grave (grado 3) entro il giorno 10 e il 32% entro il giorno 15."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "遊離T3が下がり、エネルギーを節約するために代謝率が低下します。医療管理下では、断食した人の約28%が10日目までに、32%が15日目までに重度（グレード3）の副作用を経験しました。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "유리 T3가 떨어지고 에너지를 아끼기 위해 대사율이 낮아져요. 의료진 감독하에서 단식한 사람의 약 28%가 10일차까지, 32%가 15일차까지 중증(3등급) 부작용을 겪었어요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "T3 bebas menurun dan kadar metabolik turun untuk menjimatkan tenaga. Di bawah pengawasan perubatan, kira-kira 28% orang yang berpuasa mengalami kesan sampingan teruk (gred 3) menjelang hari 10 dan 32% menjelang hari 15."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vrij T3 daalt en het metabolisme vertraagt om energie te sparen. Onder medisch toezicht had ongeveer 28% van de vasters tegen dag 10 een ernstige bijwerking (graad 3), en 32% tegen dag 15."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Stężenie wolnej T3 spada, a tempo metabolizmu się obniża, aby oszczędzać energię. Pod nadzorem medycznym około 28% poszczących miało ciężki skutek uboczny (stopień 3) do 10. dnia, a 32% do 15. dnia."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O T3 livre cai e a taxa metabólica diminui para poupar energia. Com supervisão médica, cerca de 28% das pessoas em jejum tiveram um efeito colateral grave (grau 3) até o dia 10, e 32% até o dia 15."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Уровень свободного Т3 снижается, и скорость обмена веществ падает, чтобы сэкономить энергию. Под медицинским наблюдением тяжёлый (3-й степени) побочный эффект к 10-му дню был примерно у 28% голодающих, а к 15-му дню у 32%."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Fritt T3 sjunker och ämnesomsättningen minskar för att spara energi. Under medicinsk övervakning hade cirka 28 % av de fastande en allvarlig biverkning (grad 3) senast dag 10 och 32 % senast dag 15."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "T3 huru (homoni ya tezi dundumio) hushuka na kasi ya kimetaboliki hupungua ili kuhifadhi nishati. Chini ya usimamizi wa kitabibu, takriban 28% ya waliofunga walipata dhara kali (daraja la 3) kufikia siku ya 10 na 32% kufikia siku ya 15."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "T3 อิสระลดลงและอัตราเมแทบอลิซึมลดลงเพื่อประหยัดพลังงาน ภายใต้การดูแลทางการแพทย์ ผู้อดอาหารประมาณ 28% มีผลข้างเคียงรุนแรง (ระดับ 3) ภายในวันที่ 10 และ 32% ภายในวันที่ 15"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Serbest T3 düşer ve enerji tasarrufu için metabolizma hızı azalır. Tıbbi gözetim altında oruç tutanların yaklaşık %28'inde 10. güne kadar, %32'sinde 15. güne kadar ciddi (derece 3) bir yan etki görüldü."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "T3 tự do giảm và tốc độ chuyển hóa hạ xuống để tiết kiệm năng lượng. Khi có giám sát y tế, khoảng 28% người nhịn ăn gặp tác dụng phụ nặng (độ 3) tính đến ngày 10 và 32% tính đến ngày 15."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "游离T3 下降，代谢率降低以节省能量。在医疗监护下，约 28% 的断食者到第 10 天出现了严重（3级）副作用，到第 15 天为 32%。"
          }
        }
      }
    },
