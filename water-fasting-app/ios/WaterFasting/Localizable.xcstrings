    "log.empty.body": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يُتاح تسجيل الحالة بمجرد بدء الصيام. ويشمل كل تسجيل الوزن، وضغط الدم في وضعيتي الاستلقاء والوقوف، والكيتونات، والأعراض، ثم ينبّهك إلى أي شيء يستدعي الانتباه."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kontrollen sind möglich, sobald Sie ein Fasten beginnen. Jede erfasst Gewicht, Blutdruck im Liegen und im Stehen, Ketone und Symptome und markiert dann alles, was Aufmerksamkeit braucht."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Check-ins open once you start a fast. Each one records weight, blood pressure lying and standing, ketones and symptoms, then flags anything that needs attention."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los registros se activan cuando empiezas un ayuno. Cada uno recoge el peso, la presión arterial en posición acostada y de pie, las cetonas y los síntomas, y después señala lo que requiere atención."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les bilans sont disponibles dès que vous commencez un jeûne. Chacun enregistre le poids, la tension artérielle en position couchée et debout, les cétones et les symptômes, puis signale tout ce qui demande votre attention."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "उपवास शुरू करने पर चेक-इन खुलते हैं। हर चेक-इन में वज़न, लेटे हुए और खड़े होकर ब्लड प्रेशर, कीटोन और लक्षण दर्ज होते हैं, फिर जिस भी बात पर ध्यान देना ज़रूरी हो, उसे चिह्नित किया जाता है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Cek kondisi tersedia setelah Anda memulai puasa. Setiap cek kondisi mencatat berat badan, tekanan darah saat berbaring dan berdiri, keton, dan gejala, lalu menandai apa pun yang perlu diperhatikan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le rilevazioni si attivano quando inizi un digiuno. Ognuna registra peso, pressione da sdraiati e in piedi, chetoni e sintomi, poi segnala tutto ciò che richiede attenzione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "チェックインは断食を始めると利用できます。毎回、体重、横になったときと立ったときの血圧、ケトン体、症状を記録し、注意が必要な点があればお知らせします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "단식을 시작하면 체크인할 수 있어요. 체크인할 때마다 체중, 누운 자세와 선 자세의 혈압, 케톤, 증상을 기록하고 주의가 필요한 항목을 표시해요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Pemeriksaan dibuka sebaik sahaja anda memulakan puasa. Setiap pemeriksaan merekodkan berat badan, tekanan darah semasa berbaring dan berdiri, keton dan simptom, kemudian menandakan apa-apa yang memerlukan perhatian."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Check-ins worden beschikbaar zodra je met vasten begint. Elke check-in legt je gewicht, bloeddruk liggend en staand, ketonen en klachten vast, en markeert alles wat aandacht nodig heeft."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kontrole są dostępne po rozpoczęciu postu. Każda zapisuje masę ciała, ciśnienie krwi na leżąco i na stojąco, ciała ketonowe i objawy, a następnie oznacza wszystko, co wymaga uwagi."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os registros ficam disponíveis quando você começa um jejum. Cada um anota peso, pressão arterial deitado e em pé, cetonas e sintomas, e depois sinaliza o que precisa de atenção."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Проверки становятся доступны, когда вы начинаете голодание. В каждой записываются вес, давление лёжа и стоя, кетоны и симптомы, а затем отмечается всё, что требует внимания."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Incheckningar blir tillgängliga när du startar en fasta. Varje incheckning registrerar vikt, blodtryck liggande och stående, ketoner och symtom, och flaggar sedan allt som behöver uppmärksammas."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Ukaguzi hufunguliwa ukianza mfungo. Kila ukaguzi hurekodi uzito, shinikizo la damu ukiwa umelala na ukiwa umesimama, ketoni na dalili, kisha huonyesha chochote kinachohitaji uangalizi."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เช็กอินได้เมื่อคุณเริ่มอดอาหาร แต่ละครั้งจะบันทึกน้ำหนัก ความดันโลหิตขณะนอนและขณะยืน คีโตน และอาการ แล้วแจ้งเตือนสิ่งที่ต้องใส่ใจ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kontroller, oruca başladığınızda açılır. Her kontrol kiloyu, yatarken ve ayaktayken kan basıncını, ketonları ve belirtileri kaydeder, ardından dikkat gerektiren her şeyi işaretler."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bạn có thể ghi nhận sau khi bắt đầu một đợt nhịn ăn. Mỗi lần ghi nhận lưu lại cân nặng, huyết áp khi nằm và khi đứng, thể ceton và triệu chứng, rồi đánh dấu mọi điều cần chú ý."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "开始断食后即可自查。每次自查会记录体重、平躺和站立时的血压、酮体及症状，然后标出需要注意的情况。"
          }
        }
      }
    },
