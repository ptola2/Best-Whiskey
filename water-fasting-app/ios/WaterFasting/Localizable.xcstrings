    "fast.end_confirm.title": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هل تريد إنهاء هذا الصيام؟"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses Fasten beenden?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "End this fast?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Terminar este ayuno?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Terminer ce jeûne ?"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह उपवास खत्म करें?"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Akhiri puasa ini?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Terminare questo digiuno?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この断食を終了しますか？"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 단식을 종료할까요?"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tamatkan puasa ini?"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dit vasten beëindigen?"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zakończyć ten post?"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Encerrar este jejum?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Завершить это голодание?"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Vill du avsluta fastan?"
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Ungependa kumaliza mfungo huu?"
          }
        },
        "th": {
