    "cloud.copy_removed": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your cloud copy was removed. Data on this iPhone stays. Sign out and back in to start a new backup."
          }
        }
      }
    },
    "cloud.delete.confirm": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Delete your Waterline account?"
          }
        }
      }
    },
    "cloud.delete.confirm_with_apple": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "To delete your account, confirm with Apple. This removes your cloud copy, revokes Waterline's access to your Apple ID and deletes the account. Data on this iPhone stays."
          }
        }
      }
    },
    "cloud.delete.message": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You will confirm with Apple next. Your cloud copy is deleted. Data on this iPhone stays."
          }
        }
      }
    },
    "cloud.delete_account": {
      "extractionState": "manual",
      "localizations": {
        "en": {
