    "hormone.insulin.effect": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يحرر مخازن الدهون؛ وتطرح الكليتان الصوديوم"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Öffnet die Fettreserven; Nieren scheiden Natrium aus"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Unlocks fat stores; kidneys shed sodium"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Libera las reservas de grasa; los riñones eliminan sodio"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Libère les réserves de graisse ; les reins éliminent le sodium"
