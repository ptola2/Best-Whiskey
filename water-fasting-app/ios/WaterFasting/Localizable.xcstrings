    "refeed.plan.length_value": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "%@، أي نصف مدة الصيام على الأقل"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@, mindestens die halbe Fastendauer"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@, at least half the fast"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@, al menos la mitad del ayuno"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@, au moins la moitié du jeûne"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@, उपवास का कम से कम आधा"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "%@, setidaknya separuh lama puasa"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@, almeno metà del digiuno"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@（断食期間の半分以上）"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@, 단식 기간의 절반 이상"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "%@, sekurang-kurangnya separuh tempoh puasa"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@, minstens de helft van het vasten"
          }
        },
        "pl": {
          "stringUnit": {
