          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đã được 12 giờ"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已断食 12 小时"
          }
        }
      }
    },
    "notify.h36.body": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إنتاج الكيتونات في ارتفاع. انهض ببطء: فالدوخة عند الوقوف شائعة في هذه المرحلة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Ketonproduktion steigt. Stehen Sie langsam auf: Benommenheit beim Aufstehen ist jetzt häufig."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ketone production is climbing. Get up slowly: lightheadedness on standing is common now."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La producción de cetonas está subiendo. Levántate despacio: ahora es frecuente el mareo al ponerte de pie."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La production de cétones augmente. Levez-vous lentement : les étourdissements en position debout sont fréquents à ce stade."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कीटोन बनना बढ़ रहा है। धीरे से उठें: इस समय खड़े होने पर हल्का चक्कर आना आम है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Produksi keton meningkat. Bangunlah perlahan: kepala terasa melayang saat berdiri umum terjadi sekarang."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La produzione di chetoni è in aumento. Alzati lentamente: ora è comune sentire la testa leggera quando ti alzi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ケトン体の産生が増えています。ゆっくり立ち上がってください。この時期は立ちくらみがよく起こります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "케톤 생성이 늘고 있어요. 천천히 일어나세요. 지금은 일어설 때 어지러운 증상이 흔해요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Penghasilan keton semakin meningkat. Bangun perlahan-lahan: rasa pening apabila berdiri adalah biasa pada masa ini."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De aanmaak van ketonen neemt toe. Sta langzaam op: licht in het hoofd zijn bij het opstaan komt nu vaak voor."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Produkcja ciał ketonowych rośnie. Wstawaj powoli: zawroty głowy przy wstawaniu są teraz częste."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A produção de cetonas está aumentando. Levante-se devagar: tontura ao ficar de pé é comum agora."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выработка кетонов растёт. Вставайте медленно: сейчас головокружение при вставании встречается часто."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ketonproduktionen ökar. Res dig långsamt: yrsel när du står upp är vanligt nu."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Uzalishaji wa ketoni unaongezeka. Inuka polepole: kizunguzungu unaposimama ni kawaida sasa."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การผลิตคีโตนกำลังเพิ่มขึ้น ค่อยๆ ลุกขึ้น เพราะอาการหน้ามืดเมื่อลุกยืนพบได้บ่อยในช่วงนี้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Keton üretimi artıyor. Yavaşça kalkın: ayağa kalkınca sersemlik bu dönemde sık görülür."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lượng thể ceton được tạo ra đang tăng. Hãy đứng dậy từ từ: lúc này choáng váng khi đứng là thường gặp."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "酮体生成正在增加。请慢慢起身：此时站起时头晕很常见。"
          }
        }
      }
    },
    "notify.h36.title": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "36 ساعة: التحول الأيضي"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "36 Stunden: die Stoffwechselumstellung"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "36 hours: the metabolic switch"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "36 horas: el cambio metabólico"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "36 heures : la bascule métabolique"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "36 घंटे: मेटाबोलिक स्विच"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "36 jam: peralihan metabolik"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "36 ore: la svolta metabolica"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "36時間：代謝の切り替え"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "36시간: 대사 전환"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "36 jam: suis metabolik"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "36 uur: de metabole omschakeling"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "36 godzin: przełączenie metaboliczne"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "36 horas: a virada metabólica"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "36 часов: метаболическое переключение"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "36 timmar: den metabola omställningen"
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Saa 36: mabadiliko ya kimetaboliki"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "36 ชั่วโมง: จุดเปลี่ยนเมแทบอลิซึม"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "36 saat: metabolik geçiş"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "36 giờ: bước chuyển đổi chuyển hóa"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "36 小时：代谢转换"
          }
        }
      }
    },
    "notify.h72.body": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تظهر في هذا الوقت تقريبًا تغيرات في البروتينات على مستوى الجسم كله. ويجب أن يكون الصيام بعد هذه النقطة تحت إشراف طبي."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Etwa jetzt treten im ganzen Körper Veränderungen der Proteine auf. Fasten über diesen Punkt hinaus gehört unter medizinische Aufsicht."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Body-wide protein changes appear around now. Fasts beyond this point belong under medical supervision."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Más o menos ahora aparecen cambios en las proteínas de todo el organismo. Los ayunos más allá de este punto deben hacerse bajo supervisión médica."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Des changements des protéines dans tout l’organisme apparaissent vers ce moment. Au-delà de ce point, un jeûne doit se faire sous surveillance médicale."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "लगभग इसी समय पूरे शरीर में प्रोटीन बदलाव दिखने लगते हैं। इससे आगे के उपवास चिकित्सकीय निगरानी में ही होने चाहिए।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Perubahan protein di seluruh tubuh muncul sekitar saat ini. Puasa yang melewati titik ini seharusnya berada di bawah pengawasan medis."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Intorno a questo momento compaiono cambiamenti proteici in tutto l'organismo. I digiuni oltre questo punto vanno fatti sotto supervisione medica."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このころ、全身のたんぱく質に変化が現れます。これ以降の断食は医療管理のもとで行うべきです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 무렵 몸 전체에서 단백질 변화가 나타나요. 이 시점을 넘는 단식은 의료진의 감독하에 진행해야 해요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Perubahan protein di seluruh badan muncul sekitar masa ini. Puasa melebihi tahap ini harus dilakukan di bawah pengawasan perubatan."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Rond deze tijd verschijnen veranderingen in eiwitten door het hele lichaam. Vasten na dit punt hoort onder medisch toezicht."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Mniej więcej teraz w całym organizmie pojawiają się zmiany w białkach. Posty dłuższe niż ten próg powinny odbywać się pod nadzorem medycznym."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mudanças nas proteínas de todo o corpo aparecem por volta deste momento. Jejuns além deste ponto devem ter supervisão médica."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Примерно сейчас появляются изменения белков во всём организме. Голодание дольше этого срока должно проходить под медицинским наблюдением."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Förändringar i proteiner i hela kroppen syns ungefär nu. Fastor längre än så hör hemma under medicinsk övervakning."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Mabadiliko ya protini katika mwili mzima huonekana karibu na wakati huu. Mifungo inayozidi hatua hii inapaswa kuwa chini ya usimamizi wa kitabibu."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การเปลี่ยนแปลงของโปรตีนทั่วร่างกายเริ่มปรากฏในช่วงนี้ การอดอาหารที่เกินจุดนี้ควรอยู่ภายใต้การดูแลทางการแพทย์"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu sıralarda tüm vücutta protein değişiklikleri ortaya çıkar. Bu noktayı aşan oruçlar tıbbi gözetim altında yapılmalıdır."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Những thay đổi protein trên toàn cơ thể xuất hiện vào khoảng thời điểm này. Nhịn ăn quá mốc này cần có giám sát y tế."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "全身性的蛋白质变化大约在此时出现。超过这个时间点的断食应在医疗监护下进行。"
          }
        }
      }
    },
    "notify.h72.title": {
