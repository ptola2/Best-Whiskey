    "complication.bone.response": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تحديد مدة الصيام؛ وتجنب الصيام الطويل مع انخفاض كثافة العظام"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fastendauer begrenzen; lange Fastenperioden bei geringer Knochendichte vermeiden"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cap fast length; avoid long fasts with low bone density"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Limitar la duración del ayuno; evitar ayunos largos con baja densidad ósea"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Limiter la durée du jeûne ; éviter les jeûnes longs en cas de faible densité osseuse"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "उपवास की अवधि सीमित करें; हड्डियों का घनत्व कम हो तो लंबे उपवास से बचें"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Batasi lama puasa; hindari puasa panjang jika kepadatan tulang rendah"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Limitare la durata del digiuno; evitare digiuni lunghi con bassa densità ossea"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "断食期間を制限、骨密度が低い場合は長期の断食を避ける"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "단식 기간 제한, 골밀도가 낮으면 긴 단식 피하기"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Hadkan tempoh puasa; elakkan puasa panjang jika ketumpatan tulang rendah"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vastenduur beperken; geen lang vasten bij een lage botdichtheid"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ograniczenie długości postu; unikanie długich postów przy niskiej gęstości kości"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Limitar a duração do jejum; evitar jejuns longos com baixa densidade óssea"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ограничить длительность голодания; избегать длительных голоданий при низкой плотности костей"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Begränsa fastans längd; undvik långa fastor vid låg bentäthet"
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Weka kikomo cha urefu wa mfungo; epuka mifungo mirefu ukiwa na msongamano mdogo wa mifupa"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "จำกัดระยะเวลาการอดอาหาร หลีกเลี่ยงการอดอาหารนานหากความหนาแน่นของกระดูกต่ำ"
          }
        },
        "tr": {
