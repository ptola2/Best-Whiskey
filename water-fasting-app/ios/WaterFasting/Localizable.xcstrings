            "state": "translated",
            "value": "10 to 20%"
          }
        }
      }
    },
    "learn.refeeding.aspen.moderate": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Moderate"
          }
        }
      }
    },
    "learn.refeeding.aspen.moderate_value": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "20 to 30%"
          }
        }
      }
    },
    "learn.refeeding.aspen.severe": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Severe"
          }
        }
      }
    },
    "learn.refeeding.aspen.severe_value": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Over 30%, or organ problems, or thiamine deficiency"
          }
        }
      }
    },
    "learn.refeeding.aspen.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "ASPEN severity (drop in phosphorus, potassium or magnesium within 5 days of eating)"
          }
        }
      }
    },
    "learn.refeeding.edema": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Refeeding swelling (edema) is a separate problem: insulin makes the kidneys hold sodium and water. Salt eaten too early can cause swollen legs, fluid on the lungs and heart strain."
          }
        }
      }
    },
    "learn.refeeding.higher_risk": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Higher risk: little or no food for more than 7 to 10 days, BMI under 16, unintended loss of 10 to 15% of body weight in 3 to 6 months, or low phosphate or potassium before eating again."
          }
        }
      }
    },
    "learn.refeeding.mechanism": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "During a long fast, the phosphate, magnesium and potassium stored inside cells run low, even when blood tests look normal. When carbohydrate returns, insulin drives these minerals into cells all at once. Blood phosphate can crash below 0.30 mmol/L (1.0 mg/dL). Without phosphate, red cells cannot release oxygen properly, which can lead to breathing failure, dangerous heart rhythms and muscle breakdown. Restarting carbohydrate also burns through thiamine (vitamin B1), risking lactic acidosis and Wernicke's encephalopathy."
          }
        }
      }
    },
    "learn.refeeding.rule": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The rule of thumb: refeed for at least half as long as the fast, starting with diluted juice, then fruit and steamed vegetables, then starches and plant fats, with no added salt. The Refeed tab builds this plan for you."
          }
        }
      }
    },
    "learn.risks.common": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Common mild effects: tiredness, nausea, poor sleep, headache, dizziness, fainting, indigestion, dry mouth and lower back pain."
          }
        }
      }
    },
    "learn.risks.electrolytes": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Electrolytes: the body loses about 300 mEq of potassium over the first 7 days, even while blood levels look normal (3.5 to 4.0 mmol/L). Blood pH settles around 7.32 to 7.36 as bicarbonate is used up."
          }
        }
      }
    },
    "learn.risks.intro": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A review of 768 medically supervised water fasts (2 to 41 days, median 7) graded every side effect on the standard CTCAE scale."
          }
        }
      }
    },
    "learn.section.hours": {
      "extractionState": "manual",
      "localizations": {
