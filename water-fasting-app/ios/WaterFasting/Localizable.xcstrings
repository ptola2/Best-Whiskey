          "stringUnit": {
            "state": "translated",
            "value": "Add at least one reading, symptom or note."
          }
        }
      }
    },
    "checkin.error.range": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ should be between %2$lld and %3$lld."
          }
        }
      }
    },
