    "notify.h12.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Liver glycogen is running down and fat stores are opening up."
          }
        }
      }
    },
    "notify.h12.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "12 hours in"
          }
        }
      }
    },
    "notify.h36.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ketone production is climbing. Get up slowly: lightheadedness on standing is common now."
          }
        }
      }
    },
    "notify.h36.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "36 hours: the metabolic switch"
          }
        }
      }
    },
    "notify.h72.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Body-wide protein changes appear around now. Fasts beyond this point belong under medical supervision."
          }
        }
      }
    },
    "notify.h72.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The 72-hour threshold"
          }
        }
      }
    },
    "notify.past_target.body": {
      "extractionState": "manual",
