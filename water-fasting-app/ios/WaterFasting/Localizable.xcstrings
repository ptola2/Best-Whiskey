    "refeed.plan.source": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "النطاقات مأخوذة من إرشادات ASPEN وNICE لإعادة التغذية. ويحدد طبيبك المعالج الأرقام النهائية."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Bereiche stammen aus den Refeeding-Leitlinien von ASPEN und NICE. Die endgültigen Werte legt Ihr Behandlungsteam fest."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ranges come from ASPEN and NICE refeeding guidance. Your clinician sets the final numbers."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los rangos proceden de las guías de realimentación de ASPEN y NICE. Tu profesional de la salud fija las cifras finales."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les plages proviennent des recommandations ASPEN et NICE sur la réalimentation. Votre professionnel de santé fixe les valeurs définitives."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "ये सीमाएँ ASPEN और NICE के रीफ़ीडिंग दिशानिर्देशों से ली गई हैं। अंतिम संख्याएँ आपके चिकित्सक तय करते हैं।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kisaran berasal dari pedoman makan kembali ASPEN dan NICE. Tenaga medis Anda yang menentukan angka akhirnya."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Gli intervalli provengono dalle linee guida ASPEN e NICE sulla rialimentazione. I valori definitivi li stabilisce il tuo medico."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "範囲はASPENとNICEの再栄養（回復食）ガイダンスにもとづいています。最終的な数値は担当医が決めます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "범위는 ASPEN 및 NICE의 재급식 지침에 따른 것이에요. 최종 수치는 담당 의료진이 정해요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Julat diambil daripada panduan pemakanan semula ASPEN dan NICE. Pengamal perubatan anda menetapkan angka muktamad."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De bereiken komen uit de richtlijnen voor refeeding van ASPEN en NICE. Je zorgverlener bepaalt de uiteindelijke getallen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zakresy pochodzą z wytycznych ASPEN i NICE dotyczących ponownego odżywiania. Ostateczne wartości ustala twój lekarz prowadzący."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As faixas vêm das diretrizes de realimentação da ASPEN e do NICE. Seu profissional de saúde define os números finais."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Диапазоны взяты из рекомендаций ASPEN и NICE по возобновлению питания. Окончательные цифры определяет ваш врач."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Intervallen kommer från ASPEN:s och NICE:s riktlinjer för uppbyggnad (refeeding). Din vårdkontakt bestämmer de slutliga värdena."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Viwango vinatoka kwenye miongozo ya ASPEN na NICE kuhusu kurejea kula. Mtaalamu wako wa afya ndiye anayeweka namba za mwisho."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ช่วงค่าต่างๆ มาจากแนวทางการกลับมากินอาหารของ ASPEN และ NICE แพทย์ผู้ดูแลของคุณเป็นผู้กำหนดค่าสุดท้าย"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aralıklar ASPEN ve NICE yeniden beslenme kılavuzlarından alınmıştır. Kesin değerleri sağlık uzmanınız belirler."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Các khoảng giá trị lấy từ hướng dẫn về ăn lại của ASPEN và NICE. Nhân viên y tế của bạn sẽ quyết định con số cuối cùng."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这些范围来自 ASPEN 和 NICE 的再喂养指南。最终数值由你的医生确定。"
          }
        }
      }
    },
