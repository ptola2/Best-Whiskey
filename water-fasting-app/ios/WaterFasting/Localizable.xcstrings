    "profile.safety.refeed.hint": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تزيد هذه من خطر حدوث مشكلات عند العودة إلى الأكل."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Punkte erhöhen das Risiko für Probleme, wenn Sie wieder anfangen zu essen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "These raise the risk of problems when you start eating again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aumentan el riesgo de problemas al volver a comer."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ces points augmentent le risque de problèmes lors de la reprise alimentaire."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इनसे दोबारा खाना शुरू करते समय समस्याओं का जोखिम बढ़ जाता है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Hal-hal ini meningkatkan risiko masalah saat Anda mulai makan lagi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questi fattori aumentano il rischio di problemi quando ricominci a mangiare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "これらは、食事を再開するときに問題が起こるリスクを高めます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다시 먹기 시작할 때 문제가 생길 위험을 높이는 요인이에요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Perkara ini meningkatkan risiko masalah apabila anda mula makan semula."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Deze verhogen de kans op problemen als je weer gaat eten."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Te czynniki zwiększają ryzyko problemów po powrocie do jedzenia."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Estes fatores aumentam o risco de problemas quando você voltar a comer."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Эти факторы повышают риск проблем, когда вы снова начинаете есть."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "De här ökar risken för problem när du börjar äta igen."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Haya yanaongeza hatari ya matatizo unapoanza kula tena."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "สิ่งเหล่านี้เพิ่มความเสี่ยงที่จะเกิดปัญหาเมื่อคุณกลับมากินอาหาร"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bunlar, yeniden yemeye başladığınızda sorun yaşama riskini artırır."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Những yếu tố này làm tăng nguy cơ gặp vấn đề khi bạn bắt đầu ăn lại."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这些情况会增加你恢复进食时出现问题的风险。"
          }
        }
      }
    },
