    "blocker.bmi.why": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "من دون مخزون كافٍ من الدهون والبروتين، قد يؤدي الصيام إلى هزال عضلة القلب وحدوث اضطرابات خطيرة في نظم القلب."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ohne ausreichende Fett- und Eiweißreserven kann Fasten den Herzmuskel abbauen und gefährliche Herzrhythmusstörungen verursachen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Without enough fat and protein reserves, fasting can waste heart muscle and cause dangerous heart rhythms."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sin suficientes reservas de grasa y proteínas, el ayuno puede consumir el músculo cardíaco y causar alteraciones peligrosas del ritmo cardíaco."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sans réserves suffisantes de graisse et de protéines, le jeûne peut faire fondre le muscle cardiaque et provoquer des troubles du rythme cardiaque dangereux."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पर्याप्त वसा और प्रोटीन भंडार के बिना, उपवास से दिल की मांसपेशी घट सकती है और दिल की धड़कन में खतरनाक गड़बड़ी हो सकती है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tanpa cadangan lemak dan protein yang cukup, puasa dapat mengikis otot jantung dan menyebabkan irama jantung yang berbahaya."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Senza sufficienti riserve di grasso e proteine, il digiuno può consumare il muscolo cardiaco e causare ritmi cardiaci pericolosi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "脂肪とたんぱく質の蓄えが十分でないと、断食によって心筋が衰え、危険な不整脈が起こるおそれがあります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "지방과 단백질 비축분이 충분하지 않으면 단식으로 심장 근육이 소모되고 위험한 심장 리듬 이상이 생길 수 있어요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tanpa rizab lemak dan protein yang mencukupi, puasa boleh menyusutkan otot jantung dan menyebabkan irama jantung yang berbahaya."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zonder voldoende vet- en eiwitreserves kan vasten de hartspier afbreken en gevaarlijke hartritmestoornissen veroorzaken."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bez wystarczających rezerw tłuszczu i białka post może prowadzić do zaniku mięśnia sercowego i groźnych zaburzeń rytmu serca."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sem reservas suficientes de gordura e proteína, o jejum pode consumir o músculo cardíaco e causar ritmos cardíacos perigosos."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Без достаточных запасов жира и белка голодание может разрушать сердечную мышцу и вызывать опасные нарушения сердечного ритма."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Utan tillräckliga fett- och proteinreserver kan fasta bryta ned hjärtmuskeln och orsaka farliga hjärtrytmrubbningar."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Bila akiba ya kutosha ya mafuta na protini, kufunga kunaweza kuyeyusha misuli ya moyo na kusababisha midundo hatari ya moyo."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "หากไม่มีไขมันและโปรตีนสำรองเพียงพอ การอดอาหารอาจทำให้กล้ามเนื้อหัวใจฝ่อลีบและทำให้หัวใจเต้นผิดจังหวะที่เป็นอันตราย"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yeterli yağ ve protein rezervi olmadan oruç, kalp kasının yıkımına ve tehlikeli kalp ritmi bozukluklarına yol açabilir."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Khi không đủ dự trữ mỡ và protein, nhịn ăn có thể làm hao mòn cơ tim và gây rối loạn nhịp tim nguy hiểm."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "脂肪和蛋白质储备不足时，断食可能导致心肌消耗，并引发危险的心律失常。"
          }
        }
      }
    },
