    "learn.refeeding.aspen.severe_value": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أكثر من 30%، أو مشكلات في الأعضاء، أو نقص الثيامين"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Über 30 % oder Organprobleme oder Thiaminmangel"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Over 30%, or organ problems, or thiamine deficiency"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Más del 30 %, o problemas en órganos, o déficit de tiamina"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Plus de 30 %, ou atteinte d’organes, ou carence en thiamine"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "30% से ज़्यादा, या अंगों में समस्या, या थायमिन की कमी"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Lebih dari 30%, atau gangguan organ, atau kekurangan tiamin"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Oltre il 30%, o problemi d'organo, o carenza di tiamina"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "30%超、または臓器障害、またはチアミン欠乏"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "30% 초과, 또는 장기 기능 이상, 또는 티아민 결핍"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Melebihi 30%, atau masalah organ, atau kekurangan tiamina"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Meer dan 30%, of orgaanproblemen, of thiaminetekort"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ponad 30% albo zaburzenia czynności narządów, albo niedobór tiaminy"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mais de 30%, ou disfunção de órgãos, ou deficiência de tiamina"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Более 30%, или нарушения функции органов, или дефицит тиамина"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Över 30 %, eller organpåverkan, eller tiaminbrist"
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Zaidi ya 30%, au matatizo ya viungo vya mwili, au upungufu wa thiamini"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "มากกว่า 30% หรือมีปัญหาของอวัยวะ หรือขาดไทอามีน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%30'un üzerinde ya da organ sorunları veya tiamin eksikliği"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Trên 30%, hoặc rối loạn chức năng cơ quan, hoặc thiếu thiamin"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "超过 30%，或出现器官问题，或硫胺素缺乏"
          }
        }
      }
    },
    "learn.refeeding.aspen.title": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "درجات الشدة لدى ASPEN (انخفاض الفوسفور أو البوتاسيوم أو المغنيسيوم خلال 5 أيام من العودة إلى الأكل)"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "ASPEN-Schweregrad (Abfall von Phosphor, Kalium oder Magnesium innerhalb von 5 Tagen nach Wiederbeginn des Essens)"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "ASPEN severity (drop in phosphorus, potassium or magnesium within 5 days of eating)"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Gravedad según ASPEN (descenso de fósforo, potasio o magnesio en los 5 días posteriores a volver a comer)"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sévérité selon ASPEN (baisse du phosphore, du potassium ou du magnésium dans les 5 jours suivant la reprise alimentaire)"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "ASPEN गंभीरता (खाना शुरू करने के 5 दिनों के भीतर फ़ॉस्फ़ोरस, पोटैशियम या मैग्नीशियम में गिरावट)"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tingkat keparahan ASPEN (penurunan fosfor, kalium, atau magnesium dalam 5 hari setelah mulai makan)"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Gravità secondo ASPEN (calo di fosforo, potassio o magnesio entro 5 giorni dalla ripresa dell'alimentazione)"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ASPENの重症度（食事再開後5日以内のリン、カリウム、マグネシウムの低下）"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "ASPEN 중증도(다시 먹기 시작한 후 5일 안에 인, 칼륨 또는 마그네슘 감소)"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tahap keterukan ASPEN (penurunan fosforus, kalium atau magnesium dalam tempoh 5 hari selepas mula makan)"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ernst volgens ASPEN (daling van fosfor, kalium of magnesium binnen 5 dagen na het weer eten)"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Stopień ciężkości wg ASPEN (spadek stężenia fosforu, potasu lub magnezu w ciągu 5 dni od rozpoczęcia jedzenia)"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Gravidade pela ASPEN (queda de fósforo, potássio ou magnésio em até 5 dias após voltar a comer)"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Тяжесть по ASPEN (снижение уровня фосфора, калия или магния в течение 5 дней после начала питания)"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Svårighetsgrad enligt ASPEN (sänkt fosfor, kalium eller magnesium inom 5 dagar efter att du börjat äta)"
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Ukali kwa vigezo vya ASPEN (kushuka kwa fosforasi, potasiamu au magnesiamu ndani ya siku 5 za kula)"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ความรุนแรงตาม ASPEN (ฟอสฟอรัส โพแทสเซียม หรือแมกนีเซียมลดลงภายใน 5 วันหลังกลับมากินอาหาร)"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "ASPEN şiddet derecesi (yemeye başladıktan sonraki 5 gün içinde fosfor, potasyum veya magnezyumda düşüş)"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mức độ nặng theo ASPEN (phospho, kali hoặc magie giảm trong vòng 5 ngày sau khi bắt đầu ăn)"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "ASPEN 严重程度（恢复进食后 5 天内磷、钾或镁的下降幅度）"
          }
        }
      }
    },
    "learn.refeeding.edema": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تورم إعادة التغذية (الوذمة) مشكلة منفصلة: إذ يجعل الإنسولين الكليتين تحتفظان بالصوديوم والماء. وقد يسبب تناول الملح في وقت مبكر جدًا تورم الساقين وتجمع السوائل في الرئتين وإجهاد القلب."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schwellungen beim Kostaufbau (Ödeme) sind ein eigenes Problem: Insulin bringt die Nieren dazu, Natrium und Wasser zurückzuhalten. Zu früh gegessenes Salz kann geschwollene Beine, Wasser in der Lunge und eine Belastung des Herzens verursachen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Refeeding swelling (edema) is a separate problem: insulin makes the kidneys hold sodium and water. Salt eaten too early can cause swollen legs, fluid on the lungs and heart strain."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La hinchazón por realimentación (edema) es un problema distinto: la insulina hace que los riñones retengan sodio y agua. La sal tomada demasiado pronto puede causar hinchazón de piernas, líquido en los pulmones y sobrecarga del corazón."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le gonflement de réalimentation (œdème) est un problème distinct : l’insuline pousse les reins à retenir le sodium et l’eau. Du sel consommé trop tôt peut provoquer des jambes gonflées, du liquide dans les poumons et une fatigue cardiaque."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "रीफ़ीडिंग सूजन (एडिमा) एक अलग समस्या है: इंसुलिन की वजह से गुर्दे सोडियम और पानी रोककर रखते हैं। बहुत जल्दी खाया गया नमक टाँगों में सूजन, फेफड़ों में पानी और दिल पर दबाव पैदा कर सकता है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pembengkakan saat makan kembali (edema) adalah masalah tersendiri: insulin membuat ginjal menahan natrium dan air. Garam yang dikonsumsi terlalu dini dapat menyebabkan tungkai bengkak, cairan di paru-paru, dan beban pada jantung."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il gonfiore da rialimentazione (edema) è un problema diverso: l'insulina fa trattenere ai reni sodio e acqua. Il sale assunto troppo presto può causare gambe gonfie, liquido nei polmoni e sovraccarico per il cuore."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "回復食によるむくみ（浮腫）は別の問題です：インスリンの働きで腎臓がナトリウムと水分をため込みます。早すぎる時期に塩分をとると、脚のむくみ、肺に水がたまること、心臓への負担を引き起こすおそれがあります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "재급식 부기(부종)는 별개의 문제예요. 인슐린 때문에 신장이 나트륨과 수분을 붙잡아 둬요. 소금을 너무 일찍 먹으면 다리 부기, 폐에 물이 차는 증상, 심장 부담이 생길 수 있어요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Bengkak akibat pemakanan semula (edema) ialah masalah yang berasingan: insulin menyebabkan buah pinggang menahan natrium dan air. Garam yang dimakan terlalu awal boleh menyebabkan kaki bengkak, cecair dalam paru-paru dan beban pada jantung."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vochtophoping bij het opbouwen (oedeem) is een apart probleem: insuline zorgt ervoor dat de nieren natrium en water vasthouden. Te vroeg zout eten kan leiden tot gezwollen benen, vocht in de longen en belasting van het hart."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Obrzęki po ponownym odżywieniu to odrębny problem: insulina sprawia, że nerki zatrzymują sód i wodę. Sól spożyta zbyt wcześnie może powodować obrzęki nóg, płyn w płucach i obciążenie serca."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O inchaço de realimentação (edema) é um problema à parte: a insulina faz os rins reterem sódio e água. Sal ingerido cedo demais pode causar inchaço nas pernas, líquido nos pulmões e sobrecarga do coração."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отёки при возобновлении питания (отёчный синдром) представляют собой отдельную проблему: инсулин заставляет почки удерживать натрий и воду. Соль, съеденная слишком рано, может вызвать отёки ног, скопление жидкости в лёгких и нагрузку на сердце."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Refeedingödem (svullnad) är ett separat problem: insulin får njurarna att hålla kvar natrium och vatten. Salt som äts för tidigt kan orsaka svullna ben, vätska i lungorna och belastning på hjärtat."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Uvimbe wa kurejea kula (edema) ni tatizo tofauti: insulini hufanya figo zibakize sodiamu na maji. Chumvi inayoliwa mapema mno inaweza kusababisha miguu kuvimba, maji kujaa kwenye mapafu na kuulemea moyo."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "อาการบวมจากการกลับมากินอาหาร (บวมน้ำ) เป็นอีกปัญหาหนึ่ง: อินซูลินทำให้ไตเก็บกักโซเดียมและน้ำไว้ การกินเกลือเร็วเกินไปอาจทำให้ขาบวม มีน้ำในปอด และหัวใจทำงานหนัก"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yeniden beslenmeye bağlı şişlik (ödem) ayrı bir sorundur: insülin, böbreklerin sodyum ve su tutmasına neden olur. Çok erken alınan tuz bacaklarda şişliğe, akciğerlerde sıvı birikmesine ve kalbin zorlanmasına yol açabilir."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Phù khi ăn lại là một vấn đề riêng: insulin khiến thận giữ natri và nước. Ăn muối quá sớm có thể gây phù chân, ứ dịch ở phổi và gánh nặng cho tim."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "再喂养水肿（复食后肿胀）是另一个问题：胰岛素会使肾脏潴留钠和水。过早摄入盐可能导致腿部肿胀、肺部积液和心脏负担加重。"
          }
        }
      }
    },
    "learn.refeeding.higher_risk": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "خطر أعلى: تناول القليل من الطعام أو عدم تناوله لأكثر من 7 إلى 10 أيام، أو مؤشر كتلة جسم أقل من 16، أو فقدان غير مقصود بنسبة 10 إلى 15% من وزن الجسم خلال 3 إلى 6 أشهر، أو انخفاض الفوسفات أو البوتاسيوم قبل العودة إلى الأكل."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Höheres Risiko: wenig oder keine Nahrung über mehr als 7 bis 10 Tage, BMI unter 16, ungewollter Verlust von 10 bis 15 % des Körpergewichts in 3 bis 6 Monaten oder niedriges Phosphat oder Kalium vor dem Wiederbeginn des Essens."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Higher risk: little or no food for more than 7 to 10 days, BMI under 16, unintended loss of 10 to 15% of body weight in 3 to 6 months, or low phosphate or potassium before eating again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mayor riesgo: poca o ninguna comida durante más de 7 a 10 días, IMC inferior a 16, pérdida no intencionada del 10 al 15 % del peso corporal en 3 a 6 meses, o fosfato o potasio bajos antes de volver a comer."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Risque plus élevé : peu ou pas de nourriture pendant plus de 7 à 10 jours, IMC inférieur à 16, perte involontaire de 10 à 15 % du poids corporel en 3 à 6 mois, ou phosphate ou potassium bas avant la reprise alimentaire."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "ज़्यादा जोखिम: 7 से 10 दिन से ज़्यादा समय तक बहुत कम या बिल्कुल खाना नहीं, BMI 16 से कम, 3 से 6 महीनों में बिना चाहे शरीर के वज़न का 10 से 15% घटना, या दोबारा खाने से पहले फ़ॉस्फ़ेट या पोटैशियम कम होना।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Risiko lebih tinggi: sedikit atau tidak ada makanan selama lebih dari 7 sampai 10 hari, IMT di bawah 16, penurunan 10 sampai 15% berat badan tanpa disengaja dalam 3 sampai 6 bulan, atau fosfat atau kalium rendah sebelum mulai makan lagi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Rischio più alto: poco o nessun cibo per più di 7-10 giorni, BMI sotto 16, perdita involontaria del 10-15% del peso corporeo in 3-6 mesi, oppure fosfato o potassio bassi prima di ricominciare a mangiare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "リスクが高いのは：7〜10日を超えてほとんど、またはまったく食べていない、BMI 16未満、3〜6か月で体重の10〜15%が意図せず減った、または食事を再開する前からリンやカリウムが低い場合です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "위험이 더 높은 경우: 7~10일 넘게 음식을 거의 또는 전혀 먹지 않았을 때, BMI 16 미만, 3~6개월 동안 의도치 않게 체중의 10~15%가 줄었을 때, 또는 다시 먹기 전에 인산염이나 칼륨이 낮을 때."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Risiko lebih tinggi: sedikit atau tiada makanan selama lebih daripada 7 hingga 10 hari, BMI bawah 16, kehilangan 10 hingga 15% berat badan tanpa sengaja dalam 3 hingga 6 bulan, atau fosfat atau kalium rendah sebelum mula makan semula."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Hoger risico: weinig of geen eten gedurende meer dan 7 tot 10 dagen, BMI onder 16, onbedoeld verlies van 10 tot 15% van het lichaamsgewicht in 3 tot 6 maanden, of een laag fosfaat of kalium voordat je weer gaat eten."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wyższe ryzyko: niewiele jedzenia lub jego brak przez ponad 7 do 10 dni, BMI poniżej 16, niezamierzona utrata od 10 do 15% masy ciała w ciągu 3 do 6 miesięcy lub niski poziom fosforanów albo potasu przed powrotem do jedzenia."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Risco maior: pouca ou nenhuma comida por mais de 7 a 10 dias, IMC abaixo de 16, perda não intencional de 10 a 15% do peso corporal em 3 a 6 meses ou fosfato ou potássio baixos antes de voltar a comer."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Повышенный риск: мало или совсем нет еды более 7–10 дней, ИМТ ниже 16, непреднамеренная потеря 10–15% массы тела за 3–6 месяцев или низкий уровень фосфата или калия перед возобновлением питания."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Högre risk: lite eller ingen mat i mer än 7 till 10 dagar, BMI under 16, oavsiktlig viktnedgång på 10 till 15 % av kroppsvikten på 3 till 6 månader, eller lågt fosfat eller kalium innan du börjar äta igen."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Hatari kubwa zaidi: kula kidogo au kutokula kabisa kwa zaidi ya siku 7 hadi 10, BMI chini ya 16, kupoteza bila kukusudia 10 hadi 15% ya uzito wa mwili katika miezi 3 hadi 6, au fosfeti au potasiamu ya chini kabla ya kuanza kula tena."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ความเสี่ยงสูงขึ้น: กินอาหารน้อยมากหรือไม่ได้กินเลยนานกว่า 7 ถึง 10 วัน ดัชนีมวลกายต่ำกว่า 16 น้ำหนักลดลงโดยไม่ตั้งใจ 10 ถึง 15% ของน้ำหนักตัวภายใน 3 ถึง 6 เดือน หรือมีฟอสเฟตหรือโพแทสเซียมต่ำก่อนกลับมากินอาหาร"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Daha yüksek risk: 7 ila 10 günden uzun süre çok az yemek yemek veya hiç yememek, 16'nın altında VKİ, 3 ila 6 ayda vücut ağırlığının %10 ila %15'inin istemeden kaybı ya da yeniden yemeye başlamadan önce düşük fosfat veya potasyum."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nguy cơ cao hơn: ăn rất ít hoặc không ăn trong hơn 7 đến 10 ngày, BMI dưới 16, sụt 10 đến 15% cân nặng ngoài ý muốn trong 3 đến 6 tháng, hoặc phosphat hay kali thấp trước khi ăn lại."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "较高风险：超过 7 至 10 天几乎或完全没有进食，BMI 低于 16，3 至 6 个月内非刻意减轻体重的 10% 至 15%，或恢复进食前磷或钾偏低。"
          }
        }
      }
    },
    "learn.refeeding.mechanism": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "خلال الصيام الطويل، تنخفض مخازن الفوسفات والمغنيسيوم والبوتاسيوم داخل الخلايا، حتى عندما تبدو تحاليل الدم طبيعية. وعند عودة الكربوهيدرات، يدفع الإنسولين هذه المعادن إلى داخل الخلايا دفعة واحدة. وقد ينهار مستوى الفوسفات في الدم إلى أقل من 0.30 mmol/L (1.0 mg/dL). ومن دون الفوسفات، لا تستطيع خلايا الدم الحمراء إطلاق الأكسجين كما ينبغي، مما قد يؤدي إلى الفشل التنفسي واضطرابات خطيرة في نظم القلب وتحلل العضلات. كما أن استئناف تناول الكربوهيدرات يستنزف الثيامين (فيتامين B1)، مما يعرّض لخطر الحماض اللبني واعتلال الدماغ الفيرنيكي."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Während eines langen Fastens gehen die in den Zellen gespeicherten Vorräte an Phosphat, Magnesium und Kalium zur Neige, selbst wenn Bluttests normal aussehen. Wenn wieder Kohlenhydrate zugeführt werden, treibt Insulin diese Mineralstoffe auf einmal in die Zellen. Das Phosphat im Blut kann unter 0,30 mmol/L (1,0 mg/dL) abstürzen. Ohne Phosphat können rote Blutkörperchen Sauerstoff nicht richtig abgeben, was zu Atemversagen, gefährlichen Herzrhythmusstörungen und Muskelabbau führen kann. Der Wiederbeginn mit Kohlenhydraten verbraucht außerdem Thiamin (Vitamin B1) und birgt das Risiko einer Laktatazidose und einer Wernicke-Enzephalopathie."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "During a long fast, the phosphate, magnesium and potassium stored inside cells run low, even when blood tests look normal. When carbohydrate returns, insulin drives these minerals into cells all at once. Blood phosphate can crash below 0.30 mmol/L (1.0 mg/dL). Without phosphate, red cells cannot release oxygen properly, which can lead to breathing failure, dangerous heart rhythms and muscle breakdown. Restarting carbohydrate also burns through thiamine (vitamin B1), risking lactic acidosis and Wernicke's encephalopathy."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Durante un ayuno largo, el fosfato, el magnesio y el potasio almacenados dentro de las células bajan mucho, incluso cuando los análisis de sangre parecen normales. Cuando vuelven los carbohidratos, la insulina impulsa estos minerales hacia el interior de las células de golpe. El fosfato en sangre puede desplomarse por debajo de 0,30 mmol/L (1,0 mg/dL). Sin fosfato, los glóbulos rojos no pueden liberar bien el oxígeno, lo que puede provocar insuficiencia respiratoria, alteraciones peligrosas del ritmo cardíaco y destrucción del músculo. Volver a tomar carbohidratos también agota rápidamente la tiamina (vitamina B1), con riesgo de acidosis láctica y encefalopatía de Wernicke."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pendant un long jeûne, les réserves de phosphate, de magnésium et de potassium à l’intérieur des cellules s’épuisent, même quand les analyses de sang semblent normales. Quand les glucides reviennent, l’insuline fait entrer ces minéraux dans les cellules d’un seul coup. Le phosphate sanguin peut chuter sous 0,30 mmol/L (1,0 mg/dL). Sans phosphate, les globules rouges ne peuvent plus libérer correctement l’oxygène, ce qui peut entraîner une insuffisance respiratoire, des troubles du rythme cardiaque dangereux et une destruction musculaire. La reprise des glucides consomme aussi rapidement la thiamine (vitamine B1), avec un risque d’acidose lactique et d’encéphalopathie de Gayet-Wernicke."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "लंबे उपवास के दौरान कोशिकाओं के अंदर जमा फ़ॉस्फ़ेट, मैग्नीशियम और पोटैशियम कम हो जाते हैं, भले ही खून की जाँच सामान्य दिखे। जब कार्बोहाइड्रेट दोबारा मिलता है, तो इंसुलिन इन खनिजों को एक साथ कोशिकाओं में भेज देता है। खून में फ़ॉस्फ़ेट 0.30 mmol/L (1.0 mg/dL) से नीचे गिर सकता है। फ़ॉस्फ़ेट के बिना लाल रक्त कोशिकाएँ ठीक से ऑक्सीजन नहीं छोड़ पातीं, जिससे श्वसन विफलता (साँस लेने की प्रणाली का फ़ेल होना), दिल की धड़कन में खतरनाक गड़बड़ी और मांसपेशियों का टूटना हो सकता है। कार्बोहाइड्रेट दोबारा शुरू करने से थायमिन (विटामिन B1) भी तेज़ी से खर्च होता है, जिससे लैक्टिक एसिडोसिस और वर्निके एन्सेफैलोपैथी का खतरा होता है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Selama puasa panjang, fosfat, magnesium, dan kalium yang tersimpan di dalam sel menipis, bahkan ketika tes darah tampak normal. Saat karbohidrat kembali dikonsumsi, insulin mendorong mineral-mineral ini masuk ke dalam sel sekaligus. Kadar fosfat darah dapat anjlok di bawah 0,30 mmol/L (1,0 mg/dL). Tanpa fosfat, sel darah merah tidak dapat melepaskan oksigen dengan baik, yang dapat menyebabkan gagal napas, irama jantung yang berbahaya, dan kerusakan otot. Memulai kembali karbohidrat juga menguras tiamin (vitamin B1), sehingga berisiko menimbulkan asidosis laktat dan ensefalopati Wernicke."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Durante un digiuno lungo, il fosfato, il magnesio e il potassio immagazzinati nelle cellule si riducono, anche quando gli esami del sangue sembrano normali. Quando tornano i carboidrati, l'insulina spinge questi minerali nelle cellule tutti insieme. Il fosfato nel sangue può crollare sotto 0,30 mmol/L (1,0 mg/dL). Senza fosfato, i globuli rossi non riescono a cedere bene l'ossigeno, il che può portare a insufficienza respiratoria, ritmi cardiaci pericolosi e distruzione muscolare. La ripresa dei carboidrati consuma anche la tiamina (vitamina B1), con il rischio di acidosi lattica ed encefalopatia di Wernicke."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "長期の断食中は、血液検査では正常に見えても、細胞内に蓄えられたリン、マグネシウム、カリウムが不足していきます。炭水化物が再び入ってくると、インスリンがこれらのミネラルを一気に細胞内へ送り込みます。血中のリンは0.30 mmol/L（1.0 mg/dL）未満まで急落することがあります。リンがないと赤血球が酸素をうまく放出できず、呼吸不全、危険な不整脈、筋肉の崩壊につながるおそれがあります。炭水化物の摂取を再開すると、チアミン（ビタミンB1）も急速に消費され、乳酸アシドーシスやウェルニッケ脳症のリスクが生じます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "긴 단식 중에는 혈액 검사 결과가 정상으로 보여도 세포 안에 저장된 인산염, 마그네슘, 칼륨이 부족해져요. 탄수화물이 다시 들어오면 인슐린이 이 미네랄들을 한꺼번에 세포 안으로 밀어 넣어요. 혈중 인산염이 0.30 mmol/L(1.0 mg/dL) 아래로 급락할 수 있어요. 인산염이 없으면 적혈구가 산소를 제대로 내놓지 못해 호흡 부전, 위험한 심장 리듬 이상, 근육 분해로 이어질 수 있어요. 탄수화물을 다시 먹기 시작하면 티아민(비타민 B1)도 빠르게 소모되어 젖산산증과 베르니케 뇌병증의 위험이 생겨요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Semasa puasa yang panjang, fosfat, magnesium dan kalium yang disimpan di dalam sel menjadi rendah, walaupun ujian darah kelihatan normal. Apabila karbohidrat kembali, insulin mendorong mineral ini masuk ke dalam sel sekali gus. Fosfat darah boleh jatuh mendadak di bawah 0.30 mmol/L (1.0 mg/dL). Tanpa fosfat, sel darah merah tidak dapat membebaskan oksigen dengan betul, yang boleh menyebabkan kegagalan pernafasan, irama jantung yang berbahaya dan kerosakan otot. Memulakan semula karbohidrat juga menghabiskan tiamina (vitamin B1) dengan cepat, sekali gus berisiko menyebabkan asidosis laktik dan ensefalopati Wernicke."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tijdens een lang vasten raken het fosfaat, magnesium en kalium die in de cellen zijn opgeslagen op, zelfs als bloedonderzoek normaal lijkt. Als er weer koolhydraten binnenkomen, drijft insuline deze mineralen in één keer de cellen in. Het fosfaat in het bloed kan dan kelderen tot onder 0,30 mmol/L (1,0 mg/dL). Zonder fosfaat kunnen rode bloedcellen niet goed zuurstof afgeven, wat kan leiden tot ademhalingsfalen, gevaarlijke hartritmestoornissen en spierafbraak. Het weer starten met koolhydraten verbruikt ook snel thiamine (vitamine B1), met kans op lactaatacidose en encefalopathie van Wernicke."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Podczas długiego postu zapasy fosforanów, magnezu i potasu w komórkach się wyczerpują, nawet gdy wyniki badań krwi wyglądają prawidłowo. Gdy wracają węglowodany, insulina wtłacza te minerały do komórek naraz. Stężenie fosforanów we krwi może gwałtownie spaść poniżej 0,30 mmol/L (1,0 mg/dL). Bez fosforanów czerwone krwinki nie mogą prawidłowo oddawać tlenu, co może prowadzić do niewydolności oddechowej, groźnych zaburzeń rytmu serca i rozpadu mięśni. Ponowne wprowadzenie węglowodanów zużywa też tiaminę (witaminę B1), co grozi kwasicą mleczanową i encefalopatią Wernickego."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Durante um jejum longo, o fosfato, o magnésio e o potássio armazenados dentro das células ficam baixos, mesmo quando os exames de sangue parecem normais. Quando o carboidrato volta, a insulina leva esses minerais para dentro das células de uma só vez. O fosfato no sangue pode despencar para menos de 0,30 mmol/L (1,0 mg/dL). Sem fosfato, os glóbulos vermelhos não conseguem liberar oxigênio direito, o que pode levar a insuficiência respiratória, ritmos cardíacos perigosos e degradação muscular. Retomar o carboidrato também consome tiamina (vitamina B1), com risco de acidose lática e encefalopatia de Wernicke."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Во время длительного голодания запасы фосфата, магния и калия внутри клеток истощаются, даже когда анализы крови выглядят нормальными. Когда снова поступают углеводы, инсулин разом загоняет эти минералы в клетки. Уровень фосфата в крови может резко упасть ниже 0,30 ммоль/л (1,0 мг/дл). Без фосфата эритроциты не могут нормально отдавать кислород, что может привести к дыхательной недостаточности, опасным нарушениям сердечного ритма и разрушению мышц. Возобновление приёма углеводов также быстро расходует тиамин (витамин B1), что создаёт риск лактоацидоза и энцефалопатии Вернике."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Under en lång fasta minskar förråden av fosfat, magnesium och kalium inne i cellerna, även när blodproverna ser normala ut. När kolhydrater kommer tillbaka driver insulin in de här mineralerna i cellerna på en gång. Fosfat i blodet kan rasa till under 0,30 mmol/L (1,0 mg/dL). Utan fosfat kan de röda blodkropparna inte avge syre ordentligt, vilket kan leda till andningssvikt, farliga hjärtrytmrubbningar och muskelnedbrytning. När kolhydrater återinförs förbrukas också tiamin (vitamin B1) snabbt, med risk för laktacidos och Wernickes encefalopati."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Wakati wa mfungo mrefu, fosfeti, magnesiamu na potasiamu zilizohifadhiwa ndani ya seli hupungua, hata vipimo vya damu vikionekana kawaida. Kabohaidreti inaporudi, insulini husukuma madini haya ndani ya seli kwa mara moja. Fosfeti ya damu inaweza kuporomoka chini ya 0.30 mmol/L (1.0 mg/dL). Bila fosfeti, chembe nyekundu za damu haziwezi kuachilia oksijeni ipasavyo, jambo linaloweza kusababisha kushindwa kupumua, midundo hatari ya moyo na kuvunjika kwa misuli. Kuanza tena kabohaidreti pia hutumia haraka thiamini (vitamini B1), na kuleta hatari ya asidi ya laktiki kujaa damuni (lactic acidosis) na ugonjwa wa ubongo wa Wernicke (Wernicke's encephalopathy)."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ระหว่างการอดอาหารเป็นเวลานาน ฟอสเฟต แมกนีเซียม และโพแทสเซียมที่สะสมอยู่ภายในเซลล์จะลดต่ำลง แม้ผลตรวจเลือดจะดูปกติ เมื่อกลับมาได้รับคาร์โบไฮเดรต อินซูลินจะดึงแร่ธาตุเหล่านี้เข้าสู่เซลล์พร้อมกันทั้งหมด ฟอสเฟตในเลือดอาจลดฮวบลงต่ำกว่า 0.30 mmol/L (1.0 mg/dL) หากขาดฟอสเฟต เม็ดเลือดแดงจะปล่อยออกซิเจนได้ไม่ดี ซึ่งอาจนำไปสู่ภาวะหายใจล้มเหลว หัวใจเต้นผิดจังหวะที่เป็นอันตราย และการสลายของกล้ามเนื้อ การกลับมาได้รับคาร์โบไฮเดรตยังใช้ไทอามีน (วิตามินบี 1) ไปอย่างรวดเร็ว เสี่ยงต่อภาวะเลือดเป็นกรดจากแล็กติกและโรคสมองเวอร์นิเก"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Uzun bir oruç sırasında, kan tahlilleri normal görünse bile hücre içinde depolanan fosfat, magnezyum ve potasyum azalır. Karbonhidrat yeniden alındığında insülin bu mineralleri bir anda hücrelere çeker. Kandaki fosfat 0,30 mmol/L'nin (1,0 mg/dL) altına düşebilir. Fosfat olmadan alyuvarlar oksijeni düzgün bırakamaz; bu da solunum yetmezliğine, tehlikeli kalp ritimlerine ve kas yıkımına yol açabilir. Karbonhidrata yeniden başlamak tiamini (B1 vitamini) de hızla tüketir ve laktik asidoz ile Wernicke ensefalopatisi riski doğurur."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Trong một đợt nhịn ăn dài, lượng phosphat, magie và kali dự trữ bên trong tế bào cạn dần, ngay cả khi xét nghiệm máu trông bình thường. Khi carbohydrate được đưa trở lại, insulin đẩy các khoáng chất này vào tế bào cùng một lúc. Phosphat máu có thể giảm mạnh xuống dưới 0,30 mmol/L (1,0 mg/dL). Thiếu phosphat, hồng cầu không thể giải phóng oxy đúng cách, có thể dẫn đến suy hô hấp, rối loạn nhịp tim nguy hiểm và tiêu cơ. Ăn carbohydrate trở lại cũng tiêu hao nhanh thiamin (vitamin B1), có nguy cơ gây nhiễm toan lactic và bệnh não Wernicke."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "长时间断食期间，储存在细胞内的磷、镁和钾会逐渐不足，即使验血结果看起来正常。当重新摄入碳水化合物时，胰岛素会把这些矿物质一下子全部驱入细胞。血磷可能骤降至 0.30 mmol/L（1.0 mg/dL）以下。缺磷时，红细胞无法正常释放氧气，可能导致呼吸衰竭、危险的心律失常和肌肉分解。重新摄入碳水化合物还会迅速消耗硫胺素（维生素 B1），有引发乳酸酸中毒和韦尼克脑病的风险。"
          }
        }
      }
    },
    "learn.refeeding.rule": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "القاعدة العامة: أعد التغذية لمدة لا تقل عن نصف مدة الصيام، مبتدئًا بالعصير المخفف، ثم الفواكه والخضراوات المطهوة على البخار، ثم النشويات والدهون النباتية، دون إضافة ملح. ويُعدّ لك قسم «إعادة التغذية» هذه الخطة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Faustregel: Der Kostaufbau dauert mindestens halb so lange wie das Fasten und beginnt mit verdünntem Saft, dann folgen Obst und gedämpftes Gemüse, dann stärkehaltige Lebensmittel und pflanzliche Fette, ohne zusätzliches Salz. Der Tab „Kostaufbau“ erstellt diesen Plan für Sie."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The rule of thumb: refeed for at least half as long as the fast, starting with diluted juice, then fruit and steamed vegetables, then starches and plant fats, with no added salt. The Refeed tab builds this plan for you."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La regla general: dedica a la realimentación al menos la mitad de lo que duró el ayuno, empezando con jugo diluido, luego fruta y verduras al vapor, y después almidones y grasas vegetales, sin sal añadida. La pestaña Realimentar prepara este plan por ti."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La règle générale : se réalimenter pendant au moins la moitié de la durée du jeûne, en commençant par du jus dilué, puis des fruits et des légumes vapeur, puis des féculents et des graisses végétales, sans sel ajouté. L’onglet Reprise établit ce plan pour vous."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आम नियम: उपवास के कम से कम आधे समय तक दोबारा खाने का चरण चलाएँ, पहले पानी मिला जूस, फिर फल और भाप में पकी सब्ज़ियाँ, फिर स्टार्च वाले खाद्य और पौधों से मिलने वाली वसा, ऊपर से नमक डाले बिना। “दोबारा खाना” टैब आपके लिए यह योजना बनाता है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Aturan praktisnya: jalani masa makan kembali setidaknya separuh lama puasa, dimulai dengan jus encer, lalu buah dan sayuran kukus, lalu makanan bertepung dan lemak nabati, tanpa tambahan garam. Tab Makan Kembali menyusun rencana ini untuk Anda."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La regola pratica: rialimentati per almeno metà della durata del digiuno, iniziando con succo diluito, poi frutta e verdure al vapore, poi amidi e grassi vegetali, senza sale aggiunto. La scheda Ripresa crea questo piano per te."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "目安：回復食は断食期間の少なくとも半分の長さをかけて行います。薄めたジュースから始め、次に果物と蒸し野菜、その後でんぷん質の食品と植物性脂肪へと進め、塩は加えません。「回復食」タブでこのプランを作成できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기본 원칙: 최소한 단식 기간의 절반 동안 보식하세요. 희석한 주스로 시작해 과일과 찐 채소, 그다음 전분류와 식물성 지방 순으로 늘리고, 소금은 추가하지 마세요. 보식 탭에서 이 계획을 세워 드려요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Panduan umum: lakukan pemakanan semula selama sekurang-kurangnya separuh tempoh puasa, bermula dengan jus yang dicairkan, kemudian buah-buahan dan sayur-sayuran kukus, kemudian makanan berkanji dan lemak tumbuhan, tanpa garam tambahan. Tab Makan Semula menyediakan pelan ini untuk anda."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De vuistregel: bouw minstens half zo lang op als je hebt gevast. Begin met verdund sap, dan fruit en gestoomde groente, dan zetmeelrijk voedsel en plantaardige vetten, zonder toegevoegd zout. Het tabblad Opbouw maakt dit schema voor je."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ogólna zasada: wychodź z postu przez co najmniej połowę czasu jego trwania, zaczynając od rozcieńczonego soku, potem przechodząc do owoców i warzyw gotowanych na parze, a następnie do produktów skrobiowych i tłuszczów roślinnych, bez dodatku soli. Zakładka „Po poście” przygotuje ten plan za ciebie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A regra prática: faça a realimentação por pelo menos metade da duração do jejum, começando com suco diluído, depois frutas e legumes cozidos no vapor, depois amidos e gorduras vegetais, sem sal adicionado. A aba Realimentação monta esse plano para você."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Простое правило: выход из голодания должен длиться не меньше половины срока голодания. Начинайте с разбавленного сока, затем переходите к фруктам и овощам на пару, затем к крахмалистым продуктам и растительным жирам, без добавления соли. Вкладка «Выход» составит этот план за вас."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Tumregeln: låt uppbyggnaden pågå minst hälften så länge som fastan. Börja med utspädd juice, sedan frukt och ångkokta grönsaker, sedan stärkelse och vegetabiliska fetter, utan tillsatt salt. Fliken Uppbyggnad tar fram den här planen åt dig."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Kanuni ya jumla: rejea kula kwa angalau nusu ya muda wa mfungo, ukianza na juisi iliyochanganywa na maji, kisha matunda na mboga zilizopikwa kwa mvuke, kisha vyakula vya wanga na mafuta ya mimea, bila kuongeza chumvi. Kichupo cha Kula tena kinakuandalia mpango huu."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "หลักง่ายๆ: กลับมากินอาหารเป็นเวลาอย่างน้อยครึ่งหนึ่งของระยะเวลาการอดอาหาร โดยเริ่มจากน้ำผลไม้เจือจาง ตามด้วยผลไม้และผักนึ่ง แล้วจึงเป็นอาหารประเภทแป้งและไขมันจากพืช และงดเติมเกลือ แท็บ “กลับมากิน” จะสร้างแผนนี้ให้คุณ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Temel kural: en az orucun yarısı kadar süre yeniden beslenin; önce seyreltilmiş meyve suyu, ardından meyve ve buharda pişmiş sebzeler, sonra nişastalı yiyecekler ve bitkisel yağlarla ilerleyin, tuz eklemeyin. Beslenme sekmesi bu planı sizin için oluşturur."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nguyên tắc chung: ăn lại trong ít nhất một nửa thời gian nhịn ăn, bắt đầu với nước ép pha loãng, sau đó là trái cây và rau hấp, rồi đến tinh bột và chất béo thực vật, không thêm muối. Thẻ Ăn lại sẽ lập kế hoạch này cho bạn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "经验法则：复食时间至少为断食时长的一半，先从稀释果汁开始，然后是水果和蒸蔬菜，再到淀粉类和植物脂肪，全程不额外加盐。“复食”标签页会为你制定这个计划。"
          }
        }
      }
    },
    "learn.risks.common": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الآثار الخفيفة الشائعة: التعب، والغثيان، وقلة النوم، والصداع، والدوار، والإغماء، وعسر الهضم، وجفاف الفم، وألم أسفل الظهر."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Häufige leichte Beschwerden: Müdigkeit, Übelkeit, schlechter Schlaf, Kopfschmerzen, Schwindel, Ohnmacht, Verdauungsstörungen, Mundtrockenheit und Schmerzen im unteren Rücken."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Common mild effects: tiredness, nausea, poor sleep, headache, dizziness, fainting, indigestion, dry mouth and lower back pain."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Efectos leves frecuentes: cansancio, náuseas, dormir mal, dolor de cabeza, mareo, desmayo, indigestión, boca seca y dolor lumbar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Effets légers fréquents : fatigue, nausées, mauvais sommeil, maux de tête, vertiges, évanouissement, indigestion, bouche sèche et douleurs au bas du dos."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आम हल्के असर: थकान, मतली, खराब नींद, सिरदर्द, चक्कर, बेहोशी, अपच, मुँह सूखना और कमर के निचले हिस्से में दर्द।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Efek ringan yang umum: lelah, mual, sulit tidur, sakit kepala, pusing, pingsan, gangguan pencernaan, mulut kering, dan nyeri punggung bawah."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Effetti lievi comuni: stanchezza, nausea, sonno scarso, mal di testa, capogiri, svenimenti, cattiva digestione, bocca secca e dolore lombare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "よくある軽い症状：疲れ、吐き気、睡眠不良、頭痛、めまい、失神、消化不良、口の渇き、腰痛。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "흔한 경미한 부작용: 피로, 메스꺼움, 수면 질 저하, 두통, 어지럼증, 실신, 소화불량, 입 마름, 허리 통증."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Kesan ringan yang biasa: keletihan, loya, tidur tidak lena, sakit kepala, pening, pengsan, senak perut, mulut kering dan sakit pinggang."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Veelvoorkomende milde effecten: vermoeidheid, misselijkheid, slecht slapen, hoofdpijn, duizeligheid, flauwvallen, spijsverteringsklachten, droge mond en lage rugpijn."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Częste łagodne objawy: zmęczenie, nudności, słaby sen, ból głowy, zawroty głowy, omdlenia, niestrawność, suchość w ustach i ból w dolnej części pleców."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Efeitos leves comuns: cansaço, náusea, sono ruim, dor de cabeça, tontura, desmaio, indigestão, boca seca e dor lombar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Частые лёгкие эффекты: усталость, тошнота, плохой сон, головная боль, головокружение, обмороки, нарушение пищеварения, сухость во рту и боль в пояснице."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Vanliga lindriga effekter: trötthet, illamående, dålig sömn, huvudvärk, yrsel, svimning, matsmältningsbesvär, muntorrhet och smärta i ländryggen."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Madhara madogo ya kawaida: uchovu, kichefuchefu, usingizi duni, maumivu ya kichwa, kizunguzungu, kuzimia, matatizo ya mmeng'enyo wa chakula, mdomo mkavu na maumivu ya mgongo wa chini."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ผลข้างเคียงเล็กน้อยที่พบบ่อย: อ่อนเพลีย คลื่นไส้ นอนหลับไม่ดี ปวดศีรษะ เวียนศีรษะ เป็นลม อาหารไม่ย่อย ปากแห้ง และปวดหลังส่วนล่าง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yaygın hafif etkiler: yorgunluk, bulantı, kötü uyku, baş ağrısı, baş dönmesi, bayılma, hazımsızlık, ağız kuruluğu ve bel ağrısı."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tác dụng nhẹ thường gặp: mệt mỏi, buồn nôn, ngủ kém, đau đầu, chóng mặt, ngất, khó tiêu, khô miệng và đau thắt lưng."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "常见的轻微反应：疲倦、恶心、睡眠差、头痛、头晕、晕厥、消化不良、口干和下背痛。"
          }
        }
      }
    },
    "learn.risks.electrolytes": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الإلكتروليتات: يفقد الجسم نحو 300 mEq من البوتاسيوم خلال أول 7 أيام، حتى عندما تبدو مستوياته في الدم طبيعية (من 3.5 إلى 4.0 mmol/L). ويستقر الرقم الهيدروجيني للدم عند نحو 7.32 إلى 7.36 مع استهلاك البيكربونات."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Elektrolyte: Der Körper verliert in den ersten 7 Tagen etwa 300 mEq Kalium, selbst wenn die Blutwerte normal aussehen (3,5 bis 4,0 mmol/L). Der Blut-pH pendelt sich bei etwa 7,32 bis 7,36 ein, da Bicarbonat verbraucht wird."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Electrolytes: the body loses about 300 mEq of potassium over the first 7 days, even while blood levels look normal (3.5 to 4.0 mmol/L). Blood pH settles around 7.32 to 7.36 as bicarbonate is used up."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Electrolitos: el cuerpo pierde unos 300 mEq de potasio durante los primeros 7 días, incluso cuando los niveles en sangre parecen normales (3,5 a 4,0 mmol/L). El pH de la sangre se estabiliza en torno a 7,32 a 7,36 a medida que se agota el bicarbonato."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Électrolytes : le corps perd environ 300 mEq de potassium au cours des 7 premiers jours, même quand les taux sanguins semblent normaux (3,5 à 4,0 mmol/L). Le pH sanguin se stabilise autour de 7,32 à 7,36 à mesure que les bicarbonates sont consommés."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इलेक्ट्रोलाइट: पहले 7 दिनों में शरीर लगभग 300 mEq पोटैशियम खो देता है, भले ही खून में इसका स्तर सामान्य दिखे (3.5 से 4.0 mmol/L)। बाइकार्बोनेट खर्च होने के साथ खून का pH लगभग 7.32 से 7.36 पर आ जाता है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Elektrolit: tubuh kehilangan sekitar 300 mEq kalium selama 7 hari pertama, bahkan ketika kadarnya dalam darah tampak normal (3,5 sampai 4,0 mmol/L). pH darah stabil di sekitar 7,32 sampai 7,36 seiring bikarbonat terpakai."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Elettroliti: il corpo perde circa 300 mEq di potassio nei primi 7 giorni, anche se i valori nel sangue sembrano normali (da 3,5 a 4,0 mmol/L). Il pH del sangue si stabilizza intorno a 7,32-7,36 man mano che il bicarbonato si consuma."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "電解質：血中濃度が正常（3.5〜4.0 mmol/L）に見えていても、体は最初の7日間で約300 mEqのカリウムを失います。重炭酸が消費されるにつれて、血液のpHは7.32〜7.36程度で落ち着きます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "전해질: 혈중 수치가 정상(3.5~4.0 mmol/L)으로 보여도 처음 7일 동안 몸은 약 300 mEq의 칼륨을 잃어요. 중탄산염이 소모되면서 혈액 pH는 약 7.32~7.36에서 안정돼요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Elektrolit: badan kehilangan kira-kira 300 mEq kalium dalam 7 hari pertama, walaupun paras dalam darah kelihatan normal (3.5 hingga 4.0 mmol/L). pH darah menetap sekitar 7.32 hingga 7.36 apabila bikarbonat digunakan."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Elektrolyten: het lichaam verliest in de eerste 7 dagen ongeveer 300 mEq kalium, zelfs als de bloedwaarden normaal lijken (3,5 tot 4,0 mmol/L). De pH van het bloed stabiliseert rond 7,32 tot 7,36 doordat bicarbonaat opraakt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Elektrolity: w ciągu pierwszych 7 dni organizm traci około 300 mEq potasu, nawet gdy jego stężenie we krwi wygląda prawidłowo (od 3,5 do 4,0 mmol/L). pH krwi stabilizuje się na poziomie około 7,32–7,36 w miarę zużywania wodorowęglanów."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Eletrólitos: o corpo perde cerca de 300 mEq de potássio nos primeiros 7 dias, mesmo com os níveis no sangue parecendo normais (3,5 a 4,0 mmol/L). O pH do sangue se estabiliza em torno de 7,32 a 7,36 à medida que o bicarbonato é consumido."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Электролиты: за первые 7 дней организм теряет около 300 мЭкв калия, даже если уровень в крови выглядит нормальным (3,5–4,0 ммоль/л). pH крови устанавливается около 7,32–7,36 по мере расходования бикарбоната."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Elektrolyter: kroppen förlorar cirka 300 mEq kalium under de första 7 dagarna, även när blodvärdena ser normala ut (3,5 till 4,0 mmol/L). Blodets pH stabiliseras runt 7,32 till 7,36 när bikarbonatet förbrukas."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Elektroliti: mwili hupoteza takriban 300 mEq za potasiamu katika siku 7 za kwanza, hata wakati viwango vya damu vinaonekana kawaida (3.5 hadi 4.0 mmol/L). pH ya damu hutulia karibu 7.32 hadi 7.36 kadiri bikaboneti inavyotumika."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เกลือแร่: ร่างกายสูญเสียโพแทสเซียมประมาณ 300 mEq ในช่วง 7 วันแรก แม้ระดับในเลือดจะดูปกติ (3.5 ถึง 4.0 mmol/L) ค่า pH ในเลือดจะคงอยู่ที่ราว 7.32 ถึง 7.36 เมื่อไบคาร์บอเนตถูกใช้ไป"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Elektrolitler: kan düzeyleri normal görünse bile (3,5 ila 4,0 mmol/L) vücut ilk 7 günde yaklaşık 300 mEq potasyum kaybeder. Bikarbonat tükendikçe kan pH'ı 7,32 ila 7,36 civarında dengelenir."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chất điện giải: cơ thể mất khoảng 300 mEq kali trong 7 ngày đầu, ngay cả khi nồng độ trong máu trông bình thường (3,5 đến 4,0 mmol/L). pH máu ổn định quanh mức 7,32 đến 7,36 khi bicarbonat bị tiêu hao."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "电解质：前 7 天身体会流失约 300 mEq 的钾，即使血钾水平看起来正常（3.5 至 4.0 mmol/L）。随着碳酸氢盐被消耗，血液 pH 会稳定在 7.32 至 7.36 左右。"
          }
        }
      }
    },
    "learn.risks.intro": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "صنّفت مراجعة شملت 768 حالة صيام مائي خاضعة لإشراف طبي (من 2 إلى 41 يومًا، والوسيط 7) كل أثر جانبي وفق مقياس CTCAE القياسي."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine Auswertung von 768 medizinisch überwachten Fastenperioden mit reinem Wasser (2 bis 41 Tage, Median 7) hat jede Nebenwirkung auf der standardisierten CTCAE-Skala eingestuft."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A review of 768 medically supervised water fasts (2 to 41 days, median 7) graded every side effect on the standard CTCAE scale."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una revisión de 768 ayunos con agua bajo supervisión médica (de 2 a 41 días, mediana de 7) clasificó cada efecto secundario con la escala estándar CTCAE."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une revue de 768 jeûnes hydriques sous surveillance médicale (2 à 41 jours, médiane de 7) a classé chaque effet secondaire selon l’échelle standard CTCAE."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "चिकित्सकीय निगरानी में हुए 768 पानी वाले उपवासों (2 से 41 दिन, मीडियन 7) की एक समीक्षा में हर दुष्प्रभाव को मानक CTCAE पैमाने पर ग्रेड किया गया।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Sebuah tinjauan terhadap 768 puasa air dengan pengawasan medis (2 sampai 41 hari, median 7) menilai setiap efek samping dengan skala standar CTCAE."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Una revisione di 768 digiuni a sola acqua con supervisione medica (da 2 a 41 giorni, mediana 7) ha classificato ogni effetto collaterale secondo la scala standard CTCAE."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "医療管理下で行われた768件の水断食（2〜41日間、中央値7日）を対象としたレビューでは、すべての副作用を標準的なCTCAE尺度で評価しました。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "의료진 감독하에 진행된 768건의 물 단식(2~41일, 중앙값 7일)을 검토한 연구에서 모든 부작용을 표준 CTCAE 척도로 등급을 매겼어요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Satu ulasan terhadap 768 puasa air di bawah pengawasan perubatan (2 hingga 41 hari, median 7) menggredkan setiap kesan sampingan pada skala CTCAE standard."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een review van 768 vastenperiodes op water onder medisch toezicht (2 tot 41 dagen, mediaan 7) beoordeelde elke bijwerking op de standaard CTCAE-schaal."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przegląd 768 postów wodnych prowadzonych pod nadzorem medycznym (od 2 do 41 dni, mediana 7) sklasyfikował każdy skutek uboczny według standardowej skali CTCAE."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma revisão de 768 jejuns de água com supervisão médica (2 a 41 dias, mediana de 7) classificou cada efeito colateral pela escala padrão CTCAE."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В обзоре 768 голоданий на воде под медицинским наблюдением (от 2 до 41 дня, медиана 7) каждый побочный эффект оценивался по стандартной шкале CTCAE."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "En genomgång av 768 medicinskt övervakade vattenfastor (2 till 41 dagar, median 7) graderade varje biverkning enligt standardskalan CTCAE."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Mapitio ya mifungo 768 ya maji yenye usimamizi wa kitabibu (siku 2 hadi 41, wastani wa kati [median] 7) yalipima kila dhara kwa kipimo rasmi cha CTCAE."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การทบทวนการอดอาหารแบบดื่มน้ำเปล่าภายใต้การดูแลทางการแพทย์ 768 ครั้ง (2 ถึง 41 วัน มัธยฐาน 7 วัน) ได้จัดระดับผลข้างเคียงทุกรายการตามเกณฑ์มาตรฐาน CTCAE"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tıbbi gözetim altında yapılan 768 su orucunu (2 ila 41 gün, ortanca 7) inceleyen bir çalışmada, her yan etki standart CTCAE ölçeğine göre derecelendirildi."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Một tổng quan về 768 đợt nhịn ăn chỉ uống nước có giám sát y tế (2 đến 41 ngày, trung vị 7) đã phân độ mọi tác dụng phụ theo thang CTCAE tiêu chuẩn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "一项综述分析了 768 次有医疗监护的纯水断食（2 至 41 天，中位数 7 天），并按标准 CTCAE 量表对每种副作用进行了分级。"
          }
        }
      }
    },
