            "value": "Imeshindwa kuhifadhi nakala rudufu: %@"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "สำรองข้อมูลไม่ได้: %@"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yedeklenemedi: %@"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không thể sao lưu: %@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法备份：%@"
          }
        }
      }
    },
    "cloud.copy_removed": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أُزيلت نسختك السحابية. تبقى البيانات الموجودة على هذا الـ iPhone. سجّل الخروج ثم سجّل الدخول مجددًا لبدء نسخة احتياطية جديدة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ihre Cloud-Kopie wurde entfernt. Die Daten auf diesem iPhone bleiben erhalten. Melden Sie sich ab und wieder an, um eine neue Sicherung zu starten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your cloud copy was removed. Data on this iPhone stays. Sign out and back in to start a new backup."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se ha eliminado tu copia en la nube. Los datos de este iPhone se conservan. Cierra sesión y vuelve a iniciarla para empezar una nueva copia de seguridad."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre copie dans le cloud a été supprimée. Les données sur cet iPhone sont conservées. Déconnectez-vous puis reconnectez-vous pour lancer une nouvelle sauvegarde."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपकी क्लाउड कॉपी हटा दी गई। इस iPhone पर मौजूद डेटा बना रहता है। नया बैकअप शुरू करने के लिए साइन आउट करके दोबारा साइन इन करें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Salinan cloud Anda telah dihapus. Data di iPhone ini tetap ada. Keluar lalu masuk kembali untuk memulai pencadangan baru."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La copia sul cloud è stata rimossa. I dati su questo iPhone restano. Esci e accedi di nuovo per iniziare un nuovo backup."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "クラウド上のコピーが削除されました。このiPhone上のデータは残ります。新しいバックアップを始めるには、サインアウトしてから再度サインインしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "클라우드 사본이 삭제되었어요. 이 iPhone에 있는 데이터는 그대로 남아요. 새 백업을 시작하려면 로그아웃했다가 다시 로그인하세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Salinan awan anda telah dialih keluar. Data pada iPhone ini kekal. Log keluar dan log masuk semula untuk memulakan sandaran baharu."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je cloudkopie is verwijderd. De gegevens op deze iPhone blijven staan. Log uit en weer in om een nieuwe back-up te starten."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Twoja kopia w chmurze została usunięta. Dane na tym iPhonie pozostają. Wyloguj się i zaloguj ponownie, aby utworzyć nową kopię zapasową."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sua cópia na nuvem foi removida. Os dados neste iPhone permanecem. Saia da conta e entre novamente para iniciar um novo backup."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваша облачная копия удалена. Данные на этом iPhone сохранятся. Выйдите и снова войдите, чтобы начать новое резервное копирование."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Din molnkopia togs bort. Data på den här iPhonen finns kvar. Logga ut och in igen för att starta en ny säkerhetskopia."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Nakala yako ya mtandaoni imeondolewa. Data iliyo kwenye iPhone hii inabaki. Toka kisha uingie tena ili kuanzisha nakala rudufu mpya."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "สำเนาบนคลาวด์ของคุณถูกลบแล้ว ข้อมูลบน iPhone เครื่องนี้ยังคงอยู่ ออกจากระบบแล้วลงชื่อเข้าใช้ใหม่เพื่อเริ่มการสำรองข้อมูลใหม่"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Buluttaki kopyanız kaldırıldı. Bu iPhone'daki veriler kalır. Yeni bir yedekleme başlatmak için çıkış yapıp yeniden oturum açın."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bản sao trên đám mây của bạn đã bị xóa. Dữ liệu trên iPhone này vẫn được giữ. Hãy đăng xuất rồi đăng nhập lại để bắt đầu một bản sao lưu mới."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你的云端副本已被移除。这台 iPhone 上的数据会保留。退出登录后重新登录，即可开始新的备份。"
          }
        }
      }
    },
    "cloud.delete.confirm": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هل تريد حذف حسابك في Waterline؟"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ihr Waterline-Konto löschen?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Delete your Waterline account?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Eliminar tu cuenta de Waterline?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Supprimer votre compte Waterline ?"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अपना Waterline खाता हटाएँ?"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Hapus akun Waterline Anda?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Eliminare il tuo account Waterline?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Waterlineのアカウントを削除しますか？"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Waterline 계정을 삭제할까요?"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Padam akaun Waterline anda?"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je Waterline-account verwijderen?"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Usunąć twoje konto Waterline?"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Excluir sua conta do Waterline?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Удалить аккаунт Waterline?"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Vill du radera ditt Waterline-konto?"
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Ungependa kufuta akaunti yako ya Waterline?"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ต้องการลบบัญชี Waterline ของคุณหรือไม่"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Waterline hesabınız silinsin mi?"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Xóa tài khoản Waterline của bạn?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "删除你的 Waterline 账户？"
          }
        }
      }
    },
    "cloud.delete.confirm_with_apple": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لحذف حسابك، أكّد ذلك مع Apple. سيؤدي هذا إلى إزالة نسختك السحابية، وإلغاء وصول Waterline إلى معرّف Apple الخاص بك، وحذف الحساب. تبقى البيانات الموجودة على هذا الـ iPhone."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bestätigen Sie mit Apple, um Ihr Konto zu löschen. Dadurch wird Ihre Cloud-Kopie entfernt, der Zugriff von Waterline auf Ihre Apple-ID widerrufen und das Konto gelöscht. Die Daten auf diesem iPhone bleiben erhalten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "To delete your account, confirm with Apple. This removes your cloud copy, revokes Waterline's access to your Apple ID and deletes the account. Data on this iPhone stays."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Para eliminar tu cuenta, confirma con Apple. Esto elimina tu copia en la nube, revoca el acceso de Waterline a tu Apple ID y elimina la cuenta. Los datos de este iPhone se conservan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pour supprimer votre compte, confirmez avec Apple. Cela supprime votre copie dans le cloud, révoque l’accès de Waterline à votre identifiant Apple et supprime le compte. Les données sur cet iPhone sont conservées."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अपना खाता हटाने के लिए Apple के साथ पुष्टि करें। इससे आपकी क्लाउड कॉपी हट जाती है, आपके Apple ID तक Waterline की पहुँच वापस ले ली जाती है और खाता हटा दिया जाता है। इस iPhone पर मौजूद डेटा बना रहता है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Untuk menghapus akun Anda, konfirmasikan dengan Apple. Tindakan ini menghapus salinan cloud Anda, mencabut akses Waterline ke Apple ID Anda, dan menghapus akun. Data di iPhone ini tetap ada."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Per eliminare l'account, conferma con Apple. Così rimuovi la copia sul cloud, revochi l'accesso di Waterline al tuo ID Apple ed elimini l'account. I dati su questo iPhone restano."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アカウントを削除するには、Appleで確認してください。クラウド上のコピーが削除され、WaterlineによるApple IDへのアクセスが取り消され、アカウントが削除されます。このiPhone上のデータは残ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "계정을 삭제하려면 Apple에서 확인하세요. 클라우드 사본이 삭제되고, Apple ID에 대한 Waterline의 접근 권한이 해지되며, 계정이 삭제돼요. 이 iPhone에 있는 데이터는 그대로 남아요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Untuk memadam akaun anda, sahkan dengan Apple. Ini akan mengalih keluar salinan awan anda, membatalkan akses Waterline kepada Apple ID anda dan memadam akaun tersebut. Data pada iPhone ini kekal."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bevestig bij Apple om je account te verwijderen. Hiermee wordt je cloudkopie verwijderd, wordt de toegang van Waterline tot je Apple ID ingetrokken en wordt het account verwijderd. De gegevens op deze iPhone blijven staan."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Aby usunąć konto, potwierdź to przez Apple. Spowoduje to usunięcie kopii w chmurze, cofnięcie dostępu Waterline do twojego Apple ID i usunięcie konta. Dane na tym iPhonie pozostaną."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Para excluir sua conta, confirme com a Apple. Isso remove sua cópia na nuvem, revoga o acesso do Waterline ao seu ID Apple e exclui a conta. Os dados neste iPhone permanecem."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Чтобы удалить аккаунт, подтвердите действие через Apple. Это удалит облачную копию, отзовёт доступ Waterline к вашему Apple ID и удалит аккаунт. Данные на этом iPhone сохранятся."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Bekräfta med Apple för att radera ditt konto. Det tar bort din molnkopia, återkallar Waterlines åtkomst till ditt Apple-ID och raderar kontot. Data på den här iPhonen finns kvar."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Ili kufuta akaunti yako, thibitisha kupitia Apple. Hii inaondoa nakala yako ya mtandaoni, inaondoa ruhusa ya Waterline kwa Apple ID yako na kufuta akaunti. Data iliyo kwenye iPhone hii inabaki."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "หากต้องการลบบัญชี โปรดยืนยันกับ Apple ขั้นตอนนี้จะลบสำเนาบนคลาวด์ของคุณ เพิกถอนสิทธิ์การเข้าถึง Apple ID ของคุณจาก Waterline และลบบัญชี ข้อมูลบน iPhone เครื่องนี้ยังคงอยู่"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hesabınızı silmek için Apple ile onaylayın. Bu işlem buluttaki kopyanızı kaldırır, Waterline uygulamasının Apple Kimliğinize erişimini iptal eder ve hesabı siler. Bu iPhone'daki veriler kalır."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Để xóa tài khoản, hãy xác nhận với Apple. Thao tác này xóa bản sao trên đám mây của bạn, thu hồi quyền truy cập của Waterline vào Apple ID của bạn và xóa tài khoản. Dữ liệu trên iPhone này vẫn được giữ."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "要删除账户，请通过 Apple 确认。这将移除你的云端副本，撤销 Waterline 对你 Apple ID 的访问权限，并删除账户。这台 iPhone 上的数据会保留。"
          }
        }
      }
    },
    "cloud.delete.message": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ستؤكد الحذف مع Apple في الخطوة التالية. ستُحذف نسختك السحابية، وتبقى البيانات الموجودة على هذا الـ iPhone."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Als Nächstes bestätigen Sie mit Apple. Ihre Cloud-Kopie wird gelöscht. Die Daten auf diesem iPhone bleiben erhalten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You will confirm with Apple next. Your cloud copy is deleted. Data on this iPhone stays."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "A continuación confirmarás con Apple. Tu copia en la nube se elimina. Los datos de este iPhone se conservan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous confirmerez ensuite avec Apple. Votre copie dans le cloud est supprimée. Les données sur cet iPhone sont conservées."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अगले चरण में Apple के साथ पुष्टि करनी होगी। आपकी क्लाउड कॉपी हटा दी जाती है। इस iPhone पर मौजूद डेटा बना रहता है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Selanjutnya Anda akan mengonfirmasi dengan Apple. Salinan cloud Anda dihapus. Data di iPhone ini tetap ada."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Subito dopo confermerai con Apple. La copia sul cloud viene eliminata. I dati su questo iPhone restano."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "次にAppleで確認します。クラウド上のコピーは削除されます。このiPhone上のデータは残ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이어서 Apple에서 확인하게 돼요. 클라우드 사본은 삭제돼요. 이 iPhone에 있는 데이터는 그대로 남아요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Anda akan mengesahkan dengan Apple selepas ini. Salinan awan anda dipadam. Data pada iPhone ini kekal."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je bevestigt dit hierna bij Apple. Je cloudkopie wordt verwijderd. De gegevens op deze iPhone blijven staan."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "W następnym kroku potwierdzisz to przez Apple. Twoja kopia w chmurze zostanie usunięta. Dane na tym iPhonie pozostaną."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Em seguida, você vai confirmar com a Apple. Sua cópia na nuvem é excluída. Os dados neste iPhone permanecem."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Далее вы подтвердите удаление через Apple. Облачная копия будет удалена. Данные на этом iPhone сохранятся."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "I nästa steg bekräftar du med Apple. Din molnkopia raderas. Data på den här iPhonen finns kvar."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Kisha utathibitisha kupitia Apple. Nakala yako ya mtandaoni itafutwa. Data iliyo kwenye iPhone hii inabaki."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ขั้นต่อไปคุณจะต้องยืนยันกับ Apple สำเนาบนคลาวด์ของคุณจะถูกลบ ข้อมูลบน iPhone เครื่องนี้ยังคงอยู่"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ardından Apple ile onaylayacaksınız. Buluttaki kopyanız silinir. Bu iPhone'daki veriler kalır."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tiếp theo, bạn sẽ xác nhận với Apple. Bản sao trên đám mây của bạn sẽ bị xóa. Dữ liệu trên iPhone này vẫn được giữ."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "接下来你需要通过 Apple 确认。你的云端副本将被删除。这台 iPhone 上的数据会保留。"
          }
        }
      }
    },
    "cloud.delete_account": {
      "extractionState": "manual",
