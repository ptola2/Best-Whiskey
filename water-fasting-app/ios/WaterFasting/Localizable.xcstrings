            "state": "translated",
            "value": "Fasts longer than 72 hours need a clinician supervising."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los ayunos de más de 72 horas necesitan la supervisión de un profesional de la salud."
          }
