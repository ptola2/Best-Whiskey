          "stringUnit": {
            "state": "translated",
            "value": "पानी वाला उपवास घंटे-दर-घंटे क्या करता है"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Apa yang dilakukan puasa air, jam demi jam"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Cosa fa un digiuno a sola acqua, ora per ora"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "水断食で起こること、時間ごとに"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "물 단식이 시간대별로 몸에 일으키는 변화"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Apa yang dilakukan puasa air, jam demi jam"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wat watervasten doet, uur na uur"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Co robi post wodny, godzina po godzinie"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O que um jejum de água faz, hora a hora"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Что происходит при голодании на воде, час за часом"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Vad en vattenfasta gör, timme för timme"
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Mfungo wa maji hufanya nini, saa kwa saa"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การอดอาหารแบบดื่มน้ำเปล่าส่งผลอย่างไร ทีละชั่วโมง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Su orucu saat saat neler yapar"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nhịn ăn chỉ uống nước tác động thế nào, theo từng giờ"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "纯水断食的逐小时变化"
          }
        }
      }
    },
    "tier.high.criteria": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "صيام أكثر من 7 أيام، أو مؤشر كتلة جسم أقل من 16، أو فقدان وزن حديث غير مقصود يتجاوز 10%، أو انخفاض الإلكتروليتات قبل إعادة التغذية."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fasten über 7 Tage, BMI unter 16, kürzlicher ungewollter Gewichtsverlust über 10 % oder niedrige Elektrolyte vor dem Kostaufbau."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Fast over 7 days, BMI under 16, recent unintended weight loss over 10%, or low electrolytes before refeeding."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ayuno de más de 7 días, IMC inferior a 16, pérdida de peso reciente no intencionada de más del 10 % o electrolitos bajos antes de la realimentación."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeûne de plus de 7 jours, IMC inférieur à 16, perte de poids involontaire récente de plus de 10 %, ou électrolytes bas avant la réalimentation."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "7 दिन से लंबा उपवास, BMI 16 से कम, हाल में बिना चाहे 10% से ज़्यादा वज़न घटना, या दोबारा खाने से पहले कम इलेक्ट्रोलाइट।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Puasa lebih dari 7 hari, IMT di bawah 16, penurunan berat badan tanpa disengaja lebih dari 10% baru-baru ini, atau elektrolit rendah sebelum makan kembali."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Digiuno oltre 7 giorni, BMI sotto 16, recente perdita di peso involontaria oltre il 10%, o elettroliti bassi prima della rialimentazione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "7日を超える断食、BMI 16未満、最近の意図しない10%を超える体重減少、または回復食前の電解質の低値。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "7일 넘는 단식, BMI 16 미만, 최근 의도치 않은 10% 넘는 체중 감소, 또는 보식 전 낮은 전해질."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Puasa melebihi 7 hari, BMI bawah 16, penurunan berat badan tanpa sengaja melebihi 10% baru-baru ini, atau elektrolit rendah sebelum pemakanan semula."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vasten langer dan 7 dagen, BMI onder 16, recent onbedoeld gewichtsverlies van meer dan 10%, of lage elektrolyten voor het opbouwen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Post dłuższy niż 7 dni, BMI poniżej 16, niedawna niezamierzona utrata ponad 10% masy ciała lub niski poziom elektrolitów przed powrotem do jedzenia."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Jejum de mais de 7 dias, IMC abaixo de 16, perda de peso recente não intencional de mais de 10% ou eletrólitos baixos antes da realimentação."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Голодание более 7 дней, ИМТ ниже 16, недавняя непреднамеренная потеря веса более 10% или низкий уровень электролитов перед возобновлением питания."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Fasta över 7 dagar, BMI under 16, nylig oavsiktlig viktnedgång på över 10 %, eller låga elektrolyter före uppbyggnaden."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Mfungo wa zaidi ya siku 7, BMI chini ya 16, kupungua uzito bila kukusudia hivi karibuni kwa zaidi ya 10%, au elektroliti za chini kabla ya kurejea kula."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "อดอาหารนานกว่า 7 วัน ดัชนีมวลกายต่ำกว่า 16 น้ำหนักลดลงโดยไม่ตั้งใจเมื่อเร็วๆ นี้มากกว่า 10% หรือเกลือแร่ต่ำก่อนกลับมากินอาหาร"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "7 günden uzun oruç, 16'nın altında VKİ, yakın zamanda %10'un üzerinde istem dışı kilo kaybı veya yeniden beslenmeden önce düşük elektrolitler."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nhịn ăn trên 7 ngày, BMI dưới 16, gần đây sụt hơn 10% cân nặng ngoài ý muốn, hoặc chất điện giải thấp trước khi ăn lại."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "断食超过 7 天、BMI 低于 16、近期非刻意减重超过 10%，或复食前电解质偏低。"
          }
        }
      }
    },
    "tier.high.fluids": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الثيامين (فيتامين B1)، من 100 إلى 300 mg يوميًا حسب الوصفة الطبية. لا ملح مضاف. تعويض الإلكتروليتات حسب الحاجة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Thiamin (Vitamin B1), 100 bis 300 mg pro Tag nach Verordnung. Kein zusätzliches Salz. Elektrolyte werden nach Bedarf ersetzt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Thiamine (vitamin B1), 100 to 300 mg a day as prescribed. No added salt. Electrolytes replaced as needed."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tiamina (vitamina B1), de 100 a 300 mg al día según prescripción. Sin sal añadida. Reposición de electrolitos según sea necesario."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Thiamine (vitamine B1), 100 à 300 mg par jour selon la prescription. Pas de sel ajouté. Électrolytes remplacés selon les besoins."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "थायमिन (विटामिन B1), डॉक्टर के बताए अनुसार 100 से 300 mg प्रतिदिन। ऊपर से नमक नहीं। ज़रूरत के अनुसार इलेक्ट्रोलाइट की पूर्ति।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tiamin (vitamin B1), 100 sampai 300 mg per hari sesuai resep. Tanpa tambahan garam. Elektrolit diganti sesuai kebutuhan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tiamina (vitamina B1), da 100 a 300 mg al giorno come prescritto. Niente sale aggiunto. Elettroliti reintegrati secondo necessità."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "チアミン（ビタミンB1）を処方どおり1日100〜300 mg。塩は加えません。電解質は必要に応じて補充します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "처방에 따라 티아민(비타민 B1) 하루 100~300 mg. 소금 추가 금지. 필요에 따라 전해질 보충."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tiamina (vitamin B1), 100 hingga 300 mg sehari seperti yang dipreskripsikan. Tiada garam tambahan. Elektrolit digantikan mengikut keperluan."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Thiamine (vitamine B1), 100 tot 300 mg per dag zoals voorgeschreven. Geen toegevoegd zout. Elektrolyten aanvullen waar nodig."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tiamina (witamina B1), od 100 do 300 mg dziennie zgodnie z zaleceniem lekarza. Bez dodatku soli. Uzupełnianie elektrolitów w razie potrzeby."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Tiamina (vitamina B1), 100 a 300 mg por dia, conforme prescrição. Sem sal adicionado. Reposição de eletrólitos conforme necessário."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Тиамин (витамин B1), 100–300 мг в день по назначению врача. Без добавления соли. Восполнение электролитов по необходимости."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Tiamin (vitamin B1), 100 till 300 mg per dag enligt ordination. Inget tillsatt salt. Elektrolyter ersätts vid behov."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Thiamini (vitamini B1), 100 hadi 300 mg kwa siku kama ilivyoagizwa. Usiongeze chumvi. Elektroliti zirudishwe inavyohitajika."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไทอามีน (วิตามินบี 1) 100 ถึง 300 mg ต่อวันตามที่แพทย์สั่ง งดเติมเกลือ ทดแทนเกลือแร่ตามความจำเป็น"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Reçeteye göre günde 100 ila 300 mg tiamin (B1 vitamini). Tuz eklemeyin. Elektrolitler gerektiğinde yerine konur."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thiamin (vitamin B1), 100 đến 300 mg mỗi ngày theo đơn. Không thêm muối. Bù chất điện giải khi cần."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "硫胺素（维生素 B1），按处方每天 100 至 300 mg。不额外加盐。按需补充电解质。"
          }
        }
      }
    },
