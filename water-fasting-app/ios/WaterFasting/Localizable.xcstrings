          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Marskość wątroby z powikłaniami"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Cirrose hepática com complicações"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Цирроз печени с осложнениями"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Levercirros med komplikationer"
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Sirosisi ya ini (ini kusinyaa) yenye matatizo"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ตับแข็งที่มีภาวะแทรกซ้อน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Komplikasyonlu karaciğer sirozu"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Xơ gan có biến chứng"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "肝硬化并伴有并发症"
          }
        }
      }
    },
    "screen.liver.why": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يستطيع الكبد تخزين الجليكوجين أو إنتاج الجلوكوز جيدًا، فيبقى سكر الدم منخفضًا بشكل خطير."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Leber kann weder Glykogen speichern noch Glukose gut bilden, sodass der Blutzucker gefährlich niedrig bleibt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The liver cannot store glycogen or make glucose well, so blood sugar stays dangerously low."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El hígado no puede almacenar glucógeno ni producir glucosa bien, así que el azúcar en sangre se mantiene peligrosamente bajo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le foie ne peut pas bien stocker le glycogène ni fabriquer du glucose, donc la glycémie reste dangereusement basse."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "लिवर ठीक से ग्लाइकोजन जमा नहीं कर पाता या ग्लूकोज़ नहीं बना पाता, इसलिए ब्लड शुगर खतरनाक रूप से कम बनी रहती है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Hati tidak dapat menyimpan glikogen atau membuat glukosa dengan baik, sehingga gula darah tetap sangat rendah dan berbahaya."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il fegato non riesce a immagazzinare glicogeno né a produrre glucosio in modo adeguato, quindi la glicemia resta pericolosamente bassa."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "肝臓がグリコーゲンを十分に蓄えたり、ブドウ糖をうまく作ったりできないため、血糖値が危険なほど低いままになります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "간이 글리코겐을 저장하거나 포도당을 제대로 만들지 못해 혈당이 위험할 정도로 낮게 유지돼요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Hati tidak dapat menyimpan glikogen atau menghasilkan glukosa dengan baik, jadi gula darah kekal rendah pada tahap yang berbahaya."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De lever kan glycogeen niet goed opslaan en glucose niet goed aanmaken, waardoor de bloedsuiker gevaarlijk laag blijft."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wątroba nie potrafi dobrze magazynować glikogenu ani wytwarzać glukozy, więc poziom cukru we krwi pozostaje niebezpiecznie niski."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O fígado não consegue armazenar glicogênio nem produzir glicose direito, então o açúcar no sangue fica perigosamente baixo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Печень не может нормально запасать гликоген и вырабатывать глюкозу, поэтому уровень сахара в крови остаётся опасно низким."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Levern kan inte lagra glykogen eller bilda glukos ordentligt, så blodsockret förblir farligt lågt."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Ini haliwezi kuhifadhi glikojeni wala kutengeneza glukosi vizuri, kwa hiyo sukari ya damu hubaki chini kwa kiwango hatari."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ตับไม่สามารถเก็บไกลโคเจนหรือสร้างกลูโคสได้ดี น้ำตาลในเลือดจึงต่ำอย่างอันตราย"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Karaciğer glikojeni iyi depolayamaz ve yeterince glukoz üretemez; bu yüzden kan şekeri tehlikeli derecede düşük kalır."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Gan không thể dự trữ glycogen hoặc tạo glucose tốt, nên đường huyết luôn ở mức thấp nguy hiểm."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "肝脏无法很好地储存糖原或生成葡萄糖，因此血糖会一直处于危险的低水平。"
          }
        }
      }
    },
    "screen.lytes.question": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أُخبرت بأن لديك انخفاضًا في الفوسفات أو البوتاسيوم أو المغنيسيوم"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ihnen wurden niedrige Phosphat-, Kalium- oder Magnesiumwerte mitgeteilt"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Been told you have low phosphate, potassium or magnesium"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Te han dicho que tienes el fosfato, el potasio o el magnesio bajos"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "On vous a signalé un taux bas de phosphate, de potassium ou de magnésium"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कभी बताया गया हो कि आपका फ़ॉस्फ़ेट, पोटैशियम या मैग्नीशियम कम है"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pernah diberi tahu bahwa kadar fosfat, kalium, atau magnesium Anda rendah"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ti è stato detto che hai fosfato, potassio o magnesio bassi"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "リン、カリウム、マグネシウムが低いと言われたことがある"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "인산염, 칼륨 또는 마그네슘이 낮다는 말을 들은 적 있음"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Pernah diberitahu bahawa anda mempunyai fosfat, kalium atau magnesium yang rendah"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Te horen gekregen dat je een laag fosfaat, kalium of magnesium hebt"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Stwierdzony u ciebie niski poziom fosforanów, potasu lub magnezu"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Já disseram que você tem fosfato, potássio ou magnésio baixos"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вам говорили, что у вас низкий уровень фосфата, калия или магния"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Har fått veta att du har lågt fosfat, kalium eller magnesium"
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Umeambiwa una fosfeti, potasiamu au magnesiamu ya chini"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เคยได้รับแจ้งว่ามีฟอสเฟต โพแทสเซียม หรือแมกนีเซียมต่ำ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fosfat, potasyum veya magnezyum düzeyinizin düşük olduğunun size söylenmiş olması"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Từng được cho biết bạn bị thiếu phosphat, kali hoặc magie"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "曾被告知血磷、血钾或血镁偏低"
          }
        }
      }
    },
