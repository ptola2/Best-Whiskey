          "stringUnit": {
            "state": "translated",
            "value": "Your data stays in your account and is removed from this iPhone. Sign in again to get it back."
          }
        }
      }
    },
    "cloud.signed_in": {
      "extractionState": "manual",
      "localizations": {
        "en": {
