    "timeline.subtitle": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مظلّل حسب المرحلة الأيضية، ويغمق لونه مع مرور الوقت"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nach Stoffwechselphase eingefärbt, mit der Zeit dunkler"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Shaded by metabolic phase, deeper over time"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sombreado por fase metabólica, más intenso a medida que avanza"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Coloré par phase métabolique, plus foncé avec le temps"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "मेटाबोलिक चरण के अनुसार रंग, समय के साथ गहरा होता हुआ"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Diberi warna menurut fase metabolik, makin pekat seiring waktu"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Colorata per fase metabolica, più intensa col passare del tempo"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "代謝の段階ごとに色分けし、時間がたつほど濃く表示"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "대사 단계별로 색을 칠했으며, 시간이 지날수록 진해져요"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Berlorek mengikut fasa metabolik, semakin gelap dari semasa ke semasa"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gekleurd per stofwisselingsfase, donkerder naarmate de tijd verstrijkt"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kolory według fazy metabolicznej, coraz ciemniejsze z upływem czasu"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Cores por fase metabólica, mais intensas com o tempo"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Цвет по метаболическим фазам, со временем темнее"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Skuggad efter metabol fas, mörkare med tiden"
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Rangi kulingana na awamu ya kimetaboliki, inakolea kadiri muda unavyoenda"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แรเงาตามระยะเมแทบอลิซึม ยิ่งนานสียิ่งเข้ม"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Metabolik evreye göre renklendirilmiştir, zamanla koyulaşır"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tô màu theo giai đoạn chuyển hóa, đậm dần theo thời gian"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按代谢阶段着色，时间越长颜色越深"
          }
        }
      }
    },
