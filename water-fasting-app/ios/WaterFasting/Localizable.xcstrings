    "stage.fruitVeg.text": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "فواكه كاملة نيئة وخضراوات غير نشوية مطهوة على البخار، في وجبات صغيرة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Rohes ganzes Obst und gedämpftes, nicht stärkehaltiges Gemüse in kleinen Mahlzeiten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Raw whole fruit and steamed non-starchy vegetables, in small meals."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Fruta entera cruda y verduras sin almidón al vapor, en comidas pequeñas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fruits entiers crus et légumes non féculents cuits à la vapeur, en petits repas."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कच्चे साबुत फल और भाप में पकी बिना स्टार्च वाली सब्ज़ियाँ, छोटे-छोटे भोजन में।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Buah utuh mentah dan sayuran kukus yang tidak bertepung, dalam porsi kecil."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Frutta intera cruda e verdure non amidacee al vapore, in piccoli pasti."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "生の丸ごとの果物と、でんぷん質の少ない蒸し野菜を、少量ずつの食事で。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "생 통과일과 전분이 적은 찐 채소를 소량씩 나눠 먹어요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Buah-buahan utuh yang mentah dan sayur-sayuran tidak berkanji yang dikukus, dalam hidangan kecil."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Rauw heel fruit en gestoomde zetmeelarme groente, in kleine maaltijden."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Surowe całe owoce i gotowane na parze warzywa nieskrobiowe, w małych posiłkach."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Frutas inteiras cruas e legumes sem amido cozidos no vapor, em pequenas refeições."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сырые цельные фрукты и некрахмалистые овощи на пару, небольшими порциями."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Rå hel frukt och ångkokta grönsaker som inte är stärkelserika, i små måltider."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Matunda mazima ambayo hayajapikwa na mboga zisizo na wanga zilizopikwa kwa mvuke, katika milo midogo."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ผลไม้สดทั้งผลและผักนึ่งที่ไม่มีแป้ง แบ่งเป็นมื้อเล็กๆ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Küçük öğünler halinde çiğ bütün meyveler ve buharda pişmiş nişastasız sebzeler."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Trái cây sống nguyên quả và rau hấp không chứa tinh bột, chia thành các bữa nhỏ."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "生的完整水果和蒸熟的非淀粉类蔬菜，少量多餐。"
          }
        }
      }
    },
    "stage.fruitVeg.title": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "فواكه كاملة وخضراوات مطهوة على البخار"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ganzes Obst und gedämpftes Gemüse"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Whole fruit and steamed vegetables"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Fruta entera y verduras al vapor"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fruits entiers et légumes vapeur"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "साबुत फल और भाप में पकी सब्ज़ियाँ"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Buah utuh dan sayuran kukus"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Frutta intera e verdure al vapore"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "丸ごとの果物と蒸し野菜"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "통과일과 찐 채소"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Buah-buahan utuh dan sayur-sayuran kukus"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Heel fruit en gestoomde groente"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Całe owoce i warzywa gotowane na parze"
          }
        },
        "pt-BR": {
          "stringUnit": {
