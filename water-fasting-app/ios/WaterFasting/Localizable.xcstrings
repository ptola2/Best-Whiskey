    "phase.2.text": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يحوّل الكبد سيل الأحماض الدهنية إلى كيتونات (الأسيتو أسيتات وبيتا هيدروكسي بيوتيرات، أو BHB). ويجعل انخفاض الإنسولين الكليتين تطرحان الصوديوم، فينخفض ضغط الدم. ويبلغ الفقدان المعتاد خلال أول 3 أيام من 0.9 إلى 1.5 kg يوميًا، ومعظمه ماء وجليكوجين ومحتويات الأمعاء."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Leber wandelt die Flut an Fettsäuren in Ketone um (Acetoacetat und Beta-Hydroxybutyrat, kurz BHB). Niedriges Insulin lässt die Nieren Natrium ausscheiden, sodass der Blutdruck sinkt. Typisch sind in den ersten 3 Tagen 0,9 bis 1,5 kg Verlust pro Tag, vor allem Wasser, Glykogen und Darminhalt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The liver turns the flood of fatty acids into ketones (acetoacetate and beta-hydroxybutyrate, or BHB). Low insulin makes the kidneys shed sodium, so blood pressure drops. Typical loss over the first 3 days is 0.9 to 1.5 kg a day, mostly water, glycogen and gut contents."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El hígado convierte la avalancha de ácidos grasos en cetonas (acetoacetato y beta-hidroxibutirato, o BHB). Con la insulina baja, los riñones eliminan sodio, así que la presión arterial baja. La pérdida habitual durante los 3 primeros días es de 0,9 a 1,5 kg al día, sobre todo agua, glucógeno y contenido intestinal."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le foie transforme l’afflux d’acides gras en cétones (acétoacétate et bêta-hydroxybutyrate, ou BHB). Le faible taux d’insuline pousse les reins à éliminer le sodium, donc la tension artérielle baisse. La perte typique pendant les 3 premiers jours est de 0,9 à 1,5 kg par jour, surtout de l’eau, du glycogène et du contenu intestinal."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "लिवर फ़ैटी एसिड की इस बाढ़ को कीटोन (एसीटोएसीटेट और बीटा-हाइड्रॉक्सीब्यूटिरेट, यानी BHB) में बदलता है। कम इंसुलिन की वजह से गुर्दे सोडियम बाहर निकालते हैं, इसलिए ब्लड प्रेशर गिरता है। पहले 3 दिनों में आमतौर पर 0.9 से 1.5 kg प्रतिदिन वज़न घटता है, ज़्यादातर पानी, ग्लाइकोजन और आँतों में मौजूद सामग्री।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Hati mengubah banjir asam lemak menjadi keton (asetoasetat dan beta-hidroksibutirat, atau BHB). Insulin yang rendah membuat ginjal membuang natrium, sehingga tekanan darah turun. Penurunan yang umum selama 3 hari pertama adalah 0,9 sampai 1,5 kg per hari, sebagian besar air, glikogen, dan isi usus."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il fegato trasforma il flusso di acidi grassi in chetoni (acetoacetato e beta-idrossibutirrato, o BHB). L'insulina bassa fa eliminare sodio ai reni, quindi la pressione scende. La perdita tipica nei primi 3 giorni è di 0,9-1,5 kg al giorno, soprattutto acqua, glicogeno e contenuto intestinale."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "肝臓は大量に流れ込む脂肪酸をケトン体（アセト酢酸とβ-ヒドロキシ酪酸、BHB）に変えます。インスリンが低いと腎臓がナトリウムを排出するため、血圧が下がります。最初の3日間の典型的な減少は1日あたり0.9〜1.5 kgで、主に水分、グリコーゲン、腸の内容物です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "간은 쏟아져 들어오는 지방산을 케톤(아세토아세테이트와 베타하이드록시부티레이트, 즉 BHB)으로 바꿔요. 인슐린이 낮아지면 신장이 나트륨을 배출해 혈압이 떨어져요. 처음 3일 동안의 일반적인 감량은 하루 0.9~1.5 kg이며, 대부분 수분, 글리코겐, 장 내용물이에요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Hati menukar limpahan asid lemak kepada keton (asetoasetat dan beta-hidroksibutirat, atau BHB). Insulin yang rendah menyebabkan buah pinggang membuang natrium, jadi tekanan darah menurun. Penurunan biasa dalam 3 hari pertama ialah 0.9 hingga 1.5 kg sehari, kebanyakannya air, glikogen dan kandungan usus."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De lever zet de stroom vetzuren om in ketonen (acetoacetaat en bèta-hydroxybutyraat, of BHB). Door de lage insuline scheiden de nieren natrium uit, waardoor de bloeddruk daalt. Het gebruikelijke verlies in de eerste 3 dagen is 0,9 tot 1,5 kg per dag, vooral water, glycogeen en darminhoud."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wątroba przekształca napływające kwasy tłuszczowe w ciała ketonowe (acetooctan i beta-hydroksymaślan, czyli BHB). Niski poziom insuliny sprawia, że nerki wydalają sód, więc ciśnienie krwi spada. Typowy ubytek w pierwszych 3 dniach to od 0,9 do 1,5 kg dziennie, głównie woda, glikogen i zawartość jelit."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O fígado transforma a enxurrada de ácidos graxos em cetonas (acetoacetato e beta-hidroxibutirato, ou BHB). A insulina baixa faz os rins eliminarem sódio, e a pressão arterial cai. A perda típica nos primeiros 3 dias é de 0,9 a 1,5 kg por dia, principalmente água, glicogênio e conteúdo intestinal."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Печень превращает поток жирных кислот в кетоны (ацетоацетат и бета-гидроксибутират, или BHB). Низкий уровень инсулина заставляет почки выводить натрий, поэтому давление снижается. Обычная потеря веса в первые 3 дня составляет 0,9–1,5 кг в день, в основном за счёт воды, гликогена и содержимого кишечника."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Levern omvandlar flödet av fettsyror till ketoner (acetoacetat och betahydroxibutyrat, eller BHB). Lågt insulin får njurarna att göra sig av med natrium, så blodtrycket sjunker. Typisk viktnedgång under de första 3 dagarna är 0,9 till 1,5 kg per dag, mest vatten, glykogen och tarminnehåll."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Ini hugeuza wingi wa asidi za mafuta kuwa ketoni (asetoasetati na beta-hidroksibutireti, au BHB). Insulini ya chini hufanya figo zitoe sodiamu, kwa hiyo shinikizo la damu hushuka. Upungufu wa kawaida katika siku 3 za kwanza ni 0.9 hadi 1.5 kg kwa siku, hasa maji, glikojeni na vilivyomo tumboni."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ตับเปลี่ยนกรดไขมันจำนวนมหาศาลให้เป็นคีโตน (อะซิโตอะซิเตตและเบตาไฮดรอกซีบิวทิเรต หรือ BHB) อินซูลินที่ต่ำทำให้ไตขับโซเดียมออก ความดันโลหิตจึงลดลง น้ำหนักที่ลดโดยทั่วไปในช่วง 3 วันแรกคือ 0.9 ถึง 1.5 kg ต่อวัน ส่วนใหญ่เป็นน้ำ ไกลโคเจน และสิ่งที่อยู่ในลำไส้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Karaciğer, yoğun şekilde gelen yağ asitlerini ketonlara (asetoasetat ve beta-hidroksibütirat, yani BHB) dönüştürür. Düşük insülin böbreklerin sodyum atmasına neden olur, bu yüzden kan basıncı düşer. İlk 3 gündeki tipik kayıp günde 0,9 ila 1,5 kg'dır; bunun çoğu su, glikojen ve bağırsak içeriğidir."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Gan chuyển lượng lớn acid béo thành thể ceton (acetoacetat và beta-hydroxybutyrat, hay BHB). Insulin thấp khiến thận thải natri nên huyết áp giảm. Mức giảm thường gặp trong 3 ngày đầu là 0,9 đến 1,5 kg mỗi ngày, chủ yếu là nước, glycogen và chất chứa trong ruột."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "肝脏把大量涌入的脂肪酸转化为酮体（乙酰乙酸和 β-羟丁酸，即 BHB）。胰岛素水平低使肾脏排出钠，因此血压下降。前 3 天通常每天减轻 0.9 至 1.5 kg，主要是水分、糖原和肠道内容物。"
          }
        }
      }
    },
