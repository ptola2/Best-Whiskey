          }
        }
      }
    },
    "tier.moderate.fluids": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا ملح مضاف. احرص على أن يوفر الطعام البوتاسيوم والفوسفور."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kein zusätzliches Salz. Achten Sie darauf, dass die Nahrung Kalium und Phosphor liefert."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No added salt. Make sure food supplies potassium and phosphorus."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sin sal añadida. Asegúrate de que la comida aporte potasio y fósforo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pas de sel ajouté. Veillez à ce que l’alimentation apporte du potassium et du phosphore."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "ऊपर से नमक नहीं। ध्यान रखें कि भोजन से पोटैशियम और फ़ॉस्फ़ोरस मिलें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tanpa tambahan garam. Pastikan makanan menyediakan kalium dan fosfor."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Niente sale aggiunto. Assicurati che il cibo fornisca potassio e fosforo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "塩は加えません。食事からカリウムとリンがとれるようにしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "소금을 넣지 마세요. 음식으로 칼륨과 인을 꼭 섭취하세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tiada garam tambahan. Pastikan makanan membekalkan kalium dan fosforus."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Geen toegevoegd zout. Zorg dat je voeding kalium en fosfor levert."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bez dodatku soli. Zadbaj o to, by jedzenie dostarczało potasu i fosforu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sem sal adicionado. Garanta que a alimentação forneça potássio e fósforo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Без добавления соли. Следите, чтобы пища обеспечивала поступление калия и фосфора."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Inget tillsatt salt. Se till att maten ger kalium och fosfor."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Usiongeze chumvi. Hakikisha chakula kinatoa potasiamu na fosforasi."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
