    "phase.0.text": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يأتي سكر الدم من وجبتك الأخيرة، ثم من الجليكوجين المخزن في الكبد. ويبدأ الإنسولين في الانخفاض."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Blutzucker stammt aus Ihrer letzten Mahlzeit, dann aus dem in der Leber gespeicherten Glykogen. Das Insulin beginnt zu sinken."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Blood sugar comes from your last meal, then from glycogen stored in the liver. Insulin begins to fall."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El azúcar en sangre procede de tu última comida y después del glucógeno almacenado en el hígado. La insulina empieza a bajar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le sucre sanguin provient de votre dernier repas, puis du glycogène stocké dans le foie. L’insuline commence à baisser."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "ब्लड शुगर आपके आखिरी भोजन से आती है, फिर लिवर में जमा ग्लाइकोजन से। इंसुलिन गिरने लगता है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Gula darah berasal dari makanan terakhir Anda, lalu dari glikogen yang tersimpan di hati. Insulin mulai turun."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Lo zucchero nel sangue proviene dall'ultimo pasto, poi dal glicogeno immagazzinato nel fegato. L'insulina inizia a scendere."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "血糖は最後の食事から、その後は肝臓に蓄えられたグリコーゲンから供給されます。インスリンが下がり始めます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "혈당은 마지막 식사에서, 그다음에는 간에 저장된 글리코겐에서 공급돼요. 인슐린이 떨어지기 시작해요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Gula darah datang daripada hidangan terakhir anda, kemudian daripada glikogen yang disimpan dalam hati. Insulin mula menurun."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je bloedsuiker komt uit je laatste maaltijd, daarna uit glycogeen dat in de lever is opgeslagen. Insuline begint te dalen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Cukier we krwi pochodzi z ostatniego posiłku, a potem z glikogenu zmagazynowanego w wątrobie. Poziom insuliny zaczyna spadać."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O açúcar no sangue vem da sua última refeição e depois do glicogênio armazenado no fígado. A insulina começa a cair."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сахар в крови поступает из последнего приёма пищи, а затем из гликогена, запасённого в печени. Уровень инсулина начинает снижаться."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Blodsockret kommer från din senaste måltid och sedan från glykogen som lagrats i levern. Insulinet börjar sjunka."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Sukari ya damu inatoka kwenye mlo wako wa mwisho, kisha kwenye glikojeni iliyohifadhiwa kwenye ini. Insulini huanza kushuka."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "น้ำตาลในเลือดมาจากอาหารมื้อสุดท้าย จากนั้นมาจากไกลโคเจนที่สะสมในตับ อินซูลินเริ่มลดลง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kan şekeri önce son öğününüzden, ardından karaciğerde depolanan glikojenden gelir. İnsülin düşmeye başlar."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đường huyết đến từ bữa ăn cuối cùng của bạn, sau đó từ glycogen dự trữ trong gan. Insulin bắt đầu giảm."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "血糖先来自你的最后一餐，然后来自肝脏储存的糖原。胰岛素开始下降。"
          }
        }
      }
    },
