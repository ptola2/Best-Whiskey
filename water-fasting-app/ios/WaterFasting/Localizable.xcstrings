        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "1. अपनी लंबाई, वज़न और उम्र जोड़ें"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "1. Tambahkan tinggi badan, berat badan, dan usia Anda"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "1. Aggiungi altezza, peso ed età"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "1. 身長、体重、年齢を入力する"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "1. 키, 체중, 나이 입력하기"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "1. Tambah tinggi, berat badan dan umur anda"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "1. Vul je lengte, gewicht en leeftijd in"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "1. Dodaj wzrost, masę ciała i wiek"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "1. Adicione sua altura, peso e idade"
          }
        },
        "ru": {
