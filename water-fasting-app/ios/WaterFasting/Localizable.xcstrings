    "profile.data.body": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يُحفظ كل شيء في ملف محمي على هذا الـ iPhone. لا يغادر أي شيء الجهاز إلا إذا فعّلت النسخ الاحتياطي السحابي."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alles wird in einer geschützten Datei auf diesem iPhone gespeichert. Nichts verlässt das Gerät, es sei denn, Sie aktivieren die Cloud-Sicherung."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Everything is saved in a protected file on this iPhone. Nothing leaves the device unless you switch on cloud backup."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todo se guarda en un archivo protegido en este iPhone. Nada sale del dispositivo a menos que actives la copia de seguridad en la nube."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tout est enregistré dans un fichier protégé sur cet iPhone. Rien ne quitte l’appareil, sauf si vous activez la sauvegarde dans le cloud."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सब कुछ इस iPhone पर एक सुरक्षित फ़ाइल में सेव होता है। क्लाउड बैकअप चालू किए बिना कुछ भी डिवाइस से बाहर नहीं जाता।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Semua data disimpan dalam berkas yang dilindungi di iPhone ini. Tidak ada yang keluar dari perangkat kecuali Anda mengaktifkan pencadangan cloud."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tutto viene salvato in un file protetto su questo iPhone. Nulla lascia il dispositivo a meno che tu non attivi il backup sul cloud."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "すべてのデータはこのiPhone上の保護されたファイルに保存されます。クラウドバックアップを有効にしない限り、データがデバイスの外に出ることはありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "모든 데이터는 이 iPhone의 보호된 파일에 저장돼요. 클라우드 백업을 켜지 않는 한 기기 밖으로 나가지 않아요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Semuanya disimpan dalam fail yang dilindungi pada iPhone ini. Tiada apa-apa yang keluar daripada peranti ini melainkan anda menghidupkan sandaran awan."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Alles wordt bewaard in een beveiligd bestand op deze iPhone. Er verlaat niets het apparaat, tenzij je de cloudback-up inschakelt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wszystko jest zapisywane w chronionym pliku na tym iPhonie. Nic nie opuszcza urządzenia, chyba że włączysz kopię zapasową w chmurze."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Tudo fica salvo em um arquivo protegido neste iPhone. Nada sai do aparelho, a menos que você ative o backup na nuvem."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Всё хранится в защищённом файле на этом iPhone. Ничего не покидает устройство, если вы не включите резервное копирование в облако."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Allt sparas i en skyddad fil på den här iPhonen. Ingenting lämnar enheten om du inte aktiverar säkerhetskopiering i molnet."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Kila kitu kinahifadhiwa katika faili lililolindwa kwenye iPhone hii. Hakuna kinachotoka kwenye kifaa isipokuwa ukiwasha nakala rudufu mtandaoni."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ทุกอย่างบันทึกอยู่ในไฟล์ที่ได้รับการปกป้องบน iPhone เครื่องนี้ ไม่มีข้อมูลใดออกจากอุปกรณ์ เว้นแต่คุณจะเปิดการสำรองข้อมูลบนคลาวด์"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Her şey bu iPhone'da korumalı bir dosyada saklanır. Bulut yedeklemeyi açmadığınız sürece hiçbir veri cihazdan çıkmaz."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mọi thứ được lưu trong một tệp được bảo vệ trên iPhone này. Không có gì rời khỏi thiết bị trừ khi bạn bật sao lưu đám mây."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "所有内容都保存在这台 iPhone 上的受保护文件中。除非你开启云备份，否则任何数据都不会离开设备。"
          }
        }
      }
    },
