    "complication.acid.signs": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تنفس سريع وعميق، غثيان، تعب شديد"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schnelle, tiefe Atmung, Übelkeit, extreme Müdigkeit"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Fast, deep breathing, nausea, extreme tiredness"
          }
        },
        "es": {
