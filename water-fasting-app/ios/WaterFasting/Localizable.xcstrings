    "setup.step1": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "1. أضف طولك ووزنك وعمرك"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "1. Größe, Gewicht und Alter eintragen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "1. Add your height, weight and age"
