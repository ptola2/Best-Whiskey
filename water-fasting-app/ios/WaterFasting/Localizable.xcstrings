            "state": "translated",
            "value": "Dinlenmeyi planlayın"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lên kế hoạch nghỉ ngơi"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "计划好休息"
          }
        }
      }
    },
    "before.subtitle": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ما تطلبه العيادات الخاضعة للإشراف ممن يبدؤون الصيام."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Was Kliniken mit medizinischer Aufsicht von Menschen verlangen, die ein Fasten beginnen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What supervised clinics ask of people starting a fast."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Lo que las clínicas supervisadas piden a quienes empiezan un ayuno."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce que les cliniques avec suivi médical demandent aux personnes qui commencent un jeûne."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "निगरानी वाले क्लिनिक उपवास शुरू करने वालों से क्या करवाते हैं।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Hal yang diminta klinik dengan pengawasan dari orang yang akan memulai puasa."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Cosa chiedono le cliniche specializzate a chi inizia un digiuno."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "医療管理下のクリニックが、断食を始める人に求めていること。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "의료진 감독 클리닉에서 단식을 시작하는 사람에게 요구하는 사항이에요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Perkara yang diminta oleh klinik berpengawasan daripada mereka yang memulakan puasa."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wat klinieken met toezicht vragen van mensen die gaan vasten."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Czego nadzorowane kliniki wymagają od osób rozpoczynających post."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O que as clínicas com supervisão pedem a quem vai começar um jejum."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Что клиники с медицинским наблюдением требуют от тех, кто начинает голодание."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Det här kräver kliniker med övervakning av den som ska börja fasta."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Kile ambacho kliniki zinazosimamia mifungo huwataka watu wanaoanza mfungo wafanye."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "สิ่งที่คลินิกที่มีการดูแลทางการแพทย์ขอให้ผู้ที่จะเริ่มอดอาหารปฏิบัติ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gözetimli kliniklerin oruca başlayan kişilerden istedikleri."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Những điều các phòng khám có giám sát yêu cầu ở người bắt đầu nhịn ăn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "有医疗监护的诊所对开始断食的人提出的要求。"
          }
        }
      }
    },
