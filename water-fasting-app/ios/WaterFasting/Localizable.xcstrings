    "profile.summary.clear": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا مؤشرات خطر في إجاباتك"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Keine Alarmzeichen in Ihren Antworten"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No red flags in your answers"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ninguna señal de alarma en tus respuestas"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucun signal d’alarme dans vos réponses"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपके जवाबों में कोई खतरे का संकेत नहीं"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tidak ada tanda bahaya dalam jawaban Anda"
          }
        },
        "it": {
          "stringUnit": {
