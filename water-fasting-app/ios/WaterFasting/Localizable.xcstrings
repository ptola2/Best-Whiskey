    "learn.autophagy": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Autophagy: once mTORC1 switches off, cells start breaking down and recycling damaged proteins and mitochondria. Fasting also raises spermidine, which keeps this recycling going."
          }
        }
      }
    },
    "learn.benefits_fade": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The benefits fade: 3 to 4 months later, blood pressure, glucose and blood fats are usually back near where they started unless eating habits change for good. A fast works as a short reset, not a cure."
          }
        }
      }
    },
    "learn.bp_why": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Why blood pressure falls: low insulin makes the kidneys shed sodium and water. After 48 to 72 hours the nervous system calms (less sympathetic, more parasympathetic tone). BHB also relaxes artery walls through nitric oxide and potassium channels."
          }
        }
      }
    },
    "learn.eyebrow": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The science"
          }
        }
      }
    },
    "learn.hormones.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hormones and signals"
          }
        }
      }
    },
    "learn.intro": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Water-only fasting means no food and no caloric drinks, only plain water. With nothing coming in, the body runs on its own reserves, first glycogen and then fat turned into ketones. These changes can lower blood pressure and improve blood sugar markers. They also stress the kidneys, electrolytes and acid balance, which is why the research on fasts beyond a few days comes from medically supervised clinics."
          }
        }
      }
    },
