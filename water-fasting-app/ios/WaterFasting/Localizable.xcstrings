    "fast.unsupervised.body": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تقصر الأبحاث الصيام الذي يتجاوز 72 ساعة على البيئات الخاضعة لإشراف طبي. أنهِ الصيام الآن، أو أكّد أن طبيبًا معالجًا يشرف عليه."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Forschung beschränkt Fasten über 72 Stunden auf Umgebungen mit medizinischer Aufsicht. Beenden Sie das Fasten jetzt oder bestätigen Sie, dass eine medizinische Fachperson es überwacht."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The research restricts fasts beyond 72 hours to medically supervised settings. End the fast now, or confirm that a clinician is supervising it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La investigación limita los ayunos de más de 72 horas a entornos con supervisión médica. Termina el ayuno ahora o confirma que un profesional de la salud lo está supervisando."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La recherche réserve les jeûnes de plus de 72 heures à un cadre sous surveillance médicale. Arrêtez le jeûne maintenant, ou confirmez qu’un professionnel de santé en assure le suivi."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "शोध 72 घंटे से आगे के उपवास को केवल चिकित्सकीय निगरानी वाली जगहों तक सीमित रखता है। अभी उपवास खत्म करें, या पुष्टि करें कि यह उपवास किसी चिकित्सक की निगरानी में है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Penelitian membatasi puasa lebih dari 72 jam hanya di lingkungan dengan pengawasan medis. Akhiri puasa sekarang, atau konfirmasikan bahwa tenaga medis mengawasinya."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La ricerca limita i digiuni oltre le 72 ore a contesti con supervisione medica. Interrompi ora il digiuno, oppure conferma che un medico lo sta seguendo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "研究では、72時間を超える断食は医療管理下の環境に限定されています。今すぐ断食を終了するか、医療者が管理していることを確認してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "연구에서는 72시간을 넘는 단식을 의료진의 감독이 있는 환경으로 제한해요. 지금 단식을 끝내거나, 의료진이 감독하고 있음을 확인해 주세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Penyelidikan mengehadkan puasa melebihi 72 jam kepada persekitaran di bawah pengawasan perubatan. Tamatkan puasa sekarang, atau sahkan bahawa pengamal perubatan sedang mengawasinya."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het onderzoek beperkt vasten van langer dan 72 uur tot situaties met medisch toezicht. Beëindig het vasten nu, of bevestig dat een zorgverlener er toezicht op houdt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Badania dopuszczają posty dłuższe niż 72 godziny wyłącznie pod nadzorem medycznym. Zakończ post teraz albo potwierdź, że nadzoruje go lekarz."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A pesquisa restringe jejuns de mais de 72 horas a ambientes com supervisão médica. Encerre o jejum agora ou confirme que um profissional de saúde está supervisionando."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Исследования допускают голодание дольше 72 часов только под медицинским наблюдением. Завершите голодание сейчас или подтвердите, что за ним наблюдает врач."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Forskningen begränsar fastor längre än 72 timmar till miljöer med medicinsk övervakning. Avsluta fastan nu, eller bekräfta att vårdpersonal övervakar den."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Tafiti zinaruhusu mifungo inayozidi saa 72 tu katika mazingira yenye usimamizi wa kitabibu. Maliza mfungo sasa, au thibitisha kwamba mtaalamu wa afya anausimamia."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "งานวิจัยจำกัดการอดอาหารที่นานกว่า 72 ชั่วโมงไว้เฉพาะในสถานที่ที่มีการดูแลทางการแพทย์ สิ้นสุดการอดอาหารตอนนี้ หรือยืนยันว่ามีแพทย์ผู้ดูแลกำกับการอดอาหารนี้อยู่"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Araştırmalar, 72 saati aşan oruçları tıbbi gözetim altındaki ortamlarla sınırlar. Orucu şimdi bitirin ya da bir sağlık uzmanının gözetim yaptığını onaylayın."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Các nghiên cứu chỉ cho phép nhịn ăn quá 72 giờ trong môi trường có giám sát y tế. Hãy kết thúc đợt nhịn ăn ngay, hoặc xác nhận rằng có nhân viên y tế đang giám sát."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "相关研究将超过 72 小时的断食限定在有医疗监护的环境中。请现在结束断食，或确认有医生在监护。"
          }
        }
      }
    },
