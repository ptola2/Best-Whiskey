    "refeed.planner.prefilled": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مُعبّأ مسبقًا بهدفك الحالي. عند إنهاء الصيام، تبدأ هذه الخطة تلقائيًا."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mit Ihrem aktuellen Ziel vorausgefüllt. Wenn Sie das Fasten beenden, startet dieser Plan automatisch."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Prefilled with your current target. When you end the fast, this plan starts automatically."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ya incluye tu objetivo actual. Cuando termines el ayuno, este plan se iniciará automáticamente."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Prérempli avec votre objectif actuel. Quand vous terminerez le jeûne, ce plan démarrera automatiquement."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपके मौजूदा लक्ष्य से पहले से भरा गया है। उपवास खत्म करने पर यह योजना अपने आप शुरू हो जाएगी।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Sudah diisi dengan target Anda saat ini. Saat Anda mengakhiri puasa, rencana ini dimulai secara otomatis."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Precompilato con il tuo obiettivo attuale. Quando termini il digiuno, questo piano parte automaticamente."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "現在の目標があらかじめ入力されています。断食を終了すると、このプランが自動的に始まります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "현재 목표가 미리 입력되어 있어요. 단식을 종료하면 이 계획이 자동으로 시작돼요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Diisi terlebih dahulu dengan sasaran semasa anda. Apabila anda menamatkan puasa, pelan ini bermula secara automatik."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vooraf ingevuld met je huidige doel. Als je het vasten beëindigt, start dit schema automatisch."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wstępnie wypełniono na podstawie twojego obecnego celu. Gdy zakończysz post, ten plan uruchomi się automatycznie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Preenchido com sua meta atual. Quando você encerrar o jejum, este plano começa automaticamente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Заполнено по вашей текущей цели. Когда вы завершите голодание, этот план начнётся автоматически."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Förifylld med ditt nuvarande mål. När du avslutar fastan startar den här planen automatiskt."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Imejazwa na lengo lako la sasa. Ukimaliza mfungo, mpango huu unaanza wenyewe."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "กรอกไว้ล่วงหน้าตามเป้าหมายปัจจุบันของคุณ เมื่อคุณสิ้นสุดการอดอาหาร แผนนี้จะเริ่มโดยอัตโนมัติ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mevcut hedefinizle önceden dolduruldu. Orucu bitirdiğinizde bu plan otomatik olarak başlar."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đã điền sẵn theo mục tiêu hiện tại của bạn. Khi bạn kết thúc đợt nhịn ăn, kế hoạch này sẽ tự động bắt đầu."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已按你当前的目标预先填写。结束断食时，此计划会自动开始。"
          }
        }
      }
    },
