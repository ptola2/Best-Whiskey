    "notify.unsupervised.body": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تقصر الأبحاث الصيام الذي يتجاوز 72 ساعة على البيئات الخاضعة لإشراف طبي. أنهِ الصيام الآن، أو أكّد في Waterline أن طبيبًا معالجًا يشرف عليه."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Forschung beschränkt Fasten über 72 Stunden auf Umgebungen mit medizinischer Aufsicht. Beenden Sie das Fasten jetzt oder bestätigen Sie in Waterline, dass eine medizinische Fachperson es überwacht."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The research restricts fasts beyond 72 hours to medically supervised settings. End the fast now, or confirm in Waterline that a clinician is supervising."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La investigación limita los ayunos de más de 72 horas a entornos con supervisión médica. Termina el ayuno ahora o confirma en Waterline que un profesional de la salud lo está supervisando."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La recherche réserve les jeûnes de plus de 72 heures à un cadre sous surveillance médicale. Arrêtez le jeûne maintenant, ou confirmez dans Waterline qu’un professionnel de santé assure le suivi."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "शोध 72 घंटे से आगे के उपवास को केवल चिकित्सकीय निगरानी वाली जगहों तक सीमित रखता है। अभी उपवास खत्म करें, या Waterline में पुष्टि करें कि उपवास किसी चिकित्सक की निगरानी में है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Penelitian membatasi puasa lebih dari 72 jam hanya di lingkungan dengan pengawasan medis. Akhiri puasa sekarang, atau konfirmasikan di Waterline bahwa tenaga medis mengawasinya."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La ricerca limita i digiuni oltre le 72 ore a contesti con supervisione medica. Interrompi ora il digiuno, oppure conferma in Waterline che un medico ti sta seguendo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "研究では、72時間を超える断食は医療管理下の環境に限定されています。今すぐ断食を終了するか、医療者が管理していることをWaterlineで確認してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "연구에서는 72시간을 넘는 단식을 의료진의 감독이 있는 환경으로 제한해요. 지금 단식을 끝내거나, 의료진이 감독하고 있다면 Waterline에서 확인해 주세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Penyelidikan mengehadkan puasa melebihi 72 jam kepada persekitaran di bawah pengawasan perubatan. Tamatkan puasa sekarang, atau sahkan dalam Waterline bahawa pengamal perubatan sedang mengawasi."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het onderzoek beperkt vasten van langer dan 72 uur tot situaties met medisch toezicht. Beëindig het vasten nu, of bevestig in Waterline dat een zorgverlener toezicht houdt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Badania dopuszczają posty dłuższe niż 72 godziny wyłącznie pod nadzorem medycznym. Zakończ post teraz albo potwierdź w aplikacji Waterline, że nadzoruje go lekarz."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A pesquisa restringe jejuns de mais de 72 horas a ambientes com supervisão médica. Encerre o jejum agora ou confirme no Waterline que um profissional de saúde está supervisionando."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Исследования допускают голодание дольше 72 часов только под медицинским наблюдением. Завершите голодание сейчас или подтвердите в Waterline, что за вами наблюдает врач."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Forskningen begränsar fastor längre än 72 timmar till miljöer med medicinsk övervakning. Avsluta fastan nu, eller bekräfta i Waterline att vårdpersonal övervakar den."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Tafiti zinaruhusu mifungo inayozidi saa 72 tu katika mazingira yenye usimamizi wa kitabibu. Maliza mfungo sasa, au thibitisha katika Waterline kwamba mtaalamu wa afya anausimamia."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "งานวิจัยจำกัดการอดอาหารที่นานกว่า 72 ชั่วโมงไว้เฉพาะในสถานที่ที่มีการดูแลทางการแพทย์ สิ้นสุดการอดอาหารตอนนี้ หรือยืนยันใน Waterline ว่ามีแพทย์ผู้ดูแลกำกับอยู่"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Araştırmalar, 72 saati aşan oruçları tıbbi gözetim altındaki ortamlarla sınırlar. Orucu şimdi bitirin ya da bir sağlık uzmanının gözetim yaptığını Waterline uygulamasında onaylayın."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Các nghiên cứu chỉ cho phép nhịn ăn quá 72 giờ trong môi trường có giám sát y tế. Hãy kết thúc đợt nhịn ăn ngay, hoặc xác nhận trong Waterline rằng có nhân viên y tế đang giám sát."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "相关研究将超过 72 小时的断食限定在有医疗监护的环境中。请现在结束断食，或在 Waterline 中确认有医生在监护。"
          }
        }
      }
    },
