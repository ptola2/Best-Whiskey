            "value": "Hairuhusiwi kabisa"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ห้ามโดยเด็ดขาด"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kesinlikle uygun değil"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Loại trừ hoàn toàn"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "完全禁止"
          }
        }
      }
    },
    "learn.who.bmi": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مؤشر كتلة الجسم أقل من 18.5. المخزون أقل من أن يتحمل التجويع."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "BMI unter 18,5. Zu wenig Reserven, um dem Hungern standzuhalten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "BMI under 18.5. Too few reserves to withstand starvation."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "IMC inferior a 18,5. Muy pocas reservas para soportar la inanición."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "IMC inférieur à 18,5. Trop peu de réserves pour supporter la privation de nourriture."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "BMI 18.5 से कम। भुखमरी झेलने के लिए बहुत कम भंडार।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "IMT di bawah 18,5. Cadangan terlalu sedikit untuk bertahan dari kelaparan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "BMI sotto 18,5. Riserve troppo scarse per resistere alla privazione di cibo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "BMI 18.5未満。飢餓状態に耐えるだけの蓄えが少なすぎます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "BMI 18.5 미만. 기아 상태를 견딜 비축분이 너무 적어요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "BMI bawah 18.5. Rizab terlalu sedikit untuk menahan kebuluran."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "BMI onder 18,5. Te weinig reserves om uithongering te doorstaan."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "BMI poniżej 18,5. Zbyt małe rezerwy, by znieść głodzenie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "IMC abaixo de 18,5. Reservas insuficientes para suportar a inanição."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "ИМТ ниже 18,5. Слишком мало запасов, чтобы выдержать голодание."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "BMI under 18,5. För små reserver för att klara svält."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "BMI chini ya 18.5. Akiba ni kidogo mno kustahimili njaa kali."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ดัชนีมวลกายต่ำกว่า 18.5 มีพลังงานสำรองน้อยเกินกว่าจะทนต่อภาวะอดอยากได้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "18,5'in altında VKİ. Açlığa dayanmak için rezervler yetersizdir."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "BMI dưới 18,5. Quá ít dự trữ để chịu được tình trạng đói."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "BMI 低于 18.5。储备过少，无法承受饥饿状态。"
          }
        }
      }
    },
    "learn.who.relative": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يحتاج إلى طبيب، وغالبًا إلى رعاية داخل المستشفى"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erfordert ärztliche Betreuung, oft stationär"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Needs a doctor and often inpatient care"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Necesita un médico y, a menudo, hospitalización"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nécessite un médecin et souvent une hospitalisation"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "डॉक्टर ज़रूरी, और अक्सर अस्पताल में भर्ती होकर देखभाल"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Memerlukan dokter dan sering kali rawat inap"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Serve un medico e spesso il ricovero"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "医師の関与が必要で、入院での管理が必要なことも多い"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "의사의 관리가 필요하고, 입원 치료가 필요한 경우가 많아요"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Memerlukan doktor dan selalunya rawatan sebagai pesakit dalam"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vereist een arts en vaak een ziekenhuisopname"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wymaga udziału lekarza, często w warunkach szpitalnych"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Exige um médico e, muitas vezes, internação"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нужен врач, часто в условиях стационара"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Kräver läkare och ofta slutenvård"
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Inahitaji daktari na mara nyingi kulazwa hospitalini"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ต้องมีแพทย์ดูแลและมักต้องนอนโรงพยาบาล"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Doktor ve çoğu zaman hastanede yatarak bakım gerektirir"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cần bác sĩ và thường phải điều trị nội trú"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "需要医生参与，通常还需住院"
          }
        }
      }
    },
