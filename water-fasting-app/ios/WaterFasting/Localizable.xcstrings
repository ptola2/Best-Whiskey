          "stringUnit": {
            "state": "translated",
            "value": "Verblijf in een kliniek, met twee keer per dag controles en labonderzoek"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Stacjonarnie, z kontrolami dwa razy dziennie i badaniami laboratoryjnymi"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Em regime de internação, com avaliações duas vezes ao dia e exames laboratoriais"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Стационар, проверки дважды в день и лабораторные анализы"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "På klinik med boende, med kontroller två gånger om dagen och laboratorieprover"
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Kukaa kituoni, kwa ukaguzi mara mbili kwa siku na vipimo vya maabara"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "พักในสถานพยาบาล ตรวจวันละ 2 ครั้งและตรวจทางห้องปฏิบัติการ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yatılı, günde iki kez kontrol ve laboratuvar testleriyle"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nội trú, kiểm tra hai lần mỗi ngày và làm xét nghiệm"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "住院式，每天检查两次并做化验"
          }
        }
      }
    },
