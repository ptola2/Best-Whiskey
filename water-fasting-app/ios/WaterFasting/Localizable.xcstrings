          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Gần ngất, choáng váng, mạch nhanh khi đứng"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
