    "cloud.intro": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اختياري. سجّل الدخول لنسخ بيانات صيامك احتياطيًا والاحتفاظ بها إذا أعدت تثبيت التطبيق أو غيّرت هاتفك."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Optional. Melden Sie sich an, um Ihre Fastenperioden zu sichern und zu behalten, wenn Sie die App neu installieren oder das Telefon wechseln."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Optional. Sign in to back up your fasts and keep them if you reinstall the app or change phones."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Opcional. Inicia sesión para hacer una copia de seguridad de tus ayunos y conservarlos si reinstalas la app o cambias de teléfono."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Facultatif. Connectez-vous pour sauvegarder vos jeûnes et les conserver si vous réinstallez l’app ou changez de téléphone."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "वैकल्पिक। अपने उपवासों का बैकअप लेने और ऐप दोबारा इंस्टॉल करने या फ़ोन बदलने पर उन्हें सुरक्षित रखने के लिए साइन इन करें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Opsional. Masuk untuk mencadangkan data puasa Anda agar tetap tersimpan jika Anda menginstal ulang aplikasi atau berganti ponsel."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Facoltativo. Accedi per fare il backup dei tuoi digiuni e conservarli se reinstalli l'app o cambi telefono."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "任意です。サインインすると断食の記録をバックアップでき、アプリを再インストールしたり機種変更したりしても記録を残せます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "선택 사항이에요. 로그인하면 단식 기록을 백업하고, 앱을 다시 설치하거나 휴대폰을 바꿔도 기록을 유지할 수 있어요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Pilihan. Log masuk untuk menyandarkan puasa anda dan menyimpannya jika anda memasang semula aplikasi atau menukar telefon."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Optioneel. Log in om een back-up van je vastenperiodes te maken en ze te behouden als je de app opnieuw installeert of een andere telefoon neemt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Opcjonalnie. Zaloguj się, aby tworzyć kopię zapasową postów i zachować je po ponownej instalacji aplikacji lub zmianie telefonu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Opcional. Entre na sua conta para fazer backup dos seus jejuns e mantê-los se você reinstalar o aplicativo ou trocar de celular."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Необязательно. Войдите, чтобы сохранять резервную копию ваших голоданий и не потерять их при переустановке приложения или смене телефона."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Valfritt. Logga in för att säkerhetskopiera dina fastor och behålla dem om du installerar om appen eller byter telefon."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Si lazima. Ingia ili uhifadhi nakala rudufu ya mifungo yako na usiipoteze ukisakinisha programu upya au ukibadilisha simu."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไม่บังคับ ลงชื่อเข้าใช้เพื่อสำรองข้อมูลการอดอาหารของคุณ และเก็บข้อมูลไว้ได้แม้ติดตั้งแอปใหม่หรือเปลี่ยนโทรศัพท์"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İsteğe bağlı. Oruçlarınızı yedeklemek ve uygulamayı yeniden yüklediğinizde ya da telefon değiştirdiğinizde kaybetmemek için oturum açın."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không bắt buộc. Đăng nhập để sao lưu các đợt nhịn ăn và giữ lại chúng nếu bạn cài lại ứng dụng hoặc đổi điện thoại."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "可选。登录后可备份你的断食记录，重装 App 或更换手机后也能保留。"
          }
        }
      }
    },
    "cloud.newer_version": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "حُفظت نسختك السحابية بإصدار أحدث من Waterline. حدّث التطبيق لمواصلة المزامنة. لم يُستبدل أي شيء."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ihre Cloud-Kopie wurde von einer neueren Version von Waterline gespeichert. Aktualisieren Sie die App, um weiter zu synchronisieren. Es wurde nichts überschrieben."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your cloud copy was saved by a newer version of Waterline. Update the app to keep syncing. Nothing was overwritten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu copia en la nube se guardó con una versión más reciente de Waterline. Actualiza la app para seguir sincronizando. No se ha sobrescrito nada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre copie dans le cloud a été enregistrée par une version plus récente de Waterline. Mettez à jour l’app pour continuer la synchronisation. Rien n’a été écrasé."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपकी क्लाउड कॉपी Waterline के नए संस्करण से सेव की गई थी। सिंक जारी रखने के लिए ऐप अपडेट करें। कुछ भी ओवरराइट नहीं हुआ।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Salinan cloud Anda disimpan oleh Waterline versi yang lebih baru. Perbarui aplikasi agar sinkronisasi tetap berjalan. Tidak ada yang tertimpa."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La copia sul cloud è stata salvata da una versione più recente di Waterline. Aggiorna l'app per continuare a sincronizzare. Non è stato sovrascritto nulla."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "クラウド上のコピーは、新しいバージョンのWaterlineで保存されています。同期を続けるにはアプリをアップデートしてください。上書きされたデータはありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "클라우드 사본이 더 최신 버전의 Waterline에서 저장되었어요. 계속 동기화하려면 앱을 업데이트하세요. 덮어쓴 데이터는 없어요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Salinan awan anda telah disimpan oleh versi Waterline yang lebih baharu. Kemas kini aplikasi untuk terus menyegerak. Tiada apa-apa yang ditulis ganti."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je cloudkopie is opgeslagen door een nieuwere versie van Waterline. Werk de app bij om te blijven synchroniseren. Er is niets overschreven."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Twoja kopia w chmurze została zapisana przez nowszą wersję Waterline. Zaktualizuj aplikację, aby dalej synchronizować dane. Nic nie zostało nadpisane."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sua cópia na nuvem foi salva por uma versão mais recente do Waterline. Atualize o aplicativo para continuar sincronizando. Nada foi substituído."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Облачная копия сохранена более новой версией Waterline. Обновите приложение, чтобы продолжить синхронизацию. Ничего не было перезаписано."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Din molnkopia sparades av en nyare version av Waterline. Uppdatera appen för att fortsätta synka. Inget skrevs över."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Nakala yako ya mtandaoni ilihifadhiwa na toleo jipya zaidi la Waterline. Sasisha programu ili kuendelea kusawazisha. Hakuna kilichoandikwa juu yake."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "สำเนาบนคลาวด์ของคุณบันทึกโดย Waterline เวอร์ชันที่ใหม่กว่า อัปเดตแอปเพื่อซิงค์ต่อ ไม่มีข้อมูลใดถูกเขียนทับ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Buluttaki kopyanız, Waterline uygulamasının daha yeni bir sürümüyle kaydedildi. Eşzamanlamaya devam etmek için uygulamayı güncelleyin. Hiçbir şeyin üzerine yazılmadı."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bản sao trên đám mây của bạn được lưu bởi một phiên bản Waterline mới hơn. Hãy cập nhật ứng dụng để tiếp tục đồng bộ. Không có dữ liệu nào bị ghi đè."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你的云端副本由更新版本的 Waterline 保存。请更新 App 以继续同步。没有任何数据被覆盖。"
          }
        }
      }
    },
    "cloud.no_code": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم تُرجع Apple رمز تفويض. حاول مرة أخرى."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple hat keinen Autorisierungscode geliefert. Versuchen Sie es erneut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple did not return an authorization code. Try again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple no devolvió ningún código de autorización. Vuelve a intentarlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple n’a pas renvoyé de code d’autorisation. Réessayez."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple ने ऑथराइज़ेशन कोड नहीं भेजा। फिर से कोशिश करें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple tidak mengembalikan kode otorisasi. Coba lagi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple non ha restituito un codice di autorizzazione. Riprova."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Appleから認証コードが返されませんでした。もう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple에서 인증 코드를 받지 못했어요. 다시 시도하세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple tidak mengembalikan kod kebenaran. Cuba lagi."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple gaf geen autorisatiecode terug. Probeer het opnieuw."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie otrzymano kodu autoryzacji od Apple. Spróbuj ponownie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A Apple não retornou um código de autorização. Tente novamente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "От Apple не получен код авторизации. Повторите попытку."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple returnerade ingen auktoriseringskod. Försök igen."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple haikurudisha msimbo wa idhini. Jaribu tena."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple ไม่ได้ส่งรหัสการอนุญาตกลับมา โปรดลองอีกครั้ง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple bir yetkilendirme kodu döndürmedi. Yeniden deneyin."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple không trả về mã ủy quyền. Hãy thử lại."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple 未返回授权码。请重试。"
          }
        }
      }
    },
    "cloud.no_token": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم تُرجع خدمة «تسجيل الدخول باستخدام Apple» رمزًا مميزًا. حاول مرة أخرى."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„Mit Apple anmelden“ hat kein Token geliefert. Versuchen Sie es erneut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sign in with Apple did not return a token. Try again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El inicio de sesión con Apple no devolvió ningún token. Vuelve a intentarlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "« Se connecter avec Apple » n’a pas renvoyé de jeton. Réessayez."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple से साइन इन करने पर टोकन नहीं मिला। फिर से कोशिश करें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Masuk dengan Apple tidak mengembalikan token. Coba lagi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Accedi con Apple non ha restituito un token. Riprova."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「Appleでサインイン」からトークンが返されませんでした。もう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple로 로그인에서 토큰을 받지 못했어요. 다시 시도하세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Daftar masuk dengan Apple tidak mengembalikan token. Cuba lagi."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Inloggen met Apple gaf geen token terug. Probeer het opnieuw."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Logowanie przez Apple nie zwróciło tokenu. Spróbuj ponownie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O recurso Iniciar sessão com a Apple não retornou um token. Tente novamente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вход с Apple не вернул токен. Повторите попытку."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Logga in med Apple returnerade ingen token. Försök igen."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Kuingia kwa kutumia Apple hakukurudisha tokeni. Jaribu tena."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การลงชื่อเข้าใช้ด้วย Apple ไม่ได้ส่งโทเค็นกลับมา โปรดลองอีกครั้ง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple ile Giriş Yap bir belirteç döndürmedi. Yeniden deneyin."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đăng nhập bằng Apple không trả về mã thông báo. Hãy thử lại."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“通过 Apple 登录”未返回令牌。请重试。"
          }
        }
      }
    },
    "cloud.not_configured": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أضف GoogleService-Info.plist إلى المشروع لتفعيل النسخ الاحتياطي السحابي."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fügen Sie dem Projekt GoogleService-Info.plist hinzu, um die Cloud-Sicherung zu aktivieren."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add GoogleService-Info.plist to the project to switch on cloud backup."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Añade GoogleService-Info.plist al proyecto para activar la copia de seguridad en la nube."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajoutez GoogleService-Info.plist au projet pour activer la sauvegarde dans le cloud."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "क्लाउड बैकअप चालू करने के लिए प्रोजेक्ट में GoogleService-Info.plist जोड़ें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tambahkan GoogleService-Info.plist ke proyek untuk mengaktifkan pencadangan cloud."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Aggiungi GoogleService-Info.plist al progetto per attivare il backup sul cloud."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "クラウドバックアップを有効にするには、プロジェクトにGoogleService-Info.plistを追加してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "클라우드 백업을 켜려면 프로젝트에 GoogleService-Info.plist를 추가하세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tambah GoogleService-Info.plist pada projek untuk menghidupkan sandaran awan."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Voeg GoogleService-Info.plist toe aan het project om de cloudback-up in te schakelen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dodaj plik GoogleService-Info.plist do projektu, aby włączyć kopię zapasową w chmurze."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Adicione o GoogleService-Info.plist ao projeto para ativar o backup na nuvem."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Добавьте GoogleService-Info.plist в проект, чтобы включить резервное копирование в облако."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Lägg till GoogleService-Info.plist i projektet för att aktivera säkerhetskopiering i molnet."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Ongeza GoogleService-Info.plist kwenye mradi ili kuwasha nakala rudufu mtandaoni."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เพิ่ม GoogleService-Info.plist ลงในโปรเจกต์เพื่อเปิดการสำรองข้อมูลบนคลาวด์"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bulut yedeklemeyi açmak için projeye GoogleService-Info.plist dosyasını ekleyin."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thêm GoogleService-Info.plist vào dự án để bật sao lưu đám mây."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将 GoogleService-Info.plist 添加到项目中以开启云备份。"
          }
        }
      }
    },
    "cloud.other_account": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أُزيلت من هذا الـ iPhone بيانات تخص حسابًا آخر."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Daten eines anderen Kontos wurden von diesem iPhone entfernt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Data from a different account was removed from this iPhone."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se han eliminado de este iPhone los datos de otra cuenta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les données d’un autre compte ont été supprimées de cet iPhone."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "किसी दूसरे खाते का डेटा इस iPhone से हटा दिया गया।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Data dari akun lain telah dihapus dari iPhone ini."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I dati di un altro account sono stati rimossi da questo iPhone."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "別のアカウントのデータをこのiPhoneから削除しました。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다른 계정의 데이터가 이 iPhone에서 삭제되었어요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Data daripada akaun lain telah dialih keluar daripada iPhone ini."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gegevens van een ander account zijn van deze iPhone verwijderd."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dane z innego konta zostały usunięte z tego iPhone’a."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os dados de outra conta foram removidos deste iPhone."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Данные другого аккаунта удалены с этого iPhone."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Data från ett annat konto togs bort från den här iPhonen."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Data ya akaunti nyingine imeondolewa kwenye iPhone hii."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ข้อมูลจากบัญชีอื่นถูกลบออกจาก iPhone เครื่องนี้แล้ว"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Farklı bir hesaba ait veriler bu iPhone'dan kaldırıldı."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Dữ liệu từ một tài khoản khác đã bị xóa khỏi iPhone này."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "来自其他账户的数据已从这台 iPhone 上移除。"
          }
        }
      }
    },
