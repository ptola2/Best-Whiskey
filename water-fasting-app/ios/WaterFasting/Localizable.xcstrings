    "duration.prolonged.note": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "من 4 إلى 21 يومًا من الحالة الكيتونية المستمرة. تأتي الأبحاث على الصيام بهذا الطول من عيادات خاضعة للإشراف تُجري فحوصات مرتين يوميًا وتحاليل دم أسبوعية."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "4 bis 21 Tage anhaltende Ketose. Die Forschung zu so langem Fasten stammt aus Kliniken mit medizinischer Aufsicht, mit Kontrollen zweimal täglich und wöchentlichen Blutuntersuchungen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "4 to 21 days of sustained ketosis. Research on fasts this long comes from supervised clinics with twice-daily checks and weekly blood tests."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "De 4 a 21 días de cetosis sostenida. La investigación sobre ayunos tan largos procede de clínicas supervisadas con controles dos veces al día y análisis de sangre semanales."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "4 à 21 jours de cétose soutenue. La recherche sur des jeûnes aussi longs provient de cliniques avec suivi médical, avec des contrôles deux fois par jour et des analyses de sang chaque semaine."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "4 से 21 दिन तक लगातार कीटोसिस। इतने लंबे उपवास पर शोध निगरानी वाले क्लिनिकों से आता है, जहाँ दिन में दो बार जाँच और हर हफ़्ते खून की जाँच होती है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "4 sampai 21 hari ketosis berkelanjutan. Penelitian tentang puasa selama ini berasal dari klinik dengan pengawasan, dengan pemeriksaan dua kali sehari dan tes darah setiap minggu."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Da 4 a 21 giorni di chetosi continua. La ricerca su digiuni così lunghi proviene da cliniche con supervisione medica, con controlli due volte al giorno ed esami del sangue settimanali."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "4〜21日間、ケトーシスが続きます。これほど長い断食に関する研究は、1日2回のチェックと毎週の血液検査を行う医療管理下のクリニックで行われたものです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "4~21일 동안 케토시스가 지속돼요. 이렇게 긴 단식에 관한 연구는 하루 두 번 검진하고 매주 혈액 검사를 하는 의료진 감독 클리닉에서 나온 것이에요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "4 hingga 21 hari ketosis berterusan. Penyelidikan tentang puasa sepanjang ini datang daripada klinik berpengawasan dengan pemeriksaan dua kali sehari dan ujian darah setiap minggu."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "4 tot 21 dagen aanhoudende ketose. Onderzoek naar zo lang vasten komt uit klinieken met toezicht, met twee keer per dag controles en elke week bloedonderzoek."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Od 4 do 21 dni utrzymującej się ketozy. Badania nad tak długimi postami pochodzą z nadzorowanych klinik, w których kontrole odbywają się dwa razy dziennie, a badania krwi raz w tygodniu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "4 a 21 dias de cetose sustentada. A pesquisa sobre jejuns tão longos vem de clínicas com supervisão, avaliações duas vezes ao dia e exames de sangue semanais."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "От 4 до 21 дня устойчивого кетоза. Данные о голоданиях такой длительности получены в клиниках с медицинским наблюдением, где проверки проводятся дважды в день, а анализы крови еженедельно."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "4 till 21 dagar med ihållande ketos. Forskningen på så långa fastor kommer från kliniker med övervakning, med kontroller två gånger om dagen och blodprover varje vecka."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Siku 4 hadi 21 za ketosisi endelevu. Tafiti kuhusu mifungo mirefu kiasi hiki zinatoka kliniki zenye usimamizi, zenye ukaguzi mara mbili kwa siku na vipimo vya damu kila wiki."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ภาวะคีโตซิสต่อเนื่อง 4 ถึง 21 วัน งานวิจัยเกี่ยวกับการอดอาหารนานขนาดนี้มาจากคลินิกที่มีการดูแลทางการแพทย์ ซึ่งตรวจวันละ 2 ครั้งและตรวจเลือดทุกสัปดาห์"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "4 ila 21 gün süren kesintisiz ketozis. Bu uzunluktaki oruçlarla ilgili araştırmalar, günde iki kez kontrol ve haftalık kan tahlili yapan gözetimli kliniklerden gelir."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "4 đến 21 ngày nhiễm ceton liên tục. Nghiên cứu về những đợt nhịn ăn dài như vậy đến từ các phòng khám có giám sát, với việc kiểm tra hai lần mỗi ngày và xét nghiệm máu hằng tuần."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "持续酮症 4 至 21 天。关于这么长时间断食的研究都来自有医疗监护的诊所，那里每天检查两次，每周验血。"
          }
        }
      }
    },
