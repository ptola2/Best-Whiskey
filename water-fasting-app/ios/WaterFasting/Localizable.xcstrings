    "latest.none": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا تسجيلات للحالة بعد. تسجّل العيادات ضغط الدم في وضعيتي الاستلقاء والوقوف، والنبض، والأعراض، مرتين يوميًا."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Noch keine Kontrollen. Kliniken erfassen zweimal täglich Blutdruck im Liegen und im Stehen, Puls und Symptome."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No check-ins yet. Clinics record lying and standing blood pressure, pulse and symptoms twice a day."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aún no hay registros. Las clínicas anotan la presión arterial en posición acostada y de pie, el pulso y los síntomas dos veces al día."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucun bilan pour l’instant. Les cliniques relèvent la tension artérielle en position couchée et debout, le pouls et les symptômes deux fois par jour."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अभी तक कोई चेक-इन नहीं। क्लिनिक दिन में दो बार लेटे हुए और खड़े होकर ब्लड प्रेशर, पल्स और लक्षण दर्ज करते हैं।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Belum ada cek kondisi. Klinik mencatat tekanan darah saat berbaring dan berdiri, denyut nadi, dan gejala dua kali sehari."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ancora nessuna rilevazione. Le cliniche registrano due volte al giorno la pressione da sdraiati e in piedi, le pulsazioni e i sintomi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "まだチェックインがありません。クリニックでは、横になったときと立ったときの血圧、脈拍、症状を1日2回記録します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "아직 체크인이 없어요. 클리닉에서는 하루 두 번 누운 자세와 선 자세의 혈압, 맥박, 증상을 기록해요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Belum ada pemeriksaan. Klinik merekodkan tekanan darah semasa berbaring dan berdiri, nadi dan simptom dua kali sehari."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nog geen check-ins. Klinieken noteren twee keer per dag de bloeddruk liggend en staand, de hartslag en klachten."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Brak kontroli. Kliniki dwa razy dziennie zapisują ciśnienie krwi na leżąco i na stojąco, tętno i objawy."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nenhum registro ainda. As clínicas anotam a pressão arterial deitado e em pé, o pulso e os sintomas duas vezes ao dia."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Проверок пока нет. В клиниках дважды в день записывают давление лёжа и стоя, пульс и симптомы."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Inga incheckningar än. Kliniker registrerar blodtryck liggande och stående, puls och symtom två gånger om dagen."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Bado hakuna ukaguzi. Kliniki hurekodi shinikizo la damu ukiwa umelala na ukiwa umesimama, mapigo ya moyo na dalili mara mbili kwa siku."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ยังไม่มีการเช็กอิน คลินิกจะบันทึกความดันโลหิตขณะนอนและขณะยืน ชีพจร และอาการวันละ 2 ครั้ง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Henüz kontrol yok. Klinikler yatarken ve ayaktayken kan basıncını, nabzı ve belirtileri günde iki kez kaydeder."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chưa có lần ghi nhận nào. Các phòng khám ghi lại huyết áp khi nằm và khi đứng, mạch và triệu chứng hai lần mỗi ngày."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "还没有自查记录。诊所每天会记录两次平躺和站立时的血压、脉搏和症状。"
          }
        }
      }
    },
