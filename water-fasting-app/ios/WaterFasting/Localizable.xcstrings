            "value": "किन्हें पानी वाला उपवास नहीं करना चाहिए"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Siapa yang tidak boleh puasa air"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Chi non dovrebbe fare il digiuno a sola acqua"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "水断食をしてはいけない人"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "물 단식을 하면 안 되는 사람"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Siapa yang tidak patut berpuasa air"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wie niet moet watervasten"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kto nie powinien stosować postu wodnego"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Quem não deve fazer jejum de água"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Кому нельзя голодать на воде"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Vem som inte bör vattenfasta"
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Nani hapaswi kufunga kwa maji"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ใครไม่ควรอดอาหารแบบดื่มน้ำเปล่า"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kimler su orucu yapmamalı"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ai không nên nhịn ăn chỉ uống nước"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "哪些人不应进行纯水断食"
          }
        }
      }
    },
    "learn.sources.note": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الأبحاث مدرجة باللغة التي نُشرت بها."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fachartikel werden in der Sprache aufgeführt, in der sie veröffentlicht wurden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Research papers are listed in the language they were published in."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los artículos de investigación aparecen en el idioma en que se publicaron."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les articles de recherche sont listés dans la langue de leur publication."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "शोध पत्र उसी भाषा में दिए गए हैं जिसमें वे प्रकाशित हुए थे।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Makalah penelitian dicantumkan dalam bahasa aslinya saat diterbitkan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Gli articoli scientifici sono elencati nella lingua in cui sono stati pubblicati."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "研究論文は発表された言語のまま掲載しています。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "연구 논문은 발표된 언어로 표시돼요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Kertas penyelidikan disenaraikan dalam bahasa asal penerbitannya."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Onderzoeksartikelen staan vermeld in de taal waarin ze zijn gepubliceerd."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Prace naukowe są podane w języku, w którym je opublikowano."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os artigos científicos aparecem no idioma em que foram publicados."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Научные статьи приведены на языке, на котором они были опубликованы."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Forskningsartiklar anges på det språk de publicerades på."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Machapisho ya tafiti yameorodheshwa katika lugha yalimochapishwa."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "งานวิจัยแสดงตามภาษาที่ตีพิมพ์"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Araştırma makaleleri yayımlandıkları dilde listelenmiştir."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Các bài nghiên cứu được liệt kê bằng ngôn ngữ mà chúng được công bố."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "研究论文以其发表时所用的语言列出。"
          }
        }
      }
    },
    "learn.stat.any_effect": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ظهر لديهم أثر جانبي واحد على الأقل بحلول اليوم 5، وكان خفيفًا في الغالب"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "hatten bis Tag 5 mindestens eine Nebenwirkung, meist leicht"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "had at least one side effect by day 5, mostly mild"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "tuvo al menos un efecto secundario al llegar al día 5, en su mayoría leve"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "ont eu au moins un effet secondaire au jour 5, le plus souvent léger"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "लोगों को दिन 5 तक कम से कम एक दुष्प्रभाव हुआ, ज़्यादातर हल्का"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "mengalami setidaknya satu efek samping hingga hari ke-5, sebagian besar ringan"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "ha avuto almeno un effetto collaterale entro il giorno 5, per lo più lieve"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "5日目までに少なくとも1つの副作用があった人。ほとんどは軽度"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "5일차까지 적어도 한 가지 부작용 경험, 대부분 경미"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "mengalami sekurang-kurangnya satu kesan sampingan menjelang hari 5, kebanyakannya ringan"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "had tegen dag 5 minstens één bijwerking, meestal mild"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "osób miało co najmniej jeden skutek uboczny do 5. dnia, przeważnie łagodny"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "tiveram pelo menos um efeito colateral até o dia 5, em geral leve"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "столкнулись хотя бы с одним побочным эффектом к 5-му дню, в основном лёгким"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "hade minst en biverkning senast dag 5, oftast lindrig"
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "walipata angalau dhara moja kufikia siku ya 5, mengi yakiwa madogo"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "มีผลข้างเคียงอย่างน้อยหนึ่งอย่างภายในวันที่ 5 ส่วนใหญ่ไม่รุนแรง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "5. güne kadar en az bir yan etki yaşadı, çoğunlukla hafif"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "gặp ít nhất một tác dụng phụ tính đến ngày 5, phần lớn nhẹ"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "到第 5 天至少出现过一种副作用，大多轻微"
          }
        }
      }
    },
    "learn.stat.early_loss": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "kg يوميًا تُفقد في الأيام من 1 إلى 3، معظمها ماء وجليكوجين"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "kg pro Tag Verlust an Tag 1 bis 3, vor allem Wasser und Glykogen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "kg a day lost over days 1 to 3, mostly water and glycogen"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "kg al día perdidos en los días 1 a 3, sobre todo agua y glucógeno"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "kg par jour perdus du jour 1 au jour 3, surtout de l’eau et du glycogène"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "kg प्रतिदिन कमी, दिन 1 से 3 में, ज़्यादातर पानी और ग्लाइकोजन"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
