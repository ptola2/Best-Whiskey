            "state": "translated",
            "value": "1. Lägg till längd, vikt och ålder"
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "1. Ongeza urefu, uzito na umri wako"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "1. เพิ่มส่วนสูง น้ำหนัก และอายุของคุณ"
          }
        },
        "tr": {
          "stringUnit": {
