    "cloud.wipe_failed": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذّر حذف نسختك السحابية (%@). لم يُحذف أي شيء. تحقق من اتصالك وحاول مرة أخرى."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ihre Cloud-Kopie konnte nicht gelöscht werden (%@). Es wurde nichts gelöscht. Prüfen Sie Ihre Verbindung und versuchen Sie es erneut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Could not delete your cloud copy (%@). Nothing was deleted. Check your connection and try again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo eliminar tu copia en la nube (%@). No se ha eliminado nada. Comprueba tu conexión y vuelve a intentarlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de supprimer votre copie dans le cloud (%@). Rien n’a été supprimé. Vérifiez votre connexion et réessayez."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपकी क्लाउड कॉपी नहीं हटाई जा सकी (%@)। कुछ भी नहीं हटाया गया। अपना कनेक्शन जाँचें और फिर से कोशिश करें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tidak dapat menghapus salinan cloud Anda (%@). Tidak ada yang dihapus. Periksa koneksi Anda dan coba lagi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile eliminare la copia sul cloud (%@). Non è stato eliminato nulla. Controlla la connessione e riprova."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "クラウド上のコピーを削除できませんでした（%@）。何も削除されていません。接続を確認して、もう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "클라우드 사본을 삭제하지 못했어요(%@). 아무것도 삭제되지 않았어요. 연결 상태를 확인하고 다시 시도하세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tidak dapat memadam salinan awan anda (%@). Tiada apa-apa yang dipadam. Semak sambungan anda dan cuba lagi."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kan je cloudkopie niet verwijderen (%@). Er is niets verwijderd. Controleer je verbinding en probeer het opnieuw."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie udało się usunąć twojej kopii w chmurze (%@). Nic nie zostało usunięte. Sprawdź połączenie i spróbuj ponownie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível excluir sua cópia na nuvem (%@). Nada foi excluído. Verifique sua conexão e tente novamente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось удалить облачную копию (%@). Ничего не удалено. Проверьте подключение и повторите попытку."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Det gick inte att radera din molnkopia (%@). Inget raderades. Kontrollera anslutningen och försök igen."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Imeshindwa kufuta nakala yako ya mtandaoni (%@). Hakuna kilichofutwa. Angalia muunganisho wako kisha ujaribu tena."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไม่สามารถลบสำเนาบนคลาวด์ของคุณได้ (%@) ไม่มีข้อมูลใดถูกลบ ตรวจสอบการเชื่อมต่อแล้วลองอีกครั้ง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Buluttaki kopyanız silinemedi (%@). Hiçbir şey silinmedi. Bağlantınızı kontrol edip yeniden deneyin."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không thể xóa bản sao trên đám mây của bạn (%@). Chưa có gì bị xóa. Hãy kiểm tra kết nối và thử lại."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法删除你的云端副本（%@）。没有删除任何内容。请检查网络连接后重试。"
          }
        }
      }
    },
