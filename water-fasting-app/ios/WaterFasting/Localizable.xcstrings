    "fast.end_confirm.message": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سيُعدّ Waterline خطة إعادة التغذية بناءً على مدة صيامك."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Waterline erstellt Ihren Kostaufbauplan anhand der Dauer Ihres Fastens."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Waterline will build your refeeding plan from how long you fasted."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Waterline creará tu plan de realimentación según la duración de tu ayuno."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Waterline établira votre plan de réalimentation en fonction de la durée de votre jeûne."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपने कितने समय तक उपवास किया, उसके आधार पर Waterline दोबारा खाने की आपकी योजना बनाएगा।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Waterline akan menyusun rencana makan kembali Anda berdasarkan lama Anda berpuasa."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Waterline creerà il tuo piano di rialimentazione in base alla durata del digiuno."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Waterlineは、断食した期間をもとに回復食プランを作成します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Waterline이 단식한 기간을 바탕으로 보식 계획을 세워 드려요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Waterline akan menyediakan pelan pemakanan semula anda berdasarkan tempoh anda berpuasa."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Waterline maakt je opbouwschema op basis van hoe lang je hebt gevast."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Waterline przygotuje plan wychodzenia z postu na podstawie czasu trwania twojego postu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Waterline vai montar seu plano de realimentação com base em quanto tempo você ficou em jejum."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Waterline составит план выхода из голодания с учётом его длительности."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Waterline tar fram din uppbyggnadsplan utifrån hur länge du fastade."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Waterline itaandaa mpango wako wa kurejea kula kulingana na muda uliofunga."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "Waterline จะสร้างแผนการกลับมากินอาหารตามระยะเวลาที่คุณอดอาหาร"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Waterline, yeniden beslenme planınızı orucunuzun ne kadar sürdüğüne göre oluşturur."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Waterline sẽ lập kế hoạch ăn lại dựa trên thời gian bạn đã nhịn ăn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Waterline 会根据你的断食时长制定复食计划。"
          }
        }
      }
    },
