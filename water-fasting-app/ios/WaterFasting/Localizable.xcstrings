    "cloud.sign_out.message": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تبقى بياناتك في حسابك وتُزال من هذا الـ iPhone. سجّل الدخول مرة أخرى لاستعادتها."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ihre Daten bleiben in Ihrem Konto und werden von diesem iPhone entfernt. Melden Sie sich erneut an, um sie zurückzuholen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your data stays in your account and is removed from this iPhone. Sign in again to get it back."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tus datos se quedan en tu cuenta y se eliminan de este iPhone. Vuelve a iniciar sesión para recuperarlos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vos données restent dans votre compte et sont supprimées de cet iPhone. Reconnectez-vous pour les récupérer."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपका डेटा आपके खाते में रहता है और इस iPhone से हटा दिया जाता है। इसे वापस पाने के लिए दोबारा साइन इन करें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Data Anda tetap tersimpan di akun Anda dan dihapus dari iPhone ini. Masuk lagi untuk mendapatkannya kembali."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I tuoi dati restano nel tuo account e vengono rimossi da questo iPhone. Accedi di nuovo per recuperarli."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "データはアカウントに残り、このiPhoneからは削除されます。再度サインインすると元に戻せます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "데이터는 계정에 남아 있고 이 iPhone에서는 삭제돼요. 다시 로그인하면 되돌릴 수 있어요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Data anda kekal dalam akaun anda dan dialih keluar daripada iPhone ini. Log masuk semula untuk mendapatkannya kembali."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je gegevens blijven in je account en worden van deze iPhone verwijderd. Log opnieuw in om ze terug te krijgen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Twoje dane pozostaną na koncie i zostaną usunięte z tego iPhone’a. Zaloguj się ponownie, aby je odzyskać."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Seus dados continuam na sua conta e são removidos deste iPhone. Entre novamente para recuperá-los."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваши данные останутся в аккаунте и будут удалены с этого iPhone. Войдите снова, чтобы вернуть их."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Dina data finns kvar på ditt konto och tas bort från den här iPhonen. Logga in igen för att få tillbaka dem."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Data yako inabaki kwenye akaunti yako na inaondolewa kwenye iPhone hii. Ingia tena ili uirudishe."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ข้อมูลของคุณยังคงอยู่ในบัญชีและจะถูกลบออกจาก iPhone เครื่องนี้ ลงชื่อเข้าใช้อีกครั้งเพื่อนำข้อมูลกลับมา"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Verileriniz hesabınızda kalır ve bu iPhone'dan kaldırılır. Geri almak için yeniden oturum açın."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Dữ liệu của bạn vẫn còn trong tài khoản và sẽ bị xóa khỏi iPhone này. Đăng nhập lại để lấy lại dữ liệu."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你的数据会保留在账户中，并从这台 iPhone 上移除。重新登录即可恢复。"
          }
        }
      }
    },
    "cloud.signed_in": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تم تسجيل الدخول. تُنسخ بياناتك احتياطيًا بخصوصية وتُزامَن مع أجهزتك الأخرى."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Angemeldet. Ihre Daten werden privat gesichert und mit Ihren anderen Geräten synchronisiert."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Signed in. Your data backs up privately and syncs to your other devices."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sesión iniciada. Tus datos se respaldan de forma privada y se sincronizan con tus otros dispositivos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Compte connecté. Vos données sont sauvegardées en privé et synchronisées avec vos autres appareils."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आप साइन इन हैं। आपके डेटा का निजी रूप से बैकअप होता है और यह आपके दूसरे डिवाइस पर सिंक होता है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Sudah masuk. Data Anda dicadangkan secara pribadi dan disinkronkan ke perangkat Anda yang lain."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Accesso eseguito. I tuoi dati vengono salvati in modo privato e sincronizzati sugli altri tuoi dispositivi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サインインしています。データは非公開でバックアップされ、ほかのデバイスと同期されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "로그인했어요. 데이터가 비공개로 백업되고 다른 기기와 동기화돼요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Telah log masuk. Data anda disandarkan secara peribadi dan disegerakkan ke peranti anda yang lain."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingelogd. Er wordt privé een back-up van je gegevens gemaakt en ze worden gesynchroniseerd met je andere apparaten."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zalogowano. Kopia zapasowa twoich danych jest tworzona prywatnie i synchronizowana z twoimi innymi urządzeniami."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sessão iniciada. Seus dados ficam em um backup privado e são sincronizados com seus outros dispositivos."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вы вошли. Резервная копия ваших данных хранится конфиденциально и синхронизируется с другими вашими устройствами."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Inloggad. Dina data säkerhetskopieras privat och synkas till dina andra enheter."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Umeingia. Data yako inahifadhiwa kwa faragha na kusawazishwa kwenye vifaa vyako vingine."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ลงชื่อเข้าใช้แล้ว ข้อมูลของคุณจะได้รับการสำรองแบบส่วนตัวและซิงค์กับอุปกรณ์อื่นของคุณ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Oturum açıldı. Verileriniz gizli olarak yedeklenir ve diğer cihazlarınızla eşzamanlanır."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đã đăng nhập. Dữ liệu của bạn được sao lưu riêng tư và đồng bộ sang các thiết bị khác của bạn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已登录。你的数据会以私密方式备份，并同步到你的其他设备。"
          }
        }
      }
    },
