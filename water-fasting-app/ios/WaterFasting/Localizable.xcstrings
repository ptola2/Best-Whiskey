    "kcal.high.headline": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اقتصر على 5 إلى 10 kcal لكل kg يوميًا، وزِد الكمية تدريجيًا تحت رعاية طبية."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Begrenzen Sie die Zufuhr auf 5 bis 10 kcal pro kg und Tag und steigern Sie sie schrittweise, unter medizinischer Betreuung."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Limit to 5 to 10 kcal per kg a day and advance gradually, under medical care."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Limita la ingesta a entre 5 y 10 kcal por kg al día y auméntala de forma gradual, bajo atención médica."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Limitez-vous à 5 à 10 kcal par kg et par jour et augmentez progressivement, sous surveillance médicale."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "5 से 10 kcal प्रति kg प्रतिदिन तक सीमित रखें और चिकित्सकीय देखरेख में धीरे-धीरे बढ़ाएँ।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Batasi hingga 5 sampai 10 kcal per kg per hari dan tingkatkan secara bertahap, di bawah perawatan medis."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Limitati a 5-10 kcal per kg al giorno e aumenta gradualmente, sotto controllo medico."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "1日あたり体重1 kgにつき5〜10 kcalまでに制限し、医療管理のもとで少しずつ増やしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "의료진의 관리하에 하루 kg당 5~10 kcal로 제한하고 서서히 늘려 가세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Hadkan kepada 5 hingga 10 kcal per kg sehari dan tingkatkan secara beransur-ansur, di bawah jagaan perubatan."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Beperk het tot 5 tot 10 kcal per kg per dag en bouw geleidelijk op, onder medische begeleiding."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ogranicz podaż do 5–10 kcal na kg dziennie i zwiększaj ją stopniowo, pod opieką medyczną."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Limite a 5 a 10 kcal por kg por dia e avance gradualmente, com acompanhamento médico."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ограничьтесь 5–10 ккал на кг в день и увеличивайте постепенно, под медицинским наблюдением."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Begränsa till 5 till 10 kcal per kg och dag och öka gradvis, under medicinsk vård."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Weka kikomo cha 5 hadi 10 kcal kwa kila kg kwa siku na uongeze taratibu, chini ya uangalizi wa kitabibu."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "จำกัดไว้ที่ 5 ถึง 10 kcal ต่อ kg ต่อวัน และค่อยๆ เพิ่มขึ้นทีละน้อยภายใต้การดูแลทางการแพทย์"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Günde kg başına 5 ila 10 kcal ile sınırlayın ve tıbbi gözetim altında kademeli olarak artırın."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Giới hạn ở 5 đến 10 kcal mỗi kg mỗi ngày và tăng dần, dưới sự chăm sóc y tế."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "限制在每天每 kg 体重 5 至 10 kcal，并在医疗照护下逐步增加。"
          }
        }
      }
    },
    "kcal.low.basis": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تقدير مبني على نحو %lld kcal يوميًا ليوم يغلب عليه الراحة (Mifflin-St Jeor × 1.2)."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Geschätzt anhand von etwa %lld kcal pro Tag für einen ruhigen Tag (Mifflin-St Jeor x 1,2)."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Estimated from about %lld kcal a day for a restful day (Mifflin-St Jeor x 1.2)."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Estimado a partir de unas %lld kcal al día en un día de reposo (Mifflin-St Jeor x 1,2)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Estimation fondée sur environ %lld kcal par jour pour une journée de repos (Mifflin-St Jeor × 1,2)."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आराम वाले दिन के लिए लगभग %lld kcal प्रतिदिन के आधार पर अनुमानित (Mifflin-St Jeor x 1.2)।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Diperkirakan dari sekitar %lld kcal per hari untuk hari yang santai (Mifflin-St Jeor x 1,2)."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Stima basata su circa %lld kcal al giorno per una giornata di riposo (Mifflin-St Jeor x 1,2)."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "安静に過ごす日の1日あたり約%lld kcalから推定しています（Mifflin-St Jeor x 1.2）。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "휴식하는 날 기준 하루 약 %lld kcal에서 추정했어요(Mifflin-St Jeor x 1.2)."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Dianggarkan daripada kira-kira %lld kcal sehari untuk hari rehat (Mifflin-St Jeor x 1.2)."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Geschat op basis van ongeveer %lld kcal per dag voor een rustige dag (Mifflin-St Jeor x 1,2)."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Oszacowano na podstawie około %lld kcal dziennie w spokojny dzień (Mifflin-St Jeor x 1,2)."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Estimado a partir de cerca de %lld kcal por dia em um dia de repouso (Mifflin-St Jeor x 1,2)."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Расчёт исходит примерно из %lld ккал в день для спокойного дня (Mifflin-St Jeor × 1,2)."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Uppskattat utifrån cirka %lld kcal per dag för en vilodag (Mifflin-St Jeor x 1,2)."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Imekadiriwa kutokana na takriban %lld kcal kwa siku kwa siku ya mapumziko (Mifflin-St Jeor x 1.2)."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ประเมินจากประมาณ %lld kcal ต่อวันสำหรับวันที่พักผ่อนเป็นส่วนใหญ่ (Mifflin-St Jeor x 1.2)"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dinlenerek geçen bir gün için günde yaklaşık %lld kcal üzerinden tahmin edilmiştir (Mifflin-St Jeor x 1,2)."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ước tính từ khoảng %lld kcal mỗi ngày cho một ngày nghỉ ngơi (Mifflin-St Jeor x 1,2)."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "根据静养状态下每天约 %lld kcal 的需求估算（Mifflin-St Jeor x 1.2）。"
          }
        }
      }
    },
    "kcal.low.headline": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ابدأ بما يعادل 50 إلى 70% من احتياجاتك المعتادة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beginnen Sie mit 50 bis 70 % Ihres üblichen Bedarfs."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Start at 50 to 70% of your usual needs."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Empieza con entre el 50 y el 70 % de tus necesidades habituales."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Commencez à 50 à 70 % de vos besoins habituels."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अपनी सामान्य ज़रूरत के 50 से 70% से शुरू करें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Mulailah dari 50 sampai 70% kebutuhan biasa Anda."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Inizia con il 50-70% del tuo fabbisogno abituale."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "普段の必要量の50〜70%から始めてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "평소 필요량의 50~70%로 시작하세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Mulakan pada 50 hingga 70% daripada keperluan biasa anda."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Begin met 50 tot 70% van wat je normaal nodig hebt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zacznij od 50–70% swojego zwykłego zapotrzebowania."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Comece com 50 a 70% das suas necessidades habituais."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Начните с 50–70% вашей обычной потребности."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Börja på 50 till 70 % av ditt vanliga energibehov."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Anza na 50 hadi 70% ya mahitaji yako ya kawaida."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เริ่มที่ 50 ถึง 70% ของความต้องการพลังงานปกติของคุณ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Olağan ihtiyacınızın %50 ila %70'iyle başlayın."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bắt đầu ở mức 50 đến 70% nhu cầu thông thường của bạn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "从平时所需热量的 50% 至 70% 开始。"
          }
        }
      }
    },
    "kcal.low.missing": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أضف الطول والوزن والعمر في الملف الشخصي للحصول على تقدير شخصي."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tragen Sie Größe, Gewicht und Alter im Profil ein, um eine persönliche Schätzung zu erhalten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add height, weight and age in Profile for a personal estimate."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Añade tu altura, peso y edad en Perfil para obtener una estimación personal."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajoutez votre taille, votre poids et votre âge dans Profil pour obtenir une estimation personnalisée."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "व्यक्तिगत अनुमान के लिए प्रोफ़ाइल में लंबाई, वज़न और उम्र जोड़ें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tambahkan tinggi badan, berat badan, dan usia di Profil untuk perkiraan pribadi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Aggiungi altezza, peso ed età nel Profilo per una stima personale."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "個人に合わせた推定値を出すには、プロフィールに身長、体重、年齢を入力してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "개인 맞춤 추정치를 보려면 프로필에 키, 체중, 나이를 입력하세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tambah tinggi, berat badan dan umur dalam Profil untuk anggaran peribadi."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vul je lengte, gewicht en leeftijd in bij Profiel voor een persoonlijke schatting."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dodaj wzrost, masę ciała i wiek w zakładce Profil, aby uzyskać indywidualne oszacowanie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Adicione altura, peso e idade no Perfil para ter uma estimativa personalizada."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Укажите рост, вес и возраст в профиле, чтобы получить персональную оценку."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Lägg till längd, vikt och ålder under Profil för en personlig uppskattning."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Ongeza urefu, uzito na umri katika Wasifu ili upate makadirio yako binafsi."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เพิ่มส่วนสูง น้ำหนัก และอายุในโปรไฟล์ เพื่อรับค่าประมาณเฉพาะตัวของคุณ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kişisel bir tahmin için Profil bölümüne boyunuzu, kilonuzu ve yaşınızı ekleyin."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thêm chiều cao, cân nặng và tuổi trong Hồ sơ để có ước tính riêng cho bạn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在“我的”页面填写身高、体重和年龄，即可获得个人估算。"
          }
        }
      }
    },
    "kcal.moderate.headline": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ابدأ بكمية منخفضة، نحو 10 إلى 20 kcal لكل kg يوميًا (نطاق البدء لدى ASPEN)، ثم زدها تدريجيًا على مدى 4 إلى 7 أيام."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beginnen Sie niedrig, mit etwa 10 bis 20 kcal pro kg und Tag (Startbereich nach ASPEN), und steigern Sie die Menge über 4 bis 7 Tage."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Start low, around 10 to 20 kcal per kg a day (the ASPEN starting range), and build up across 4 to 7 days."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Empieza con poco, unas 10 a 20 kcal por kg al día (el rango inicial de ASPEN), y ve aumentando a lo largo de 4 a 7 días."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Commencez bas, autour de 10 à 20 kcal par kg et par jour (la plage de départ ASPEN), et augmentez sur 4 à 7 jours."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कम से शुरू करें, लगभग 10 से 20 kcal प्रति kg प्रतिदिन (ASPEN की शुरुआती सीमा), और 4 से 7 दिनों में बढ़ाएँ।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Mulailah dari jumlah rendah, sekitar 10 sampai 20 kcal per kg per hari (kisaran awal ASPEN), lalu tingkatkan selama 4 sampai 7 hari."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Inizia con poco, circa da 10 a 20 kcal per kg al giorno (l'intervallo iniziale ASPEN), e aumenta nell'arco di 4-7 giorni."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "少なめに始めてください。1日あたり体重1 kgにつき約10〜20 kcal（ASPENの開始範囲）とし、4〜7日かけて増やしていきます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "하루 kg당 약 10~20 kcal(ASPEN 시작 범위)로 낮게 시작하고, 4~7일에 걸쳐 늘려 가세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Mulakan dengan rendah, sekitar 10 hingga 20 kcal per kg sehari (julat permulaan ASPEN), dan tingkatkan secara beransur-ansur dalam tempoh 4 hingga 7 hari."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Begin laag, rond 10 tot 20 kcal per kg per dag (het startbereik van ASPEN), en bouw op over 4 tot 7 dagen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zacznij nisko, od około 10–20 kcal na kg dziennie (zakres początkowy wg ASPEN), i zwiększaj podaż stopniowo przez 4 do 7 dni."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Comece baixo, com cerca de 10 a 20 kcal por kg por dia (a faixa inicial da ASPEN), e aumente ao longo de 4 a 7 dias."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Начните с малого, около 10–20 ккал на кг в день (стартовый диапазон ASPEN), и постепенно увеличивайте в течение 4–7 дней."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Börja lågt, runt 10 till 20 kcal per kg och dag (ASPEN:s startintervall), och öka under 4 till 7 dagar."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Anza kidogo, karibu 10 hadi 20 kcal kwa kila kg kwa siku (kiwango cha kuanzia cha ASPEN), na uongeze taratibu katika siku 4 hadi 7."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เริ่มต้นที่ระดับต่ำ ประมาณ 10 ถึง 20 kcal ต่อ kg ต่อวัน (ช่วงเริ่มต้นของ ASPEN) แล้วค่อยๆ เพิ่มขึ้นในช่วง 4 ถึง 7 วัน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Düşük başlayın: günde kg başına yaklaşık 10 ila 20 kcal (ASPEN başlangıç aralığı). Ardından 4 ila 7 gün boyunca kademeli olarak artırın."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bắt đầu ở mức thấp, khoảng 10 đến 20 kcal mỗi kg mỗi ngày (mức khởi đầu của ASPEN), rồi tăng dần trong 4 đến 7 ngày."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "从低量开始，约为每天每 kg 体重 10 至 20 kcal（ASPEN 起始范围），并在 4 至 7 天内逐步增加。"
          }
        }
      }
    },
