    "profile.data.delete_message": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سيُحذف ملفك الشخصي وإجاباتك وصيامك الحالي وسجلك نهائيًا، بما في ذلك أي نسخة سحابية."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ihr Profil, Ihre Antworten, das laufende Fasten und der Verlauf werden endgültig gelöscht, einschließlich einer etwaigen Cloud-Kopie."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your profile, answers, current fast and history will be gone for good, including any cloud copy."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu perfil, tus respuestas, el ayuno actual y el historial desaparecerán para siempre, incluida cualquier copia en la nube."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre profil, vos réponses, votre jeûne en cours et votre historique seront définitivement supprimés, y compris toute copie dans le cloud."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपकी प्रोफ़ाइल, जवाब, मौजूदा उपवास और इतिहास हमेशा के लिए मिट जाएँगे, किसी भी क्लाउड कॉपी सहित।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Profil, jawaban, puasa saat ini, dan riwayat Anda akan hilang selamanya, termasuk salinan cloud mana pun."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il tuo profilo, le risposte, il digiuno in corso e lo storico verranno eliminati definitivamente, compresa l'eventuale copia sul cloud."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "プロフィール、回答、現在の断食、履歴が、クラウド上のコピーも含めて完全に削除されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "프로필, 답변, 진행 중인 단식, 기록이 클라우드 사본을 포함해 영구적으로 삭제돼요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Profil, jawapan, puasa semasa dan sejarah anda akan hilang selama-lamanya, termasuk sebarang salinan awan."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je profiel, antwoorden, huidige vasten en geschiedenis zijn dan definitief weg, ook een eventuele cloudkopie."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Twój profil, odpowiedzi, bieżący post i historia zostaną usunięte na zawsze, łącznie z kopią w chmurze."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Seu perfil, suas respostas, o jejum atual e o histórico serão apagados definitivamente, incluindo qualquer cópia na nuvem."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваш профиль, ответы, текущее голодание и история будут удалены навсегда, включая облачную копию."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Din profil, dina svar, din pågående fasta och din historik försvinner för gott, inklusive eventuell molnkopia."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Wasifu wako, majibu, mfungo wa sasa na historia vitafutwa kabisa, pamoja na nakala yoyote ya mtandaoni."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "โปรไฟล์ คำตอบ การอดอาหารปัจจุบัน และประวัติของคุณจะถูกลบอย่างถาวร รวมถึงสำเนาบนคลาวด์ด้วย"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Profiliniz, yanıtlarınız, mevcut orucunuz ve geçmişiniz, buluttaki kopyalar dahil kalıcı olarak silinecek."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hồ sơ, câu trả lời, đợt nhịn ăn hiện tại và lịch sử của bạn sẽ bị xóa vĩnh viễn, kể cả mọi bản sao trên đám mây."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你的个人资料、回答、当前断食和历史记录将被永久删除，包括所有云端副本。"
          }
        }
      }
    },
