        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "174 взрослых с высоким давлением, голодание на воде в среднем 10,5 дня"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "174 vuxna med högt blodtryck, vattenfasta i genomsnitt 10,5 dagar"
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Watu wazima 174 wenye shinikizo la damu la juu, mfungo wa maji wa wastani wa siku 10.5"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ผู้ใหญ่ 174 คนที่มีความดันโลหิตสูง อดอาหารแบบดื่มน้ำเปล่าเฉลี่ย 10.5 วัน"
