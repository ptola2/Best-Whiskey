    "stop.chest": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ألم في الصدر، أو تسارع ضربات القلب أو عدم انتظامها"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Brustschmerzen oder einen rasenden oder unregelmäßigen Herzschlag haben"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "have chest pain, or a racing or irregular heartbeat"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "tienes dolor en el pecho, o latidos acelerados o irregulares"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "douleur thoracique, ou battements cardiaques rapides ou irréguliers"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सीने में दर्द, या दिल की धड़कन तेज़ या अनियमित होना"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "mengalami nyeri dada, atau detak jantung yang cepat atau tidak teratur"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "hai dolore al petto, o battito cardiaco accelerato o irregolare"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "胸の痛み、または脈が速い・不規則"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "가슴 통증이 있거나, 심장이 빠르게 또는 불규칙하게 뛸 때"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "mengalami sakit dada, atau degupan jantung yang laju atau tidak sekata"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "pijn op de borst hebt, of een snelle of onregelmatige hartslag"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "masz ból w klatce piersiowej albo szybkie lub nieregularne bicie serca"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "tiver dor no peito ou batimentos cardíacos acelerados ou irregulares"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "у вас боль в груди, учащённое или неровное сердцебиение"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "har bröstsmärta, eller snabba eller oregelbundna hjärtslag"
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "una maumivu ya kifua, au moyo unadunda kwa kasi au bila mpangilio"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เจ็บหน้าอก หรือหัวใจเต้นเร็วหรือเต้นผิดจังหวะ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Göğüs ağrısı ya da hızlı veya düzensiz kalp atışı"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "bị đau ngực, hoặc tim đập nhanh hay không đều"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "胸痛，或心跳过快、心律不齐"
          }
        }
      }
    },
    "stop.clinics": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تُنهي العيادات الخاضعة للإشراف الصيام أيضًا عند تحقيق هدفه أو عندما تصبح العلامات الحيوية غير مستقرة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kliniken mit medizinischer Aufsicht beenden ein Fasten außerdem, wenn sein Ziel erreicht ist oder die Vitalzeichen instabil werden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Supervised clinics also end a fast when its goal is reached or when vital signs become unstable."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las clínicas supervisadas también terminan el ayuno cuando se alcanza su objetivo o cuando los signos vitales se vuelven inestables."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les cliniques avec suivi médical arrêtent aussi un jeûne quand son objectif est atteint ou quand les signes vitaux deviennent instables."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "निगरानी वाले क्लिनिक लक्ष्य पूरा होने पर या वाइटल साइन अस्थिर होने पर भी उपवास खत्म कर देते हैं।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Klinik dengan pengawasan juga mengakhiri puasa saat tujuannya tercapai atau saat tanda vital menjadi tidak stabil."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le cliniche specializzate interrompono il digiuno anche quando l'obiettivo è raggiunto o quando i parametri vitali diventano instabili."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "医療管理下のクリニックでは、目標に達したときや、バイタルサインが不安定になったときにも断食を終了します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "의료진 감독 클리닉에서도 목표에 도달하거나 활력 징후가 불안정해지면 단식을 끝내요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Klinik berpengawasan juga menamatkan puasa apabila matlamatnya dicapai atau apabila tanda vital menjadi tidak stabil."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Klinieken met toezicht beëindigen een vasten ook als het doel is bereikt of als de vitale functies instabiel worden."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nadzorowane kliniki kończą post także wtedy, gdy zostanie osiągnięty jego cel lub gdy parametry życiowe stają się niestabilne."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Clínicas com supervisão também encerram o jejum quando a meta é atingida ou quando os sinais vitais ficam instáveis."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Клиники с медицинским наблюдением также завершают голодание, когда цель достигнута или когда жизненные показатели становятся нестабильными."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Kliniker med övervakning avslutar också en fasta när målet är nått eller när vitalparametrarna blir instabila."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Kliniki zinazosimamia mifungo pia humaliza mfungo lengo lake linapofikiwa au viashiria muhimu vya mwili (vital signs) vinapokosa utulivu."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คลินิกที่มีการดูแลทางการแพทย์จะสิ้นสุดการอดอาหารเช่นกันเมื่อบรรลุเป้าหมาย หรือเมื่อสัญญาณชีพไม่คงที่"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gözetimli klinikler, hedefe ulaşıldığında veya yaşamsal bulgular dengesizleştiğinde de orucu bitirir."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Các phòng khám có giám sát cũng kết thúc đợt nhịn ăn khi đã đạt mục tiêu hoặc khi các dấu hiệu sinh tồn trở nên không ổn định."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "有医疗监护的诊所也会在达成目标或生命体征变得不稳定时结束断食。"
          }
        }
      }
    },
