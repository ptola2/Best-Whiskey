    "screen.t1d.why": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "في غياب الإنسولين الذي ينتجه جسمك، يؤدي الصيام إلى الحماض الكيتوني السكري إذا أُوقف الإنسولين، أو إلى انخفاض خطير في سكر الدم إذا لم يُوقف."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ohne eigenes Insulin führt ein Fasten zu einer diabetischen Ketoazidose, wenn das Insulin abgesetzt wird, oder zu gefährlich niedrigem Blutzucker, wenn nicht."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Without your own insulin, a fast leads to diabetic ketoacidosis if insulin is stopped, or dangerously low blood sugar if it is not."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sin insulina propia, un ayuno provoca cetoacidosis diabética si se suspende la insulina, o un azúcar en sangre peligrosamente bajo si no se suspende."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sans production propre d’insuline, un jeûne entraîne une acidocétose diabétique si l’insuline est arrêtée, ou une glycémie dangereusement basse si elle ne l’est pas."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अपना इंसुलिन न बनने पर, उपवास में इंसुलिन रोकने से डायबिटिक कीटोएसिडोसिस हो जाता है, और न रोकने से ब्लड शुगर खतरनाक रूप से कम हो जाती है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tanpa insulin dari tubuh sendiri, puasa menyebabkan ketoasidosis diabetik jika insulin dihentikan, atau gula darah yang sangat rendah dan berbahaya jika insulin tidak dihentikan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Senza insulina propria, un digiuno porta alla chetoacidosi diabetica se l'insulina viene sospesa, o a una glicemia pericolosamente bassa se non lo è."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "自分でインスリンを作れないため、断食中にインスリンを止めると糖尿病性ケトアシドーシスに、止めないと危険な低血糖になります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "자체 인슐린이 없으면, 단식 중 인슐린을 끊을 경우 당뇨병성 케톤산증이 생기고, 끊지 않을 경우 위험한 저혈당이 생겨요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tanpa insulin anda sendiri, puasa membawa kepada ketoasidosis diabetik jika insulin dihentikan, atau gula darah rendah yang berbahaya jika insulin tidak dihentikan."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zonder eigen insuline leidt vasten tot diabetische ketoacidose als de insuline wordt gestopt, of tot gevaarlijk lage bloedsuiker als dat niet gebeurt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bez własnej insuliny post prowadzi do cukrzycowej kwasicy ketonowej, jeśli insulina zostanie odstawiona, albo do niebezpiecznie niskiego poziomu cukru we krwi, jeśli nie zostanie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sem produção própria de insulina, o jejum leva à cetoacidose diabética se a insulina for suspensa, ou a um açúcar no sangue perigosamente baixo se não for."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Без собственного инсулина голодание приводит к диабетическому кетоацидозу, если инсулин отменён, или к опасно низкому уровню сахара в крови, если нет."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Utan egen insulinproduktion leder en fasta till diabetisk ketoacidos om insulinet sätts ut, eller till farligt lågt blodsocker om det inte sätts ut."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Bila insulini yako mwenyewe, mfungo husababisha asidi ya ketoni kujaa mwilini kutokana na kisukari (diabetic ketoacidosis) ikiwa insulini itasimamishwa, au sukari ya damu kushuka kwa kiwango hatari ikiwa haitasimamishwa."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เมื่อร่างกายไม่ผลิตอินซูลินเอง การอดอาหารจะนำไปสู่ภาวะเลือดเป็นกรดจากคีโตนในผู้ป่วยเบาหวานหากหยุดอินซูลิน หรือน้ำตาลในเลือดต่ำอย่างอันตรายหากไม่หยุด"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kendi insülininiz olmadığından oruç, insülin kesilirse diyabetik ketoasidoza, kesilmezse tehlikeli derecede düşük kan şekerine yol açar."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Khi cơ thể không tự tạo insulin, nhịn ăn sẽ dẫn đến nhiễm toan ceton do đái tháo đường nếu ngừng insulin, hoặc hạ đường huyết nguy hiểm nếu không ngừng."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "由于自身无法产生胰岛素，断食时如果停用胰岛素，会导致糖尿病酮症酸中毒；如果不停用，则会导致危险的低血糖。"
          }
        }
      }
    },
    "screen.t2d.action": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يجب أن يخفض الطبيب جرعات الأدوية تدريجيًا أو يوقفها، على أن تُوقف مثبطات SGLT2 قبل الصيام بوقت كافٍ. لا تصم إلا تحت إشراف طبيب."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Medikamente müssen ärztlich ausgeschlichen oder abgesetzt werden, SGLT2-Hemmer lange vor dem Fasten. Fasten Sie nur unter ärztlicher Aufsicht."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Medicines must be tapered or stopped by a doctor, SGLT2 inhibitors well before the fast. Fast only under physician oversight."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un médico debe reducir progresivamente o suspender los medicamentos, y los inhibidores de SGLT2 bastante antes del ayuno. Ayuna solo bajo la supervisión de un médico."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les médicaments doivent être réduits progressivement ou arrêtés par un médecin, les inhibiteurs de SGLT2 bien avant le jeûne. Ne jeûnez que sous la surveillance d’un médecin."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "दवाओं को डॉक्टर द्वारा धीरे-धीरे कम या बंद करना ज़रूरी है, SGLT2 इनहिबिटर को उपवास से काफ़ी पहले। उपवास केवल डॉक्टर की देखरेख में करें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Obat-obatan harus diturunkan dosisnya secara bertahap atau dihentikan oleh dokter, penghambat SGLT2 jauh sebelum puasa. Berpuasalah hanya di bawah pengawasan dokter."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I farmaci vanno ridotti gradualmente o sospesi da un medico, gli inibitori di SGLT2 con largo anticipo rispetto al digiuno. Digiuna solo sotto supervisione medica."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "薬は医師が減量または中止する必要があり、SGLT2阻害薬は断食のかなり前に中止します。断食は必ず医師の監督のもとで行ってください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "약은 의사가 서서히 줄이거나 중단해야 하며, SGLT2 억제제는 단식 훨씬 전에 중단해야 해요. 반드시 의사의 감독하에서만 단식하세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Ubat-ubatan mesti dikurangkan secara beransur-ansur atau dihentikan oleh doktor, dan perencat SGLT2 perlu dihentikan lebih awal sebelum puasa. Berpuasa hanya di bawah pengawasan doktor."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Medicijnen moeten door een arts worden afgebouwd of gestopt, SGLT2-remmers ruim voor het vasten. Vast alleen onder toezicht van een arts."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dawki leków musi stopniowo zmniejszyć lub leki odstawić lekarz, a inhibitory SGLT2 na długo przed postem. Pość wyłącznie pod nadzorem lekarza."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os medicamentos devem ser reduzidos gradualmente ou suspensos por um médico, os inibidores de SGLT2 bem antes do jejum. Faça jejum apenas com acompanhamento médico."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Дозы лекарств должен постепенно снизить или отменить врач, а ингибиторы SGLT2 нужно отменить задолго до голодания. Голодайте только под наблюдением врача."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Läkemedlen måste trappas ned eller sättas ut av en läkare, SGLT2-hämmare i god tid före fastan. Fasta bara under en läkares tillsyn."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Dawa lazima zipunguzwe taratibu au zisimamishwe na daktari, na dawa za kuzuia SGLT2 zisimamishwe muda mrefu kabla ya mfungo. Funga tu chini ya uangalizi wa daktari."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แพทย์ต้องเป็นผู้ลดขนาดหรือหยุดยา โดยต้องหยุดยากลุ่มยับยั้ง SGLT2 ล่วงหน้านานพอก่อนการอดอาหาร อดอาหารภายใต้การกำกับดูแลของแพทย์เท่านั้น"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İlaçların dozu bir doktor tarafından azaltılmalı veya ilaçlar kesilmelidir; SGLT2 inhibitörleri oruçtan çok önce kesilmelidir. Yalnızca hekim gözetiminde oruç tutun."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thuốc phải được bác sĩ giảm liều dần hoặc ngừng, riêng thuốc ức chế SGLT2 phải ngừng từ rất sớm trước đợt nhịn ăn. Chỉ nhịn ăn dưới sự giám sát của bác sĩ."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "必须由医生逐步减量或停药，SGLT2 抑制剂需在断食前提早停用。只能在医生监督下断食。"
          }
        }
      }
    },
    "screen.t2d.question": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "السكري من النوع 2 المعالَج بالأقراص أو الإنسولين"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Typ-2-Diabetes, behandelt mit Tabletten oder Insulin"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Type 2 diabetes treated with tablets or insulin"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Diabetes tipo 2 tratada con pastillas o insulina"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Diabète de type 2 traité par comprimés ou par insuline"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "टाइप 2 डायबिटीज़, जिसका इलाज गोलियों या इंसुलिन से होता है"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Diabetes tipe 2 yang diobati dengan tablet atau insulin"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Diabete di tipo 2 trattato con compresse o insulina"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "飲み薬またはインスリンで治療中の2型糖尿病"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "알약이나 인슐린으로 치료 중인 제2형 당뇨병"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Diabetes jenis 2 yang dirawat dengan tablet atau insulin"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Diabetes type 2, behandeld met tabletten of insuline"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Cukrzyca typu 2 leczona tabletkami lub insuliną"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Diabetes tipo 2 tratado com comprimidos ou insulina"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сахарный диабет 2 типа, который лечат таблетками или инсулином"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Typ 2-diabetes som behandlas med tabletter eller insulin"
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Kisukari aina ya 2 kinachotibiwa kwa vidonge au insulini"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เบาหวานชนิดที่ 2 ที่รักษาด้วยยาเม็ดหรืออินซูลิน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tablet veya insülinle tedavi edilen tip 2 diyabet"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đái tháo đường típ 2 điều trị bằng thuốc viên hoặc insulin"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "2 型糖尿病，正在使用口服药或胰岛素治疗"
          }
        }
      }
    },
    "screen.t2d.why": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تسبب أدوية السلفونيل يوريا انخفاضًا شديدًا في سكر الدم في غياب الطعام. وقد تسبب مثبطات SGLT2 الحماض الكيتوني حتى مع مستوى طبيعي من الجلوكوز."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sulfonylharnstoffe verursachen ohne Nahrung schwere Unterzuckerungen. SGLT2-Hemmer können selbst bei normalem Blutzucker eine Ketoazidose auslösen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sulfonylureas cause severe low blood sugar without food. SGLT2 inhibitors can cause ketoacidosis even with normal glucose."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las sulfonilureas causan bajadas graves del azúcar en sangre sin comida. Los inhibidores de SGLT2 pueden causar cetoacidosis incluso con glucosa normal."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les sulfamides hypoglycémiants (sulfonylurées) provoquent une baisse sévère de la glycémie sans nourriture. Les inhibiteurs de SGLT2 peuvent provoquer une acidocétose même avec une glycémie normale."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सल्फ़ोनिलयूरिया दवाएँ खाने के बिना ब्लड शुगर को बहुत कम कर देती हैं। SGLT2 इनहिबिटर ग्लूकोज़ सामान्य होने पर भी कीटोएसिडोसिस कर सकते हैं।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Sulfonilurea menyebabkan gula darah sangat rendah saat tidak makan. Penghambat SGLT2 dapat menyebabkan ketoasidosis bahkan dengan kadar glukosa normal."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le sulfaniluree causano un grave calo della glicemia senza cibo. Gli inibitori di SGLT2 possono causare chetoacidosi anche con glicemia normale."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スルホニル尿素薬は、食事がないと重度の低血糖を引き起こします。SGLT2阻害薬は、血糖値が正常でもケトアシドーシスを引き起こすことがあります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "설포닐우레아계 약물은 음식이 없으면 심한 저혈당을 일으켜요. SGLT2 억제제는 혈당이 정상이어도 케톤산증을 일으킬 수 있어요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Sulfonilurea menyebabkan gula darah sangat rendah tanpa makanan. Perencat SGLT2 boleh menyebabkan ketoasidosis walaupun glukosa normal."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sulfonylureumderivaten veroorzaken zonder eten ernstig lage bloedsuiker. SGLT2-remmers kunnen ketoacidose veroorzaken, zelfs bij een normale glucose."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pochodne sulfonylomocznika bez jedzenia powodują ciężkie niedocukrzenie. Inhibitory SGLT2 mogą wywołać kwasicę ketonową nawet przy prawidłowym poziomie glukozy."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As sulfonilureias causam açúcar no sangue gravemente baixo sem alimentação. Os inibidores de SGLT2 podem causar cetoacidose mesmo com glicose normal."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Препараты сульфонилмочевины без еды вызывают тяжёлое снижение сахара в крови. Ингибиторы SGLT2 могут вызывать кетоацидоз даже при нормальном уровне глюкозы."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Sulfonylureider orsakar svårt lågt blodsocker utan mat. SGLT2-hämmare kan orsaka ketoacidos även med normalt glukos."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Dawa za sulfonylurea husababisha sukari ya damu kushuka sana bila chakula. Dawa za kuzuia SGLT2 (SGLT2 inhibitors) zinaweza kusababisha asidi ya ketoni kujaa mwilini (ketoacidosis) hata glukosi ikiwa ya kawaida."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ยากลุ่มซัลโฟนิลยูเรียทำให้น้ำตาลในเลือดต่ำรุนแรงเมื่อไม่ได้กินอาหาร ยากลุ่มยับยั้ง SGLT2 อาจทำให้เกิดภาวะเลือดเป็นกรดจากคีโตนแม้ระดับกลูโคสจะปกติ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sülfonilüreler, yemek yenmediğinde ciddi düşük kan şekerine neden olur. SGLT2 inhibitörleri, glukoz normal olsa bile ketoasidoza yol açabilir."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Sulfonylurea gây hạ đường huyết nặng khi không ăn. Thuốc ức chế SGLT2 có thể gây nhiễm toan ceton ngay cả khi đường huyết bình thường."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "不进食时，磺脲类药物会导致严重低血糖。SGLT2 抑制剂即使在血糖正常时也可能导致酮症酸中毒。"
          }
        }
      }
    },
    "screen.wtloss.question": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "فقدت أكثر من 10% من وزن جسمك دون قصد خلال آخر 3 إلى 6 أشهر"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "In den letzten 3 bis 6 Monaten ungewollt mehr als 10 % des Körpergewichts verloren"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Lost more than 10% of your body weight without trying in the last 3 to 6 months"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Has perdido más del 10 % de tu peso corporal sin proponértelo en los últimos 3 a 6 meses"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Perte involontaire de plus de 10 % de votre poids corporel au cours des 3 à 6 derniers mois"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पिछले 3 से 6 महीनों में बिना कोशिश के अपने शरीर के वज़न का 10% से ज़्यादा घटना"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kehilangan lebih dari 10% berat badan tanpa berusaha dalam 3 sampai 6 bulan terakhir"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Hai perso più del 10% del peso corporeo senza volerlo negli ultimi 3-6 mesi"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "過去3〜6か月で、意図せずに体重が10%を超えて減った"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "최근 3~6개월 동안 의도하지 않게 체중의 10% 넘게 감소"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Kehilangan lebih daripada 10% berat badan anda tanpa sengaja dalam 3 hingga 6 bulan yang lalu"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "In de afgelopen 3 tot 6 maanden ongewild meer dan 10% van je lichaamsgewicht verloren"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Niezamierzona utrata ponad 10% masy ciała w ciągu ostatnich 3 do 6 miesięcy"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Perda de mais de 10% do seu peso corporal sem querer nos últimos 3 a 6 meses"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "За последние 3–6 месяцев вы без намеренных усилий потеряли более 10% массы тела"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Har gått ned mer än 10 % av din kroppsvikt utan att försöka under de senaste 3 till 6 månaderna"
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Umepoteza zaidi ya 10% ya uzito wa mwili wako bila kujaribu katika miezi 3 hadi 6 iliyopita"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "น้ำหนักลดลงมากกว่า 10% ของน้ำหนักตัวโดยไม่ได้ตั้งใจในช่วง 3 ถึง 6 เดือนที่ผ่านมา"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Son 3 ila 6 ayda, istemeden vücut ağırlığınızın %10'undan fazlasını kaybetmiş olmak"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đã sụt hơn 10% cân nặng mà không cố ý giảm trong 3 đến 6 tháng qua"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "过去 3 至 6 个月内，在没有刻意减重的情况下体重下降超过 10%"
          }
        }
      }
    },
    "setup.body": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الصيام المائي ليس آمنًا للجميع. أجب عن بضعة أسئلة أولًا. وهي مأخوذة مباشرة من موانع الصيام الواردة في الأبحاث السريرية."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wasserfasten ist nicht für alle sicher. Beantworten Sie zuerst ein paar Fragen. Sie stammen direkt aus den Kontraindikationen der klinischen Forschung."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Water fasting is not safe for everyone. Answer a few questions first. They come straight from the contraindications in the clinical research."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El ayuno con agua no es seguro para todo el mundo. Primero responde unas preguntas. Proceden directamente de las contraindicaciones de la investigación clínica."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le jeûne hydrique n’est pas sans danger pour tout le monde. Répondez d’abord à quelques questions. Elles reprennent directement les contre-indications de la recherche clinique."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पानी वाला उपवास हर किसी के लिए सुरक्षित नहीं है। पहले कुछ सवालों के जवाब दें। ये सीधे क्लिनिकल शोध में बताई गई उन स्थितियों से लिए गए हैं, जिनमें उपवास नहीं करना चाहिए (कॉन्ट्राइंडिकेशन)।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Puasa air tidak aman untuk semua orang. Jawab beberapa pertanyaan terlebih dahulu. Pertanyaan ini diambil langsung dari kontraindikasi dalam penelitian klinis."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il digiuno a sola acqua non è sicuro per tutti. Prima rispondi ad alcune domande. Derivano direttamente dalle controindicazioni riportate nella ricerca clinica."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "水断食は誰にとっても安全なわけではありません。まずいくつかの質問に答えてください。質問は臨床研究で示された禁忌にもとづいています。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "물 단식은 모든 사람에게 안전하지는 않아요. 먼저 몇 가지 질문에 답해 주세요. 임상 연구의 금기 사항에서 그대로 가져온 질문이에요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Puasa air tidak selamat untuk semua orang. Jawab beberapa soalan dahulu. Soalan ini diambil terus daripada kontraindikasi dalam penyelidikan klinikal."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Watervasten is niet voor iedereen veilig. Beantwoord eerst een paar vragen. Ze komen rechtstreeks uit de contra-indicaties in het klinisch onderzoek."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Post wodny nie jest bezpieczny dla każdego. Najpierw odpowiedz na kilka pytań. Pochodzą one bezpośrednio z przeciwwskazań opisanych w badaniach klinicznych."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O jejum de água não é seguro para todos. Responda a algumas perguntas primeiro. Elas vêm diretamente das contraindicações da pesquisa clínica."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Голодание на воде подходит не всем. Сначала ответьте на несколько вопросов. Они взяты непосредственно из противопоказаний, описанных в клинических исследованиях."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Vattenfasta är inte säkert för alla. Svara först på några frågor. De kommer direkt från kontraindikationerna i den kliniska forskningen."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Kufunga kwa maji si salama kwa kila mtu. Jibu maswali machache kwanza. Yanatokana moja kwa moja na hali zinazozuia kufunga (contraindications) katika tafiti za kitabibu."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การอดอาหารแบบดื่มน้ำเปล่าไม่ปลอดภัยสำหรับทุกคน โปรดตอบคำถามสองสามข้อก่อน คำถามเหล่านี้มาจากข้อห้ามในงานวิจัยทางคลินิกโดยตรง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Su orucu herkes için güvenli değildir. Önce birkaç soruyu yanıtlayın. Sorular doğrudan klinik araştırmalardaki kontrendikasyonlardan (orucun uygun olmadığı durumlardan) alınmıştır."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nhịn ăn chỉ uống nước không an toàn với tất cả mọi người. Trước tiên, hãy trả lời một vài câu hỏi. Các câu hỏi này lấy trực tiếp từ các chống chỉ định trong nghiên cứu lâm sàng."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "纯水断食并非对每个人都安全。请先回答几个问题。这些问题直接来自临床研究中的禁忌证。"
          }
        }
      }
    },
    "setup.eyebrow": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الإعداد"
          }
        },
        "de": {
