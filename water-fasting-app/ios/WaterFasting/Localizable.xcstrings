    "cloud.intro": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Optional. Sign in to back up your fasts and keep them if you reinstall the app or change phones."
          }
        }
      }
    },
    "cloud.newer_version": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your cloud copy was saved by a newer version of Waterline. Update the app to keep syncing. Nothing was overwritten."
          }
        }
      }
    },
    "cloud.no_code": {
      "extractionState": "manual",
