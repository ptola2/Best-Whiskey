    "before.water.body": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ماء عادي مقطّر أو قليل المعادن."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Reines destilliertes oder mineralarmes Wasser."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Plain distilled or low-mineral water."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Agua sola, destilada o de baja mineralización."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Eau pure, distillée ou faiblement minéralisée."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सादा डिस्टिल्ड या कम खनिज वाला पानी।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Air suling biasa atau air rendah mineral."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Acqua semplice, distillata o oligominerale."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "普通の蒸留水、またはミネラルの少ない水。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "증류수 또는 미네랄 함량이 낮은 맹물."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Air suling biasa atau air rendah mineral."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gewoon gedestilleerd of mineraalarm water."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Czysta woda destylowana lub niskozmineralizowana."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Água pura destilada ou de baixa mineralização."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Чистая дистиллированная или маломинерализованная вода."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Rent destillerat eller mineralfattigt vatten."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Maji matupu yaliyotakaswa (distilled) au yenye madini kidogo."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "น้ำกลั่นหรือน้ำที่มีแร่ธาตุต่ำ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sade, distile veya mineral oranı düşük su."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nước cất hoặc nước ít khoáng, không pha thêm gì."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "普通蒸馏水或低矿物质水。"
          }
        }
      }
    },
    "before.water.title": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اشرب من 1.2 إلى 2.5 L من الماء يوميًا"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Trinken Sie 1,2 bis 2,5 L Wasser pro Tag"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Drink 1.2 to 2.5 L of water a day"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Bebe de 1,2 a 2,5 L de agua al día"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Buvez 1,2 à 2,5 L d’eau par jour"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "रोज़ 1.2 से 2.5 L पानी पिएँ"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Minum 1,2 sampai 2,5 L air per hari"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Bevi da 1,2 a 2,5 L di acqua al giorno"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "1日に1.2〜2.5 Lの水を飲む"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "하루 1.2~2.5 L의 물을 마시세요"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Minum 1.2 hingga 2.5 L air sehari"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Drink 1,2 tot 2,5 L water per dag"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pij od 1,2 do 2,5 L wody dziennie"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Beba de 1,2 a 2,5 L de água por dia"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Пейте от 1,2 до 2,5 л воды в день"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Drick 1,2 till 2,5 L vatten per dag"
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Kunywa maji 1.2 hadi 2.5 L kwa siku"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ดื่มน้ำวันละ 1.2 ถึง 2.5 L"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Günde 1,2 ila 2,5 L su için"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Uống 1,2 đến 2,5 L nước mỗi ngày"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每天饮水 1.2 至 2.5 L"
          }
        }
      }
    },
    "blocked.footer": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تحدّث مع طبيبك عمّا هو آمن لك. إذا أخطأت في إحدى الإجابات، فغيّرها في الملف الشخصي."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sprechen Sie mit Ihrer Ärztin oder Ihrem Arzt darüber, was für Sie sicher ist. Falls eine Antwort falsch war, ändern Sie sie im Profil."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Talk to your doctor about what is safe for you. If an answer was a mistake, change it in Profile."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Habla con tu médico sobre lo que es seguro para ti. Si te equivocaste en alguna respuesta, cámbiala en Perfil."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Parlez à votre médecin de ce qui est sans danger pour vous. Si une réponse était une erreur, modifiez-la dans Profil."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपके लिए क्या सुरक्षित है, इस बारे में अपने डॉक्टर से बात करें। अगर कोई जवाब गलती से दिया गया था, तो उसे प्रोफ़ाइल में बदलें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Bicarakan dengan dokter Anda tentang apa yang aman untuk Anda. Jika ada jawaban yang keliru, ubah di Profil."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Parla con il tuo medico di cosa è sicuro per te. Se una risposta era sbagliata, modificala nel Profilo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "何が安全かについて医師に相談してください。回答を間違えた場合は、プロフィールで変更できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "본인에게 무엇이 안전한지 의사와 상담하세요. 잘못 답한 항목이 있다면 프로필에서 바꾸세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Berbincang dengan doktor anda tentang apa yang selamat untuk anda. Jika ada jawapan yang tersilap, ubahnya dalam Profil."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bespreek met je arts wat voor jou veilig is. Heb je per ongeluk een verkeerd antwoord gegeven, pas het dan aan bij Profiel."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Porozmawiaj z lekarzem o tym, co jest dla ciebie bezpieczne. Jeśli któraś odpowiedź była błędna, zmień ją w zakładce Profil."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Converse com seu médico sobre o que é seguro para você. Se alguma resposta estiver errada, altere-a no Perfil."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Обсудите с врачом, что для вас безопасно. Если вы ошиблись в ответе, измените его в профиле."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Prata med din läkare om vad som är säkert för dig. Om du svarade fel på något kan du ändra det under Profil."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Zungumza na daktari wako kuhusu kilicho salama kwako. Ikiwa jibu lilikuwa kosa, libadilishe katika Wasifu."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ปรึกษาแพทย์เกี่ยวกับสิ่งที่ปลอดภัยสำหรับคุณ หากตอบผิดพลาด แก้ไขได้ในโปรไฟล์"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sizin için neyin güvenli olduğunu doktorunuzla konuşun. Bir yanıtı yanlışlıkla verdiyseniz Profil bölümünden değiştirin."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hãy trao đổi với bác sĩ về điều gì an toàn cho bạn. Nếu bạn trả lời nhầm, hãy sửa trong Hồ sơ."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请咨询医生，了解哪些方式对你是安全的。如果某个回答填错了，可以在“我的”页面修改。"
          }
        }
      }
    },
    "blocked.title": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الصيام المائي ليس آمنًا لك."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wasserfasten ist für Sie nicht sicher."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Water fasting is not safe for you."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El ayuno con agua no es seguro para ti."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le jeûne hydrique n’est pas sans danger pour vous."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पानी वाला उपवास आपके लिए सुरक्षित नहीं है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Puasa air tidak aman untuk Anda."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il digiuno a sola acqua non è sicuro per te."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "水断食はあなたにとって安全ではありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "물 단식은 본인에게 안전하지 않아요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Puasa air tidak selamat untuk anda."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Watervasten is niet veilig voor jou."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Post wodny nie jest dla ciebie bezpieczny."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O jejum de água não é seguro para você."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Голодание на воде для вас небезопасно."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Vattenfasta är inte säkert för dig."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Kufunga kwa maji si salama kwako."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การอดอาหารแบบดื่มน้ำเปล่าไม่ปลอดภัยสำหรับคุณ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Su orucu sizin için güvenli değil."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nhịn ăn chỉ uống nước không an toàn với bạn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "纯水断食对你来说不安全。"
          }
        }
      }
    },
