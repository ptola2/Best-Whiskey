    "welcome.tagline": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الصيام المائي وفق الأدلة العلمية"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wasserfasten, evidenzbasiert"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Water fasting, by the evidence"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El ayuno con agua, según la evidencia"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le jeûne hydrique, preuves à l’appui"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पानी वाला उपवास, प्रमाणों के आधार पर"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Puasa air, berdasarkan bukti ilmiah"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il digiuno a sola acqua, secondo le evidenze"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "エビデンスに基づく水断食"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "근거에 기반한 물 단식"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Puasa air, berpandukan bukti"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Watervasten, gebaseerd op bewijs"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Post wodny oparty na dowodach naukowych"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Jejum de água, com base em evidências"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Голодание на воде с опорой на доказательства"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Vattenfasta, baserad på evidens"
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Kufunga kwa maji, kwa mujibu wa ushahidi"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การอดอาหารแบบดื่มน้ำเปล่า ตามหลักฐานงานวิจัย"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kanıtlara dayalı su orucu"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nhịn ăn chỉ uống nước, dựa trên bằng chứng"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "纯水断食，以证据为本"
          }
        }
      }
    },
    "welcome.timer.body": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مؤقت مباشر يعرض كل مرحلة أيضية، من نفاد الجليكوجين إلى عتبة 72 ساعة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein mitlaufender Timer zeigt jede Stoffwechselphase, vom Aufbrauchen des Glykogens bis zur 72-Stunden-Schwelle."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A live timer shows each metabolic phase, from glycogen running out to the 72-hour threshold."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un temporizador en tiempo real muestra cada fase metabólica, desde que se agota el glucógeno hasta el umbral de las 72 horas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un minuteur en direct affiche chaque phase métabolique, de l’épuisement du glycogène jusqu’au seuil des 72 heures."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "एक लाइव टाइमर हर मेटाबोलिक चरण दिखाता है, ग्लाइकोजन खत्म होने से लेकर 72 घंटे की सीमा तक।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Penghitung waktu langsung menampilkan setiap fase metabolik, dari habisnya glikogen hingga ambang 72 jam."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un timer in tempo reale mostra ogni fase metabolica, dall'esaurimento del glicogeno alla soglia delle 72 ore."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ライブタイマーが、グリコーゲンが尽きる段階から72時間の境目まで、代謝の各段階を表示します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "실시간 타이머가 글리코겐이 바닥나는 시점부터 72시간 임계점까지 각 대사 단계를 보여 줘요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Pemasa langsung menunjukkan setiap fasa metabolik, daripada glikogen habis hingga ambang 72 jam."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een live timer toont elke stofwisselingsfase, van het opraken van glycogeen tot de drempel van 72 uur."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Licznik na żywo pokazuje każdą fazę metaboliczną, od wyczerpania glikogenu po próg 72 godzin."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um cronômetro em tempo real mostra cada fase metabólica, do esgotamento do glicogênio ao limite de 72 horas."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Таймер в реальном времени показывает каждую метаболическую фазу: от истощения запасов гликогена до порога 72 часов."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "En timer i realtid visar varje metabol fas, från att glykogenet tar slut till 72-timmarsgränsen."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Kipima muda kinachoendelea kinaonyesha kila awamu ya kimetaboliki, kuanzia glikojeni kuisha hadi kizingiti cha saa 72."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ตัวจับเวลาที่เดินอยู่ตลอดจะแสดงแต่ละระยะของเมแทบอลิซึม ตั้งแต่ไกลโคเจนเริ่มหมด ไปจนถึงเกณฑ์ 72 ชั่วโมง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Canlı bir zamanlayıcı, glikojenin tükenmesinden 72 saat eşiğine kadar her metabolik evreyi gösterir."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đồng hồ trực tiếp hiển thị từng giai đoạn chuyển hóa, từ lúc glycogen cạn dần đến ngưỡng 72 giờ."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "实时计时器显示每个代谢阶段，从糖原耗尽到 72 小时临界点。"
          }
        }
      }
    },
    "welcome.timer.title": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اعرف أين وصلت"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wissen, wo Sie stehen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Know where you are"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ten claro en qué punto estás"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sachez où vous en êtes"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "जानें कि आप कहाँ हैं"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ketahui posisi Anda"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sappi a che punto sei"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "今どの段階にいるかを知る"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "지금 어느 단계인지 확인하세요"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Ketahui di mana anda berada"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Weet waar je staat"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wiedz, na jakim etapie jesteś"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Saiba em que ponto você está"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Знайте, на каком вы этапе"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Vet var du befinner dig"
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Jua uko wapi"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "รู้ว่าตอนนี้คุณอยู่ระยะไหน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nerede olduğunuzu bilin"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Biết bạn đang ở giai đoạn nào"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "清楚自己所处的阶段"
          }
        }
      }
    },
    "welcome.warnings.body": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تُقيّم تسجيلات الحالة ضغط الدم والكيتونات والأعراض وفق ما توصلت إليه الأبحاث السريرية."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Regelmäßige Kontrollen bewerten Blutdruck, Ketone und Symptome anhand der klinischen Forschung."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Check-ins grade blood pressure, ketones and symptoms against the clinical research."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los registros evalúan la presión arterial, las cetonas y los síntomas con los criterios de la investigación clínica."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les bilans évaluent la tension artérielle, les cétones et les symptômes au regard de la recherche clinique."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "चेक-इन आपके ब्लड प्रेशर, कीटोन और लक्षणों को क्लिनिकल शोध के मानकों से परखते हैं।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Cek kondisi menilai tekanan darah, keton, dan gejala berdasarkan penelitian klinis."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le rilevazioni valutano pressione arteriosa, chetoni e sintomi in base alla ricerca clinica."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "チェックインでは、血圧、ケトン体、症状を臨床研究に照らして評価します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "체크인할 때 혈압, 케톤, 증상을 임상 연구 기준에 따라 평가해요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Pemeriksaan menilai tekanan darah, keton dan simptom berdasarkan penyelidikan klinikal."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Check-ins beoordelen bloeddruk, ketonen en klachten aan de hand van het klinisch onderzoek."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kontrole oceniają ciśnienie krwi, ciała ketonowe i objawy na tle wyników badań klinicznych."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os registros classificam a pressão arterial, as cetonas e os sintomas com base na pesquisa clínica."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Проверки самочувствия оценивают давление, кетоны и симптомы по данным клинических исследований."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Incheckningarna bedömer blodtryck, ketoner och symtom utifrån den kliniska forskningen."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Ukaguzi hutathmini shinikizo la damu, ketoni na dalili kwa kulinganisha na tafiti za kitabibu."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การเช็กอินจะประเมินความดันโลหิต คีโตน และอาการต่างๆ โดยเทียบกับงานวิจัยทางคลินิก"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kontroller kan basıncını, ketonları ve belirtileri klinik araştırmalara göre değerlendirir."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mỗi lần ghi nhận sẽ đánh giá huyết áp, thể ceton và triệu chứng dựa trên nghiên cứu lâm sàng."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每次自查都会对照临床研究，对血压、酮体和症状进行分级评估。"
          }
        }
      }
    },
    "welcome.warnings.title": {
      "extractionState": "manual",
      "localizations": {
