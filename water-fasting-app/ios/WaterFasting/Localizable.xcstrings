          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "加入淀粉类和植物脂肪"
          }
        }
      }
    },
    "stop.add_clinician": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أضف بيانات الاتصال بطبيبك المعالج في الملف الشخصي لتظهر هنا."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hinterlegen Sie im Profil die Kontaktdaten Ihres Behandlungsteams, damit sie hier angezeigt werden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add your clinician's contact details in Profile so they show here."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Añade los datos de contacto de tu profesional de la salud en Perfil para que aparezcan aquí."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajoutez les coordonnées de votre professionnel de santé dans Profil pour qu’elles s’affichent ici."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "प्रोफ़ाइल में अपने चिकित्सक का संपर्क विवरण जोड़ें, ताकि वह यहाँ दिखे।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tambahkan kontak tenaga medis Anda di Profil agar ditampilkan di sini."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Aggiungi i contatti del tuo medico nel Profilo per vederli qui."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "プロフィールに担当医の連絡先を入力すると、ここに表示されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "여기에 표시되도록 프로필에 담당 의료진의 연락처를 추가하세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tambah butiran hubungan pengamal perubatan anda dalam Profil supaya ia dipaparkan di sini."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vul bij Profiel de contactgegevens van je zorgverlener in, zodat ze hier verschijnen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dodaj dane kontaktowe lekarza prowadzącego w zakładce Profil, aby się tu wyświetlały."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Adicione os contatos do seu profissional de saúde no Perfil para que apareçam aqui."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Добавьте контакты своего врача в профиле, чтобы они отображались здесь."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Lägg till kontaktuppgifter till din vårdkontakt under Profil så visas de här."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Ongeza mawasiliano ya mtaalamu wako wa afya katika Wasifu ili yaonekane hapa."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เพิ่มข้อมูลติดต่อของแพทย์ผู้ดูแลในโปรไฟล์ เพื่อให้แสดงที่นี่"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Burada görünmesi için sağlık uzmanınızın iletişim bilgilerini Profil bölümüne ekleyin."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thêm thông tin liên hệ của nhân viên y tế trong Hồ sơ để hiển thị tại đây."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在“我的”页面添加你的医生的联系方式，即可显示在这里。"
          }
        }
      }
    },
    "stop.breathing": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "بدء تنفس سريع وعميق"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "anfangen, schnell und tief zu atmen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "start fast, deep breathing"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "empiezas a respirar de forma rápida y profunda"
          }
        },
        "fr": {
