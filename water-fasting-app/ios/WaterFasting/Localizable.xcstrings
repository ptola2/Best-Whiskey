        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "건강한 정상 체중 남성, 8일 물 단식"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Lelaki sihat dengan berat badan normal, puasa air 8 hari"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gezonde mannen met een normaal gewicht, watervasten van 8 dagen"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zdrowi mężczyźni z prawidłową masą ciała, 8-dniowy post wodny"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Homens saudáveis com peso normal, jejum de água de 8 dias"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Здоровые мужчины с нормальным весом, 8-дневное голодание на воде"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Friska, normalviktiga män, vattenfasta i 8 dagar"
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Wanaume wenye afya na uzito wa kawaida, mfungo wa maji wa siku 8"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ผู้ชายสุขภาพดีที่มีน้ำหนักปกติ อดอาหารแบบดื่มน้ำเปล่า 8 วัน"
          }
        },
        "tr": {
          "stringUnit": {
