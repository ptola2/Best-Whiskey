          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Napas cepat dan dalam, mual, sangat lelah"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Respiro rapido e profondo, nausea, stanchezza estrema"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "速く深い呼吸、吐き気、極度の疲れ"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "빠르고 깊은 호흡, 메스꺼움, 극심한 피로"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Pernafasan laju dan dalam, loya, keletihan melampau"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Snelle, diepe ademhaling, misselijkheid, extreme vermoeidheid"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Szybki, głęboki oddech, nudności, skrajne zmęczenie"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Respiração rápida e profunda, náusea, cansaço extremo"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Частое глубокое дыхание, тошнота, крайняя усталость"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Snabb, djup andning, illamående, extrem trötthet"
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Kupumua haraka na kwa kina, kichefuchefu, uchovu mkubwa mno"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "หายใจเร็วและลึก คลื่นไส้ อ่อนเพลียอย่างมาก"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hızlı, derin nefes alma, bulantı, aşırı yorgunluk"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thở nhanh và sâu, buồn nôn, cực kỳ mệt mỏi"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "呼吸深快、恶心、极度疲倦"
          }
        }
      }
