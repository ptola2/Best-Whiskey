        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "बाइकार्बोनेट पर नज़र; खून का pH गिरे तो दोबारा खाना शुरू करें"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pantau bikarbonat; mulai makan kembali jika pH darah turun"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Monitorare il bicarbonato; iniziare la rialimentazione se il pH del sangue scende"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "重炭酸を追跡、血液のpHが下がったら回復食を開始"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "중탄산염 추적, 혈액 pH가 떨어지면 보식 시작"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Pantau bikarbonat; mulakan pemakanan semula jika pH darah menurun"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bicarbonaat volgen; begin met opbouwen als de pH van het bloed daalt"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kontrola wodorowęglanów; powrót do jedzenia, jeśli pH krwi spada"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Acompanhar o bicarbonato; iniciar a realimentação se o pH do sangue cair"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Контролировать бикарбонат; начать возобновление питания, если pH крови падает"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Följ bikarbonatet; börja uppbyggnaden om blodets pH sjunker"
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Fuatilia bikaboneti; anza kurejea kula ikiwa pH ya damu itashuka"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ติดตามไบคาร์บอเนต เริ่มกลับมากินอาหารหากค่า pH ในเลือดลดลง"
          }
        },
        "tr": {
          "stringUnit": {
