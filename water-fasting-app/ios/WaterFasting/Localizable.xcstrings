        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Uomini sani normopeso, digiuno a sola acqua di 8 giorni"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "健康で標準体重の男性、8日間の水断食"
          }
