    "teaser.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "From the glycogen switch at 12 to 36 hours to the protein changes that appear around day 3, read what the research found, including the risks."
          }
        }
      }
    },
    "teaser.eyebrow": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "While you're here"
          }
        }
      }
    },
    "teaser.open": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open Learn"
          }
        }
      }
    },
    "teaser.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What a water fast does, hour by hour"
          }
        }
      }
    },
    "tier.high.criteria": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Fast over 7 days, BMI under 16, recent unintended weight loss over 10%, or low electrolytes before refeeding."
          }
        }
      }
    },
    "tier.high.fluids": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Thiamine (vitamin B1), 100 to 300 mg a day as prescribed. No added salt. Electrolytes replaced as needed."
          }
        }
      }
    },
    "tier.high.label": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Significant risk"
          }
        }
      }
    },
    "tier.high.monitoring": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Daily blood tests (electrolytes, magnesium, phosphorus) for 3 to 5 days."
          }
        }
      }
    },
    "tier.low.criteria": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Fast under 5 days, normal electrolytes and a healthy BMI."
          }
        }
      }
    },
    "tier.low.fluids": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Drink to thirst. Keep added salt out at first, then bring it back slowly."
          }
        }
      }
    },
    "tier.low.label": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Lower risk"
          }
        }
      }
    },
    "tier.low.monitoring": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Baseline checks only. Get tested if symptoms appear."
          }
        }
      }
    },
    "tier.moderate.criteria": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Fast of 5 to 7 days, or BMI 16 to 18.5."
          }
        }
      }
    },
    "tier.moderate.fluids": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No added salt. Make sure food supplies potassium and phosphorus."
          }
        }
      }
    },
    "tier.moderate.label": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Moderate risk"
          }
        }
