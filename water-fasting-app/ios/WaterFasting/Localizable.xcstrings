{
  "sourceLanguage": "en",
  "strings": {
    "assess.action.fast": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "End the fast and contact your clinician now."
          }
        }
      }
    },
    "assess.action.refeed": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Contact your clinician now. These can be signs of refeeding syndrome or refeeding swelling."
          }
        }
      }
    },
    "assess.bhb.brain": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "BHB of %@ mmol/L: above 2.0, ketones are reaching the brain and covering much of its fuel."
          }
        }
      }
    },
    "assess.bhb.high": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "BHB of %@ mmol/L is above the 3.0 to 7.0 range usually seen by days 5 to 10. Share the reading with your clinician."
          }
        }
      }
    },
    "assess.bhb.low": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "BHB of %@ mmol/L. Ketones start reaching the brain in quantity above 2.0 mmol/L."
          }
        }
      }
    },
    "assess.bp_drop": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Blood pressure fell %1$lld/%2$lld mmHg when you stood up. A drop of 20/10 or more counts as orthostatic hypotension. Share it with your clinician and avoid sudden position changes."
          }
        }
      }
    },
    "assess.common": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Common, mostly mild side effects. In 768 supervised fasts, 90% of people had at least one by day 5."
          }
        }
      }
    },
    "assess.dizzy": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Lightheadedness on standing is common on days 2 to 5 as blood volume drops. Get up slowly and rest. If you faint or nearly faint, stop the fast."
          }
        }
      }
    },
    "assess.joint": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A hot, swollen joint during a fast is often gout: ketones block uric acid clearance. An acute flare is a reason to end the fast."
          }
        }
      }
    },
    "assess.low_systolic": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A lying systolic pressure of %lld mmHg is low. Rest and tell your clinician."
          }
        }
      }
    },
    "assess.none": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No warning signs in this check-in."
          }
        }
      }
    },
    "assess.pulse_rise": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your pulse rose %lld beats a minute on standing, a sign of low blood volume."
          }
        }
      }
    },
    "assess.sodium.likely": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cramps with headache, sluggishness or dizziness can point to low sodium (below 136 mmol/L). Only a blood test can tell. Let your clinician know."
          }
        }
      }
    },
    "assess.sodium.possible": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cramps or heavy drowsiness can be early signs of low sodium. Mention it to your clinician and keep watching."
          }
        }
      }
    },
    "assess.warnings": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Warning signs: %1$@. %2$@ If it feels severe, call your local emergency number."
          }
        }
      }
    },
    "assess.water.high": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Yesterday you logged %@ L of water, above the usual 1.2 to 2.5 L. Large amounts of plain water can lower blood sodium."
          }
        }
      }
    },
    "assess.water.low": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Yesterday you logged %@ L of water, under the 1.2 L minimum."
          }
        }
      }
    },
    "assess.weight_down": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Down %1$@ kg (%2$@%%) since the start. Early loss is mostly water and glycogen, which come back when you eat."
          }
        }
      }
    },
    "before.doctor.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Blood tests (metabolic panel and blood count), a urine test and a resting ECG."
          }
        }
      }
    },
    "before.doctor.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "See a doctor first"
          }
        }
      }
    },
    "before.ease_in.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Eat only raw and steamed fruit and vegetables for two days beforehand."
          }
        }
      }
    },
    "before.ease_in.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ease in for 48 hours"
          }
        }
      }
    },
    "before.refeed.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "At least half as long as the fast. A 10-day fast needs 5 days of careful refeeding."
          }
        }
      }
    },
    "before.refeed.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Block out time to refeed"
          }
        }
      }
    },
    "before.rest.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Quiet walking and lying down only. Rest protects muscle and prevents fainting."
          }
        }
      }
    },
    "before.rest.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Plan to rest"
          }
        }
      }
    },
    "before.subtitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What supervised clinics ask of people starting a fast."
          }
        }
      }
    },
    "before.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Before you start"
          }
        }
      }
    },
    "before.water.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Plain distilled or low-mineral water."
          }
        }
      }
    },
    "before.water.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Drink 1.2 to 2.5 L of water a day"
          }
        }
      }
    },
    "blocked.footer": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Talk to your doctor about what is safe for you. If an answer was a mistake, change it in Profile."
          }
        }
      }
    },
    "blocked.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Water fasting is not safe for you."
          }
        }
      }
    },
    "blocker.bmi.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "BMI of %@ (under 18.5)"
          }
        }
      }
    },
    "blocker.bmi.why": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Without enough fat and protein reserves, fasting can waste heart muscle and cause dangerous heart rhythms."
          }
        }
      }
    },
    "blocker.minor.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Under 18"
          }
        }
      }
    },
    "blocker.minor.why": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The research covers adults only."
          }
        }
      }
    },
    "checkin.bp.how": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Measure lying down after 5 minutes of rest, then after 1 to 3 minutes standing."
          }
        }
      }
    },
    "checkin.bp.lying": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Lying down"
          }
        }
      }
    },
    "checkin.bp.standing": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Standing"
          }
        }
      }
    },
    "checkin.bp.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Blood pressure and pulse"
          }
        }
      }
    },
    "checkin.diastolic": {
