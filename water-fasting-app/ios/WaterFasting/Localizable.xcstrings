          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "72時間を超える断食には、医療者による管理が必要です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "72시간을 넘는 단식은 의료진의 감독이 필요해요."
