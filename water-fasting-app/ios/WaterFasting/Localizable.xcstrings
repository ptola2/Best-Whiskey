    },
    "refeed_today.full_plan": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "See the full plan"
          }
        }
      }
    },
    "refeed_today.no_salt.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "After a fast, insulin makes the kidneys hold on to sodium and water. Salt now can cause swelling and strain the heart."
          }
        }
      }
    },
    "refeed_today.no_salt.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No added salt yet."
          }
        }
      }
    },
    "refeed_today.then": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": ", then "
          }
        }
      }
    },
    "refeed_warnings.breath": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "shortness of breath"
          }
        }
      }
    },
    "refeed_warnings.confusion": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "confusion"
          }
        }
      }
    },
    "refeed_warnings.heart": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "a racing or irregular heartbeat"
          }
        }
      }
    },
    "refeed_warnings.note": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "These can signal refeeding syndrome (phosphate, potassium and magnesium rushing into cells) or refeeding swelling (edema). Both are most likely in the first 3 to 5 days of eating again."
          }
        }
      }
    },
    "refeed_warnings.swelling": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "swelling in your ankles, legs or face"
          }
        }
      }
    },
    "refeed_warnings.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Call your clinician if you notice"
          }
        }
      }
    },
    "refeed_warnings.weakness": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "muscle weakness or new numbness"
          }
        }
      }
    },
    "risk.acid.action": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Fast, deep breathing means stop and get medical help."
          }
        }
      }
    },
    "risk.acid.name": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ketone acid build-up (metabolic acidosis)"
          }
        }
      }
    },
    "risk.acid.signs": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Fast, deep breathing, nausea, extreme tiredness."
          }
        }
      }
    },
    "risk.bone.action": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A reason to cap how long a fast runs, especially with low bone density."
          }
        }
      }
    },
    "risk.bone.name": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Bone mineral loss"
          }
        }
      }
    },
    "risk.bone.signs": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No symptoms. Shows up as more calcium in urine."
          }
        }
      }
    },
    "risk.gout.action": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keep up your water intake. An acute flare means ending the fast."
          }
        }
      }
    },
    "risk.gout.name": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "High uric acid and gout"
          }
        }
      }
    },
    "risk.gout.signs": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hot, red, painful swelling in a joint, often the big toe."
          }
        }
      }
    },
    "risk.hypona.action": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only a blood test can confirm sodium below 136 mmol/L. Tell your clinician. Stay inside your water target rather than drinking extra."
          }
        }
      }
    },
    "risk.hypona.name": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Low sodium (hyponatremia)"
          }
        }
      }
    },
    "risk.hypona.signs": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Muscle cramps, sluggishness, headache, dizziness."
          }
        }
      }
    },
    "risk.ortho.action": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sit on the edge of the bed before standing. Keep to rest and quiet walking."
          }
        }
      }
    },
    "risk.ortho.name": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Low blood pressure on standing"
          }
        }
      }
    },
    "risk.ortho.signs": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Lightheaded, faint or a racing heart when you stand up."
          }
        }
      }
    },
    "screen.bone.action": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Fasts over 72 hours are off the table. Keep any fast short."
          }
        }
      }
    },
    "screen.bone.question": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Osteopenia or osteoporosis"
          }
        }
      }
    },
    "screen.bone.why": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Long fasts draw minerals from bone to buffer ketone acids."
          }
        }
      }
    },
    "screen.bpmeds.action": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only your doctor should reduce or stop these."
          }
        }
      }
    },
    "screen.bpmeds.question": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Taking blood pressure medicine (ACE inhibitor, ARB, calcium channel blocker, beta-blocker)"
          }
        }
      }
    },
    "screen.bpmeds.why": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Fasting lowers blood pressure by itself. Full doses on top can cause severe low pressure, fainting and poor blood flow to the kidneys."
          }
        }
      }
    },
    "screen.cachexia.question": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Severe weight or muscle wasting (cachexia, sarcopenia)"
          }
        }
      }
    },
    "screen.cachexia.why": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Without fat and protein reserves, fasting can waste heart muscle and cause fatal heart rhythms."
          }
        }
      }
    },
    "screen.ckd.question": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Advanced kidney disease (CKD stage 3b to 5, or dialysis)"
          }
        }
      }
    },
    "screen.ckd.why": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The kidneys cannot clear the acid load, which risks severe acidosis and high potassium."
          }
        }
      }
    },
    "screen.diuretic.action": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your doctor has to stop it before the fast, and the fast needs inpatient monitoring."
          }
        }
      }
    },
    "screen.diuretic.question": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Taking a diuretic (“water pill”)"
          }
        }
      }
    },
    "screen.diuretic.why": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Diuretics add to the sodium loss of fasting and can cause fluid collapse, fainting, low potassium and heart rhythm problems."
          }
        }
      }
    },
    "screen.ed.question": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A current or past eating disorder (anorexia, bulimia, ARFID)"
          }
        }
      }
    },
    "screen.ed.why": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stopping food can set off a serious relapse and carries a high risk of fatal refeeding problems. If eating feels hard right now, an eating disorder support service can help."
          }
        }
      }
    },
    "screen.gout.action": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Drink enough water and have uric acid checked during the fast."
          }
        }
      }
    },
    "screen.gout.question": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Gout or high uric acid"
          }
        }
      }
    },
    "screen.gout.why": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ketones compete with uric acid for removal by the kidneys, which can set off a gout flare."
          }
        }
      }
    },
    "screen.heart.action": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Needs specialist supervision."
          }
        }
      }
    },
    "screen.heart.question": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Heart disease or a heart rhythm problem"
          }
        }
      }
    },
    "screen.heart.why": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Electrolyte losses can trigger rhythm problems, and refeeding can overload the heart with salt and fluid."
          }
        }
      }
    },
    "screen.lithium.action": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Needs close monitoring by your prescriber."
          }
        }
      }
    },
    "screen.lithium.question": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Taking lithium or another psychiatric medicine with a narrow safe range"
          }
        }
      }
    },
    "screen.lithium.why": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Dehydration and sodium changes slow lithium clearance and raise the risk of toxicity."
          }
        }
      }
    },
    "screen.liver.question": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cirrhosis of the liver with complications"
          }
        }
      }
    },
    "screen.liver.why": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The liver cannot store glycogen or make glucose well, so blood sugar stays dangerously low."
          }
        }
      }
    },
    "screen.lytes.question": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Been told you have low phosphate, potassium or magnesium"
          }
        }
      }
    },
    "screen.porph.question": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Acute porphyria"
          }
        }
      }
    },
    "screen.porph.why": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cutting calories switches on the liver enzyme ALAS1, which sets off attacks."
          }
        }
      }
    },
    "screen.preg.question": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pregnant or breastfeeding"
          }
        }
      }
    },
    "screen.preg.why": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A baby relies on a steady supply of glucose and amino acids, sustained ketones may affect brain development, and milk supply drops."
          }
        }
      }
    },
    "screen.t1d.question": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Type 1 diabetes"
          }
        }
      }
    },
    "screen.t1d.why": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Without your own insulin, a fast leads to diabetic ketoacidosis if insulin is stopped, or dangerously low blood sugar if it is not."
          }
        }
      }
    },
    "screen.t2d.action": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Medicines must be tapered or stopped by a doctor, SGLT2 inhibitors well before the fast. Fast only under physician oversight."
          }
        }
      }
    },
    "screen.t2d.question": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Type 2 diabetes treated with tablets or insulin"
          }
        }
      }
    },
    "screen.t2d.why": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sulfonylureas cause severe low blood sugar without food. SGLT2 inhibitors can cause ketoacidosis even with normal glucose."
          }
        }
      }
    },
    "screen.wtloss.question": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Lost more than 10% of your body weight without trying in the last 3 to 6 months"
          }
        }
      }
    },
    "setup.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Water fasting is not safe for everyone. Answer a few questions first. They come straight from the contraindications in the clinical research."
          }
        }
      }
    },
    "setup.eyebrow": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Get set up"
          }
        }
      }
    },
    "setup.go": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Go to the safety check"
          }
        }
      }
    },
    "setup.step1": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "1. Add your height, weight and age"
          }
        }
      }
    },
    "setup.step2": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "2. Answer the safety questions"
          }
        }
      }
    },
    "setup.step3": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "3. Plan your fast"
          }
        }
      }
    },
    "setup.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Start with the safety check"
          }
        }
      }
    },
    "stage.fruitVeg.text": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Raw whole fruit and steamed non-starchy vegetables, in small meals."
          }
        }
      }
    },
    "stage.fruitVeg.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Whole fruit and steamed vegetables"
          }
        }
      }
    },
    "stage.juice.text": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Fresh fruit or vegetable juice diluted with water, 100 to 200 mL every 2 to 3 hours. It gently restarts stomach acid, digestive enzymes and insulin."
          }
        }
      }
    },
    "stage.juice.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Diluted juice"
          }
        }
      }
    },
    "stage.starch.text": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Complex carbohydrates such as sweet potato or brown rice, plus modest plant fats like avocado, nuts or seeds. Keep avoiding concentrated animal fats and refined sugar."
          }
        }
      }
    },
    "stage.starch.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add starches and plant fats"
          }
        }
      }
    },
    "stop.add_clinician": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add your clinician's contact details in Profile so they show here."
          }
        }
      }
    },
    "stop.breathing": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "start fast, deep breathing"
          }
        }
      }
    },
    "stop.call": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Call"
          }
        }
      }
    },
    "stop.chest": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "have chest pain, or a racing or irregular heartbeat"
          }
        }
      }
    },
    "stop.clinics": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Supervised clinics also end a fast when its goal is reached or when vital signs become unstable."
          }
        }
      }
    },
    "stop.confused": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "become confused"
          }
        }
      }
    },
    "stop.faint": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "faint or nearly faint"
          }
        }
      }
    },
    "stop.joint": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "get a hot, swollen, painful joint"
          }
        }
      }
    },
    "stop.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "End the fast and get help if you"
          }
        }
      }
    },
    "stop.vomit": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "vomit and cannot keep water down"
          }
        }
      }
    },
    "stop.your_clinician": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your clinician"
          }
        }
      }
    },
    "study.dai.cohort": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Overweight men without diabetes, 10-day water fast"
          }
        }
      }
    },
    "study.dai.finding": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Weight fell 7.28 kg (9.8%). Systolic pressure was down 6.44% by day 7 and 14.68% at its lowest, on the first day of refeeding. Sodium, chloride and IGF-1 fell."
          }
        }
      }
    },
    "study.goldhamer.cohort": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "174 adults with high blood pressure, water fast averaging 10.5 days"
          }
        }
      }
    },
    "study.goldhamer.finding": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "89% reached a reading under 140/90 mmHg. People starting above 180/110 dropped 37/13 mmHg on average. Everyone on blood pressure medicine stopped it during the fast with no rebound."
          }
        }
      }
    },
    "study.oglodek.cohort": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Healthy, normal-weight men, 8-day water fast"
          }
        }
      }
    },
    "study.oglodek.finding": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Lower blood pressure, weight, BMI, fat-free mass and body water. Low sodium (under 136 mmol/L) developed, and uric acid clearance fell."
          }
        }
      }
    },
    "study.pietzner.cohort": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Healthy adults, 7-day water fast"
          }
        }
      }
    },
    "study.pietzner.finding": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Average loss of 5.7 kg, with the lean mass regained after refeeding. A distinct change in blood proteins appeared from day 3, involving about 36% of those measured."
          }
        }
      }
    },
    "study.scharf.cohort": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Adults with obesity, no diabetes, 17-day water fast"
          }
        }
      }
    },
    "study.scharf.finding": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Body weight fell 10.2%. Blood pressure, fasting glucose, insulin and insulin resistance (HOMA-IR) fell. Triglycerides rose for a while."
          }
        }
      }
    },
    "symptom.backpain": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Lower back pain"
          }
        }
      }
    },
    "symptom.breathing": {
