    "complication.acid.response": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "متابعة البيكربونات؛ وبدء إعادة التغذية إذا انخفض الرقم الهيدروجيني للدم"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bicarbonat überwachen; Kostaufbau beginnen, wenn der Blut-pH sinkt"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Track bicarbonate; start refeeding if blood pH falls"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Controlar el bicarbonato; empezar la realimentación si baja el pH de la sangre"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Suivre les bicarbonates ; commencer la réalimentation si le pH sanguin baisse"
