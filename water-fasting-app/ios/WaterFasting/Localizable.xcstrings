    "teaser.body": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "من التحول عن الجليكوجين في الساعات من 12 إلى 36 إلى تغيرات البروتينات التي تظهر نحو اليوم 3، اقرأ ما توصلت إليه الأبحاث، بما في ذلك المخاطر."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Von der Glykogen-Umstellung nach 12 bis 36 Stunden bis zu den Proteinveränderungen um Tag 3: Lesen Sie, was die Forschung herausgefunden hat, einschließlich der Risiken."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "From the glycogen switch at 12 to 36 hours to the protein changes that appear around day 3, read what the research found, including the risks."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Desde el cambio del glucógeno, entre las 12 y las 36 horas, hasta los cambios en las proteínas que aparecen hacia el día 3, descubre lo que encontró la investigación, riesgos incluidos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "De la bascule du glycogène entre 12 et 36 heures aux changements des protéines qui apparaissent vers le jour 3, découvrez ce que la recherche a montré, risques compris."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "12 से 36 घंटे पर ग्लाइकोजन स्विच से लेकर लगभग दिन 3 पर दिखने वाले प्रोटीन बदलावों तक, पढ़ें कि शोध में क्या पाया गया, जोखिमों सहित।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Dari peralihan glikogen pada 12 sampai 36 jam hingga perubahan protein yang muncul sekitar hari ke-3, baca temuan penelitian, termasuk risikonya."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Dal passaggio dal glicogeno tra le 12 e le 36 ore ai cambiamenti proteici che compaiono verso il terzo giorno, leggi cosa ha scoperto la ricerca, rischi compresi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "12〜36時間で起こるグリコーゲンからの切り替えから、3日目ごろに現れるたんぱく質の変化まで、研究でわかったことをリスクも含めてご覧ください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "12~36시간의 글리코겐 전환부터 3일차 무렵 나타나는 단백질 변화까지, 위험을 포함한 연구 결과를 읽어 보세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Daripada suis glikogen pada 12 hingga 36 jam hingga perubahan protein yang muncul sekitar hari 3, baca apa yang ditemui oleh penyelidikan, termasuk risikonya."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Van de glycogeenomschakeling na 12 tot 36 uur tot de eiwitveranderingen rond dag 3: lees wat het onderzoek vond, inclusief de risico's."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Od przełączenia z glikogenu między 12. a 36. godziną do zmian w białkach, które pojawiają się około 3. dnia: przeczytaj, co wykazały badania, także na temat zagrożeń."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Da virada do glicogênio entre 12 e 36 horas às mudanças nas proteínas que aparecem por volta do dia 3, veja o que a pesquisa descobriu, incluindo os riscos."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "От переключения с гликогена через 12–36 часов до изменений белков примерно на 3-й день: узнайте, что выяснили исследования, включая риски."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Från glykogenomställningen vid 12 till 36 timmar till proteinförändringarna som syns runt dag 3: läs vad forskningen kom fram till, inklusive riskerna."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Kuanzia mabadiliko ya glikojeni (saa 12 hadi 36) mpaka mabadiliko ya protini yanayoonekana karibu na siku ya 3, soma kile tafiti zilichogundua, zikiwemo hatari."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ตั้งแต่การเปลี่ยนจากไกลโคเจนในชั่วโมงที่ 12 ถึง 36 ไปจนถึงการเปลี่ยนแปลงของโปรตีนที่ปรากฏราววันที่ 3 อ่านสิ่งที่งานวิจัยค้นพบ รวมถึงความเสี่ยง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "12 ila 36 saatteki glikojen geçişinden 3. gün civarında ortaya çıkan protein değişikliklerine kadar, riskler dahil araştırmaların neler bulduğunu okuyun."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Từ bước chuyển đổi glycogen ở 12 đến 36 giờ đến những thay đổi protein xuất hiện vào khoảng ngày 3, hãy đọc những gì nghiên cứu đã phát hiện, bao gồm cả các rủi ro."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "从 12 至 36 小时的糖原转换，到第 3 天左右出现的蛋白质变化，看看研究发现了什么，包括其中的风险。"
          }
        }
      }
    },
