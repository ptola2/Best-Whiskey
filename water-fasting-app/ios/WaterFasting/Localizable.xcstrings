    "blocker.minor.why": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تشمل الأبحاث البالغين فقط."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Forschung umfasst nur Erwachsene."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The research covers adults only."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La investigación solo incluye a adultos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La recherche ne porte que sur des adultes."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "शोध केवल वयस्कों पर हुआ है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Penelitian ini hanya mencakup orang dewasa."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La ricerca riguarda solo gli adulti."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "研究の対象は成人のみです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "연구는 성인만을 대상으로 해요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Penyelidikan ini hanya meliputi orang dewasa."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het onderzoek gaat alleen over volwassenen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Badania obejmują wyłącznie dorosłych."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A pesquisa abrange apenas adultos."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Исследования охватывают только взрослых."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Forskningen gäller bara vuxna."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Tafiti zinahusu watu wazima pekee."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "งานวิจัยครอบคลุมเฉพาะผู้ใหญ่เท่านั้น"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Araştırmalar yalnızca yetişkinleri kapsar."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nghiên cứu chỉ bao gồm người trưởng thành."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "相关研究仅涵盖成年人。"
          }
        }
      }
    },
    "checkin.bp.how": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "قِس في وضعية الاستلقاء بعد 5 دقائق من الراحة، ثم بعد 1 إلى 3 دقائق من الوقوف."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Messen Sie im Liegen nach 5 Minuten Ruhe, dann nach 1 bis 3 Minuten im Stehen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Measure lying down after 5 minutes of rest, then after 1 to 3 minutes standing."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mide primero en posición acostada, tras 5 minutos de reposo, y luego tras 1 a 3 minutos de pie."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mesurez en position couchée après 5 minutes de repos, puis après 1 à 3 minutes debout."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "5 मिनट आराम करने के बाद लेटकर मापें, फिर खड़े होने के 1 से 3 मिनट बाद।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ukur saat berbaring setelah istirahat 5 menit, lalu setelah berdiri 1 sampai 3 menit."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Misura da sdraiati dopo 5 minuti di riposo, poi dopo 1-3 minuti in piedi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "5分間横になって安静にした後に測り、続いて立ってから1〜3分後に測ってください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "5분 동안 쉰 후 누운 자세에서 측정하고, 이어서 일어선 지 1~3분 후에 측정하세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Ukur semasa berbaring selepas berehat 5 minit, kemudian selepas berdiri 1 hingga 3 minit."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Meet liggend na 5 minuten rust, en daarna na 1 tot 3 minuten staan."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zmierz na leżąco po 5 minutach odpoczynku, a następnie po 1 do 3 minutach w pozycji stojącej."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Meça na posição deitada após 5 minutos de repouso e depois de 1 a 3 minutos em pé."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Измерьте лёжа после 5 минут отдыха, а затем стоя через 1–3 минуты после того, как встанете."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Mät liggande efter 5 minuters vila och sedan efter 1 till 3 minuter i stående."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Pima ukiwa umelala baada ya dakika 5 za kupumzika, kisha baada ya dakika 1 hadi 3 ukiwa umesimama."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "วัดขณะนอนหลังพัก 5 นาที แล้ววัดอีกครั้งหลังยืน 1 ถึง 3 นาที"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "5 dakika dinlendikten sonra yatarken, ardından 1 ila 3 dakika ayakta durduktan sonra ölçün."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đo khi nằm sau 5 phút nghỉ, rồi đo lại sau khi đứng 1 đến 3 phút."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "先平躺休息 5 分钟后测量，然后站立 1 至 3 分钟后再测量。"
          }
        }
      }
    },
