    "refeed_warnings.title": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اتصل بطبيبك المعالج إذا لاحظت أيًّا مما يلي:"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Rufen Sie Ihr Behandlungsteam an, wenn Sie Folgendes bemerken:"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Call your clinician if you notice"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Llama a tu profesional de la salud si notas"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Appelez votre professionnel de santé si vous remarquez :"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अगर आपको इनमें से कुछ भी दिखे, तो अपने चिकित्सक को कॉल करें:"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Hubungi tenaga medis Anda jika Anda mengalami"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Chiama il tuo medico se noti"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "次のような症状に気づいたら、担当医に連絡してください："
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다음 증상이 있으면 담당 의료진에게 연락하세요:"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Hubungi pengamal perubatan anda jika anda mengalami"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bel je zorgverlener bij"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zadzwoń do lekarza prowadzącego, jeśli zauważysz:"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ligue para seu profissional de saúde se notar"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Позвоните врачу, если заметите такие признаки:"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ring din vårdkontakt om du märker"
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Mpigie simu mtaalamu wako wa afya ukiona:"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "โทรหาแพทย์ผู้ดูแลหากคุณสังเกตเห็น"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Şunları fark ederseniz sağlık uzmanınızı arayın:"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Gọi cho nhân viên y tế nếu bạn thấy"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "如果你注意到以下情况，请联系你的医生："
          }
        }
      }
    },
    "refeed_warnings.weakness": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ضعف في العضلات أو خدر جديد"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Muskelschwäche oder neues Taubheitsgefühl"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "muscle weakness or new numbness"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "debilidad muscular o un entumecimiento que no tenías antes"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "une faiblesse musculaire ou un nouvel engourdissement"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "मांसपेशियों में कमज़ोरी या नया सुन्नपन"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "otot lemah atau mati rasa yang baru muncul"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "debolezza muscolare o un intorpidimento che prima non c'era"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "筋力の低下、または新たなしびれ"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "근력 약화 또는 새로 생긴 저림"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "otot lemah atau rasa kebas yang baharu"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "spierzwakte of nieuwe gevoelloosheid"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "osłabienie mięśni lub nowe drętwienie"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "fraqueza muscular ou dormência nova"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "мышечная слабость или новое онемение"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "muskelsvaghet eller nytillkommen domning"
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "udhaifu wa misuli au ganzi mpya"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "กล้ามเนื้ออ่อนแรงหรืออาการชาที่เพิ่งเกิดขึ้นใหม่"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kas güçsüzlüğü veya yeni başlayan uyuşma"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "yếu cơ hoặc mới bị tê"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "肌肉无力或新出现的麻木"
          }
        }
      }
    },
    "risk.acid.action": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "التنفس السريع والعميق يعني أن عليك التوقف وطلب المساعدة الطبية."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bei schneller, tiefer Atmung: aufhören und medizinische Hilfe holen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Fast, deep breathing means stop and get medical help."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La respiración rápida y profunda significa que debes parar y buscar ayuda médica."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une respiration rapide et profonde signifie qu’il faut arrêter et obtenir une aide médicale."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "तेज़, गहरी साँसें आएँ, तो रुकें और चिकित्सा सहायता लें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Napas cepat dan dalam berarti Anda harus berhenti dan mencari pertolongan medis."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un respiro rapido e profondo significa: fermati e chiedi aiuto medico."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "速く深い呼吸が出たら、中止して医療機関の助けを求めてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "빠르고 깊은 호흡이 나타나면 중단하고 의료 도움을 받으세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Pernafasan laju dan dalam bermakna anda perlu berhenti dan mendapatkan bantuan perubatan."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Snelle, diepe ademhaling betekent: stop en zoek medische hulp."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Szybki, głęboki oddech oznacza, że trzeba przerwać post i szukać pomocy medycznej."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Respiração rápida e profunda significa parar e procurar ajuda médica."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Частое глубокое дыхание означает, что нужно прекратить голодание и обратиться за медицинской помощью."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Snabb, djup andning betyder att du ska avbryta och söka medicinsk hjälp."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Kupumua haraka na kwa kina kunamaanisha uache mfungo na utafute msaada wa kitabibu."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "หากหายใจเร็วและลึก ให้หยุดและขอความช่วยเหลือทางการแพทย์"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hızlı ve derin nefes alma, durup tıbbi yardım almanız gerektiği anlamına gelir."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thở nhanh và sâu nghĩa là phải dừng lại và tìm trợ giúp y tế."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "出现呼吸深快，意味着应停止断食并寻求医疗帮助。"
          }
        }
      }
    },
