    "welcome.refeed.body": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "خطة لإعادة التغذية تناسب مدة صيامك، مبنية على مستويات الخطر لدى ASPEN وNICE."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Kostaufbauplan passend zur Länge Ihres Fastens, nach den Risikostufen von ASPEN und NICE."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A refeeding plan sized to your fast, using the ASPEN and NICE risk levels."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un plan de realimentación adaptado a tu ayuno, con los niveles de riesgo de ASPEN y NICE."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un plan de réalimentation adapté à votre jeûne, fondé sur les niveaux de risque ASPEN et NICE."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपके उपवास की लंबाई के अनुसार दोबारा खाना शुरू करने की योजना, ASPEN और NICE के जोखिम स्तरों के आधार पर।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Rencana makan kembali yang disesuaikan dengan lama puasa Anda, menggunakan tingkat risiko ASPEN dan NICE."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un piano di rialimentazione commisurato al tuo digiuno, con i livelli di rischio ASPEN e NICE."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ASPENとNICEのリスク区分を用いて、断食の長さに合わせた回復食プランを作成します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "ASPEN 및 NICE 위험 등급을 활용해 단식 기간에 맞춘 보식 계획을 세워 드려요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Pelan pemakanan semula yang disesuaikan dengan tempoh puasa anda, menggunakan tahap risiko ASPEN dan NICE."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een opbouwschema afgestemd op je vasten, op basis van de risiconiveaus van ASPEN en NICE."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Plan wychodzenia z postu dopasowany do długości twojego postu, oparty na poziomach ryzyka ASPEN i NICE."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um plano de realimentação ajustado ao seu jejum, usando os níveis de risco da ASPEN e do NICE."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "План выхода из голодания, рассчитанный под длительность вашего голодания, с учётом уровней риска ASPEN и NICE."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "En uppbyggnadsplan anpassad efter din fasta, med riskgraderna från ASPEN och NICE."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Mpango wa kurejea kula unaolingana na mfungo wako, kwa kutumia viwango vya hatari vya ASPEN na NICE."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แผนการกลับมากินอาหารที่ปรับตามระยะเวลาการอดอาหารของคุณ โดยใช้ระดับความเสี่ยงของ ASPEN และ NICE"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "ASPEN ve NICE risk düzeylerini kullanan, orucunuzun süresine göre ayarlanmış bir yeniden beslenme planı."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kế hoạch ăn lại phù hợp với độ dài đợt nhịn ăn của bạn, dùng các mức nguy cơ của ASPEN và NICE."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "根据你的断食时长制定复食计划，采用 ASPEN 和 NICE 的风险分级。"
          }
        }
      }
    },
    "welcome.refeed.title": {
      "extractionState": "manual",
      "localizations": {
