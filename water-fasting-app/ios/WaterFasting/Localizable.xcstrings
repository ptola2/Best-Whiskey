    "cloud.account_deleted": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تم حذف الحساب. تبقى بياناتك الموجودة على هذا الـ iPhone."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Konto gelöscht. Ihre Daten auf diesem iPhone bleiben erhalten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Account deleted. Your data on this iPhone stays."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuenta eliminada. Tus datos en este iPhone se conservan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Compte supprimé. Vos données sur cet iPhone sont conservées."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "खाता हटा दिया गया। इस iPhone पर आपका डेटा बना रहता है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Akun dihapus. Data Anda di iPhone ini tetap ada."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Account eliminato. I tuoi dati su questo iPhone restano."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アカウントを削除しました。このiPhone上のデータは残っています。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "계정이 삭제되었어요. 이 iPhone에 있는 데이터는 그대로 남아요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Akaun dipadam. Data anda pada iPhone ini kekal."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Account verwijderd. Je gegevens op deze iPhone blijven staan."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Konto usunięte. Twoje dane na tym iPhonie pozostają."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Conta excluída. Seus dados neste iPhone permanecem."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Аккаунт удалён. Ваши данные на этом iPhone сохранены."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Kontot är raderat. Dina data på den här iPhonen finns kvar."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Akaunti imefutwa. Data yako iliyo kwenye iPhone hii inabaki."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ลบบัญชีแล้ว ข้อมูลของคุณบน iPhone เครื่องนี้ยังคงอยู่"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hesap silindi. Bu iPhone'daki verileriniz kalır."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đã xóa tài khoản. Dữ liệu của bạn trên iPhone này vẫn được giữ."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "账户已删除。这台 iPhone 上的数据会保留。"
          }
        }
      }
