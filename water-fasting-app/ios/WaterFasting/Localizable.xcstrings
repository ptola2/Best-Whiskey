    },
    "profile.summary.clear.body": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هذا لا يغني عن الفحص الطبي. فالعيادات تُجري مع ذلك تحاليل دم وتحليل بول وتخطيط كهربية القلب (ECG) قبل الصيام."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das ersetzt keine ärztliche Untersuchung. Kliniken machen vor einem Fasten trotzdem Blutuntersuchungen, eine Urinuntersuchung und ein EKG."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "That does not replace a check-up. Clinics still run blood tests, a urine test and an ECG before a fast."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Eso no sustituye a una revisión médica. Las clínicas siguen haciendo análisis de sangre, un análisis de orina y un ECG antes de un ayuno."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cela ne remplace pas un examen médical. Les cliniques font quand même des analyses de sang, une analyse d’urine et un ECG avant un jeûne."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह डॉक्टरी जाँच की जगह नहीं लेता। क्लिनिक उपवास से पहले फिर भी खून की जाँच, पेशाब की जाँच और ईसीजी (ECG) करते हैं।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ini tidak menggantikan pemeriksaan kesehatan. Klinik tetap melakukan tes darah, tes urine, dan ECG sebelum puasa."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo non sostituisce una visita medica. Le cliniche eseguono comunque esami del sangue, esame delle urine ed ECG prima di un digiuno."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "これは健康診断の代わりにはなりません。クリニックでは断食前に、やはり血液検査、尿検査、心電図を行います。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "그렇다고 건강 검진을 대신할 수는 없어요. 클리닉에서도 단식 전에 혈액 검사, 소변 검사, 심전도(ECG) 검사를 해요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Ini tidak menggantikan pemeriksaan kesihatan. Klinik masih menjalankan ujian darah, ujian air kencing dan ECG sebelum puasa."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dat vervangt geen medische controle. Klinieken doen voor een vasten nog steeds bloedonderzoek, urineonderzoek en een ECG."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "To nie zastępuje badań kontrolnych. Kliniki i tak wykonują przed postem badania krwi, badanie moczu i EKG."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Isso não substitui uma avaliação médica. As clínicas ainda fazem exames de sangue, exame de urina e ECG antes de um jejum."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Это не заменяет медицинского обследования. Перед голоданием клиники всё равно проводят анализы крови, анализ мочи и ЭКГ."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Det ersätter inte en hälsokontroll. Kliniker tar ändå blodprover, ett urinprov och ett EKG före en fasta."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Hilo halichukui nafasi ya uchunguzi wa afya. Kliniki bado hufanya vipimo vya damu, kipimo cha mkojo na kipimo cha umeme wa moyo (ECG) kabla ya mfungo."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "สิ่งนี้ไม่สามารถใช้แทนการตรวจสุขภาพได้ คลินิกยังคงตรวจเลือด ตรวจปัสสาวะ และตรวจคลื่นไฟฟ้าหัวใจ (ECG) ก่อนการอดอาหาร"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu, bir sağlık kontrolünün yerini tutmaz. Klinikler oruçtan önce yine de kan tahlilleri, idrar tahlili ve EKG yapar."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Điều đó không thay thế cho việc khám sức khỏe. Các phòng khám vẫn làm xét nghiệm máu, xét nghiệm nước tiểu và điện tâm đồ trước khi nhịn ăn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这不能代替体检。诊所在断食前仍会进行验血、尿检和心电图检查。"
          }
        }
      }
    },
