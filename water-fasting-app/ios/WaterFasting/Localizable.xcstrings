          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Riconosci presto i segnali d'allarme"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "危険な兆候を早めに察知する"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "경고 신호를 일찍 알아차리세요"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Kenal pasti tanda amaran lebih awal"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Herken waarschuwingssignalen vroeg"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wcześnie wychwytuj sygnały alarmowe"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Identifique sinais de alerta cedo"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Замечайте тревожные признаки вовремя"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Upptäck varningstecken tidigt"
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Gundua dalili za hatari mapema"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "สังเกตสัญญาณเตือนได้แต่เนิ่นๆ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Uyarı işaretlerini erken fark edin"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Phát hiện sớm dấu hiệu cảnh báo"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "及早发现警示信号"
          }
        }
      }
    }
