    "hormone.igf1.effect": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يوقف إشارات نمو الخلايا؛ ويزيد مقاومة الإجهاد"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Stoppt Zellwachstumssignale; mehr Stressresistenz"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Halts cell growth signals; more stress resistance"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Frena las señales de crecimiento celular; más resistencia al estrés"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Stoppe les signaux de croissance cellulaire ; meilleure résistance au stress"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कोशिका वृद्धि के संकेत रुकते हैं; तनाव झेलने की क्षमता बढ़ती है"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Menghentikan sinyal pertumbuhan sel; ketahanan terhadap stres meningkat"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Blocca i segnali di crescita cellulare; più resistenza allo stress"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "細胞増殖のシグナルを止める、ストレス耐性が高まる"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "세포 성장 신호 중단, 스트레스 저항성 증가"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Menghentikan isyarat pertumbuhan sel; lebih tahan tekanan"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Stopt signalen voor celgroei; meer weerstand tegen stress"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wycisza sygnały wzrostu komórek; większa odporność na stres"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Interrompe os sinais de crescimento celular; mais resistência ao estresse"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Останавливает сигналы роста клеток; повышает устойчивость к стрессу"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Stoppar signaler för celltillväxt; ökad motståndskraft mot stress"
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Husimamisha ishara za ukuaji wa seli; ustahimilivu zaidi dhidi ya msongo"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "หยุดสัญญาณการเติบโตของเซลล์ และทนต่อความเครียดได้มากขึ้น"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hücre büyüme sinyallerini durdurur; strese direnç artar"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Dừng tín hiệu tăng trưởng tế bào; tăng sức chống chịu căng thẳng"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "停止细胞生长信号；增强抗应激能力"
          }
        }
      }
    },
