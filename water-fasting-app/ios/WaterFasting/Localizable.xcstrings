        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld phút"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld 分钟"
          }
        }
      }
    },
    "footer.disclaimer": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "Waterline أداة تثقيفية مبنية على الأبحاث المنشورة حول الصيام على الماء فقط. وهي ليست نصيحة طبية. في حالات الطوارئ، اتصل برقم الطوارئ المحلي."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Waterline ist ein Informationsangebot auf Grundlage veröffentlichter Forschung zum reinen Wasserfasten. Es ist keine medizinische Beratung. Rufen Sie im Notfall die örtliche Notrufnummer an."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Waterline is an educational tool built from published research on water-only fasting. It is not medical advice. In an emergency, call your local emergency number."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Waterline es una herramienta educativa basada en investigaciones publicadas sobre el ayuno solo con agua. No es consejo médico. En caso de emergencia, llama al número de emergencias local."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Waterline est un outil éducatif fondé sur la recherche publiée sur le jeûne à l’eau seule. Ce n’est pas un avis médical. En cas d’urgence, appelez le numéro d’urgence local."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Waterline केवल पानी वाले उपवास पर प्रकाशित शोध के आधार पर बना एक शैक्षिक साधन है। यह चिकित्सा सलाह नहीं है। आपात स्थिति में अपने स्थानीय आपातकालीन नंबर पर कॉल करें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Waterline adalah alat edukasi yang disusun dari penelitian yang telah dipublikasikan tentang puasa hanya air. Ini bukan nasihat medis. Dalam keadaan darurat, hubungi nomor darurat setempat."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Waterline è uno strumento educativo basato sulla ricerca pubblicata sul digiuno a sola acqua. Non è un consiglio medico. In caso di emergenza, chiama il numero di emergenza locale."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Waterlineは、水のみの断食に関する公表された研究をもとに作られた教育用ツールです。医学的助言ではありません。緊急時は、お住まいの地域の緊急通報番号に電話してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Waterline은 물 단식에 관해 발표된 연구를 바탕으로 만든 교육용 도구예요. 의학적 조언이 아니에요. 응급 상황에서는 현지 응급 번호로 전화하세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Waterline ialah alat pendidikan yang dibina berdasarkan penyelidikan yang diterbitkan tentang puasa air sahaja. Ia bukan nasihat perubatan. Dalam kecemasan, hubungi nombor kecemasan tempatan anda."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Waterline is een educatief hulpmiddel, gebaseerd op gepubliceerd onderzoek naar vasten op alleen water. Het is geen medisch advies. Bel in een noodgeval het lokale alarmnummer."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Waterline to narzędzie edukacyjne oparte na opublikowanych badaniach nad postem o samej wodzie. Nie stanowi porady medycznej. W nagłym wypadku zadzwoń pod lokalny numer alarmowy."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Waterline é uma ferramenta educativa baseada em pesquisas publicadas sobre o jejum apenas com água. Não é aconselhamento médico. Em caso de emergência, ligue para o número de emergência local."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Waterline: образовательный инструмент, созданный на основе опубликованных исследований голодания только на воде. Это не медицинская консультация. В экстренной ситуации звоните в местную службу экстренной помощи."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Waterline är ett utbildningsverktyg som bygger på publicerad forskning om ren vattenfasta. Det är inte medicinsk rådgivning. Vid en nödsituation ringer du ditt lokala larmnummer."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Waterline ni zana ya kielimu iliyotengenezwa kutokana na tafiti zilizochapishwa kuhusu kufunga kwa maji pekee. Si ushauri wa kitabibu. Ikitokea dharura, piga simu kwa namba ya dharura ya eneo lako."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "Waterline เป็นเครื่องมือเพื่อการศึกษาที่สร้างจากงานวิจัยที่ตีพิมพ์แล้วเกี่ยวกับการอดอาหารแบบดื่มน้ำเปล่าอย่างเดียว ไม่ใช่คำแนะนำทางการแพทย์ ในกรณีฉุกเฉิน โปรดโทรหมายเลขฉุกเฉินในพื้นที่ของคุณ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Waterline, su orucu üzerine yayımlanmış araştırmalardan hazırlanmış bir eğitim aracıdır. Tıbbi tavsiye değildir. Acil bir durumda yerel acil durum numarasını arayın."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Waterline là công cụ giáo dục được xây dựng từ các nghiên cứu đã công bố về nhịn ăn chỉ uống nước. Đây không phải lời khuyên y tế. Trong trường hợp khẩn cấp, hãy gọi số cấp cứu tại địa phương."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Waterline 是一款教育工具，内容基于已发表的纯水断食研究。它不构成医疗建议。紧急情况下，请拨打当地急救电话。"
          }
        }
      }
    },
    "health.body": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "احفظ الوزن وضغط الدم من تسجيلات حالتك في Apple Health، واملأ تسجيلات الحالة من القراءات الموجودة فيه بالفعل."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Speichern Sie Gewicht und Blutdruck aus Ihren Kontrollen in Apple Health und übernehmen Sie Messwerte, die dort bereits vorhanden sind, in Ihre Kontrollen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Save the weight and blood pressure from your check-ins to Apple Health, and fill in check-ins from readings already there."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Guarda en Apple Health el peso y la presión arterial de tus registros, y completa tus registros con las mediciones que ya estén allí."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Enregistrez dans Apple Health le poids et la tension artérielle de vos bilans, et remplissez vos bilans à partir des mesures qui s’y trouvent déjà."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Save the weight and blood pressure from your check-ins to Apple Health, and fill in check-ins from readings already there."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Simpan berat badan dan tekanan darah dari cek kondisi Anda ke Apple Health, dan isi cek kondisi dari hasil pengukuran yang sudah ada di sana."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Salva il peso e la pressione delle tue rilevazioni in Apple Health e usa i valori già presenti lì per compilare le rilevazioni."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "チェックインの体重と血圧をApple Healthに保存し、Apple Healthにすでにある測定値をチェックインに入力します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "체크인의 체중과 혈압을 Apple Health에 저장하고, Apple Health에 이미 있는 측정값으로 체크인을 채워요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Simpan berat badan dan tekanan darah daripada pemeriksaan anda ke Apple Health, dan isi pemeriksaan menggunakan bacaan yang sudah ada di sana."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bewaar het gewicht en de bloeddruk uit je check-ins in Apple Health, en vul check-ins in met metingen die daar al staan."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zapisuj masę ciała i ciśnienie krwi z kontroli w Apple Health, a kontrole uzupełniaj pomiarami, które już tam są."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Salve o peso e a pressão arterial dos seus registros no Apple Health e preencha registros com medições que já estão lá."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сохраняйте вес и давление из проверок в Apple Health и заполняйте проверки данными, которые там уже есть."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Spara vikt och blodtryck från dina incheckningar i Apple Health och fyll i incheckningar med mätvärden som redan finns där."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Hifadhi kwenye Apple Health uzito na shinikizo la damu kutoka kwenye ukaguzi wako, na ujaze ukaguzi kwa vipimo vilivyomo tayari humo."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "บันทึกน้ำหนักและความดันโลหิตจากการเช็กอินของคุณลงใน Apple Health และดึงค่าที่มีอยู่แล้วใน Apple Health มากรอกในการเช็กอิน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kontrollerinizdeki kilo ve kan basıncı değerlerini Apple Health'e kaydedin ve orada zaten bulunan ölçümlerle kontrolleri doldurun."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lưu cân nặng và huyết áp từ các lần ghi nhận của bạn vào Apple Health và dùng các chỉ số đã có ở đó để điền vào lần ghi nhận."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将自查中的体重和血压保存到 Apple Health，并用其中已有的读数填写自查。"
          }
        }
      }
    },
    "health.denied": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الحفظ في Apple Health غير مفعّل لتطبيق Waterline. فعّله من تطبيق صحتي: اضغط على صورة ملفك الشخصي، ثم «التطبيقات»، ثم Waterline."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Speichern in Apple Health ist für Waterline deaktiviert. Aktivieren Sie es in der Health-App: Tippen Sie auf Ihr Profilbild, dann auf „Apps“ und dann auf „Waterline“."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Saving to Apple Health is off for Waterline. Turn it on in the Health app: tap your profile picture, then Apps, then Waterline."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El guardado en Apple Health está desactivado para Waterline. Actívalo en la app Salud: toca tu foto de perfil, luego Apps y después Waterline."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’enregistrement dans Apple Health est désactivé pour Waterline. Activez-le dans l’app Santé : touchez votre photo de profil, puis Apps, puis Waterline."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Saving to Apple Health is off for Waterline. Turn it on in the Health app: tap your profile picture, then Apps, then Waterline."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Izin Waterline untuk menyimpan ke Apple Health dimatikan. Nyalakan di aplikasi Kesehatan: ketuk foto profil Anda, lalu App, lalu Waterline."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il salvataggio in Apple Health è disattivato per Waterline. Attivalo nell'app Salute: tocca la tua foto del profilo, poi App, poi Waterline."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "WaterlineからApple Healthへの保存がオフになっています。オンにするには、「ヘルスケア」アプリでプロフィール写真をタップし、「App」、「Waterline」の順にタップしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Waterline의 Apple Health 저장이 꺼져 있어요. 건강 앱에서 프로필 사진, “앱”, “Waterline”을 차례로 탭해 켜세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Kebenaran Waterline untuk menyimpan ke Apple Health dimatikan. Hidupkan dalam aplikasi Kesihatan: ketik gambar profil anda, kemudian App, kemudian Waterline."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Opslaan in Apple Health staat uit voor Waterline. Zet het aan in de Gezondheid-app: tik op je profielfoto, dan op Apps en dan op Waterline."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zapisywanie w Apple Health jest wyłączone dla aplikacji Waterline. Włącz je w aplikacji Zdrowie: stuknij w swoje zdjęcie profilowe, potem w Aplikacje, a następnie w Waterline."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Salvar no Apple Health está desativado para o Waterline. Ative no aplicativo Saúde: toque na sua foto de perfil, depois em Apps e depois em Waterline."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сохранение в Apple Health для Waterline выключено. Включите его в приложении «Здоровье»: коснитесь фото профиля, затем «Приложения», затем Waterline."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Att spara i Apple Health är avstängt för Waterline. Slå på det i appen Hälsa: tryck på din profilbild, sedan på Appar och sedan på Waterline."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Uhifadhi kwenye Apple Health umezimwa kwa Waterline. Ili kuuwasha, fungua programu ya Health: gusa picha yako ya wasifu, kisha Apps, kisha Waterline."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การบันทึกลงใน Apple Health ปิดอยู่สำหรับ Waterline เปิดได้ในแอปสุขภาพ โดยแตะรูปโปรไฟล์ของคุณ แล้วแตะ “แอป” จากนั้นแตะ Waterline"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Waterline için Apple Health'e kaydetme izni kapalı. Bunu Sağlık uygulamasından açabilirsiniz: profil resminize, ardından Uygulamalar'a, sonra da Waterline'a dokunun."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Quyền lưu vào Apple Health của Waterline đang tắt. Hãy bật trong ứng dụng Sức khỏe: chạm vào ảnh hồ sơ của bạn, sau đó chạm vào Ứng dụng, rồi chạm vào Waterline."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Waterline 保存到 Apple Health 的权限已关闭。请在“健康”App 中开启：轻点你的个人资料图片，然后轻点“App”，再轻点“Waterline”。"
          }
        }
      }
    },
