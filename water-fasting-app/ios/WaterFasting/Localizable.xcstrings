        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Niektóre zmiany nie mają jeszcze kopii zapasowej, więc nie wylogowano cię. Sprawdź połączenie i spróbuj ponownie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Algumas alterações ainda não estão no backup, então sua sessão continua ativa. Verifique sua conexão e tente novamente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Некоторые изменения ещё не сохранены в резервной копии, поэтому вы всё ещё в аккаунте. Проверьте подключение и повторите попытку."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Vissa ändringar är inte säkerhetskopierade än, så du är fortfarande inloggad. Kontrollera anslutningen och försök igen."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Baadhi ya mabadiliko bado hayajahifadhiwa, kwa hiyo bado umeingia. Angalia muunganisho wako kisha ujaribu tena."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การเปลี่ยนแปลงบางส่วนยังไม่ได้สำรอง คุณจึงยังลงชื่อเข้าใช้อยู่ ตรวจสอบการเชื่อมต่อแล้วลองอีกครั้ง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bazı değişiklikler henüz yedeklenmedi, bu yüzden oturumunuz hâlâ açık. Bağlantınızı kontrol edip yeniden deneyin."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Một số thay đổi vẫn chưa được sao lưu nên bạn vẫn đang đăng nhập. Hãy kiểm tra kết nối và thử lại."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "部分更改尚未备份，因此你仍处于登录状态。请检查网络连接后重试。"
          }
        }
      }
    },
