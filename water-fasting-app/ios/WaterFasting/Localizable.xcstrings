        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Target reached"
          }
        }
      }
    },
    "notify.unsupervised.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The research restricts fasts beyond 72 hours to medically supervised settings. End the fast now, or confirm in Waterline that a clinician is supervising."
          }
        }
      }
    },
    "notify.unsupervised.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "72 hours without supervision"
          }
        }
      }
    },
    "phase.0.name": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Running on your last meal"
          }
        }
      }
    },
    "phase.0.range": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "0 to 12 h"
          }
        }
      }
    },
    "phase.0.text": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Blood sugar comes from your last meal, then from glycogen stored in the liver. Insulin begins to fall."
          }
        }
      }
    },
    "phase.1.name": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Glycogen runs down"
          }
        }
      }
    },
    "phase.1.range": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "12 to 36 h"
          }
        }
      }
    },
    "phase.1.text": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Liver glycogen is used up. Falling insulin unlocks fat stores, sending fatty acids and glycerol into the blood. Each gram of glycogen holds 3 to 4 g of water, so early weight loss is mostly water."
          }
        }
      }
    },
    "phase.2.name": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The metabolic switch"
          }
        }
      }
    },
    "phase.2.range": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "36 to 72 h"
          }
        }
      }
    },
    "phase.2.text": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The liver turns the flood of fatty acids into ketones (acetoacetate and beta-hydroxybutyrate, or BHB). Low insulin makes the kidneys shed sodium, so blood pressure drops. Typical loss over the first 3 days is 0.9 to 1.5 kg a day, mostly water, glycogen and gut contents."
          }
        }
      }
    },
    "phase.3.name": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The 72-hour threshold"
          }
        }
      }
    },
    "phase.3.range": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Day 4"
          }
        }
      }
    },
    "phase.3.text": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A study that tracked about 3,000 blood proteins daily saw only small changes for 48 hours. From the third day, about 36% of them changed together across every major organ system. 72-hour trials also show more autophagy markers (LC3-II, Beclin-1)."
          }
        }
      }
    },
    "phase.4.name": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keto-adaptation"
          }
        }
      }
    },
    "phase.4.range": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Days 5 to 7"
          }
        }
      }
    },
    "phase.4.text": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Once BHB passes 2.0 mmol/L, ketones reach the brain and can cover 60 to 70% of its energy. The body needs less glucose made from muscle protein, so protein breakdown drops and steadies around days 4 to 7. The kidneys raise ammonium output to save sodium and potassium."
          }
        }
      }
    },
    "phase.5.name": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Deep ketosis"
          }
        }
      }
    },
    "phase.5.range": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Days 8 to 10"
          }
        }
      }
    },
    "phase.5.text": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "BHB usually sits between 3.0 and 7.0 mmol/L by days 5 to 10, up from under 0.1 mmol/L at baseline. IGF-1 falls 40 to 60% by days 5 to 8. Weight loss slows to about 0.25 to 0.40 kg a day as the kidneys switch to saving sodium."
          }
        }
      }
    },
    "phase.6.name": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Prolonged fast"
          }
        }
      }
    },
    "phase.6.range": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Days 11 to 21"
          }
        }
      }
    },
    "phase.6.text": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Free T3 falls and metabolic rate drops to save energy. Under medical supervision, about 28% of fasters had a severe (Grade 3) side effect by day 10 and 32% by day 15."
          }
        }
      }
    },
    "phase.7.name": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Extreme range"
          }
        }
      }
    },
    "phase.7.range": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Past day 21"
          }
        }
      }
    },
    "phase.7.text": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Lean tissue loss, low micronutrients and strain on the heart become major concerns. Fasts this long have only been studied in residential medical settings."
          }
        }
      }
    },
    "phase_card.next": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Next: %1$@ in %2$@."
