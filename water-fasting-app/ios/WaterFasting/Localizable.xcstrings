    "notify.checkin.body": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سجّل ضغط الدم في وضعيتي الاستلقاء والوقوف، والنبض، والوزن، وكيف تشعر."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tragen Sie Blutdruck im Liegen und im Stehen, Puls, Gewicht und Ihr Befinden ein."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Log lying and standing blood pressure, pulse, weight and how you feel."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Anota la presión arterial en posición acostada y de pie, el pulso, el peso y cómo te sientes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Notez votre tension artérielle en position couchée et debout, votre pouls, votre poids et comment vous vous sentez."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "लेटे हुए और खड़े होकर ब्लड प्रेशर, पल्स, वज़न और अपनी तबीयत दर्ज करें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Catat tekanan darah saat berbaring dan berdiri, denyut nadi, berat badan, dan bagaimana perasaan Anda."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Registra pressione da sdraiati e in piedi, pulsazioni, peso e come ti senti."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "横になったときと立ったときの血圧、脈拍、体重、体調を記録してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "누운 자세와 선 자세의 혈압, 맥박, 체중, 몸 상태를 기록하세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Catat tekanan darah semasa berbaring dan berdiri, nadi, berat badan dan perasaan anda."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Noteer je bloeddruk liggend en staand, je hartslag, je gewicht en hoe je je voelt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zapisz ciśnienie krwi na leżąco i na stojąco, tętno, masę ciała i samopoczucie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Registre a pressão arterial deitado e em pé, o pulso, o peso e como você se sente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Запишите давление лёжа и стоя, пульс, вес и самочувствие."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Logga blodtryck liggande och stående, puls, vikt och hur du mår."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Rekodi shinikizo la damu ukiwa umelala na ukiwa umesimama, mapigo ya moyo, uzito na jinsi unavyojisikia."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "บันทึกความดันโลหิตขณะนอนและขณะยืน ชีพจร น้ำหนัก และความรู้สึกของคุณ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yatarken ve ayaktayken kan basıncınızı, nabzınızı, kilonuzu ve kendinizi nasıl hissettiğinizi kaydedin."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ghi lại huyết áp khi nằm và khi đứng, mạch, cân nặng và cảm giác của bạn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "记录平躺和站立时的血压、脉搏、体重以及你的感受。"
          }
        }
      }
    },
    "notify.checkin.title": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
