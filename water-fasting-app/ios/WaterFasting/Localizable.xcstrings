    "plan.reason.answers_need_supervision": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعني إجاباتك أن هذا الصيام يحتاج إلى إشراف طبيب معالج."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aufgrund Ihrer Antworten muss dieses Fasten von einer medizinischen Fachperson überwacht werden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your answers mean this fast needs a clinician supervising."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Según tus respuestas, este ayuno necesita la supervisión de un profesional de la salud."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "D’après vos réponses, ce jeûne nécessite le suivi d’un professionnel de santé."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपके जवाबों के अनुसार इस उपवास के लिए किसी चिकित्सक की निगरानी ज़रूरी है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Berdasarkan jawaban Anda, puasa ini memerlukan pengawasan tenaga medis."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "In base alle tue risposte, questo digiuno richiede la supervisione di un medico."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "あなたの回答から、この断食には医療者による管理が必要です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "답변 내용상 이 단식은 의료진의 감독이 필요해요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Jawapan anda bermakna puasa ini memerlukan pengawasan pengamal perubatan."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Door je antwoorden is voor dit vasten toezicht door een zorgverlener nodig."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Twoje odpowiedzi oznaczają, że ten post wymaga nadzoru lekarza."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Suas respostas indicam que este jejum precisa da supervisão de um profissional de saúde."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Судя по вашим ответам, это голодание требует наблюдения врача."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Dina svar innebär att den här fastan kräver övervakning av vårdpersonal."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Majibu yako yanamaanisha mfungo huu unahitaji usimamizi wa mtaalamu wa afya."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "จากคำตอบของคุณ การอดอาหารครั้งนี้ต้องมีแพทย์ผู้ดูแลกำกับ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yanıtlarınıza göre bu oruç bir sağlık uzmanının gözetimini gerektiriyor."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Theo câu trả lời của bạn, đợt nhịn ăn này cần có nhân viên y tế giám sát."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "根据你的回答，这次断食需要有医生监护。"
          }
        }
      }
    },
    "plan.reason.bone": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "في حالة قلة العظم أو هشاشة العظام، اجعل مدة الصيام 72 ساعة أو أقل."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bei Osteopenie oder Osteoporose beschränken Sie das Fasten auf höchstens 72 Stunden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "With osteopenia or osteoporosis, keep fasts to 72 hours or less."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Con osteopenia u osteoporosis, limita los ayunos a 72 horas o menos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "En cas d’ostéopénie ou d’ostéoporose, limitez les jeûnes à 72 heures maximum."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "ऑस्टियोपीनिया या ऑस्टियोपोरोसिस होने पर उपवास 72 घंटे या उससे कम रखें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Dengan osteopenia atau osteoporosis, batasi puasa hingga 72 jam atau kurang."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Con osteopenia od osteoporosi, limita i digiuni a 72 ore o meno."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "骨減少症や骨粗しょう症がある場合、断食は72時間以内にしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "골감소증이나 골다공증이 있다면 단식을 72시간 이하로 유지하세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Dengan osteopenia atau osteoporosis, hadkan puasa kepada 72 jam atau kurang."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Houd je vasten bij osteopenie of osteoporose op 72 uur of korter."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przy osteopenii lub osteoporozie ogranicz posty do 72 godzin lub krócej."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Com osteopenia ou osteoporose, limite os jejuns a 72 horas ou menos."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "При остеопении или остеопорозе голодание должно длиться не более 72 часов."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Vid osteopeni eller osteoporos ska fastor vara högst 72 timmar."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Ukiwa na upungufu wa madini ya mifupa (osteopenia) au mifupa dhaifu (osteoporosis), mifungo yako isizidi saa 72."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "หากมีภาวะมวลกระดูกบางหรือโรคกระดูกพรุน ควรอดอาหารไม่เกิน 72 ชั่วโมง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Osteopeni veya osteoporoz varsa oruçları 72 saat veya daha kısa tutun."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nếu bị thiếu xương hoặc loãng xương, chỉ nhịn ăn tối đa 72 giờ."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "如果你有骨量减少或骨质疏松症，请将断食控制在 72 小时或更短。"
          }
        }
      }
    },
    "plan.reason.doctor": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أكّد أن طبيبك راجع هذا الصيام والأدوية التي تتناولها."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bestätigen Sie, dass Ihre Ärztin oder Ihr Arzt dieses Fasten und Ihre Medikamente geprüft hat."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Confirm your doctor has reviewed this fast and your medicines."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Confirma que tu médico ha revisado este ayuno y tus medicamentos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Confirmez que votre médecin a examiné ce jeûne et vos médicaments."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पुष्टि करें कि आपके डॉक्टर ने इस उपवास और आपकी दवाओं की समीक्षा की है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pastikan dokter Anda telah meninjau puasa ini dan obat-obatan Anda."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Conferma che il tuo medico ha valutato questo digiuno e i tuoi farmaci."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "医師がこの断食と服用中の薬をチェック済みであることを確認してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "의사가 이 단식과 복용 중인 약을 검토했는지 확인하세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Sahkan bahawa doktor anda telah menyemak puasa ini dan ubat-ubatan anda."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bevestig dat je arts dit vasten en je medicijnen heeft beoordeeld."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Potwierdź, że ten post i twoje leki zostały skonsultowane z lekarzem."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Confirme que seu médico revisou este jejum e seus medicamentos."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Подтвердите, что врач оценил это голодание и ваши лекарства."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Bekräfta att din läkare har gått igenom den här fastan och dina läkemedel."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Thibitisha kwamba daktari wako amekagua mfungo huu na dawa zako."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ยืนยันว่าแพทย์ของคุณได้ตรวจสอบการอดอาหารครั้งนี้และยาที่คุณใช้แล้ว"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Doktorunuzun bu orucu ve ilaçlarınızı incelediğini onaylayın."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Xác nhận rằng bác sĩ đã xem xét đợt nhịn ăn này và các loại thuốc bạn dùng."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请确认你的医生已审核过这次断食和你的用药。"
          }
        }
      }
    },
    "plan.reason.long_needs_supervision": {
      "extractionState": "manual",
      "localizations": {
