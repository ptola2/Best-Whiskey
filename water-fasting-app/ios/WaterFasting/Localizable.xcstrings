          "stringUnit": {
            "state": "translated",
            "value": "Posty dłuższe niż 72 godziny wymagają nadzoru lekarza."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Jejuns de mais de 72 horas precisam da supervisão de um profissional de saúde."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Голодание дольше 72 часов требует наблюдения врача."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Fastor längre än 72 timmar kräver övervakning av vårdpersonal."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Mifungo inayozidi saa 72 inahitaji usimamizi wa mtaalamu wa afya."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การอดอาหารที่นานกว่า 72 ชั่วโมงต้องมีแพทย์ผู้ดูแลกำกับ"
