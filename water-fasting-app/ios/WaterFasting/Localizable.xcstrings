          "stringUnit": {
            "state": "translated",
            "value": "1. Añade tu altura, peso y edad"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "1. Ajoutez votre taille, votre poids et votre âge"
