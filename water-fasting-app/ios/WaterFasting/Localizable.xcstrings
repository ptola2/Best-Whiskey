            "state": "translated",
            "value": "回答に危険信号はありません"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "답변에 위험 신호가 없어요"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tiada tanda bahaya dalam jawapan anda"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Geen alarmsignalen in je antwoorden"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Brak niepokojących sygnałów w odpowiedziach"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nenhum sinal de alerta nas suas respostas"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В ваших ответах нет тревожных сигналов"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Inga varningsflaggor i dina svar"
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Hakuna ishara za hatari katika majibu yako"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไม่พบสัญญาณอันตรายในคำตอบของคุณ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yanıtlarınızda uyarı işareti yok"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Câu trả lời của bạn không có dấu hiệu đáng lo ngại"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你的回答中没有危险信号"
          }
        }
