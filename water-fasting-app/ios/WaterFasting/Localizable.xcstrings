        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "वसा भंडार खुलते हैं; गुर्दे सोडियम बाहर निकालते हैं"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Membuka cadangan lemak; ginjal membuang natrium"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Libera le riserve di grasso; i reni eliminano sodio"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "脂肪の蓄えを解放、腎臓がナトリウムを排出"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "지방 저장고가 열림, 신장이 나트륨 배출"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Membuka simpanan lemak; buah pinggang membuang natrium"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Maakt vetvoorraden vrij; nieren scheiden natrium uit"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Uwalnia zapasy tłuszczu; nerki wydalają sód"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Libera as reservas de gordura; os rins eliminam sódio"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Открывает доступ к жировым запасам; почки выводят натрий"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Frigör fettdepåer; njurarna gör sig av med natrium"
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Hufungua akiba ya mafuta; figo hutoa sodiamu"
          }
        },
        "th": {
