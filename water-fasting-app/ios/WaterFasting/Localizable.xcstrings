    "hormone.uric.why": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعيق الكيتونات طرحه عبر الكلى"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ketone hemmen ihre Ausscheidung in der Niere"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ketones block its removal in the kidney"
