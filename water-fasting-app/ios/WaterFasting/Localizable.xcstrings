    "profile.summary.incomplete.body": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تحدد إجاباتك أنواع الصيام التي سيساعدك Waterline على التخطيط لها."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ihre Antworten entscheiden, bei welchen Fastenperioden Waterline Sie bei der Planung unterstützt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your answers decide which fasts Waterline will help you plan."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tus respuestas deciden qué ayunos te ayudará a planificar Waterline."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vos réponses déterminent les jeûnes que Waterline vous aidera à planifier."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपके जवाब तय करते हैं कि Waterline किन उपवासों की योजना बनाने में आपकी मदद करेगा।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Jawaban Anda menentukan puasa mana yang dapat Waterline bantu rencanakan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le tue risposte determinano quali digiuni Waterline ti aiuterà a pianificare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "回答内容によって、Waterlineが計画をサポートできる断食が決まります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "답변에 따라 Waterline이 계획을 도울 수 있는 단식이 정해져요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Jawapan anda menentukan puasa yang Waterline akan bantu anda rancang."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je antwoorden bepalen bij welk vasten Waterline je helpt plannen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Twoje odpowiedzi decydują o tym, jakie posty Waterline pomoże ci zaplanować."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Suas respostas determinam quais jejuns o Waterline vai ajudar você a planejar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "От ваших ответов зависит, какие голодания Waterline поможет вам спланировать."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Dina svar avgör vilka fastor Waterline hjälper dig att planera."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Majibu yako yanaamua ni mifungo ipi Waterline itakusaidia kupanga."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คำตอบของคุณเป็นตัวกำหนดว่า Waterline จะช่วยคุณวางแผนการอดอาหารแบบใดได้บ้าง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Waterline, yanıtlarınıza göre hangi oruçları planlamanıza yardım edeceğine karar verir."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Câu trả lời của bạn quyết định những đợt nhịn ăn nào Waterline sẽ giúp bạn lên kế hoạch."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你的回答决定 Waterline 会帮你规划哪些断食。"
          }
        }
      }
    },
