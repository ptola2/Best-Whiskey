        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "酸を中和するために骨がカルシウム塩を放出する"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "뼈가 산을 완충하려고 칼슘염을 방출"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tulang membebaskan garam kalsium untuk menimbal asid"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bot geeft calciumzouten af om zuur te bufferen"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kości uwalniają sole wapnia, aby buforować kwas"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os ossos liberam sais de cálcio para neutralizar o ácido"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Кости высвобождают соли кальция для нейтрализации кислоты"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
