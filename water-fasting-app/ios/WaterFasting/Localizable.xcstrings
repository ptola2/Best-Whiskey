    "phase.7.text": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يصبح فقدان الأنسجة الخالية من الدهون ونقص المغذيات الدقيقة وإجهاد القلب مصادر قلق كبيرة. ولم يُدرس الصيام بهذا الطول إلا في بيئات طبية بإقامة داخلية."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verlust von fettfreiem Gewebe, Mangel an Mikronährstoffen und Belastung des Herzens werden zu ernsten Problemen. So lange Fastenperioden wurden nur in stationären medizinischen Einrichtungen untersucht."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Lean tissue loss, low micronutrients and strain on the heart become major concerns. Fasts this long have only been studied in residential medical settings."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La pérdida de tejido magro, la falta de micronutrientes y la sobrecarga del corazón pasan a ser problemas importantes. Los ayunos tan largos solo se han estudiado en entornos médicos residenciales."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La perte de tissu maigre, le manque de micronutriments et la fatigue cardiaque deviennent des préoccupations majeures. Des jeûnes aussi longs n’ont été étudiés qu’en établissement médical avec hébergement."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "लीन टिशू का नुकसान, सूक्ष्म पोषक तत्वों की कमी और दिल पर दबाव बड़ी चिंताएँ बन जाती हैं। इतने लंबे उपवासों का अध्ययन केवल आवासीय चिकित्सा केंद्रों में हुआ है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Hilangnya jaringan tanpa lemak, kadar mikronutrien yang rendah, dan beban pada jantung menjadi masalah utama. Puasa selama ini hanya pernah diteliti di fasilitas medis tempat peserta menginap."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La perdita di tessuto magro, la carenza di micronutrienti e lo sforzo sul cuore diventano gravi motivi di preoccupazione. Digiuni così lunghi sono stati studiati solo in strutture mediche residenziali."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "除脂肪組織の減少、微量栄養素の不足、心臓への負担が大きな懸念となります。これほど長い断食は、入所型の医療施設でしか研究されていません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "제지방 조직 손실, 미량영양소 부족, 심장 부담이 주요 우려 사항이 돼요. 이렇게 긴 단식은 입소형 의료 환경에서만 연구되었어요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Kehilangan tisu tanpa lemak, mikronutrien yang rendah dan beban pada jantung menjadi kebimbangan utama. Puasa sepanjang ini hanya pernah dikaji dalam kalangan peserta yang tinggal di pusat rawatan perubatan."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Verlies van vetvrij weefsel, tekorten aan micronutriënten en belasting van het hart worden ernstige zorgpunten. Zo lang vasten is alleen onderzocht in klinieken waar mensen onder medisch toezicht verbleven."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Utrata tkanki beztłuszczowej, niedobory mikroskładników i obciążenie serca stają się poważnymi zagrożeniami. Tak długie posty badano wyłącznie w stacjonarnych ośrodkach medycznych."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Perda de tecido magro, micronutrientes baixos e sobrecarga do coração se tornam preocupações importantes. Jejuns tão longos só foram estudados em ambientes médicos com internação."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Серьёзными проблемами становятся потеря безжировой массы, дефицит микронутриентов и нагрузка на сердце. Голодания такой длительности изучались только в медицинских учреждениях с проживанием."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Förlust av fettfri vävnad, låga nivåer av mikronäringsämnen och belastning på hjärtat blir allvarliga problem. Så långa fastor har bara studerats på kliniker där deltagarna bodde under medicinsk övervakning."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Kupotea kwa tishu zisizo za mafuta, upungufu wa virutubishi vidogo na mzigo kwa moyo huwa wasiwasi mkubwa. Mifungo mirefu kiasi hiki imechunguzwa tu katika mazingira ya kitabibu ambapo watu hukaa kituoni."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การสูญเสียเนื้อเยื่อไร้ไขมัน การขาดสารอาหารรอง และภาระต่อหัวใจกลายเป็นข้อกังวลสำคัญ การอดอาหารนานขนาดนี้มีการศึกษาเฉพาะในสถานพยาบาลแบบพักค้างเท่านั้น"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yağsız doku kaybı, düşük mikro besin düzeyleri ve kalbin zorlanması başlıca endişeler hâline gelir. Bu uzunlukta oruçlar yalnızca yatılı tıbbi ortamlarda incelenmiştir."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mất mô nạc, thiếu vi chất dinh dưỡng và gánh nặng cho tim trở thành mối lo ngại lớn. Những đợt nhịn ăn dài như vậy chỉ được nghiên cứu trong môi trường y tế nội trú."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "瘦体组织流失、微量营养素缺乏和心脏负担加重成为主要问题。这么长的断食只在住院式医疗环境中研究过。"
          }
        }
      }
    },
