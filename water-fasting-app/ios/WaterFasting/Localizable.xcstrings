          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "kg al giorno persi nei giorni da 1 a 3, soprattutto acqua e glicogeno"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "1〜3日目に1日あたり減るkg数。主に水分とグリコーゲン"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "1~3일차 하루 감량 kg, 대부분 수분과 글리코겐"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "kg sehari hilang pada hari 1 hingga 3, kebanyakannya air dan glikogen"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "kg per dag verlies op dag 1 tot 3, vooral water en glycogeen"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "kg ubytku dziennie w dniach od 1 do 3, głównie woda i glikogen"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "kg por dia perdidos nos dias 1 a 3, principalmente água e glicogênio"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "кг в день теряется с 1-го по 3-й день, в основном вода и гликоген"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "kg per dag förlorat dag 1 till 3, mest vatten och glykogen"
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "kg kwa siku zinazopotea katika siku ya 1 hadi 3, hasa maji na glikojeni"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "kg ต่อวันที่ลดลงในวันที่ 1 ถึง 3 ส่วนใหญ่เป็นน้ำและไกลโคเจน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "1. ila 3. günlerde günde kaybedilen kg, çoğunlukla su ve glikojen"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "kg giảm mỗi ngày trong ngày 1 đến 3, chủ yếu là nước và glycogen"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "第 1 至 3 天每天减轻的体重（kg），主要是水分和糖原"
          }
        }
      }
    },
