    "watch.subtitle": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الفترات التي تبدأ فيها هذه المشكلات عادةً، وفق بيانات الصيام الخاضع للإشراف."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Zeitfenster, in denen diese Probleme meist beginnen, nach Daten aus medizinisch überwachtem Fasten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The windows when these problems usually start, from supervised fasting data."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los periodos en los que suelen empezar estos problemas, según datos de ayunos supervisados."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les périodes où ces problèmes apparaissent habituellement, d’après les données de jeûnes sous suivi médical."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "निगरानी वाले उपवास के आँकड़ों के अनुसार वह समय, जब ये समस्याएँ आमतौर पर शुरू होती हैं।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Rentang waktu ketika masalah ini biasanya mulai muncul, berdasarkan data puasa dengan pengawasan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I periodi in cui di solito iniziano questi problemi, secondo i dati di digiuni sotto supervisione medica."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "医療管理下での断食データにもとづく、これらの問題が起こり始めやすい時期です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "의료진 감독하의 단식 데이터에서 이런 문제가 주로 시작되는 시기예요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tempoh masalah ini biasanya bermula, berdasarkan data puasa berpengawasan."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De periodes waarin deze problemen meestal beginnen, volgens gegevens van vasten onder toezicht."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Okresy, w których te problemy zwykle się pojawiają, według danych z nadzorowanych postów."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os períodos em que esses problemas costumam começar, segundo dados de jejuns supervisionados."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Периоды, когда обычно начинаются эти проблемы, по данным голоданий под медицинским наблюдением."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "De perioder när de här problemen brukar börja, enligt data från övervakade fastor."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Vipindi ambavyo matatizo haya kwa kawaida huanza, kutokana na data ya mifungo yenye usimamizi."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ช่วงเวลาที่ปัญหาเหล่านี้มักเริ่มเกิดขึ้น จากข้อมูลการอดอาหารภายใต้การดูแลทางการแพทย์"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gözetimli oruç verilerine göre bu sorunların genellikle başladığı dönemler."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Những khoảng thời gian các vấn đề này thường bắt đầu, theo dữ liệu nhịn ăn có giám sát."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "根据有医疗监护的断食数据，这些问题通常开始出现的时间段。"
          }
        }
      }
    },
