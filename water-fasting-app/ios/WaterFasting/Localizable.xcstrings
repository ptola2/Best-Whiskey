    "stage.starch.text": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "كربوهيدرات معقدة مثل البطاطا الحلوة أو الأرز البني، مع كميات معتدلة من الدهون النباتية مثل الأفوكادو أو المكسرات أو البذور. واصل تجنب الدهون الحيوانية المركزة والسكر المكرر."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Komplexe Kohlenhydrate wie Süßkartoffel oder Naturreis, dazu maßvoll pflanzliche Fette wie Avocado, Nüsse oder Samen. Meiden Sie weiterhin konzentrierte tierische Fette und raffinierten Zucker."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Complex carbohydrates such as sweet potato or brown rice, plus modest plant fats like avocado, nuts or seeds. Keep avoiding concentrated animal fats and refined sugar."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Carbohidratos complejos como la batata o el arroz integral, más una cantidad moderada de grasas vegetales como aguacate, frutos secos o semillas. Sigue evitando las grasas animales concentradas y el azúcar refinado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Des glucides complexes comme la patate douce ou le riz complet, avec des graisses végétales en quantité modérée comme l’avocat, les noix ou les graines. Continuez à éviter les graisses animales concentrées et le sucre raffiné."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "शकरकंद या ब्राउन राइस जैसे कॉम्प्लेक्स कार्बोहाइड्रेट, साथ में एवोकाडो, मेवे या बीज जैसी पौधों से मिलने वाली वसा थोड़ी मात्रा में। सघन पशु वसा और रिफ़ाइंड चीनी से अब भी बचें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Karbohidrat kompleks seperti ubi jalar atau beras merah, ditambah lemak nabati secukupnya seperti alpukat, kacang, atau biji-bijian. Tetap hindari lemak hewani pekat dan gula rafinasi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Carboidrati complessi come patata dolce o riso integrale, più quantità moderate di grassi vegetali come avocado, frutta secca o semi. Continua a evitare grassi animali concentrati e zuccheri raffinati."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "さつまいもや玄米などの複合炭水化物に、アボカド、ナッツ、種子類などの植物性脂肪を適量加えます。濃縮された動物性脂肪と精製糖は引き続き避けてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "고구마나 현미 같은 복합 탄수화물에 아보카도, 견과류, 씨앗 같은 식물성 지방을 적당히 더해요. 농축된 동물성 지방과 정제 설탕은 계속 피하세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Karbohidrat kompleks seperti ubi keledek atau beras perang, serta lemak tumbuhan secara sederhana seperti avokado, kekacang atau biji-bijian. Terus elakkan lemak haiwan pekat dan gula bertapis."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Complexe koolhydraten zoals zoete aardappel of zilvervliesrijst, plus een beetje plantaardig vet zoals avocado, noten of zaden. Blijf geconcentreerde dierlijke vetten en geraffineerde suiker vermijden."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Węglowodany złożone, takie jak batat czy brązowy ryż, oraz umiarkowane ilości tłuszczów roślinnych, np. z awokado, orzechów lub nasion. Nadal unikaj skoncentrowanych tłuszczów zwierzęcych i cukru rafinowanego."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Carboidratos complexos, como batata-doce ou arroz integral, além de gorduras vegetais com moderação, como abacate, castanhas ou sementes. Continue evitando gorduras animais concentradas e açúcar refinado."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сложные углеводы, например батат или бурый рис, а также умеренное количество растительных жиров, таких как авокадо, орехи или семена. По-прежнему избегайте концентрированных животных жиров и рафинированного сахара."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Komplexa kolhydrater som sötpotatis eller fullkornsris, plus måttligt med vegetabiliska fetter som avokado, nötter eller frön. Fortsätt undvika koncentrerade animaliska fetter och raffinerat socker."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Kabohaidreti changamano kama viazi vitamu au mchele wa kahawia, pamoja na kiasi cha wastani cha mafuta ya mimea kama parachichi, karanga au mbegu. Endelea kuepuka mafuta ya wanyama yaliyokolea na sukari iliyosafishwa."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คาร์โบไฮเดรตเชิงซ้อน เช่น มันเทศหรือข้าวกล้อง ร่วมกับไขมันจากพืชในปริมาณพอเหมาะ เช่น อะโวคาโด ถั่ว หรือเมล็ดพืช หลีกเลี่ยงไขมันสัตว์เข้มข้นและน้ำตาลขัดขาวต่อไป"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tatlı patates veya esmer pirinç gibi kompleks karbonhidratlar, ayrıca avokado, kuruyemiş veya tohumlar gibi ölçülü miktarda bitkisel yağlar. Yoğun hayvansal yağlardan ve rafine şekerden kaçınmaya devam edin."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Carbohydrate phức hợp như khoai lang hoặc gạo lứt, cùng một lượng vừa phải chất béo thực vật như quả bơ, quả hạch hoặc các loại hạt. Tiếp tục tránh mỡ động vật đậm đặc và đường tinh luyện."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "复合碳水化合物，如红薯或糙米，再加适量植物脂肪，如牛油果、坚果或种子。继续避免高浓度的动物脂肪和精制糖。"
          }
        }
      }
    },
    "stage.starch.title": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إضافة النشويات والدهون النباتية"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Stärke und pflanzliche Fette ergänzen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add starches and plant fats"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Añade almidones y grasas vegetales"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajout de féculents et de graisses végétales"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "स्टार्च और पौधों से मिलने वाली वसा जोड़ें"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tambahkan makanan bertepung dan lemak nabati"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Aggiungi amidi e grassi vegetali"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "でんぷん質と植物性脂肪を加える"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "전분류와 식물성 지방 추가"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tambah makanan berkanji dan lemak tumbuhan"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Voeg zetmeel en plantaardige vetten toe"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dodaj produkty skrobiowe i tłuszcze roślinne"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Inclua amidos e gorduras vegetais"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Добавьте крахмалистые продукты и растительные жиры"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Lägg till stärkelse och vegetabiliska fetter"
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Ongeza vyakula vya wanga na mafuta ya mimea"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เพิ่มอาหารประเภทแป้งและไขมันจากพืช"
          }
        },
        "tr": {
          "stringUnit": {
