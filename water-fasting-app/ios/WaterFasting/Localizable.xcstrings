          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Finora sotto il minimo giornaliero di 1,2 L."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "現時点で、1日の最低量1.2 Lを下回っています。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "지금까지 하루 최소량인 1.2 L에 못 미쳐요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Setakat ini kurang daripada minimum harian 1.2 L."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tot nu toe onder het dagelijkse minimum van 1,2 L."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Na razie poniżej dziennego minimum 1,2 L."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Abaixo do mínimo diário de 1,2 L até agora."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Пока меньше суточного минимума в 1,2 л."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Under dagsminimum på 1,2 L hittills."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Chini ya kiwango cha chini cha kila siku cha 1.2 L hadi sasa."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ขณะนี้ยังต่ำกว่าขั้นต่ำ 1.2 L ต่อวัน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Şimdilik günlük 1,2 L'lik alt sınırın altında."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đến giờ vẫn dưới mức tối thiểu 1,2 L mỗi ngày."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "目前低于每日 1.2 L 的最低量。"
          }
        }
      }
    },
