          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ผลไม้ทั้งผลและผักนึ่ง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bütün meyveler ve buharda pişmiş sebzeler"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
