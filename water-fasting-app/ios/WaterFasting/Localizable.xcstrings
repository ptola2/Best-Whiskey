            "value": "%@, minst hälften av fastans längd"
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "%@, angalau nusu ya mfungo"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
