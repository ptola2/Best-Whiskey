            "value": "12 timmar efter ditt mål"
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Saa 12 baada ya lengo lako"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เลยเป้าหมายมา 12 ชั่วโมงแล้ว"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hedefinizi 12 saat geçtiniz"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đã quá mục tiêu 12 giờ"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已超过目标 12 小时"
          }
        }
      }
    },
    "notify.target.body": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "بلغت هدفك: صيام %@. أنهِ الصيام في Waterline لتحصل على خطة إعادة التغذية."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sie haben Ihr Ziel (%@) erreicht. Beenden Sie das Fasten in Waterline, um Ihren Kostaufbauplan zu erhalten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You reached your %@ target. End the fast in Waterline to get your refeeding plan."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Has alcanzado tu objetivo de %@. Termina el ayuno en Waterline para obtener tu plan de realimentación."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous avez atteint votre objectif de %@. Terminez le jeûne dans Waterline pour obtenir votre plan de réalimentation."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपका %@ का लक्ष्य पूरा हो गया। दोबारा खाने की अपनी योजना पाने के लिए Waterline में उपवास खत्म करें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Anda telah mencapai target %@. Akhiri puasa di Waterline untuk mendapatkan rencana makan kembali Anda."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Hai raggiunto il tuo obiettivo di %@. Termina il digiuno in Waterline per ottenere il piano di rialimentazione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@の目標に達しました。Waterlineで断食を終了すると、回復食プランを確認できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 목표에 도달했어요. Waterline에서 단식을 종료하고 보식 계획을 받으세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Anda telah mencapai sasaran %@ anda. Tamatkan puasa dalam Waterline untuk mendapatkan pelan pemakanan semula anda."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je hebt je doel van %@ bereikt. Beëindig het vasten in Waterline om je opbouwschema te krijgen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Twój cel (%@) został osiągnięty. Zakończ post w aplikacji Waterline, aby otrzymać plan wychodzenia z postu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Você atingiu sua meta de %@. Encerre o jejum no Waterline para receber seu plano de realimentação."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вы достигли цели: %@. Завершите голодание в Waterline, чтобы получить план выхода из голодания."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Du har nått ditt mål på %@. Avsluta fastan i Waterline för att få din uppbyggnadsplan."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Umefikia lengo lako la %@. Maliza mfungo katika Waterline ili upate mpango wako wa kurejea kula."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คุณถึงเป้าหมาย %@ แล้ว สิ้นสุดการอดอาหารใน Waterline เพื่อรับแผนการกลับมากินอาหาร"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hedefinize ulaştınız: %@. Yeniden beslenme planınızı almak için orucu Waterline uygulamasında bitirin."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bạn đã đạt mục tiêu %@. Hãy kết thúc đợt nhịn ăn trong Waterline để nhận kế hoạch ăn lại."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你已达到 %@目标。请在 Waterline 中结束断食，获取你的复食计划。"
          }
        }
      }
    },
