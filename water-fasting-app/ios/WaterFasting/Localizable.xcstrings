          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В этой проверке тревожных признаков нет."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Inga varningstecken i den här incheckningen."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Hakuna dalili za hatari katika ukaguzi huu."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไม่พบสัญญาณเตือนในการเช็กอินครั้งนี้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu kontrolde uyarı işareti yok."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không có dấu hiệu cảnh báo trong lần ghi nhận này."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "本次自查未发现警示信号。"
          }
        }
      }
    },
    "assess.pulse_rise": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ارتفع نبضك بمقدار %lld نبضة في الدقيقة عند الوقوف، وهذه علامة على انخفاض حجم الدم."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ihr Puls ist beim Aufstehen um %lld Schläge pro Minute gestiegen, ein Zeichen für ein niedriges Blutvolumen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your pulse rose %lld beats a minute on standing, a sign of low blood volume."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu pulso subió %lld latidos por minuto al ponerte de pie, una señal de bajo volumen de sangre."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre pouls a augmenté de %lld battements par minute en position debout, signe d’un faible volume sanguin."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "खड़े होने पर आपकी पल्स %lld धड़कन प्रति मिनट बढ़ गई, जो खून की कम मात्रा का संकेत है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Denyut nadi Anda naik %lld kali per menit saat berdiri, tanda volume darah rendah."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le pulsazioni sono aumentate di %lld battiti al minuto al momento di alzarti, un segno di basso volume di sangue."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "立ち上がったときに脈拍が1分あたり%lld回増えました。血液量が少ない兆候です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "일어섰을 때 맥박이 분당 %lld회 올라갔어요. 혈액량이 적다는 신호예요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Nadi anda meningkat %lld denyutan seminit apabila berdiri, tanda isipadu darah rendah."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je hartslag steeg bij het opstaan met %lld slagen per minuut, een teken van een laag bloedvolume."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Po wstaniu twoje tętno wzrosło o %lld ud./min, co jest oznaką małej objętości krwi."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Seu pulso subiu %lld batimentos por minuto ao ficar de pé, um sinal de baixo volume de sangue."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "При вставании пульс вырос на %lld уд/мин. Это признак сниженного объёма крови."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Din puls steg med %lld slag per minut när du reste dig, ett tecken på låg blodvolym."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Mapigo yako ya moyo yaliongezeka kwa %lld kwa dakika uliposimama, ishara ya kiasi kidogo cha damu."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ชีพจรของคุณเพิ่มขึ้น %lld ครั้งต่อนาทีเมื่อลุกยืน ซึ่งเป็นสัญญาณของปริมาณเลือดต่ำ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ayağa kalktığınızda nabzınız dakikada %lld atım arttı; bu, düşük kan hacminin bir işaretidir."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mạch của bạn tăng %lld nhịp mỗi phút khi đứng, một dấu hiệu của thể tích máu thấp."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "站起时你的脉搏每分钟增加了 %lld 次，这是血容量不足的迹象。"
          }
        }
      }
    },
    "assess.sodium.likely": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "قد تشير التقلصات المصحوبة بصداع أو خمول أو دوار إلى انخفاض الصوديوم (أقل من 136 mmol/L). ولا يمكن التأكد من ذلك إلا بتحليل دم. أبلغ طبيبك المعالج."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Krämpfe zusammen mit Kopfschmerzen, Trägheit oder Schwindel können auf niedriges Natrium (unter 136 mmol/L) hinweisen. Nur ein Bluttest kann das klären. Informieren Sie Ihr Behandlungsteam."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cramps with headache, sluggishness or dizziness can point to low sodium (below 136 mmol/L). Only a blood test can tell. Let your clinician know."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los calambres con dolor de cabeza, decaimiento o mareo pueden indicar sodio bajo (menos de 136 mmol/L). Solo un análisis de sangre puede confirmarlo. Díselo a tu profesional de la salud."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Des crampes accompagnées de maux de tête, de torpeur ou de vertiges peuvent indiquer un taux de sodium bas (inférieur à 136 mmol/L). Seule une analyse de sang permet de le savoir. Prévenez votre professionnel de santé."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सिरदर्द, सुस्ती या चक्कर के साथ ऐंठन कम सोडियम (136 mmol/L से नीचे) की ओर इशारा कर सकती है। यह केवल खून की जाँच से पता चल सकता है। अपने चिकित्सक को बताएँ।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kram disertai sakit kepala, lesu, atau pusing dapat menandakan natrium rendah (di bawah 136 mmol/L). Hanya tes darah yang dapat memastikannya. Beri tahu tenaga medis Anda."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Crampi con mal di testa, fiacchezza o capogiri possono indicare sodio basso (sotto 136 mmol/L). Solo un esame del sangue può dirlo. Informa il tuo medico."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "筋肉のけいれんに頭痛、だるさ、めまいを伴う場合は、低ナトリウム（136 mmol/L未満）の可能性があります。確かめられるのは血液検査だけです。担当医に伝えてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "근육 경련과 함께 두통, 무기력감 또는 어지럼증이 있으면 나트륨 수치가 낮다는(136 mmol/L 미만) 신호일 수 있어요. 혈액 검사로만 확인할 수 있어요. 담당 의료진에게 알리세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Kekejangan otot bersama sakit kepala, lesu atau pening boleh menunjukkan natrium rendah (bawah 136 mmol/L). Hanya ujian darah dapat memastikannya. Maklumkan kepada pengamal perubatan anda."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Krampen samen met hoofdpijn, lusteloosheid of duizeligheid kunnen wijzen op een laag natrium (onder 136 mmol/L). Alleen bloedonderzoek kan dat uitwijzen. Laat het je zorgverlener weten."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Skurcze z bólem głowy, ospałością lub zawrotami głowy mogą wskazywać na niski poziom sodu (poniżej 136 mmol/L). Potwierdzi to tylko badanie krwi. Poinformuj lekarza prowadzącego."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Cãibras com dor de cabeça, lentidão ou tontura podem indicar sódio baixo (abaixo de 136 mmol/L). Só um exame de sangue pode dizer. Avise seu profissional de saúde."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Судороги вместе с головной болью, вялостью или головокружением могут указывать на низкий уровень натрия (ниже 136 ммоль/л). Точно это покажет только анализ крови. Сообщите врачу."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Kramper tillsammans med huvudvärk, slöhet eller yrsel kan tyda på lågt natrium (under 136 mmol/L). Bara ett blodprov kan avgöra det. Berätta det för din vårdkontakt."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Mkakamao wa misuli pamoja na maumivu ya kichwa, ulegevu au kizunguzungu unaweza kuashiria sodiamu ya chini (chini ya 136 mmol/L). Ni kipimo cha damu pekee kinachoweza kubaini. Mjulishe mtaalamu wako wa afya."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ตะคริวร่วมกับปวดศีรษะ ซึม หรือเวียนศีรษะ อาจบ่งชี้ว่าโซเดียมต่ำ (ต่ำกว่า 136 mmol/L) มีเพียงการตรวจเลือดเท่านั้นที่บอกได้ โปรดแจ้งแพทย์ผู้ดูแลของคุณ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Baş ağrısı, uyuşukluk veya baş dönmesiyle birlikte görülen kramplar, düşük sodyuma (136 mmol/L'nin altında) işaret edebilir. Bunu yalnızca kan tahlili gösterebilir. Sağlık uzmanınıza bildirin."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chuột rút kèm đau đầu, uể oải hoặc chóng mặt có thể cho thấy natri thấp (dưới 136 mmol/L). Chỉ xét nghiệm máu mới xác định được. Hãy báo cho nhân viên y tế của bạn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "抽筋伴头痛、倦怠或头晕，可能提示低钠（低于 136 mmol/L）。只有验血才能确定。请告知你的医生。"
          }
        }
      }
    },
    "assess.sodium.possible": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "قد تكون التقلصات أو النعاس الشديد علامات مبكرة على انخفاض الصوديوم. أخبر طبيبك المعالج بذلك وواصل المراقبة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Krämpfe oder starke Schläfrigkeit können frühe Anzeichen von niedrigem Natrium sein. Sprechen Sie Ihr Behandlungsteam darauf an und beobachten Sie es weiter."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cramps or heavy drowsiness can be early signs of low sodium. Mention it to your clinician and keep watching."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los calambres o una somnolencia intensa pueden ser señales tempranas de sodio bajo. Coméntaselo a tu profesional de la salud y sigue vigilando."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Des crampes ou une forte somnolence peuvent être des signes précoces d’un taux de sodium bas. Parlez-en à votre professionnel de santé et continuez à surveiller."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "ऐंठन या बहुत ज़्यादा उनींदापन कम सोडियम के शुरुआती संकेत हो सकते हैं। अपने चिकित्सक को इसके बारे में बताएँ और नज़र रखते रहें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kram atau rasa kantuk yang berat bisa menjadi tanda awal natrium rendah. Sampaikan kepada tenaga medis Anda dan terus pantau."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Crampi o forte sonnolenza possono essere i primi segni di sodio basso. Parlane con il tuo medico e continua a osservare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "筋肉のけいれんや強い眠気は、低ナトリウムの初期兆候である可能性があります。担当医に伝え、引き続き様子を見てください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "근육 경련이나 심한 졸림은 저나트륨의 초기 신호일 수 있어요. 담당 의료진에게 알리고 계속 지켜보세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Kekejangan otot atau rasa sangat mengantuk boleh menjadi tanda awal natrium rendah. Beritahu pengamal perubatan anda dan terus perhatikan."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Krampen of sterke sufheid kunnen vroege tekenen zijn van een laag natrium. Meld het aan je zorgverlener en blijf het in de gaten houden."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Skurcze lub silna senność mogą być wczesnymi objawami niskiego poziomu sodu. Wspomnij o tym lekarzowi prowadzącemu i dalej obserwuj objawy."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Cãibras ou sonolência intensa podem ser sinais iniciais de sódio baixo. Comente com seu profissional de saúde e continue observando."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Судороги или сильная сонливость могут быть ранними признаками низкого уровня натрия. Сообщите об этом врачу и продолжайте следить за состоянием."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Kramper eller kraftig dåsighet kan vara tidiga tecken på lågt natrium. Nämn det för din vårdkontakt och fortsätt hålla koll."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Mkakamao wa misuli au kusinzia sana kunaweza kuwa dalili za awali za sodiamu ya chini. Mweleze mtaalamu wako wa afya na uendelee kufuatilia."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ตะคริวหรืออาการง่วงซึมมากอาจเป็นสัญญาณระยะแรกของโซเดียมต่ำ แจ้งเรื่องนี้กับแพทย์ผู้ดูแลของคุณและคอยสังเกตอาการต่อไป"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kramplar veya yoğun uyku hali, düşük sodyumun erken belirtileri olabilir. Bunu sağlık uzmanınıza söyleyin ve izlemeye devam edin."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chuột rút hoặc buồn ngủ li bì có thể là dấu hiệu sớm của natri thấp. Hãy nói với nhân viên y tế của bạn và tiếp tục theo dõi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "抽筋或严重困倦可能是低钠的早期迹象。请告诉你的医生，并继续观察。"
          }
        }
      }
    },
    "assess.warnings": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "علامات تحذيرية: %1$@. %2$@ إذا شعرت بأن الأعراض شديدة، فاتصل برقم الطوارئ المحلي."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Warnzeichen: %1$@. %2$@ Wenn Sie die Beschwerden als schwer empfinden, rufen Sie die örtliche Notrufnummer an."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Warning signs: %1$@. %2$@ If it feels severe, call your local emergency number."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Señales de alarma: %1$@. %2$@ Si te parece grave, llama al número de emergencias local."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Signes d’alerte : %1$@. %2$@ Si cela vous semble grave, appelez le numéro d’urgence local."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "चेतावनी के संकेत: %1$@। %2$@ अगर यह गंभीर लगे, तो अपने स्थानीय आपातकालीन नंबर पर कॉल करें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tanda bahaya: %1$@. %2$@ Jika terasa berat, hubungi nomor darurat setempat."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Segnali d'allarme: %1$@. %2$@ Se ti sembra grave, chiama il numero di emergenza locale."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "危険な兆候：%1$@。%2$@症状が重いと感じる場合は、お住まいの地域の緊急通報番号に電話してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "경고 신호: %1$@. %2$@ 증상이 심하게 느껴지면 현지 응급 번호로 전화하세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tanda amaran: %1$@. %2$@ Jika ia terasa teruk, hubungi nombor kecemasan tempatan anda."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Waarschuwingssignalen: %1$@. %2$@ Bel het lokale alarmnummer als het ernstig aanvoelt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sygnały alarmowe: %1$@. %2$@ Jeśli czujesz, że objawy są ciężkie, zadzwoń pod lokalny numer alarmowy."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sinais de alerta: %1$@. %2$@ Se parecer grave, ligue para o número de emergência local."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Тревожные признаки: %1$@. %2$@ Если состояние тяжёлое, звоните в местную службу экстренной помощи."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Varningstecken: %1$@. %2$@ Ring ditt lokala larmnummer om det känns allvarligt."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Dalili za hatari: %1$@. %2$@ Ikiwa unahisi ni kali, piga simu kwa namba ya dharura ya eneo lako."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "สัญญาณเตือน: %1$@ %2$@ หากรู้สึกว่ารุนแรง โปรดโทรหมายเลขฉุกเฉินในพื้นที่ของคุณ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Uyarı işaretleri: %1$@. %2$@ Durumun ciddi olduğunu hissediyorsanız yerel acil durum numarasını arayın."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Dấu hiệu cảnh báo: %1$@. %2$@ Nếu thấy nghiêm trọng, hãy gọi số cấp cứu tại địa phương."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "警示信号：%1$@。%2$@如果感觉严重，请拨打当地急救电话。"
          }
        }
      }
    },
    "assess.water.high": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سجّلت أمس %@ L من الماء، وهو أعلى من المعتاد (من 1.2 إلى 2.5 L). قد تؤدي الكميات الكبيرة من الماء العادي إلى خفض الصوديوم في الدم."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gestern haben Sie %@ L Wasser eingetragen, mehr als die üblichen 1,2 bis 2,5 L. Große Mengen reinen Wassers können den Natriumspiegel im Blut senken."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Yesterday you logged %@ L of water, above the usual 1.2 to 2.5 L. Large amounts of plain water can lower blood sodium."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ayer registraste %@ L de agua, por encima de los 1,2 a 2,5 L habituales. Grandes cantidades de agua sola pueden bajar el sodio en sangre."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hier, vous avez enregistré %@ L d’eau, au-dessus de la plage habituelle de 1,2 à 2,5 L. De grandes quantités d’eau pure peuvent faire baisser le sodium sanguin."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कल आपने %@ L पानी दर्ज किया, जो सामान्य 1.2 से 2.5 L से ज़्यादा है। बहुत ज़्यादा सादा पानी खून में सोडियम कम कर सकता है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kemarin Anda mencatat %@ L air, di atas kisaran biasa 1,2 sampai 2,5 L. Air putih dalam jumlah besar dapat menurunkan kadar natrium darah."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ieri hai registrato %@ L di acqua, sopra il consueto intervallo da 1,2 a 2,5 L. Grandi quantità di acqua semplice possono abbassare il sodio nel sangue."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "昨日記録した水の量は%@ Lで、通常の1.2〜2.5 Lを上回っています。普通の水を大量に飲むと、血中ナトリウムが低下することがあります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "어제 기록한 물 섭취량은 %@ L로, 일반적인 범위인 1.2~2.5 L를 넘어요. 맹물을 많이 마시면 혈중 나트륨이 낮아질 수 있어요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Semalam anda mencatat %@ L air, melebihi julat biasa 1.2 hingga 2.5 L. Air kosong dalam jumlah yang banyak boleh merendahkan natrium darah."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gisteren heb je %@ L water genoteerd, meer dan de gebruikelijke 1,2 tot 2,5 L. Grote hoeveelheden gewoon water kunnen het natrium in je bloed verlagen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wczoraj zapisano %@ L wody, czyli więcej niż zwykłe od 1,2 do 2,5 L. Duże ilości czystej wody mogą obniżyć poziom sodu we krwi."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ontem você registrou %@ L de água, acima da faixa habitual de 1,2 a 2,5 L. Grandes quantidades de água pura podem baixar o sódio no sangue."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вчера вы записали %@ л воды: это больше обычного диапазона от 1,2 до 2,5 л. Большие объёмы чистой воды могут снижать уровень натрия в крови."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Igår loggade du %@ L vatten, över det vanliga intervallet 1,2 till 2,5 L. Stora mängder rent vatten kan sänka natriumhalten i blodet."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Jana ulirekodi %@ L za maji, juu ya kiwango cha kawaida cha 1.2 hadi 2.5 L. Maji matupu mengi yanaweza kupunguza sodiamu katika damu."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เมื่อวานคุณบันทึกการดื่มน้ำ %@ L ซึ่งมากกว่าช่วงปกติ 1.2 ถึง 2.5 L การดื่มน้ำเปล่าปริมาณมากอาจทำให้โซเดียมในเลือดลดลง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dün %@ L su kaydettiniz; bu, olağan 1,2 ila 2,5 L'nin üzerindedir. Çok miktarda sade su içmek kandaki sodyumu düşürebilir."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hôm qua bạn ghi nhận %@ L nước, cao hơn mức thông thường 1,2 đến 2,5 L. Uống lượng lớn nước lọc có thể làm giảm natri máu."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "昨天你记录的饮水量为 %@ L，高于通常的 1.2 至 2.5 L。大量饮用纯水可能会降低血钠。"
          }
        }
      }
    },
    "assess.water.low": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سجّلت أمس %@ L من الماء، وهو أقل من الحد الأدنى البالغ 1.2 L."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gestern haben Sie %@ L Wasser eingetragen, weniger als das Minimum von 1,2 L."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Yesterday you logged %@ L of water, under the 1.2 L minimum."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ayer registraste %@ L de agua, por debajo del mínimo de 1,2 L."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hier, vous avez enregistré %@ L d’eau, en dessous du minimum de 1,2 L."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कल आपने %@ L पानी दर्ज किया, जो 1.2 L के न्यूनतम से कम है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kemarin Anda mencatat %@ L air, di bawah batas minimum 1,2 L."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ieri hai registrato %@ L di acqua, sotto il minimo di 1,2 L."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "昨日記録した水の量は%@ Lで、最低量の1.2 Lを下回っています。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "어제 기록한 물 섭취량은 %@ L로, 최소 기준인 1.2 L보다 적어요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Semalam anda mencatat %@ L air, kurang daripada minimum 1.2 L."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gisteren heb je %@ L water genoteerd, minder dan het minimum van 1,2 L."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wczoraj zapisano %@ L wody, czyli mniej niż minimum 1,2 L."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ontem você registrou %@ L de água, abaixo do mínimo de 1,2 L."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вчера вы записали %@ л воды: это меньше минимума в 1,2 л."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Igår loggade du %@ L vatten, under minimigränsen på 1,2 L."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Jana ulirekodi %@ L za maji, chini ya kiwango cha chini cha 1.2 L."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เมื่อวานคุณบันทึกการดื่มน้ำ %@ L ซึ่งน้อยกว่าขั้นต่ำ 1.2 L"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dün %@ L su kaydettiniz; bu, 1,2 L'lik alt sınırın altındadır."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hôm qua bạn ghi nhận %@ L nước, dưới mức tối thiểu 1,2 L."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "昨天你记录的饮水量为 %@ L，低于 1.2 L 的最低量。"
          }
        }
      }
    },
    "assess.weight_down": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "انخفض وزنك %1$@ kg (%2$@%%) منذ البداية. معظم الفقدان المبكر ماء وجليكوجين، ويعودان عندما تأكل."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Seit Beginn %1$@ kg weniger (%2$@ %%). Der frühe Verlust ist vor allem Wasser und Glykogen, die zurückkommen, sobald Sie wieder essen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Down %1$@ kg (%2$@%%) since the start. Early loss is mostly water and glycogen, which come back when you eat."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Has bajado %1$@ kg (%2$@ %%) desde el inicio. La pérdida inicial es sobre todo agua y glucógeno, que se recuperan al volver a comer."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Perte de %1$@ kg (%2$@ %%) depuis le début. La perte initiale est surtout de l’eau et du glycogène, qui reviennent quand vous remangez."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "शुरुआत से %1$@ kg (%2$@%%) कम। शुरुआती कमी ज़्यादातर पानी और ग्लाइकोजन की होती है, जो खाना शुरू करने पर वापस आ जाते हैं।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Turun %1$@ kg (%2$@%%) sejak awal. Penurunan awal sebagian besar adalah air dan glikogen, yang akan kembali saat Anda makan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Calo di %1$@ kg (%2$@%%) dall'inizio. La perdita iniziale è soprattutto acqua e glicogeno, che tornano quando riprendi a mangiare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "開始時から%1$@ kg（%2$@%%）減りました。初期の減少の大部分は水分とグリコーゲンで、食事を再開すると戻ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "시작 후 %1$@ kg(%2$@%%) 줄었어요. 초기 감량은 대부분 수분과 글리코겐이며, 다시 먹으면 돌아와요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Turun %1$@ kg (%2$@%%) sejak mula. Penurunan awal kebanyakannya air dan glikogen, yang akan kembali apabila anda makan."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ kg (%2$@%%) afgevallen sinds de start. Het vroege verlies is vooral water en glycogeen, en dat komt terug als je weer eet."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Spadek o %1$@ kg (%2$@%%) od początku. Wczesny ubytek to głównie woda i glikogen, które wracają, gdy znów zaczynasz jeść."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Queda de %1$@ kg (%2$@%%) desde o início. A perda inicial é principalmente água e glicogênio, que voltam quando você come."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "С начала голодания вес снизился на %1$@ кг (%2$@%%). Ранняя потеря веса связана в основном с водой и гликогеном, которые возвращаются, когда вы снова начинаете есть."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Du har gått ned %1$@ kg (%2$@ %%) sedan starten. Den tidiga viktnedgången är mest vatten och glykogen, som kommer tillbaka när du äter."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Umepungua %1$@ kg (%2$@%%) tangu mwanzo. Upungufu wa mwanzo ni hasa maji na glikojeni, ambavyo hurudi unapokula."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "น้ำหนักลดลง %1$@ kg (%2$@%%) นับจากเริ่มต้น น้ำหนักที่ลดในช่วงแรกส่วนใหญ่เป็นน้ำและไกลโคเจน ซึ่งจะกลับคืนมาเมื่อคุณกลับมากินอาหาร"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Başlangıçtan bu yana %1$@ kg (%%%2$@) verdiniz. Erken kayıp çoğunlukla su ve glikojendir; bunlar yemeye başladığınızda geri gelir."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đã giảm %1$@ kg (%2$@%%) so với lúc bắt đầu. Lượng giảm ban đầu chủ yếu là nước và glycogen, sẽ quay lại khi bạn ăn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "自开始以来减轻了 %1$@ kg（%2$@%%）。早期减掉的主要是水分和糖原，恢复进食后会回来。"
          }
        }
      }
    },
    "before.doctor.body": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تحاليل دم (لوحة الأيض وتعداد الدم)، وتحليل بول، وتخطيط كهربية القلب (ECG) أثناء الراحة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Blutuntersuchungen (Stoffwechselwerte und Blutbild), eine Urinuntersuchung und ein Ruhe-EKG."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Blood tests (metabolic panel and blood count), a urine test and a resting ECG."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Análisis de sangre (perfil metabólico y hemograma), un análisis de orina y un ECG en reposo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Des analyses de sang (bilan métabolique et numération formule sanguine), une analyse d’urine et un ECG au repos."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "खून की जाँच (मेटाबोलिक पैनल और ब्लड काउंट), पेशाब की जाँच और आराम की अवस्था में ईसीजी (ECG)।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tes darah (panel metabolik dan hitung darah), tes urine, dan ECG saat istirahat."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Esami del sangue (pannello metabolico ed emocromo), esame delle urine ed ECG a riposo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "血液検査（生化学検査と血算）、尿検査、安静時心電図。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "혈액 검사(대사 패널과 혈구 검사), 소변 검사, 안정 시 심전도(ECG)."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Ujian darah (panel metabolik dan kiraan darah), ujian air kencing dan ECG semasa rehat."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bloedonderzoek (stofwisselingswaarden en bloedbeeld), urineonderzoek en een ECG in rust."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Badania krwi (panel metaboliczny i morfologia), badanie moczu i spoczynkowe EKG."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Exames de sangue (painel metabólico e hemograma), exame de urina e ECG em repouso."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Анализы крови (биохимический и общий анализ крови), анализ мочи и ЭКГ в покое."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Blodprover (blodkemi och blodstatus), ett urinprov och ett vilo-EKG."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Vipimo vya damu (kemikali za damu na hesabu ya seli za damu), kipimo cha mkojo na kipimo cha umeme wa moyo (ECG) ukiwa umepumzika."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ตรวจเลือด (ค่าเคมีในเลือดและความสมบูรณ์ของเม็ดเลือด) ตรวจปัสสาวะ และตรวจคลื่นไฟฟ้าหัวใจ (ECG) ขณะพัก"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kan tahlilleri (metabolik panel ve kan sayımı), idrar tahlili ve dinlenme halinde EKG."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Xét nghiệm máu (bảng chuyển hóa và công thức máu), xét nghiệm nước tiểu và điện tâm đồ lúc nghỉ."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "验血（生化检查和血常规）、尿检和静息心电图。"
          }
        }
      }
    },
    "before.doctor.title": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "راجع الطبيب أولًا"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zuerst ärztlich untersuchen lassen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "See a doctor first"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ve primero al médico"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Consultez d’abord un médecin"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पहले डॉक्टर से मिलें"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Temui dokter terlebih dahulu"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Prima vai dal medico"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "まず医師の診察を受ける"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "먼저 의사를 만나세요"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Jumpa doktor dahulu"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ga eerst naar een arts"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Najpierw skonsultuj się z lekarzem"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Consulte um médico antes"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сначала обратитесь к врачу"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Träffa en läkare först"
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Mwone daktari kwanza"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "พบแพทย์ก่อน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Önce doktora görünün"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Gặp bác sĩ trước"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "先去看医生"
          }
        }
      }
    },
    "before.ease_in.body": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تناول الفواكه والخضراوات النيئة والمطهوة على البخار فقط لمدة يومين قبل الصيام."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Essen Sie in den zwei Tagen davor nur rohes und gedämpftes Obst und Gemüse."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Eat only raw and steamed fruit and vegetables for two days beforehand."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Come solo fruta y verdura crudas y al vapor durante los dos días previos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mangez uniquement des fruits et légumes crus et cuits à la vapeur pendant les deux jours qui précèdent."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "उपवास से पहले के दो दिन केवल कच्चे और भाप में पके फल और सब्ज़ियाँ खाएँ।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Makan hanya buah dan sayuran mentah serta kukus selama dua hari sebelumnya."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nei due giorni precedenti mangia solo frutta e verdura crude o al vapore."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "事前の2日間は、生または蒸した果物と野菜だけを食べてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "단식 전 이틀 동안은 날것 또는 찐 과일과 채소만 드세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Makan hanya buah-buahan dan sayur-sayuran mentah dan kukus selama dua hari sebelumnya."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Eet de twee dagen ervoor alleen rauwe en gestoomde groente en fruit."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przez dwa dni przed postem jedz wyłącznie surowe i gotowane na parze owoce i warzywa."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Coma apenas frutas e legumes crus ou cozidos no vapor nos dois dias anteriores."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "За два дня до начала ешьте только сырые и приготовленные на пару фрукты и овощи."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ät bara rå och ångkokt frukt och grönsaker de två dagarna innan."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Kula matunda na mboga mbichi au zilizopikwa kwa mvuke pekee kwa siku mbili kabla."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "กินเฉพาะผลไม้และผักสดหรือนึ่งเป็นเวลาสองวันก่อนเริ่มอดอาหาร"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Öncesindeki iki gün boyunca yalnızca çiğ ve buharda pişmiş meyve ve sebze yiyin."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chỉ ăn trái cây và rau sống hoặc hấp trong hai ngày trước đó."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "断食前两天只吃生的和蒸熟的水果和蔬菜。"
          }
        }
      }
    },
    "before.ease_in.title": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مهّد للصيام لمدة 48 ساعة"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "48 Stunden lang sanft einsteigen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ease in for 48 hours"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Prepárate durante 48 horas"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Préparez-vous pendant 48 heures"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "48 घंटे पहले से धीरे-धीरे तैयारी करें"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Masa transisi selama 48 jam"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Preparati per 48 ore"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "48時間かけて体を慣らす"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "48시간 동안 서서히 준비하세요"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Bersedia secara beransur-ansur selama 48 jam"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bouw 48 uur geleidelijk af"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przygotuj się przez 48 godzin"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Faça uma transição de 48 horas"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Плавный вход за 48 часов"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Förbered kroppen i 48 timmar"
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Jiandae kwa saa 48"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ค่อยๆ ปรับตัว 48 ชั่วโมง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "48 saat boyunca yavaşça geçiş yapın"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chuẩn bị dần trong 48 giờ"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用 48 小时逐步过渡"
          }
        }
      }
    },
    "before.refeed.body": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "نصف مدة الصيام على الأقل. فالصيام لمدة 10 أيام يحتاج إلى 5 أيام من إعادة التغذية الحذرة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mindestens halb so lange wie das Fasten. Ein 10-tägiges Fasten braucht 5 Tage sorgfältigen Kostaufbau."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "At least half as long as the fast. A 10-day fast needs 5 days of careful refeeding."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Al menos la mitad de lo que dure el ayuno. Un ayuno de 10 días necesita 5 días de realimentación cuidadosa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Au moins la moitié de la durée du jeûne. Un jeûne de 10 jours nécessite 5 jours de réalimentation prudente."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कम से कम उपवास का आधा समय। 10 दिन के उपवास के बाद 5 दिन सावधानी से दोबारा खाना शुरू करना होता है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Setidaknya separuh lama puasa. Puasa 10 hari memerlukan 5 hari makan kembali dengan hati-hati."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Almeno la metà della durata del digiuno. Un digiuno di 10 giorni richiede 5 giorni di rialimentazione attenta."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "断食期間の少なくとも半分の長さが必要です。10日間の断食なら、5日間の慎重な回復食が必要です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "최소한 단식 기간의 절반이 필요해요. 10일 단식이라면 5일 동안 신중하게 보식해야 해요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Sekurang-kurangnya separuh daripada tempoh puasa. Puasa 10 hari memerlukan 5 hari pemakanan semula secara berhati-hati."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Minstens half zo lang als het vasten. Na 10 dagen vasten zijn 5 dagen zorgvuldig opbouwen nodig."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Co najmniej połowę czasu trwania postu. Post 10-dniowy wymaga 5 dni ostrożnego wychodzenia z postu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Pelo menos metade da duração do jejum. Um jejum de 10 dias exige 5 dias de realimentação cuidadosa."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не меньше половины длительности голодания. После 10-дневного голодания нужно 5 дней осторожного выхода."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Minst hälften så lång tid som fastan. En fasta på 10 dagar kräver 5 dagars försiktig uppbyggnad."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Angalau nusu ya muda wa mfungo. Mfungo wa siku 10 unahitaji siku 5 za kurejea kula kwa uangalifu."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "อย่างน้อยครึ่งหนึ่งของระยะเวลาการอดอาหาร การอดอาหาร 10 วันต้องใช้เวลา 5 วันในการกลับมากินอาหารอย่างระมัดระวัง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "En az orucun yarısı kadar süre. 10 günlük bir oruç, 5 günlük dikkatli bir yeniden beslenme gerektirir."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ít nhất bằng một nửa thời gian nhịn ăn. Đợt nhịn ăn 10 ngày cần 5 ngày ăn lại cẩn thận."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "至少为断食时长的一半。10 天的断食需要 5 天谨慎复食。"
          }
        }
      }
    },
    "before.refeed.title": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "خصّص وقتًا لإعادة التغذية"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zeit für den Kostaufbau einplanen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Block out time to refeed"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Reserva tiempo para la realimentación"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Réservez du temps pour la réalimentation"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "दोबारा खाना शुरू करने के लिए समय निकालें"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Sisihkan waktu untuk makan kembali"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Riserva tempo per la rialimentazione"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "回復食の期間を確保する"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "보식할 시간을 확보하세요"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Peruntukkan masa untuk pemakanan semula"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Reserveer tijd om op te bouwen"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zarezerwuj czas na wychodzenie z postu"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Reserve tempo para a realimentação"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выделите время на выход из голодания"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Avsätt tid för uppbyggnaden"
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Tenga muda wa kurejea kula"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "กันเวลาไว้สำหรับการกลับมากินอาหาร"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yeniden beslenme için zaman ayırın"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Dành thời gian để ăn lại"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "预留复食时间"
          }
        }
      }
    },
    "before.rest.body": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "المشي الهادئ والاستلقاء فقط. فالراحة تحمي العضلات وتمنع الإغماء."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nur ruhiges Gehen und Liegen. Ruhe schützt die Muskeln und beugt Ohnmacht vor."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Quiet walking and lying down only. Rest protects muscle and prevents fainting."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo paseos tranquilos y recostarte. El reposo protege los músculos y evita los desmayos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Uniquement de la marche tranquille et du repos allongé. Le repos protège les muscles et évite les évanouissements."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "केवल धीरे टहलना और लेटना। आराम मांसपेशियों को बचाता है और बेहोशी को रोकता है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Hanya jalan santai dan berbaring. Istirahat melindungi otot dan mencegah pingsan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo passeggiate tranquille e riposo da sdraiati. Il riposo protegge i muscoli e previene gli svenimenti."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "静かに歩くことと横になることだけにしてください。安静にすることで筋肉が守られ、失神を防げます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "가벼운 걷기와 누워 있기만 하세요. 휴식은 근육을 보호하고 실신을 예방해요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Hanya berjalan santai dan berbaring. Rehat melindungi otot dan mencegah pengsan."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Alleen rustig wandelen en liggen. Rust beschermt je spieren en voorkomt flauwvallen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tylko spokojne spacery i leżenie. Odpoczynek chroni mięśnie i zapobiega omdleniom."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Apenas caminhadas leves e repouso deitado. O descanso protege os músculos e evita desmaios."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Только спокойная ходьба и отдых лёжа. Отдых сохраняет мышцы и предотвращает обмороки."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Bara lugna promenader och vila liggande. Vila skyddar musklerna och förebygger svimning."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Kutembea taratibu na kulala chini tu. Kupumzika hulinda misuli na huzuia kuzimia."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เดินเบาๆ และนอนพักเท่านั้น การพักผ่อนช่วยปกป้องกล้ามเนื้อและป้องกันการเป็นลม"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yalnızca sakin yürüyüş ve uzanma. Dinlenmek kasları korur ve bayılmayı önler."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chỉ đi bộ nhẹ nhàng và nằm nghỉ. Nghỉ ngơi giúp bảo vệ cơ và phòng ngừa ngất."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只做缓慢散步和躺卧休息。休息可以保护肌肉，防止晕倒。"
          }
        }
      }
    },
    "before.rest.title": {
      "extractionState": "manual",
      "localizations": {
