    "plan.supervised": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يشرف طبيب معالج على هذا الصيام، مع فحوصات منتظمة لضغط دمي ونبضي وتحاليل دم."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine medizinische Fachperson überwacht dieses Fasten, mit regelmäßigen Kontrollen meines Blutdrucks und Pulses sowie Blutuntersuchungen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A clinician is supervising this fast, with regular checks of my blood pressure, pulse and blood tests."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un profesional de la salud supervisa este ayuno, con controles periódicos de mi presión arterial, mi pulso y análisis de sangre."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un professionnel de santé assure le suivi de ce jeûne, avec des contrôles réguliers de ma tension artérielle, de mon pouls et des analyses de sang."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह उपवास एक चिकित्सक की निगरानी में है, और मेरे ब्लड प्रेशर, पल्स और खून की नियमित जाँच हो रही है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tenaga medis mengawasi puasa ini, dengan pemeriksaan rutin tekanan darah, denyut nadi, dan tes darah saya."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un medico supervisiona questo digiuno, con controlli regolari di pressione, pulsazioni ed esami del sangue."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "医療者がこの断食を管理し、血圧、脈拍、血液検査を定期的にチェックしています。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "의료진이 제 혈압과 맥박을 정기적으로 확인하고 혈액 검사를 하며 이 단식을 감독하고 있어요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Pengamal perubatan sedang mengawasi puasa ini, dengan pemeriksaan tetap tekanan darah, nadi dan ujian darah saya."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een zorgverlener houdt toezicht op dit vasten, met regelmatige controle van mijn bloeddruk, hartslag en bloedwaarden."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ten post nadzoruje lekarz, który regularnie sprawdza moje ciśnienie krwi, tętno i wyniki badań krwi."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um profissional de saúde está supervisionando este jejum, com verificações regulares da minha pressão arterial, do meu pulso e exames de sangue."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "За этим голоданием наблюдает врач, который регулярно проверяет моё давление, пульс и анализы крови."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Vårdpersonal övervakar den här fastan, med regelbundna kontroller av mitt blodtryck, min puls och blodprover."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Mtaalamu wa afya anasimamia mfungo huu, akipima mara kwa mara shinikizo langu la damu na mapigo ya moyo, na kufanya vipimo vya damu."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "มีแพทย์ผู้ดูแลกำกับการอดอาหารครั้งนี้ โดยตรวจความดันโลหิต ชีพจร และตรวจเลือดของฉันเป็นประจำ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu oruç, kan basıncım, nabzım ve kan tahlillerim düzenli olarak kontrol edilerek bir sağlık uzmanının gözetiminde yapılıyor."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Có nhân viên y tế đang giám sát đợt nhịn ăn này, thường xuyên kiểm tra huyết áp, mạch và xét nghiệm máu cho tôi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "有医生在监护这次断食，并定期检查我的血压、脉搏和进行验血。"
          }
        }
      }
    },
