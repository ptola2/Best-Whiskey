    "refeed.active.intro": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "بعد صيام دام %1$lld ساعة، يلزمك %2$@ على الأقل لإعادة التغذية، أي نصف مدة الصيام."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nach einem Fasten von %1$lld Stunden dauert der Kostaufbau mindestens %2$@: halb so lange wie das Fasten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "After a fast of %1$lld hours, refeed for at least %2$@: half the length of the fast."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tras un ayuno de %1$lld horas, dedica al menos %2$@ a la realimentación: la mitad de lo que duró el ayuno."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Après un jeûne de %1$lld heures, réalimentez-vous pendant au moins %2$@ : la moitié de la durée du jeûne."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld घंटे के उपवास के बाद, कम से कम %2$@ तक दोबारा खाने का चरण चलाएँ: यानी उपवास की लंबाई का आधा।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Setelah puasa %1$lld jam, jalani masa makan kembali setidaknya %2$@: separuh lama puasa."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Dopo un digiuno di %1$lld ore, rialimentati per almeno %2$@: metà della durata del digiuno."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld時間の断食の後は、少なくとも%2$@（断食期間の半分）回復食を続けてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld시간 단식 후에는 최소 %2$@ 동안 보식하세요. 단식 기간의 절반이에요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Selepas puasa selama %1$lld jam, lakukan pemakanan semula selama sekurang-kurangnya %2$@: separuh daripada tempoh puasa."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Na %1$lld uur vasten bouw je minstens %2$@ op: de helft van de duur van het vasten."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Po poście trwającym %1$lld h wychodź z niego przez co najmniej %2$@, czyli połowę czasu jego trwania."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Após um jejum de %1$lld horas, faça a realimentação por pelo menos %2$@: metade da duração do jejum."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Голодание длилось %1$lld ч, поэтому выход из него должен занять не меньше половины этого срока: %2$@."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Efter en fasta på %1$lld timmar bör uppbyggnaden pågå i minst %2$@: hälften av fastans längd."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Baada ya mfungo wa saa %1$lld, rejea kula kwa angalau %2$@: nusu ya urefu wa mfungo."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "หลังการอดอาหาร %1$lld ชั่วโมง ให้ใช้เวลากลับมากินอาหารอย่างน้อย %2$@ ซึ่งเท่ากับครึ่งหนึ่งของระยะเวลาการอดอาหาร"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld saatlik bir oruçtan sonra en az %2$@ boyunca yeniden beslenin: orucun yarısı kadar süre."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Sau đợt nhịn ăn %1$lld giờ, hãy ăn lại trong ít nhất %2$@: bằng một nửa thời gian nhịn ăn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "断食 %1$lld 小时后，至少复食 %2$@：即断食时长的一半。"
          }
        }
      }
    },
    "refeed.finish.body": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "انتقل إلى نظام غذائي قائم على الأطعمة الكاملة وقليل الصوديوم. فمن دون تغييرات دائمة، يعود ضغط الدم وسكر الدم ودهون الدم تدريجيًا نحو مستوياتها الأولى خلال 3 إلى 4 أشهر."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Stellen Sie auf eine natriumarme Vollwertkost um. Ohne dauerhafte Veränderungen kehren Blutdruck, Blutzucker und Blutfette innerhalb von 3 bis 4 Monaten in Richtung der Ausgangswerte zurück."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Move on to a whole-food, low-sodium diet. Without lasting changes, blood pressure, blood sugar and blood fats drift back toward where they started within 3 to 4 months."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pasa a una dieta de alimentos mínimamente procesados y baja en sodio. Sin cambios duraderos, la presión arterial, el azúcar en sangre y las grasas en sangre vuelven a acercarse a sus valores iniciales en 3 a 4 meses."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Passez à une alimentation à base d’aliments non transformés, pauvre en sodium. Sans changements durables, la tension artérielle, la glycémie et les graisses sanguines reviennent vers leurs valeurs de départ en 3 à 4 mois."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अब बिना प्रोसेस किए प्राकृतिक भोजन वाले, कम सोडियम वाले आहार पर आएँ। स्थायी बदलावों के बिना, 3 से 4 महीनों में ब्लड प्रेशर, ब्लड शुगर और खून की वसा फिर से शुरुआती स्तर की ओर लौट जाते हैं।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Beralihlah ke pola makan berbahan makanan utuh yang rendah natrium. Tanpa perubahan yang bertahan lama, tekanan darah, gula darah, dan lemak darah akan kembali mendekati kondisi awal dalam 3 sampai 4 bulan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Passa a un'alimentazione a base di cibi non trasformati e povera di sodio. Senza cambiamenti duraturi, pressione, glicemia e grassi nel sangue tornano verso i valori di partenza entro 3-4 mesi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "未加工の食品を中心とした減塩の食事に移行してください。食生活を継続的に変えなければ、血圧、血糖値、血中脂質は3〜4か月以内に元の水準へ戻っていきます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "자연식품 위주의 저염식으로 넘어가세요. 지속적인 변화가 없으면 혈압, 혈당, 혈중 지질이 3~4개월 안에 처음 수준 쪽으로 다시 돌아가요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Beralih kepada diet makanan tidak diproses yang rendah natrium. Tanpa perubahan yang berkekalan, tekanan darah, gula darah dan lemak darah akan beransur-ansur kembali ke arah paras asal dalam tempoh 3 hingga 4 bulan."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Stap over op onbewerkte, natriumarme voeding. Zonder blijvende veranderingen schuiven bloeddruk, bloedsuiker en bloedvetten binnen 3 tot 4 maanden terug naar waar ze begonnen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przejdź na dietę opartą na nieprzetworzonej żywności, z małą ilością sodu. Bez trwałych zmian ciśnienie krwi, poziom cukru i tłuszczów we krwi w ciągu 3 do 4 miesięcy stopniowo wracają w kierunku wartości wyjściowych."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Passe para uma alimentação à base de alimentos naturais e com pouco sódio. Sem mudanças duradouras, a pressão arterial, o açúcar no sangue e as gorduras no sangue tendem a voltar para perto dos níveis iniciais em 3 a 4 meses."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Переходите на питание цельными продуктами с низким содержанием натрия. Без устойчивых изменений давление, уровень сахара и жиров в крови в течение 3–4 месяцев постепенно возвращаются к исходным значениям."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Gå över till en kost med hela, oprocessade livsmedel och lite natrium. Utan bestående förändringar glider blodtryck, blodsocker och blodfetter tillbaka mot utgångsläget inom 3 till 4 månader."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Hamia kwenye lishe ya vyakula visivyosindikwa yenye sodiamu kidogo. Bila mabadiliko ya kudumu, shinikizo la damu, sukari ya damu na mafuta ya damu hurudi taratibu karibu na yalipoanzia ndani ya miezi 3 hadi 4."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เปลี่ยนไปกินอาหารที่ไม่ผ่านการแปรรูปและมีโซเดียมต่ำ หากไม่เปลี่ยนแปลงพฤติกรรมอย่างถาวร ความดันโลหิต น้ำตาลในเลือด และไขมันในเลือดจะค่อยๆ กลับไปใกล้ค่าเริ่มต้นภายใน 3 ถึง 4 เดือน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İşlenmemiş gıdalara dayalı, düşük sodyumlu bir beslenmeye geçin. Kalıcı değişiklikler yapılmazsa kan basıncı, kan şekeri ve kan yağları 3 ila 4 ay içinde başlangıçtaki düzeylerine doğru geri döner."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chuyển sang chế độ ăn thực phẩm tự nhiên, ít qua chế biến và ít natri. Nếu không thay đổi lâu dài, huyết áp, đường huyết và mỡ máu sẽ dần quay về mức ban đầu trong vòng 3 đến 4 tháng."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "接下来转为以天然完整食物为主的低钠饮食。如果没有持久的改变，血压、血糖和血脂会在 3 至 4 个月内逐渐回到原来的水平。"
          }
        }
      }
    },
    "refeed.finish.button": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعليم إعادة التغذية كمكتملة"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kostaufbau als abgeschlossen markieren"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Mark refeeding complete"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Marcar la realimentación como terminada"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Marquer la réalimentation comme terminée"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "दोबारा खाने का चरण पूरा चिह्नित करें"
          }
        },
        "id": {
