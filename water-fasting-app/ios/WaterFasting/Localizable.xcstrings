    "water.status.above": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أعلى من النطاق المعتاد. الإكثار من الماء العادي ليس أفضل: فقد يخفّف تركيز الصوديوم في الدم."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Über dem üblichen Bereich. Mehr reines Wasser ist nicht besser: Es kann das Natrium im Blut verdünnen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Above the usual range. More plain water is not better: it can dilute blood sodium."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Por encima del rango habitual. Más agua sola no es mejor: puede diluir el sodio en sangre."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Au-dessus de la plage habituelle. Boire plus d’eau pure n’est pas mieux : cela peut diluer le sodium sanguin."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सामान्य सीमा से ज़्यादा। ज़्यादा सादा पानी बेहतर नहीं है: यह खून में सोडियम को पतला कर सकता है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Di atas kisaran biasa. Lebih banyak air putih tidak lebih baik: air dapat mengencerkan natrium darah."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sopra l'intervallo consueto. Più acqua semplice non è meglio: può diluire il sodio nel sangue."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "通常の範囲を上回っています。普通の水は多く飲めばよいわけではありません。血中ナトリウムを薄めるおそれがあります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "일반적인 범위를 넘었어요. 맹물을 더 마신다고 좋은 것은 아니에요. 혈중 나트륨을 묽게 만들 수 있어요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Melebihi julat biasa. Lebih banyak air kosong tidak lebih baik: ia boleh mencairkan natrium darah."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Boven het gebruikelijke bereik. Meer gewoon water is niet beter: het kan het natrium in je bloed verdunnen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Powyżej zwykłego zakresu. Więcej czystej wody nie znaczy lepiej: może rozcieńczyć sód we krwi."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Acima da faixa habitual. Mais água pura não é melhor: ela pode diluir o sódio no sangue."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выше обычного диапазона. Больше чистой воды не значит лучше: она может разбавлять натрий в крови."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Över det vanliga intervallet. Mer rent vatten är inte bättre: det kan späda ut natriumet i blodet."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Juu ya kiwango cha kawaida. Maji matupu zaidi si bora: yanaweza kupunguza ukolezi wa sodiamu katika damu."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "สูงกว่าช่วงปกติ การดื่มน้ำเปล่ามากขึ้นไม่ได้ดีกว่า เพราะอาจทำให้โซเดียมในเลือดเจือจาง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Olağan aralığın üzerinde. Daha fazla sade su daha iyi değildir: kandaki sodyumu seyreltebilir."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cao hơn mức thông thường. Uống thêm nước lọc không tốt hơn: nó có thể làm loãng natri trong máu."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "高于通常范围。多喝纯水并不更好：它可能稀释血钠。"
          }
        }
      }
    },
    "water.status.below": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أقل من الحد الأدنى اليومي البالغ 1.2 L حتى الآن."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bisher unter dem täglichen Minimum von 1,2 L."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Below the 1.2 L daily minimum so far."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Por ahora, por debajo del mínimo diario de 1,2 L."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "En dessous du minimum quotidien de 1,2 L pour l’instant."
