    "duration.shortterm.note": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "من 24 إلى 72 ساعة. ينفد الجليكوجين وتبدأ الحالة الكيتونية المبكرة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "24 bis 72 Stunden. Das Glykogen geht zur Neige und eine frühe Ketose beginnt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "24 to 72 hours. Glycogen runs out and early ketosis begins."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "De 24 a 72 horas. El glucógeno se agota y comienza la cetosis temprana."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "24 à 72 heures. Le glycogène s’épuise et une cétose précoce commence."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "24 से 72 घंटे। ग्लाइकोजन खत्म हो जाता है और शुरुआती कीटोसिस शुरू होता है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "24 sampai 72 jam. Glikogen habis dan ketosis awal dimulai."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Da 24 a 72 ore. Il glicogeno si esaurisce e inizia la chetosi precoce."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "24〜72時間。グリコーゲンが尽き、初期のケトーシスが始まります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "24~72시간. 글리코겐이 바닥나고 초기 케토시스가 시작돼요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "24 hingga 72 jam. Glikogen habis dan ketosis awal bermula."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "24 tot 72 uur. Het glycogeen raakt op en de vroege ketose begint."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Od 24 do 72 godzin. Glikogen się wyczerpuje i zaczyna się wczesna ketoza."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "24 a 72 horas. O glicogênio se esgota e a cetose inicial começa."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "От 24 до 72 часов. Запасы гликогена заканчиваются, начинается ранний кетоз."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "24 till 72 timmar. Glykogenet tar slut och tidig ketos börjar."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Saa 24 hadi 72. Glikojeni huisha na hali ya ketosisi (ketosis) ya awali huanza."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "24 ถึง 72 ชั่วโมง ไกลโคเจนหมดลงและภาวะคีโตซิสระยะแรกเริ่มต้นขึ้น"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "24 ila 72 saat. Glikojen tükenir ve erken ketozis başlar."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "24 đến 72 giờ. Glycogen cạn dần và giai đoạn nhiễm ceton sớm bắt đầu."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "24 至 72 小时。糖原耗尽，早期酮症开始。"
          }
        }
      }
    },
