    "cloud.signout_needs_update": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "بعض التغييرات غير منسوخة احتياطيًا، لذا لم يُسجَّل خروجك. حدّث التطبيق ثم حاول مرة أخرى."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Einige Änderungen sind nicht gesichert, daher sind Sie weiterhin angemeldet. Aktualisieren Sie die App und versuchen Sie es dann erneut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Some changes are not backed up, so you are still signed in. Update the app, then try again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Algunos cambios no tienen copia de seguridad, así que sigues con la sesión iniciada. Actualiza la app y vuelve a intentarlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Certaines modifications ne sont pas sauvegardées, votre session reste donc ouverte. Mettez à jour l’app, puis réessayez."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कुछ बदलावों का बैकअप नहीं हुआ है, इसलिए आप अभी भी साइन इन हैं। ऐप अपडेट करें, फिर दोबारा कोशिश करें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Beberapa perubahan tidak tercadangkan, jadi Anda masih masuk. Perbarui aplikasi, lalu coba lagi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Alcune modifiche non sono salvate nel backup, quindi l'accesso è ancora attivo. Aggiorna l'app, poi riprova."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "バックアップされていない変更があるため、サインインしたままになっています。アプリをアップデートしてから、もう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "백업되지 않은 변경 사항이 있어서 로그인 상태가 유지되었어요. 앱을 업데이트한 후 다시 시도하세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Sesetengah perubahan tidak disandarkan, jadi anda masih log masuk. Kemas kini aplikasi, kemudian cuba lagi."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Van sommige wijzigingen is geen back-up gemaakt, dus je bent nog ingelogd. Werk de app bij en probeer het daarna opnieuw."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Niektóre zmiany nie mają kopii zapasowej, więc nie wylogowano cię. Zaktualizuj aplikację i spróbuj ponownie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Algumas alterações não estão no backup, então sua sessão continua ativa. Atualize o aplicativo e tente novamente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Некоторые изменения не сохранены в резервной копии, поэтому вы всё ещё в аккаунте. Обновите приложение и повторите попытку."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Vissa ändringar är inte säkerhetskopierade, så du är fortfarande inloggad. Uppdatera appen och försök sedan igen."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Baadhi ya mabadiliko hayajahifadhiwa, kwa hiyo bado umeingia. Sasisha programu, kisha ujaribu tena."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การเปลี่ยนแปลงบางส่วนไม่ได้สำรองไว้ คุณจึงยังลงชื่อเข้าใช้อยู่ อัปเดตแอปแล้วลองอีกครั้ง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bazı değişiklikler yedeklenmedi, bu yüzden oturumunuz hâlâ açık. Uygulamayı güncelleyin, ardından yeniden deneyin."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Một số thay đổi chưa được sao lưu nên bạn vẫn đang đăng nhập. Hãy cập nhật ứng dụng rồi thử lại."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "部分更改尚未备份，因此你仍处于登录状态。请更新 App 后重试。"
          }
        }
      }
    },
