    "tier.low.monitoring": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الفحوصات الأساسية فقط. أجرِ الفحوصات إذا ظهرت أعراض."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nur Basisuntersuchungen. Lassen Sie sich testen, wenn Symptome auftreten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Baseline checks only. Get tested if symptoms appear."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo controles iniciales. Hazte pruebas si aparecen síntomas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Contrôles de départ uniquement. Faites des analyses si des symptômes apparaissent."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "केवल शुरुआती जाँच। लक्षण दिखें तो जाँच करवाएँ।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Hanya pemeriksaan awal. Lakukan tes jika muncul gejala."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo controlli di base. Fai degli esami se compaiono sintomi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "開始時の確認のみ。症状が出たら検査を受けてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기본 검사만 해요. 증상이 나타나면 검사를 받으세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Pemeriksaan asas sahaja. Jalani ujian jika simptom muncul."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Alleen een nulmeting vooraf. Laat je testen als er klachten optreden."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tylko badania wyjściowe. Zbadaj się, jeśli pojawią się objawy."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Apenas avaliações iniciais. Faça exames se surgirem sintomas."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Только исходные обследования. Сдайте анализы, если появятся симптомы."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Bara grundläggande kontroller. Låt testa dig om symtom uppstår."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Vipimo vya msingi tu. Pima ikiwa dalili zitajitokeza."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ตรวจพื้นฐานเท่านั้น ตรวจเพิ่มเติมหากมีอาการ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yalnızca başlangıç kontrolleri. Belirti ortaya çıkarsa test yaptırın."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chỉ kiểm tra ban đầu. Hãy đi xét nghiệm nếu xuất hiện triệu chứng."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只做基线检查。如果出现症状，请去检查。"
          }
        }
      }
    },
    "tier.moderate.criteria": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "صيام من 5 إلى 7 أيام، أو مؤشر كتلة جسم من 16 إلى 18.5."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fasten von 5 bis 7 Tagen oder BMI 16 bis 18,5."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Fast of 5 to 7 days, or BMI 16 to 18.5."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ayuno de 5 a 7 días, o IMC de 16 a 18,5."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeûne de 5 à 7 jours, ou IMC de 16 à 18,5."
          }
