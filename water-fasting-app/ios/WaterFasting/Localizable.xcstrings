    "complication.ortho.signs": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "شبه إغماء، ودوخة، وتسارع النبض عند الوقوف"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beinahe-Ohnmacht, Benommenheit, schneller Puls beim Aufstehen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Near-fainting, lightheadedness, racing pulse on standing"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sensación de desmayo, mareo, pulso acelerado al ponerse de pie"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Quasi-évanouissement, étourdissements, pouls rapide en position debout"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "खड़े होने पर बेहोशी जैसा लगना, हल्का चक्कर, तेज़ पल्स"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Hampir pingsan, kepala terasa melayang, nadi cepat saat berdiri"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quasi svenimento, testa leggera, polso accelerato quando ti alzi"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "立ったときに気が遠くなる、ふらつき、脈が速くなる"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "실신할 듯한 느낌, 어지러움, 일어설 때 빠른 맥박"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Hampir pengsan, pening, nadi laju apabila berdiri"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bijna flauwvallen, licht in het hoofd, snelle hartslag bij opstaan"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Stan bliski omdlenia, zawroty głowy, szybkie tętno po wstaniu"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Quase desmaio, tontura, pulso acelerado ao ficar de pé"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Предобморочное состояние, головокружение, учащённый пульс при вставании"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Nära att svimma, yrsel, snabb puls när du reser dig"
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Karibu kuzimia, kizunguzungu, mapigo ya moyo ya kasi unaposimama"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เกือบเป็นลม หน้ามืด ชีพจรเร็วเมื่อลุกยืน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
