    "water.status.none": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم يُسجَّل شيء اليوم بعد."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Heute noch nichts eingetragen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nothing logged yet today."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aún no has registrado nada hoy."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rien d’enregistré aujourd’hui pour l’instant."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आज अभी तक कुछ दर्ज नहीं किया गया।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Belum ada yang dicatat hari ini."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Oggi non hai ancora registrato nulla."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "今日はまだ記録がありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "오늘은 아직 기록이 없어요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Belum ada catatan hari ini."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vandaag nog niets genoteerd."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dziś nic jeszcze nie zapisano."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nada registrado hoje ainda."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сегодня пока ничего не записано."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Inget loggat idag än."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Bado hujarekodi chochote leo."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "วันนี้ยังไม่มีการบันทึก"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bugün henüz kayıt yok."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hôm nay chưa ghi nhận gì."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "今天还没有记录。"
          }
        }
      }
    },
    "water.title": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الماء اليوم"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wasser heute"
          }
        },
        "en": {
