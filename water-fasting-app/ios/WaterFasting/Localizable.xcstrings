            "value": "到第 7 至 10 天时每天减轻的体重（kg）"
          }
        }
      }
    },
    "learn.stat.lean_mass": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "من الوزن المفقود في صيام 5 إلى 20 يومًا كتلة خالية من الدهون، يُستعاد معظمها خلال 3 إلى 5 أيام"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "des Verlusts bei 5- bis 20-tägigem Fasten ist Magermasse, größtenteils innerhalb von 3 bis 5 Tagen zurückgewonnen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "of loss in 5 to 20 day fasts is lean mass, mostly regained within 3 to 5 days"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "de la pérdida en ayunos de 5 a 20 días es masa magra, que en su mayoría se recupera en 3 a 5 días"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "de la perte lors de jeûnes de 5 à 20 jours est de la masse maigre, en grande partie récupérée en 3 à 5 jours"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "5 से 20 दिन के उपवासों में घटे वज़न का यह हिस्सा लीन मास होता है, जो ज़्यादातर 3 से 5 दिनों में वापस आ जाता है"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "dari penurunan pada puasa 5 sampai 20 hari adalah massa tanpa lemak, sebagian besar kembali dalam 3 sampai 5 hari"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "della perdita nei digiuni da 5 a 20 giorni è massa magra, in gran parte recuperata entro 3-5 giorni"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "5〜20日間の断食で減った分のうち除脂肪量の割合。大部分は3〜5日以内に戻る"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "5~20일 단식에서 감량 중 제지방 비율, 대부분 3~5일 안에 회복"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "daripada kehilangan berat badan dalam puasa 5 hingga 20 hari ialah jisim tanpa lemak, kebanyakannya diperoleh semula dalam 3 hingga 5 hari"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "van het verlies bij vasten van 5 tot 20 dagen is vetvrije massa, grotendeels binnen 3 tot 5 dagen teruggewonnen"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "ubytku w postach trwających od 5 do 20 dni to masa beztłuszczowa, w większości odzyskiwana w ciągu 3 do 5 dni"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "da perda em jejuns de 5 a 20 dias é massa magra, em grande parte recuperada em 3 a 5 dias"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "потери веса при голоданиях от 5 до 20 дней приходится на безжировую массу, которая в основном восстанавливается за 3–5 дней"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "av viktnedgången vid fastor på 5 till 20 dagar är fettfri massa, som till största delen återfås inom 3 till 5 dagar"
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "ya uzito unaopotea katika mifungo ya siku 5 hadi 20 ni uzito usio wa mafuta (lean mass), mwingi hurudi ndani ya siku 3 hadi 5"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ของน้ำหนักที่ลดในการอดอาหาร 5 ถึง 20 วันเป็นมวลไร้ไขมัน ซึ่งส่วนใหญ่กลับคืนมาภายใน 3 ถึง 5 วัน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "5 ila 20 günlük oruçlarda kaybın yağsız kütle olan kısmı; çoğu 3 ila 5 gün içinde geri kazanılır"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "lượng giảm trong các đợt nhịn ăn 5 đến 20 ngày là khối nạc, phần lớn được lấy lại trong 3 đến 5 ngày"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "5 至 20 天断食中减掉的瘦体重占比，大部分在 3 至 5 天内恢复"
          }
        }
      }
    },
    "learn.stat.serious": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أحداث مهددة للحياة / وفيات، وجميعها تحت فحوصات طبية يومية"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "lebensbedrohliche Ereignisse / Todesfälle, alle unter täglichen medizinischen Kontrollen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "life-threatening events / deaths, all under daily medical checks"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "eventos potencialmente mortales / muertes, todos con controles médicos diarios"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "événements mettant la vie en danger / décès, tous sous contrôles médicaux quotidiens"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "जानलेवा घटनाएँ / मौतें, सभी रोज़ाना चिकित्सकीय जाँच के दौरान"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "kejadian yang mengancam jiwa / kematian, semuanya dengan pemeriksaan medis harian"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "eventi potenzialmente mortali / decessi, tutti sotto controllo medico quotidiano"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "生命を脅かす事象 / 死亡。いずれも毎日の医療チェック下"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "생명을 위협하는 사건 / 사망, 모두 매일 의료 점검을 받던 중"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "kejadian mengancam nyawa / kematian, semuanya di bawah pemeriksaan perubatan harian"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "levensbedreigende voorvallen / overlijdens, allemaal onder dagelijkse medische controle"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "zdarzenia zagrażające życiu / zgony, wszystkie przy codziennej kontroli lekarskiej"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "eventos com risco de vida / mortes, todos sob acompanhamento médico diário"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "угрожающих жизни явлений / смертей, все при ежедневном медицинском контроле"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "livshotande händelser / dödsfall, alla under daglig medicinsk kontroll"
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "matukio ya kutishia maisha / vifo, yote yakiwa chini ya uchunguzi wa kitabibu wa kila siku"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เหตุการณ์ที่คุกคามชีวิต / การเสียชีวิต ทั้งหมดอยู่ภายใต้การตรวจทางการแพทย์ทุกวัน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "yaşamı tehdit eden olay / ölüm; hepsi günlük tıbbi kontroller altında"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "biến cố đe dọa tính mạng / tử vong, tất cả đều xảy ra khi đang được kiểm tra y tế hằng ngày"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "危及生命的事件 / 死亡，均发生在每日医疗检查之下"
          }
        }
      }
    },
    "learn.title": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ما يفعله الصيام على الماء فقط بالجسم"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Was reines Wasserfasten im Körper bewirkt"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What a water-only fast does to the body"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Lo que un ayuno solo con agua le hace al cuerpo"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce qu’un jeûne à l’eau seule fait au corps"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "केवल पानी वाला उपवास शरीर पर क्या असर करता है"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Apa yang dilakukan puasa hanya air terhadap tubuh"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Cosa fa al corpo un digiuno a sola acqua"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "水だけの断食が体に及ぼす影響"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "물만 마시는 단식이 몸에 일으키는 변화"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Apa yang dilakukan puasa air sahaja kepada badan"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wat vasten op alleen water met het lichaam doet"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Co post o samej wodzie robi z organizmem"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O que um jejum apenas com água faz com o corpo"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Что голодание только на воде делает с организмом"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Vad en ren vattenfasta gör med kroppen"
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Mfungo wa maji pekee unafanya nini mwilini"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การอดอาหารแบบดื่มน้ำเปล่าอย่างเดียวส่งผลต่อร่างกายอย่างไร"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yalnızca su ile yapılan oruç vücuda ne yapar"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nhịn ăn chỉ uống nước tác động lên cơ thể như thế nào"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "纯水断食对身体有什么影响"
          }
        }
      }
    },
    "learn.types.durations": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "المدد في الدراسات: قصير الأمد من 24 إلى 72 ساعة، ومطوّل من 4 إلى 21 يومًا، ومفرط أكثر من 21 يومًا (حتى 40 يومًا في بعض المجموعات ضمن برامج الإقامة الداخلية)."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dauer in Studien: Kurzzeitfasten 24 bis 72 Stunden, Langzeitfasten 4 bis 21 Tage, extremes Fasten über 21 Tage (in manchen stationären Gruppen bis zu 40)."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Durations in studies: short-term 24 to 72 hours, prolonged 4 to 21 days, extreme over 21 days (up to 40 in some residential groups)."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Duraciones en los estudios: corto plazo, de 24 a 72 horas; prolongado, de 4 a 21 días; extremo, más de 21 días (hasta 40 en algunos grupos residenciales)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Durées dans les études : courte durée de 24 à 72 heures, prolongé de 4 à 21 jours, extrême au-delà de 21 jours (jusqu’à 40 dans certains groupes en établissement avec hébergement)."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अध्ययनों में अवधि: अल्पकालिक 24 से 72 घंटे, लंबा 4 से 21 दिन, अत्यधिक लंबा 21 दिन से ज़्यादा (कुछ आवासीय समूहों में 40 दिन तक)।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Durasi dalam penelitian: jangka pendek 24 sampai 72 jam, berkepanjangan 4 sampai 21 hari, ekstrem lebih dari 21 hari (hingga 40 hari pada beberapa kelompok yang menginap di klinik)."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Durate negli studi: a breve termine da 24 a 72 ore, prolungato da 4 a 21 giorni, estremo oltre 21 giorni (fino a 40 in alcuni gruppi in regime residenziale)."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "研究での期間：短期は24〜72時間、長期は4〜21日間、超長期は21日超（一部の入所型グループでは最長40日）。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "연구에서의 기간: 단기 24~72시간, 장기 4~21일, 극단적 21일 초과(일부 입소형 그룹에서는 최대 40일)."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tempoh dalam kajian: jangka pendek 24 hingga 72 jam, berpanjangan 4 hingga 21 hari, ekstrem melebihi 21 hari (sehingga 40 hari dalam sesetengah kumpulan yang tinggal di pusat rawatan)."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Duur in studies: kortdurend 24 tot 72 uur, langdurig 4 tot 21 dagen, extreem meer dan 21 dagen (tot 40 in sommige groepen met verblijf in een kliniek)."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Długość postów w badaniach: krótkoterminowe od 24 do 72 godzin, przedłużone od 4 do 21 dni, ekstremalne ponad 21 dni (w niektórych grupach stacjonarnych do 40 dni)."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Durações nos estudos: curta duração, 24 a 72 horas; prolongado, 4 a 21 dias; extremo, mais de 21 dias (até 40 em alguns grupos em regime de internação)."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Длительность в исследованиях: кратковременное голодание от 24 до 72 часов, длительное от 4 до 21 дня, экстремальное более 21 дня (до 40 дней в некоторых группах с проживанием в клинике)."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Längder i studier: korttidsfasta 24 till 72 timmar, långvarig fasta 4 till 21 dagar, extrem fasta över 21 dagar (upp till 40 i vissa grupper som bodde på klinik)."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Muda katika tafiti: muda mfupi saa 24 hadi 72, muda mrefu siku 4 hadi 21, kupindukia zaidi ya siku 21 (hadi 40 katika baadhi ya vikundi vilivyokaa vituoni)."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ระยะเวลาในงานวิจัย: ระยะสั้น 24 ถึง 72 ชั่วโมง ระยะยาว 4 ถึง 21 วัน และแบบสุดขั้วนานกว่า 21 วัน (สูงสุด 40 วันในกลุ่มที่พักในสถานพยาบาลบางกลุ่ม)"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Çalışmalardaki süreler: kısa süreli 24 ila 72 saat, uzun süreli 4 ila 21 gün, aşırı uzun 21 günden fazla (bazı yatılı gruplarda 40 güne kadar)."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thời gian trong các nghiên cứu: ngắn hạn 24 đến 72 giờ, kéo dài 4 đến 21 ngày, cực đoan trên 21 ngày (đến 40 ngày ở một số nhóm nội trú)."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "研究中的时长：短期为 24 至 72 小时，长时间为 4 至 21 天，极端为超过 21 天（部分住院式群体可达 40 天）。"
          }
        }
      }
    },
    "learn.who.absolute": {
      "extractionState": "manual",
      "localizations": {
