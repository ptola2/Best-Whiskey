          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld/%2$lld mmHg, Puls %3$lld · %4$@"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld/%2$lld mmHg, pulse %3$lld · %4$@"
          }
        },
