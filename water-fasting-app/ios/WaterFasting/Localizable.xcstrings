          "stringUnit": {
            "state": "translated",
            "value": "Maji ya leo: mililita %lld. Lengo ni 1,200 hadi 2,500."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การดื่มน้ำวันนี้: %lld มิลลิลิตร เป้าหมาย 1,200 ถึง 2,500"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bugünkü su: %lld mililitre. Hedef 1.200 ila 2.500."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nước hôm nay: %lld mililít. Mục tiêu 1.200 đến 2.500."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "今日饮水：%lld 毫升。目标 1,200 至 2,500。"
          }
        }
      }
    },
