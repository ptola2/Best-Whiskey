    },
    "stage.juice.text": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "عصير فواكه أو خضراوات طازج مخفف بالماء، من 100 إلى 200 mL كل 2 إلى 3 ساعات. يعيد تنشيط حمض المعدة والإنزيمات الهاضمة والإنسولين بلطف."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Frischer Obst- oder Gemüsesaft, mit Wasser verdünnt, 100 bis 200 mL alle 2 bis 3 Stunden. Das bringt Magensäure, Verdauungsenzyme und Insulin sanft wieder in Gang."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Fresh fruit or vegetable juice diluted with water, 100 to 200 mL every 2 to 3 hours. It gently restarts stomach acid, digestive enzymes and insulin."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Jugo fresco de fruta o verdura diluido con agua, de 100 a 200 mL cada 2 a 3 horas. Reactiva suavemente el ácido del estómago, las enzimas digestivas y la insulina."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Jus frais de fruits ou de légumes dilué dans de l’eau, 100 à 200 mL toutes les 2 à 3 heures. Il relance en douceur l’acidité gastrique, les enzymes digestives et l’insuline."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पानी मिलाकर पतला किया हुआ ताज़े फल या सब्ज़ी का जूस, हर 2 से 3 घंटे में 100 से 200 mL। यह पेट के एसिड, पाचक एंज़ाइम और इंसुलिन को धीरे-धीरे फिर से शुरू करता है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Jus buah atau sayur segar yang diencerkan dengan air, 100 sampai 200 mL setiap 2 sampai 3 jam. Jus ini dengan lembut mengaktifkan kembali asam lambung, enzim pencernaan, dan insulin."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Succo fresco di frutta o verdura diluito con acqua, da 100 a 200 mL ogni 2-3 ore. Riattiva delicatamente acidi gastrici, enzimi digestivi e insulina."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "新鮮な果物や野菜のジュースを水で薄めたものを、2〜3時間ごとに100〜200 mL。胃酸、消化酵素、インスリンの働きをゆっくり再開させます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "물로 희석한 신선한 과일 또는 채소 주스를 2~3시간마다 100~200 mL씩 마셔요. 위산, 소화 효소, 인슐린 분비를 부드럽게 다시 깨워 줘요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Jus buah-buahan atau sayur-sayuran segar yang dicairkan dengan air, 100 hingga 200 mL setiap 2 hingga 3 jam. Ia memulakan semula asid perut, enzim pencernaan dan insulin secara perlahan."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vers vruchten- of groentesap verdund met water, 100 tot 200 mL om de 2 tot 3 uur. Het zet maagzuur, spijsverteringsenzymen en insuline voorzichtig weer op gang."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Świeży sok owocowy lub warzywny rozcieńczony wodą, od 100 do 200 mL co 2–3 godziny. Delikatnie pobudza wydzielanie kwasu żołądkowego, enzymów trawiennych i insuliny."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Suco natural de fruta ou legume diluído em água, 100 a 200 mL a cada 2 a 3 horas. Ele reativa suavemente o ácido do estômago, as enzimas digestivas e a insulina."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Свежий фруктовый или овощной сок, разбавленный водой, по 100–200 мл каждые 2–3 часа. Он мягко возобновляет выработку желудочной кислоты, пищеварительных ферментов и инсулина."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Färsk frukt- eller grönsaksjuice utspädd med vatten, 100 till 200 mL var 2:a till 3:e timme. Den sätter försiktigt igång magsyra, matsmältningsenzymer och insulin igen."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Juisi mpya ya matunda au mboga iliyochanganywa na maji, 100 hadi 200 mL kila baada ya saa 2 hadi 3. Inaamsha taratibu asidi ya tumbo, vimeng'enya vya mmeng'enyo wa chakula na insulini."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "น้ำผลไม้หรือน้ำผักคั้นสดผสมน้ำ 100 ถึง 200 mL ทุก 2 ถึง 3 ชั่วโมง ช่วยกระตุ้นกรดในกระเพาะ เอนไซม์ย่อยอาหาร และอินซูลินให้กลับมาทำงานอย่างนุ่มนวล"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Suyla seyreltilmiş taze meyve veya sebze suyu, 2 ila 3 saatte bir 100 ila 200 mL. Mide asidini, sindirim enzimlerini ve insülini nazikçe yeniden harekete geçirir."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nước ép trái cây hoặc rau tươi pha loãng với nước, 100 đến 200 mL mỗi 2 đến 3 giờ. Giúp nhẹ nhàng khởi động lại acid dạ dày, enzym tiêu hóa và insulin."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用水稀释的新鲜果汁或蔬菜汁，每 2 至 3 小时 100 至 200 mL。它能温和地重新启动胃酸、消化酶和胰岛素的分泌。"
          }
        }
      }
    },
