          "stringUnit": {
            "state": "translated",
            "value": "Some changes are not backed up, so you are still signed in. Update the app, then try again."
          }
        }
      }
    },
    "cloud.signout_pending": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Some changes are not backed up yet, so you are still signed in. Check your connection and try again."
          }
        }
      }
    },
