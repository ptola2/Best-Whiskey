    "risk.bone.signs": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا أعراض. يظهر على شكل زيادة في الكالسيوم في البول."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Keine Symptome. Zeigt sich als mehr Calcium im Urin."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No symptoms. Shows up as more calcium in urine."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sin síntomas. Se detecta como más calcio en la orina."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucun symptôme. Se traduit par plus de calcium dans les urines."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कोई लक्षण नहीं। पेशाब में ज़्यादा कैल्शियम के रूप में दिखता है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tanpa gejala. Terlihat sebagai peningkatan kalsium dalam urine."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessun sintomo. Si manifesta con più calcio nelle urine."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "自覚症状はありません。尿中のカルシウムの増加として現れます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "증상은 없어요. 소변 속 칼슘 증가로 나타나요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tiada simptom. Dikesan sebagai kalsium yang lebih tinggi dalam air kencing."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Geen klachten. Zichtbaar als meer calcium in de urine."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Brak objawów. Widoczna jako większa ilość wapnia w moczu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sem sintomas. Aparece como mais cálcio na urina."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Симптомов нет. Проявляется повышенным содержанием кальция в моче."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Inga symtom. Syns som mer kalcium i urinen."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Hakuna dalili. Huonekana kama kalsiamu zaidi kwenye mkojo."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไม่มีอาการ ตรวจพบได้จากแคลเซียมในปัสสาวะที่สูงขึ้น"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Belirti vermez. İdrarda kalsiyum artışı olarak ortaya çıkar."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không có triệu chứng. Biểu hiện qua lượng canxi trong nước tiểu tăng."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "没有症状。表现为尿钙增加。"
          }
        }
      }
    },
    "risk.gout.action": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "واظب على شرب الماء. والنوبة الحادة تعني إنهاء الصيام."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Trinken Sie weiterhin ausreichend Wasser. Ein akuter Schub bedeutet, das Fasten zu beenden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keep up your water intake. An acute flare means ending the fast."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantén tu consumo de agua. Una crisis aguda significa terminar el ayuno."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Continuez à boire suffisamment d’eau. Une crise aiguë signifie qu’il faut arrêter le jeûne."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पानी की मात्रा बनाए रखें। गाउट का तीव्र दौरा पड़े, तो उपवास खत्म करें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Jaga asupan air Anda. Serangan akut berarti puasa harus diakhiri."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Continua a bere a sufficienza. Un attacco acuto significa interrompere il digiuno."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "水分摂取を続けてください。急性の発作が起きたら断食を終了してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "물 섭취를 유지하세요. 급성 발작이 생기면 단식을 끝내야 해요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Kekalkan pengambilan air anda. Serangan akut bermakna puasa perlu ditamatkan."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Blijf voldoende water drinken. Een acute aanval betekent dat je stopt met vasten."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pij odpowiednią ilość wody. Ostry napad oznacza konieczność zakończenia postu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantenha a ingestão de água. Uma crise aguda significa encerrar o jejum."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Пейте достаточно воды. Острый приступ означает, что голодание нужно завершить."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Fortsätt dricka tillräckligt med vatten. Ett akut giktanfall innebär att fastan ska avslutas."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Endelea kunywa maji ya kutosha. Shambulio kali la ghafla linamaanisha kumaliza mfungo."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ดื่มน้ำให้เพียงพอต่อไป หากเกาต์กำเริบเฉียบพลัน ต้องสิ้นสุดการอดอาหาร"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Su alımınızı sürdürün. Akut bir atak, orucu bitirmek anlamına gelir."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Duy trì lượng nước uống. Cơn gút cấp nghĩa là phải kết thúc đợt nhịn ăn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "保持饮水量。急性发作即意味着要结束断食。"
          }
        }
      }
    },
    "risk.gout.name": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ارتفاع حمض اليوريك والنقرس"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erhöhte Harnsäure und Gicht"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "High uric acid and gout"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ácido úrico alto y gota"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Acide urique élevé et goutte"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "हाई यूरिक एसिड और गाउट"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Asam urat tinggi dan gout"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Acido urico alto e gotta"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "高尿酸と痛風"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "높은 요산과 통풍"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Asid urik tinggi dan gout"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Hoog urinezuur en jicht"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wysoki poziom kwasu moczowego i dna moczanowa"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ácido úrico alto e gota"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Высокий уровень мочевой кислоты и подагра"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Hög urinsyra och gikt"
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Asidi ya uriki ya juu na gauti"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "กรดยูริกสูงและโรคเกาต์"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yüksek ürik asit ve gut"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Acid uric cao và bệnh gút"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "高尿酸与痛风"
          }
        }
      }
    },
    "risk.gout.signs": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تورم ساخن وأحمر ومؤلم في أحد المفاصل، غالبًا في إصبع القدم الكبير."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Heiße, rote, schmerzhafte Schwellung eines Gelenks, oft am großen Zeh."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hot, red, painful swelling in a joint, often the big toe."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Hinchazón caliente, roja y dolorosa en una articulación, a menudo el dedo gordo del pie."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gonflement chaud, rouge et douloureux d’une articulation, souvent le gros orteil."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "किसी जोड़ में गर्म, लाल, दर्द भरी सूजन, अक्सर पैर के अँगूठे में।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pembengkakan sendi yang panas, merah, dan nyeri, sering kali di jempol kaki."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Gonfiore caldo, arrossato e doloroso in un'articolazione, spesso l'alluce."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "関節（多くは足の親指）が熱をもち、赤く腫れて痛む。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "관절이 뜨겁고 붉게 붓고 아파요. 흔히 엄지발가락에 생겨요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Bengkak yang panas, merah dan sakit pada sendi, selalunya ibu jari kaki."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Warme, rode, pijnlijke zwelling in een gewricht, vaak de grote teen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gorący, zaczerwieniony, bolesny obrzęk stawu, często dużego palca u stopy."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Inchaço quente, vermelho e doloroso em uma articulação, muitas vezes no dedão do pé."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Горячий, красный, болезненный отёк сустава, часто большого пальца стопы."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Varm, röd och smärtsam svullnad i en led, ofta stortån."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Uvimbe wenye joto, wekundu na maumivu kwenye kiungo, mara nyingi kidole gumba cha mguu."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ข้อบวม แดง ร้อน และปวด มักเกิดที่นิ้วหัวแม่เท้า"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir eklemde, çoğu zaman ayak başparmağında sıcak, kızarık ve ağrılı şişlik."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Một khớp sưng nóng, đỏ, đau, thường ở ngón chân cái."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "关节红、热、肿、痛，常见于大脚趾。"
          }
        }
      }
    },
    "risk.hypona.action": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يمكن تأكيد انخفاض الصوديوم إلى أقل من 136 mmol/L إلا بتحليل دم. أبلغ طبيبك المعالج. والتزم بهدفك من الماء بدلًا من شرب كميات إضافية."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nur ein Bluttest kann Natrium unter 136 mmol/L bestätigen. Informieren Sie Ihr Behandlungsteam. Bleiben Sie innerhalb Ihres Wasserziels, statt zusätzlich zu trinken."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only a blood test can confirm sodium below 136 mmol/L. Tell your clinician. Stay inside your water target rather than drinking extra."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo un análisis de sangre puede confirmar un sodio inferior a 136 mmol/L. Díselo a tu profesional de la salud. Mantente dentro de tu objetivo de agua en lugar de beber de más."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seule une analyse de sang peut confirmer un sodium inférieur à 136 mmol/L. Prévenez votre professionnel de santé. Restez dans votre objectif d’eau plutôt que de boire davantage."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "136 mmol/L से कम सोडियम की पुष्टि केवल खून की जाँच से हो सकती है। अपने चिकित्सक को बताएँ। ज़्यादा पानी पीने के बजाय पानी के अपने लक्ष्य के भीतर रहें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Hanya tes darah yang dapat memastikan natrium di bawah 136 mmol/L. Beri tahu tenaga medis Anda. Tetaplah dalam target minum air Anda, jangan minum lebih dari itu."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo un esame del sangue può confermare un sodio sotto 136 mmol/L. Avvisa il tuo medico. Resta entro il tuo obiettivo di acqua invece di bere di più."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ナトリウムが136 mmol/L未満かどうかは、血液検査でしか確認できません。担当医に伝えてください。余分に飲まず、水分の目標範囲内にとどめてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "나트륨이 136 mmol/L 미만인지는 혈액 검사로만 확인할 수 있어요. 담당 의료진에게 알리세요. 물을 더 마시지 말고 목표 섭취량 안에서 유지하세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Hanya ujian darah boleh mengesahkan natrium bawah 136 mmol/L. Beritahu pengamal perubatan anda. Kekal dalam sasaran air anda dan jangan minum lebih daripada itu."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Alleen bloedonderzoek kan natrium onder 136 mmol/L bevestigen. Vertel het je zorgverlener. Blijf binnen je waterdoel in plaats van extra te drinken."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tylko badanie krwi może potwierdzić stężenie sodu poniżej 136 mmol/L. Powiedz o tym lekarzowi prowadzącemu. Trzymaj się swojego celu dotyczącego wody, zamiast pić więcej."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Só um exame de sangue pode confirmar sódio abaixo de 136 mmol/L. Avise seu profissional de saúde. Mantenha-se dentro da sua meta de água em vez de beber mais."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Уровень натрия ниже 136 ммоль/л можно подтвердить только анализом крови. Сообщите врачу. Придерживайтесь своей нормы воды и не пейте сверх неё."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Bara ett blodprov kan bekräfta natrium under 136 mmol/L. Berätta det för din vårdkontakt. Håll dig inom ditt vattenmål i stället för att dricka extra."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Ni kipimo cha damu pekee kinachoweza kuthibitisha sodiamu chini ya 136 mmol/L. Mweleze mtaalamu wako wa afya. Baki ndani ya lengo lako la maji badala ya kunywa zaidi."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "มีเพียงการตรวจเลือดที่ยืนยันได้ว่าโซเดียมต่ำกว่า 136 mmol/L แจ้งแพทย์ผู้ดูแลของคุณ ดื่มน้ำให้อยู่ในเป้าหมาย แทนที่จะดื่มเพิ่ม"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "136 mmol/L'nin altındaki sodyumu yalnızca kan tahlili doğrulayabilir. Sağlık uzmanınıza haber verin. Fazladan su içmek yerine su hedefinizin içinde kalın."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chỉ xét nghiệm máu mới xác nhận được natri dưới 136 mmol/L. Hãy báo cho nhân viên y tế của bạn. Hãy uống trong phạm vi lượng nước mục tiêu thay vì uống thêm."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只有验血才能确认血钠是否低于 136 mmol/L。请告诉你的医生。将饮水量保持在目标范围内，不要额外多喝。"
          }
        }
      }
    },
    "risk.hypona.name": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "انخفاض الصوديوم (نقص صوديوم الدم)"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
