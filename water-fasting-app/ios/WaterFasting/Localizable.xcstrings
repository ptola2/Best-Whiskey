    "hormone.igf1.why": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يتوقف الكبد عن الاستجابة لهرمون النمو"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Leber reagiert nicht mehr auf Wachstumshormon"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Liver stops responding to growth hormone"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El hígado deja de responder a la hormona del crecimiento"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le foie ne répond plus à l’hormone de croissance"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "लिवर ग्रोथ हार्मोन पर प्रतिक्रिया देना बंद कर देता है"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Hati berhenti merespons hormon pertumbuhan"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il fegato smette di rispondere all'ormone della crescita"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "肝臓が成長ホルモンに反応しなくなる"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "간이 성장호르몬에 반응하지 않음"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Hati berhenti bertindak balas terhadap hormon pertumbuhan"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Lever reageert niet meer op groeihormoon"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wątroba przestaje reagować na hormon wzrostu"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O fígado deixa de responder ao hormônio do crescimento"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Печень перестаёт реагировать на гормон роста"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Levern slutar svara på tillväxthormon"
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Ini huacha kuitikia homoni ya ukuaji"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ตับหยุดตอบสนองต่อโกรทฮอร์โมน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Karaciğer büyüme hormonuna yanıt vermeyi bırakır"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Gan ngừng đáp ứng với hormone tăng trưởng"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "肝脏不再对生长激素产生反应"
