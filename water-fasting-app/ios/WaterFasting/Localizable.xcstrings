          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Gikt eller hög urinsyra"
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Gauti au asidi ya uriki ya juu"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "โรคเกาต์หรือกรดยูริกสูง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gut veya yüksek ürik asit"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bệnh gút hoặc acid uric cao"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "痛风或高尿酸"
          }
        }
      }
    },
    "screen.gout.why": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تتنافس الكيتونات مع حمض اليوريك على الإخراج عبر الكليتين، مما قد يثير نوبة نقرس."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ketone konkurrieren mit Harnsäure um die Ausscheidung über die Nieren, was einen Gichtanfall auslösen kann."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ketones compete with uric acid for removal by the kidneys, which can set off a gout flare."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las cetonas compiten con el ácido úrico para ser eliminadas por los riñones, lo que puede desencadenar una crisis de gota."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les cétones entrent en compétition avec l’acide urique pour leur élimination par les reins, ce qui peut déclencher une crise de goutte."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "गुर्दों से बाहर निकलने के लिए कीटोन यूरिक एसिड से होड़ करते हैं, जिससे गाउट का दौरा पड़ सकता है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Keton bersaing dengan asam urat untuk dibuang oleh ginjal, yang dapat memicu serangan gout."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I chetoni competono con l'acido urico per l'eliminazione da parte dei reni, il che può scatenare un attacco di gotta."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ケトン体は腎臓からの排出をめぐって尿酸と競合するため、痛風発作を引き起こすことがあります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "케톤이 신장에서 요산과 배출 경쟁을 해서 통풍 발작을 일으킬 수 있어요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Keton bersaing dengan asid urik untuk disingkirkan oleh buah pinggang, yang boleh mencetuskan serangan gout."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ketonen concurreren met urinezuur om uitscheiding door de nieren, wat een jichtaanval kan uitlokken."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ciała ketonowe konkurują z kwasem moczowym o wydalanie przez nerki, co może wywołać napad dny."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As cetonas competem com o ácido úrico pela eliminação nos rins, o que pode desencadear uma crise de gota."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Кетоны конкурируют с мочевой кислотой за выведение почками, что может спровоцировать приступ подагры."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ketoner konkurrerar med urinsyra om utsöndringen via njurarna, vilket kan utlösa ett giktanfall."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Ketoni hushindana na asidi ya uriki kuondolewa na figo, jambo linaloweza kuchochea shambulio la gauti."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คีโตนแย่งกับกรดยูริกในการถูกขับออกทางไต ซึ่งอาจกระตุ้นให้เกาต์กำเริบ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ketonlar böbreklerden atılım için ürik asitle yarışır; bu da gut atağını tetikleyebilir."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thể ceton cạnh tranh với acid uric trong quá trình đào thải qua thận, có thể gây khởi phát cơn gút."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "酮体与尿酸竞争经肾脏排出，可能诱发痛风发作。"
          }
        }
      }
    },
