    "tier.moderate.monitoring": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "العلامات الحيوية مرتين يوميًا، وإلكتروليتات الدم كل 48 ساعة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Vitalzeichen zweimal täglich und Blutelektrolyte alle 48 Stunden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Vital signs twice a day and blood electrolytes every 48 hours."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Signos vitales dos veces al día y electrolitos en sangre cada 48 horas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Signes vitaux deux fois par jour et électrolytes sanguins toutes les 48 heures."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "दिन में दो बार वाइटल साइन और हर 48 घंटे में खून के इलेक्ट्रोलाइट की जाँच।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tanda vital dua kali sehari dan elektrolit darah setiap 48 jam."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Parametri vitali due volte al giorno ed elettroliti nel sangue ogni 48 ore."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "バイタルサインを1日2回、血中の電解質を48時間ごとに確認します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "하루 두 번 활력 징후 확인, 48시간마다 혈중 전해질 검사."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tanda vital dua kali sehari dan elektrolit darah setiap 48 jam."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vitale functies twee keer per dag en elektrolyten in het bloed elke 48 uur."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Parametry życiowe dwa razy dziennie i elektrolity we krwi co 48 godzin."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sinais vitais duas vezes ao dia e eletrólitos no sangue a cada 48 horas."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Жизненные показатели дважды в день и электролиты крови каждые 48 часов."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Vitalparametrar två gånger om dagen och elektrolyter i blodet var 48:e timme."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Viashiria muhimu vya mwili mara mbili kwa siku na elektroliti za damu kila baada ya saa 48."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ตรวจสัญญาณชีพวันละ 2 ครั้ง และตรวจเกลือแร่ในเลือดทุก 48 ชั่วโมง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Günde iki kez yaşamsal bulgular ve 48 saatte bir kan elektrolitleri."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đo dấu hiệu sinh tồn hai lần mỗi ngày và xét nghiệm điện giải máu mỗi 48 giờ."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每天测量两次生命体征，每 48 小时查一次血电解质。"
          }
        }
      }
    },
