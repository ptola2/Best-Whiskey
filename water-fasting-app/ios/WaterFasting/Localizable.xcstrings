    "duration.extreme.note": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أكثر من 21 يومًا. يصبح فقدان الأنسجة الخالية من الدهون ونضوب المغذيات الدقيقة وإجهاد القلب مصادر قلق كبيرة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Über 21 Tage. Verlust von fettfreiem Gewebe, Mangel an Mikronährstoffen und Belastung des Herzens werden zu ernsten Problemen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Over 21 days. Lean tissue loss, micronutrient depletion and heart strain become major concerns."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Más de 21 días. La pérdida de tejido magro, el agotamiento de micronutrientes y la sobrecarga del corazón pasan a ser problemas importantes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Plus de 21 jours. La perte de tissu maigre, l’épuisement des micronutriments et la fatigue cardiaque deviennent des préoccupations majeures."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "21 दिन से ज़्यादा। लीन टिशू का नुकसान, सूक्ष्म पोषक तत्वों की कमी और दिल पर दबाव बड़ी चिंताएँ बन जाती हैं।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Lebih dari 21 hari. Hilangnya jaringan tanpa lemak, menipisnya mikronutrien, dan beban pada jantung menjadi masalah utama."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Oltre 21 giorni. La perdita di tessuto magro, l'esaurimento dei micronutrienti e lo sforzo sul cuore diventano gravi motivi di preoccupazione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "21日超。除脂肪組織の減少、微量栄養素の枯渇、心臓への負担が大きな懸念となります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "21일 초과. 제지방 조직 손실, 미량영양소 고갈, 심장 부담이 주요 우려 사항이 돼요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Melebihi 21 hari. Kehilangan tisu tanpa lemak, kekurangan mikronutrien dan beban pada jantung menjadi kebimbangan utama."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Langer dan 21 dagen. Verlies van vetvrij weefsel, uitputting van micronutriënten en belasting van het hart worden ernstige zorgpunten."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ponad 21 dni. Utrata tkanki beztłuszczowej, wyczerpanie zapasów mikroskładników i obciążenie serca stają się poważnymi zagrożeniami."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mais de 21 dias. Perda de tecido magro, depleção de micronutrientes e sobrecarga do coração se tornam preocupações importantes."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Более 21 дня. Серьёзными проблемами становятся потеря безжировой массы тела, истощение запасов микронутриентов и нагрузка на сердце."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Över 21 dagar. Förlust av fettfri vävnad, brist på mikronäringsämnen och belastning på hjärtat blir allvarliga problem."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Zaidi ya siku 21. Kupotea kwa tishu zisizo za mafuta (lean tissue), upungufu wa virutubishi vidogo (micronutrients) na mzigo kwa moyo huwa wasiwasi mkubwa."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "นานกว่า 21 วัน การสูญเสียเนื้อเยื่อไร้ไขมัน การพร่องสารอาหารรอง และภาระต่อหัวใจกลายเป็นข้อกังวลสำคัญ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "21 günden uzun. Yağsız doku kaybı, mikro besin tükenmesi ve kalbin zorlanması başlıca endişeler hâline gelir."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Trên 21 ngày. Mất mô nạc, cạn kiệt vi chất dinh dưỡng và gánh nặng cho tim trở thành mối lo ngại lớn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "超过 21 天。瘦体组织流失、微量营养素耗竭和心脏负担加重成为主要问题。"
          }
        }
      }
    },
