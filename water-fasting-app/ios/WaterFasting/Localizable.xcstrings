    "profile.summary.blocked.body": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تحدّث مع طبيبك عمّا هو آمن."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sprechen Sie mit Ihrer Ärztin oder Ihrem Arzt darüber, was sicher ist."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Talk to your doctor about what is safe."
          }
        },
        "es": {
