    "risk.hypona.signs": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تقلصات عضلية، خمول، صداع، دوار."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Muskelkrämpfe, Trägheit, Kopfschmerzen, Schwindel."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Muscle cramps, sluggishness, headache, dizziness."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Calambres musculares, decaimiento, dolor de cabeza, mareo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Crampes musculaires, torpeur, maux de tête, vertiges."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "मांसपेशियों में ऐंठन, सुस्ती, सिरदर्द, चक्कर।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kram otot, lesu, sakit kepala, pusing."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Crampi muscolari, fiacchezza, mal di testa, capogiri."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "筋肉のけいれん、だるさ、頭痛、めまい。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "근육 경련, 무기력감, 두통, 어지럼증."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Kekejangan otot, lesu, sakit kepala, pening."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Spierkrampen, lusteloosheid, hoofdpijn, duizeligheid."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Skurcze mięśni, ospałość, ból głowy, zawroty głowy."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Cãibras musculares, lentidão, dor de cabeça, tontura."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Мышечные судороги, вялость, головная боль, головокружение."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Muskelkramper, slöhet, huvudvärk, yrsel."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Mkakamao wa misuli, ulegevu, maumivu ya kichwa, kizunguzungu."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "กล้ามเนื้อเป็นตะคริว ซึม ปวดศีรษะ เวียนศีรษะ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kas krampları, uyuşukluk, baş ağrısı, baş dönmesi."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chuột rút cơ, uể oải, đau đầu, chóng mặt."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "肌肉抽筋、倦怠、头痛、头晕。"
          }
        }
      }
    },
    "risk.ortho.action": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اجلس على حافة السرير قبل الوقوف. والتزم بالراحة والمشي الهادئ."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Setzen Sie sich vor dem Aufstehen auf die Bettkante. Beschränken Sie sich auf Ruhe und ruhiges Gehen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sit on the edge of the bed before standing. Keep to rest and quiet walking."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Siéntate en el borde de la cama antes de ponerte de pie. Limítate a descansar y caminar con calma."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Asseyez-vous au bord du lit avant de vous lever. Limitez-vous au repos et à la marche tranquille."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "खड़े होने से पहले बिस्तर के किनारे पर बैठें। आराम और धीमी सैर तक सीमित रहें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Duduklah di tepi tempat tidur sebelum berdiri. Tetaplah beristirahat dan hanya berjalan santai."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Siediti sul bordo del letto prima di alzarti. Limitati al riposo e a passeggiate tranquille."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "立ち上がる前にベッドの端に座ってください。安静と静かな散歩にとどめてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "일어서기 전에 침대 가장자리에 앉으세요. 휴식과 가벼운 걷기만 하세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Duduk di tepi katil sebelum berdiri. Hadkan aktiviti kepada berehat dan berjalan santai."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ga eerst op de rand van het bed zitten voordat je opstaat. Beperk je tot rusten en rustig wandelen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zanim wstaniesz, usiądź na brzegu łóżka. Ogranicz się do odpoczynku i spokojnych spacerów."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sente-se na beira da cama antes de se levantar. Limite-se a repouso e caminhadas leves."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Прежде чем встать, посидите на краю кровати. Ограничьтесь отдыхом и спокойной ходьбой."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Sitt på sängkanten innan du reser dig. Håll dig till vila och lugna promenader."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Kaa ukingoni mwa kitanda kabla ya kusimama. Pumzika na utembee taratibu tu."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "นั่งที่ขอบเตียงก่อนลุกยืน พักผ่อนและเดินเบาๆ เท่านั้น"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ayağa kalkmadan önce yatağın kenarına oturun. Dinlenmeye ve sakin yürüyüşe devam edin."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ngồi ở mép giường trước khi đứng dậy. Chỉ nghỉ ngơi và đi bộ nhẹ nhàng."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "站起前先在床边坐一会儿。以休息和缓慢散步为主。"
          }
        }
      }
    },
    "risk.ortho.name": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "انخفاض ضغط الدم عند الوقوف"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Niedriger Blutdruck beim Aufstehen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Low blood pressure on standing"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Presión arterial baja al ponerse de pie"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tension basse en position debout"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "खड़े होने पर ब्लड प्रेशर कम होना"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tekanan darah rendah saat berdiri"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Pressione bassa quando ti alzi"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "立ち上がったときの低血圧"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "일어설 때 혈압 저하"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tekanan darah rendah apabila berdiri"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Lage bloeddruk bij het opstaan"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Niskie ciśnienie krwi po wstaniu"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Pressão baixa ao ficar de pé"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Низкое давление при вставании"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Lågt blodtryck när du står upp"
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Shinikizo la damu kushuka unaposimama"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ความดันโลหิตต่ำเมื่อลุกยืน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ayağa kalkınca düşük kan basıncı"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hạ huyết áp khi đứng"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "站立时低血压"
          }
        }
      }
    },
    "risk.ortho.signs": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "دوخة أو إغماء أو تسارع ضربات القلب عند الوقوف."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Benommenheit, Ohnmachtsgefühl oder Herzrasen beim Aufstehen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Lightheaded, faint or a racing heart when you stand up."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mareo, desmayo o corazón acelerado al ponerte de pie."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Étourdissements, malaise ou cœur qui s’emballe quand vous vous levez."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "खड़े होने पर हल्का चक्कर, बेहोशी या दिल की तेज़ धड़कन।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kepala terasa melayang, rasa mau pingsan, atau jantung berdebar cepat saat Anda berdiri."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Testa leggera, svenimento o cuore accelerato quando ti alzi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "立ち上がったときのふらつき、気が遠くなる感じ、または速い脈。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "일어설 때 어지럽거나, 실신할 것 같거나, 심장이 빠르게 뛰어요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Pening, rasa hendak pengsan atau jantung berdegup kencang apabila anda berdiri."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Licht in het hoofd, flauwvallen of een snelle hartslag als je opstaat."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zawroty głowy, omdlenie lub szybkie bicie serca, gdy wstajesz."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Tontura, sensação de desmaio ou coração acelerado quando você se levanta."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Головокружение, обморок или учащённое сердцебиение, когда вы встаёте."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Yr, svimfärdig eller snabb puls när du reser dig."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Kizunguzungu, kuzimia au moyo kudunda kwa kasi unaposimama."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "หน้ามืด เป็นลม หรือหัวใจเต้นเร็วเมื่อลุกยืน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ayağa kalktığınızda sersemlik, bayılma veya hızlı kalp atışı."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Choáng váng, ngất hoặc tim đập nhanh khi bạn đứng dậy."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "站起时头晕、晕厥或心跳加快。"
          }
        }
      }
    },
    "screen.bone.action": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الصيام لأكثر من 72 ساعة غير وارد. اجعل أي صيام قصيرًا."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fasten über 72 Stunden kommt nicht infrage. Halten Sie jedes Fasten kurz."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Fasts over 72 hours are off the table. Keep any fast short."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los ayunos de más de 72 horas quedan descartados. Haz que cualquier ayuno sea corto."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les jeûnes de plus de 72 heures sont exclus. Gardez tout jeûne court."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "72 घंटे से लंबे उपवास नहीं किए जा सकते। कोई भी उपवास छोटा रखें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Puasa lebih dari 72 jam tidak boleh dilakukan. Jaga agar puasa apa pun tetap singkat."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I digiuni oltre le 72 ore sono esclusi. Mantieni brevi i digiuni."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "72時間を超える断食はできません。断食は短くしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "72시간을 넘는 단식은 할 수 없어요. 어떤 단식이든 짧게 유지하세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Puasa melebihi 72 jam tidak boleh dilakukan. Pastikan sebarang puasa adalah singkat."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vasten langer dan 72 uur is uitgesloten. Houd elk vasten kort."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Posty dłuższe niż 72 godziny nie wchodzą w grę. Każdy post powinien być krótki."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Jejuns de mais de 72 horas estão fora de questão. Mantenha qualquer jejum curto."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Голодание дольше 72 часов исключено. Любое голодание должно быть коротким."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Fastor över 72 timmar är uteslutna. Håll alla fastor korta."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Mifungo ya zaidi ya saa 72 hairuhusiwi. Mfungo wowote uwe mfupi."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไม่สามารถอดอาหารนานกว่า 72 ชั่วโมงได้ การอดอาหารใดๆ ควรสั้น"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "72 saati aşan oruçlar söz konusu değildir. Her orucu kısa tutun."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không được nhịn ăn quá 72 giờ. Mọi đợt nhịn ăn đều nên ngắn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "不能进行超过 72 小时的断食。任何断食都应保持短时。"
          }
        }
      }
    },
    "screen.bone.question": {
