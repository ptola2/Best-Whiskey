    "screen.porph.why": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يؤدي تقليل السعرات الحرارية إلى تنشيط إنزيم الكبد ALAS1، مما يثير النوبات."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kalorienreduktion aktiviert das Leberenzym ALAS1, das Attacken auslöst."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cutting calories switches on the liver enzyme ALAS1, which sets off attacks."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Reducir las calorías activa la enzima hepática ALAS1, que desencadena las crisis."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La réduction des calories active l’enzyme hépatique ALAS1, ce qui déclenche des crises."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कैलोरी घटाने से लिवर का एंज़ाइम ALAS1 सक्रिय हो जाता है, जिससे पोर्फिरिया के दौरे पड़ते हैं।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Mengurangi kalori mengaktifkan enzim hati ALAS1, yang memicu serangan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ridurre le calorie attiva l'enzima epatico ALAS1, che scatena gli attacchi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "カロリーを減らすと肝臓の酵素ALAS1が活性化し、発作を引き起こします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "칼로리를 줄이면 간 효소 ALAS1이 활성화되어 발작을 일으켜요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Mengurangkan kalori mengaktifkan enzim hati ALAS1, yang mencetuskan serangan."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Minder calorieën activeert het leverenzym ALAS1, dat aanvallen uitlokt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ograniczenie kalorii włącza enzym wątrobowy ALAS1, co wywołuje napady."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Cortar calorias ativa a enzima hepática ALAS1, que desencadeia crises."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ограничение калорий активирует печёночный фермент ALAS1, что провоцирует приступы."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Minskat kaloriintag aktiverar leverenzymet ALAS1, vilket utlöser attacker."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Kupunguza kalori huwasha kimeng'enya cha ini ALAS1, ambacho huchochea mashambulizi."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การลดแคลอรีจะกระตุ้นเอนไซม์ ALAS1 ในตับ ซึ่งทำให้เกิดอาการกำเริบ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kalori kısıtlaması karaciğerdeki ALAS1 enzimini etkinleştirir ve bu da atakları tetikler."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cắt giảm calo kích hoạt enzym ALAS1 của gan, gây khởi phát các cơn cấp."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "减少热量摄入会激活肝酶 ALAS1，从而诱发发作。"
          }
        }
      }
    },
