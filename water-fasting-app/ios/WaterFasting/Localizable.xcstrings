    "risk.acid.signs": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تنفس سريع وعميق، غثيان، تعب شديد."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schnelle, tiefe Atmung, Übelkeit, extreme Müdigkeit."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Fast, deep breathing, nausea, extreme tiredness."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Respiración rápida y profunda, náuseas, cansancio extremo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Respiration rapide et profonde, nausées, fatigue extrême."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "तेज़, गहरी साँसें, मतली, बहुत ज़्यादा थकान।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Napas cepat dan dalam, mual, sangat lelah."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Respiro rapido e profondo, nausea, stanchezza estrema."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "速く深い呼吸、吐き気、極度の疲れ。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "빠르고 깊은 호흡, 메스꺼움, 극심한 피로."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Pernafasan laju dan dalam, loya, keletihan melampau."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Snelle, diepe ademhaling, misselijkheid, extreme vermoeidheid."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Szybki, głęboki oddech, nudności, skrajne zmęczenie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Respiração rápida e profunda, náusea, cansaço extremo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Частое глубокое дыхание, тошнота, крайняя усталость."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Snabb, djup andning, illamående, extrem trötthet."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Kupumua haraka na kwa kina, kichefuchefu, uchovu mkubwa mno."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "หายใจเร็วและลึก คลื่นไส้ อ่อนเพลียอย่างมาก"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hızlı ve derin nefes alma, bulantı, aşırı yorgunluk."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thở nhanh và sâu, buồn nôn, cực kỳ mệt mỏi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "呼吸深快、恶心、极度疲倦。"
          }
        }
      }
    },
    "risk.bone.action": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سبب لتحديد مدة الصيام، خاصة مع انخفاض كثافة العظام."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Grund, die Dauer eines Fastens zu begrenzen, besonders bei geringer Knochendichte."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A reason to cap how long a fast runs, especially with low bone density."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un motivo para limitar la duración del ayuno, sobre todo con baja densidad ósea."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une raison de limiter la durée d’un jeûne, surtout en cas de faible densité osseuse."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "उपवास की अवधि सीमित रखने का एक कारण, खासकर हड्डियों का घनत्व कम होने पर।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Alasan untuk membatasi lama puasa, terutama jika kepadatan tulang rendah."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un motivo per limitare la durata del digiuno, soprattutto con bassa densità ossea."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "特に骨密度が低い場合、断食の期間を制限する理由になります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "특히 골밀도가 낮다면 단식 기간을 제한해야 하는 이유예요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Sebab untuk menghadkan tempoh puasa, terutamanya jika ketumpatan tulang rendah."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een reden om de duur van het vasten te beperken, vooral bij een lage botdichtheid."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Powód, by ograniczyć długość postu, zwłaszcza przy niskiej gęstości kości."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um motivo para limitar a duração do jejum, principalmente com baixa densidade óssea."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Повод ограничить длительность голодания, особенно при низкой плотности костей."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ett skäl att begränsa hur länge en fasta pågår, särskilt vid låg bentäthet."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Ni sababu ya kuweka kikomo cha muda wa mfungo, hasa ukiwa na msongamano mdogo wa mifupa (low bone density)."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เป็นเหตุผลที่ต้องจำกัดระยะเวลาการอดอาหาร โดยเฉพาะผู้ที่มีความหนาแน่นของกระดูกต่ำ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Özellikle kemik yoğunluğu düşükse, orucun süresini sınırlamak için bir nedendir."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Là lý do để giới hạn thời gian nhịn ăn, đặc biệt khi mật độ xương thấp."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这是限制断食时长的一个理由，骨密度低时尤其如此。"
          }
        }
      }
    },
