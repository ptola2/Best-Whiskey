    "complication.gout.response": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الحفاظ على الترطيب؛ وإنهاء الصيام عند حدوث نوبة حادة"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ausreichend trinken; bei akutem Anfall das Fasten beenden"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keep hydrated; end the fast for an acute flare"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantener la hidratación; terminar el ayuno ante una crisis aguda"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bien s’hydrater ; arrêter le jeûne en cas de crise aiguë"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पानी पीते रहें; तीव्र दौरे पर उपवास खत्म करें"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Jaga hidrasi; akhiri puasa jika terjadi serangan akut"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantenere l'idratazione; interrompere il digiuno in caso di attacco acuto"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "水分補給を続ける、急性の発作では断食を終了"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "수분 유지, 급성 발작 시 단식 종료"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Kekal terhidrat; tamatkan puasa jika berlaku serangan akut"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Voldoende drinken; stop met vasten bij een acute aanval"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nawadnianie; zakończenie postu przy ostrym napadzie"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Manter a hidratação; encerrar o jejum em caso de crise aguda"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Пить достаточно воды; при остром приступе завершить голодание"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Drick tillräckligt; avsluta fastan vid ett akut giktanfall"
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Kunywa maji ya kutosha; maliza mfungo shambulio kali la ghafla likitokea"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ดื่มน้ำให้เพียงพอ สิ้นสุดการอดอาหารหากเกาต์กำเริบเฉียบพลัน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yeterli sıvı alınır; akut atakta oruç bitirilir"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Uống đủ nước; kết thúc nhịn ăn nếu lên cơn gút cấp"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "保持充足饮水；急性发作时结束断食"
          }
        }
      }
    },
    "complication.gout.signs": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مفصل أحمر ومؤلم ومتورم، غالبًا إصبع القدم الكبير"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Rotes, schmerzhaftes, geschwollenes Gelenk, oft am großen Zeh"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Red, painful, swollen joint, often the big toe"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Articulación roja, dolorosa e hinchada, a menudo el dedo gordo del pie"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Articulation rouge, douloureuse et gonflée, souvent le gros orteil"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "लाल, दर्द भरा, सूजा हुआ जोड़, अक्सर पैर का अँगूठा"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Sendi merah, nyeri, dan bengkak, sering kali di jempol kaki"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Articolazione arrossata, dolorosa e gonfia, spesso l'alluce"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "関節が赤く腫れて痛む、多くは足の親指"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "붉고 아프고 부은 관절, 흔히 엄지발가락"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Sendi merah, sakit dan bengkak, selalunya ibu jari kaki"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Rood, pijnlijk, gezwollen gewricht, vaak de grote teen"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zaczerwieniony, bolesny, obrzęknięty staw, często duży palec u stopy"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Articulação vermelha, dolorida e inchada, muitas vezes o dedão do pé"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Красный, болезненный, опухший сустав, часто большой палец стопы"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Röd, smärtsam och svullen led, ofta stortån"
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Kiungo chekundu, kinachouma na kilichovimba, mara nyingi kidole gumba cha mguu"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ข้อแดง ปวด บวม มักเกิดที่นิ้วหัวแม่เท้า"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kızarık, ağrılı, şiş eklem; çoğu zaman ayak başparmağı"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Khớp đỏ, đau, sưng, thường ở ngón chân cái"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "关节红、痛、肿，常见于大脚趾"
          }
        }
      }
    },
