    "refeed.plan.needs_clinician": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تحتاج إعادة التغذية هذه إلى طبيب معالج."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Kostaufbau muss medizinisch betreut werden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This refeed needs a clinician."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta realimentación necesita a un profesional de la salud."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette réalimentation nécessite un professionnel de santé."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "दोबारा खाने के इस चरण के लिए चिकित्सक की ज़रूरत है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Masa makan kembali ini memerlukan tenaga medis."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questa rialimentazione richiede un medico."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この回復食には医療者の管理が必要です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 보식에는 의료진이 필요해요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Pemakanan semula ini memerlukan pengamal perubatan."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Voor deze opbouw is een zorgverlener nodig."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "To wychodzenie z postu wymaga nadzoru lekarza."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta realimentação precisa de um profissional de saúde."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Такой выход из голодания требует наблюдения врача."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Den här uppbyggnaden kräver vårdpersonal."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Kurejea kula huku kunahitaji mtaalamu wa afya."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การกลับมากินอาหารครั้งนี้ต้องมีแพทย์ผู้ดูแล"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu yeniden beslenme bir sağlık uzmanı gerektirir."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Giai đoạn ăn lại này cần có nhân viên y tế."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这次复食需要医生指导。"
          }
        }
      }
    },
    "refeed.plan.needs_clinician.body": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعتمد إعادة التغذية ذات الخطر الكبير على الثيامين الموصوف طبيًا وتحاليل الدم اليومية."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kostaufbau mit erheblichem Risiko erfolgt mit verordnetem Thiamin und täglichen Blutuntersuchungen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Significant-risk refeeding uses prescribed thiamine and daily blood tests."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La realimentación de riesgo significativo usa tiamina prescrita y análisis de sangre diarios."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une réalimentation à risque important repose sur de la thiamine prescrite et des analyses de sang quotidiennes."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "ज़्यादा जोखिम में दोबारा खाना शुरू करते समय डॉक्टर द्वारा दी गई थायमिन और रोज़ खून की जाँच की ज़रूरत होती है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Makan kembali dengan risiko signifikan menggunakan tiamin yang diresepkan dan tes darah setiap hari."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La rialimentazione a rischio significativo prevede tiamina su prescrizione ed esami del sangue quotidiani."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "重大なリスクがある場合の回復食では、処方されたチアミンを用い、毎日血液検査を行います。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "상당한 위험 단계의 보식에서는 처방된 티아민을 사용하고 매일 혈액 검사를 해요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Pemakanan semula berisiko ketara menggunakan tiamina yang dipreskripsikan dan ujian darah setiap hari."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Opbouwen met een aanzienlijk risico gebeurt met voorgeschreven thiamine en dagelijks bloedonderzoek."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przy znacznym ryzyku wychodzenie z postu obejmuje tiaminę przepisaną przez lekarza i codzienne badania krwi."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A realimentação de risco significativo usa tiamina prescrita e exames de sangue diários."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "При значительном риске выход из голодания проводится с назначенным врачом тиамином и ежедневными анализами крови."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Uppbyggnad med betydande risk sker med förskrivet tiamin och dagliga blodprover."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Kurejea kula kwenye hatari kubwa hutumia thiamini iliyoagizwa na daktari na vipimo vya damu kila siku."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การกลับมากินอาหารที่มีความเสี่ยงสูงต้องใช้ไทอามีนตามที่แพทย์สั่งและตรวจเลือดทุกวัน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Belirgin riskli yeniden beslenmede reçeteli tiamin ve günlük kan tahlilleri kullanılır."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ăn lại khi có nguy cơ đáng kể cần dùng thiamin theo đơn và xét nghiệm máu hằng ngày."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "显著风险的复食需使用处方硫胺素，并每天验血。"
          }
        }
      }
    },
    "refeed.plan.no_salt": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "طوال الفترة: لا ملح مضاف ولا توابل مالحة. فبعد الصيام، يجعل الإنسولين الكليتين تحتفظان بالصوديوم والماء، مما قد يسبب التورم ويُجهد القلب."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Durchgehend: kein zusätzliches Salz und keine salzigen Gewürze. Nach dem Fasten bringt Insulin die Nieren dazu, Natrium und Wasser zurückzuhalten, was Schwellungen verursachen und das Herz belasten kann."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Throughout: no added salt or salty seasonings. Insulin makes the kidneys hold sodium and water after a fast, which can cause swelling and strain the heart."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Durante todo el proceso: nada de sal añadida ni condimentos salados. La insulina hace que los riñones retengan sodio y agua después de un ayuno, lo que puede causar hinchazón y sobrecargar el corazón."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pendant toute la durée : pas de sel ajouté ni d’assaisonnements salés. Après un jeûne, l’insuline pousse les reins à retenir le sodium et l’eau, ce qui peut provoquer un gonflement et fatiguer le cœur."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पूरे समय: ऊपर से नमक या नमकीन मसाले नहीं। उपवास के बाद इंसुलिन की वजह से गुर्दे सोडियम और पानी रोककर रखते हैं, जिससे सूजन हो सकती है और दिल पर दबाव पड़ सकता है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Sepanjang masa ini: tanpa tambahan garam atau bumbu asin. Insulin membuat ginjal menahan natrium dan air setelah puasa, yang dapat menyebabkan pembengkakan dan membebani jantung."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Per tutto il periodo: niente sale aggiunto né condimenti salati. Dopo un digiuno l'insulina fa trattenere ai reni sodio e acqua, il che può causare gonfiore e affaticare il cuore."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "期間中ずっと：塩や塩辛い調味料を加えないでください。断食後はインスリンの働きで腎臓がナトリウムと水分をため込むため、むくみが生じ、心臓に負担がかかるおそれがあります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "전 기간: 소금이나 짠 양념을 추가하지 마세요. 단식 후에는 인슐린 때문에 신장이 나트륨과 수분을 붙잡아 두어, 부기가 생기고 심장에 부담이 갈 수 있어요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Sepanjang tempoh: tiada garam tambahan atau perasa masin. Insulin menyebabkan buah pinggang menahan natrium dan air selepas berpuasa, yang boleh menyebabkan bengkak dan membebankan jantung."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De hele periode: geen toegevoegd zout of zoute kruiden. Na het vasten zorgt insuline ervoor dat de nieren natrium en water vasthouden, wat zwelling kan veroorzaken en het hart kan belasten."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przez cały czas: bez dodatku soli i słonych przypraw. Po poście insulina sprawia, że nerki zatrzymują sód i wodę, co może wywołać obrzęki i obciążyć serce."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Durante todo o período: sem sal adicionado nem temperos salgados. Após um jejum, a insulina faz os rins reterem sódio e água, o que pode causar inchaço e sobrecarregar o coração."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "На всём протяжении: без добавления соли и солёных приправ. После голодания инсулин заставляет почки удерживать натрий и воду, что может вызвать отёки и нагрузку на сердце."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Hela tiden: inget tillsatt salt eller salta kryddor. Insulin får njurarna att hålla kvar natrium och vatten efter en fasta, vilket kan orsaka svullnad och belasta hjärtat."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Muda wote: usiongeze chumvi wala viungo vyenye chumvi. Baada ya mfungo, insulini hufanya figo zibakize sodiamu na maji, jambo linaloweza kusababisha uvimbe na kuulemea moyo."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ตลอดช่วงนี้: งดเติมเกลือหรือเครื่องปรุงรสเค็ม หลังการอดอาหาร อินซูลินทำให้ไตเก็บกักโซเดียมและน้ำไว้ ซึ่งอาจทำให้เกิดอาการบวมและเพิ่มภาระให้หัวใจ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Süreç boyunca: tuz veya tuzlu çeşni eklemeyin. Oruçtan sonra insülin, böbreklerin sodyum ve su tutmasına neden olur; bu da şişliğe yol açabilir ve kalbi zorlayabilir."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Trong suốt quá trình: không thêm muối hoặc gia vị mặn. Sau khi nhịn ăn, insulin khiến thận giữ natri và nước, có thể gây phù và tạo gánh nặng cho tim."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "全程：不额外加盐，也不用咸味调料。断食后，胰岛素会使肾脏潴留钠和水，可能引起肿胀并加重心脏负担。"
          }
        }
      }
    },
