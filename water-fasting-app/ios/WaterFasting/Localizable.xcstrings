            "value": "Keton menghambat pembuangannya di ginjal"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I chetoni ne bloccano l'eliminazione nel rene"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ケトン体が腎臓での排出を妨げる"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "케톤이 신장에서 요산 배출을 막음"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Keton menyekat penyingkirannya di buah pinggang"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ketonen remmen de uitscheiding ervan in de nier"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ciała ketonowe blokują jego wydalanie przez nerki"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As cetonas bloqueiam sua eliminação pelos rins"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Кетоны мешают её выведению почками"
