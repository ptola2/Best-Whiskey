        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Ketoni huzuia kuondolewa kwake kwenye figo"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คีโตนขัดขวางการขับกรดยูริกที่ไต"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
