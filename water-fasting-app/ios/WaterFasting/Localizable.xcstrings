    "notify.h12.body": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يتناقص جليكوجين الكبد وتبدأ مخازن الدهون في التحرر."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Leberglykogen geht zur Neige und die Fettreserven werden zugänglich."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Liver glycogen is running down and fat stores are opening up."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El glucógeno del hígado se está agotando y empiezan a usarse las reservas de grasa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le glycogène du foie s’épuise et les réserves de graisse commencent à être mobilisées."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "लिवर का ग्लाइकोजन घट रहा है और वसा भंडार खुलने लगे हैं।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Glikogen hati mulai menipis dan cadangan lemak mulai terbuka."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il glicogeno del fegato si sta esaurendo e le riserve di grasso iniziano a essere usate."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "肝臓のグリコーゲンが減り、脂肪の蓄えが使われ始めています。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "간 글리코겐이 줄어들고 지방 저장고가 열리기 시작해요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Glikogen hati semakin berkurangan dan simpanan lemak mula digunakan."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het leverglycogeen raakt op en je vetvoorraden komen vrij."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Glikogen w wątrobie się kończy, a organizm zaczyna sięgać po zapasy tłuszczu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O glicogênio do fígado está acabando e as reservas de gordura estão sendo liberadas."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Запасы гликогена в печени истощаются, и организм начинает использовать жировые запасы."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Leverns glykogen håller på att ta slut och fettdepåerna börjar öppnas."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Glikojeni ya ini inapungua na akiba ya mafuta inaanza kutumika."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไกลโคเจนในตับกำลังลดลง และร่างกายเริ่มดึงไขมันสะสมมาใช้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Karaciğerdeki glikojen azalıyor ve yağ depoları kullanılmaya başlıyor."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Glycogen trong gan đang cạn dần và kho mỡ dự trữ bắt đầu được huy động."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "肝糖原正在减少，身体开始动用脂肪储备。"
          }
        }
      }
    },
    "notify.h12.title": {
      "extractionState": "manual",
