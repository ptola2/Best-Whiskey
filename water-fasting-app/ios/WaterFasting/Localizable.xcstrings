    "screen.preg.why": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يعتمد الطفل على إمداد ثابت من الجلوكوز والأحماض الأمينية، وقد يؤثر استمرار الكيتونات في نمو الدماغ، كما ينخفض إدرار الحليب."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Baby ist auf eine stetige Versorgung mit Glukose und Aminosäuren angewiesen, eine anhaltende Ketose kann die Gehirnentwicklung beeinträchtigen und die Milchmenge sinkt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A baby relies on a steady supply of glucose and amino acids, sustained ketones may affect brain development, and milk supply drops."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El bebé depende de un aporte constante de glucosa y aminoácidos, las cetonas mantenidas pueden afectar al desarrollo del cerebro y la producción de leche disminuye."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le bébé dépend d’un apport régulier en glucose et en acides aminés, des cétones élevées de façon prolongée peuvent affecter le développement de son cerveau, et la production de lait diminue."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "बच्चा ग्लूकोज़ और अमीनो एसिड की लगातार आपूर्ति पर निर्भर रहता है, लंबे समय तक बने रहने वाले कीटोन दिमाग के विकास पर असर डाल सकते हैं, और दूध कम बनने लगता है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Bayi bergantung pada pasokan glukosa dan asam amino yang stabil, keton yang bertahan lama dapat memengaruhi perkembangan otak, dan produksi ASI menurun."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il bambino ha bisogno di un apporto costante di glucosio e aminoacidi, i chetoni prolungati possono influire sullo sviluppo del cervello e la produzione di latte cala."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "赤ちゃんはブドウ糖とアミノ酸の安定した供給に頼っており、ケトン体が続くと脳の発達に影響するおそれがあり、母乳の量も減ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "아기는 포도당과 아미노산의 꾸준한 공급에 의존하고, 지속적인 케톤은 뇌 발달에 영향을 줄 수 있으며, 모유량이 줄어요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Bayi bergantung pada bekalan glukosa dan asid amino yang stabil, keton yang berterusan mungkin menjejaskan perkembangan otak, dan bekalan susu berkurangan."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een baby is afhankelijk van een constante aanvoer van glucose en aminozuren, aanhoudende ketonen kunnen de hersenontwikkeling beïnvloeden en de melkproductie daalt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dziecko potrzebuje stałej podaży glukozy i aminokwasów, długotrwale podwyższone stężenie ciał ketonowych może wpływać na rozwój mózgu, a ilość mleka spada."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O bebê depende de um suprimento constante de glicose e aminoácidos, cetonas elevadas por muito tempo podem afetar o desenvolvimento do cérebro, e a produção de leite cai."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ребёнку необходимо постоянное поступление глюкозы и аминокислот, длительно повышенные кетоны могут влиять на развитие мозга, а количество молока уменьшается."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ett barn är beroende av en jämn tillförsel av glukos och aminosyror, ihållande ketoner kan påverka hjärnans utveckling, och mjölkproduktionen minskar."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Mtoto hutegemea upatikanaji thabiti wa glukosi na asidi za amino, ketoni za muda mrefu zinaweza kuathiri ukuaji wa ubongo, na maziwa ya mama hupungua."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ทารกต้องอาศัยกลูโคสและกรดอะมิโนอย่างสม่ำเสมอ คีโตนที่สูงต่อเนื่องอาจส่งผลต่อพัฒนาการของสมอง และปริมาณน้ำนมจะลดลง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bebek sürekli bir glukoz ve amino asit desteğine ihtiyaç duyar, uzun süre yüksek seyreden ketonlar beyin gelişimini etkileyebilir ve süt miktarı azalır."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Em bé cần nguồn glucose và acid amin ổn định, thể ceton kéo dài có thể ảnh hưởng đến sự phát triển não, và lượng sữa sẽ giảm."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "宝宝依赖稳定的葡萄糖和氨基酸供应，持续的酮体可能影响大脑发育，而且乳汁分泌会减少。"
          }
        }
      }
    },
