{
  "sourceLanguage": "en",
  "strings": {
    "NSHealthShareUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يقرأ Waterline وزنك وضغط دمك ومعدل ضربات قلبك من Apple Health لملء تسجيلات الحالة وملفك الشخصي."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Waterline liest Ihr Gewicht, Ihren Blutdruck und Ihre Herzfrequenz aus Apple Health, um Kontrollen und Ihr Profil auszufüllen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Waterline reads your weight, blood pressure and heart rate from Apple Health to fill in check-ins and your profile."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Waterline lee tu peso, tu presión arterial y tu frecuencia cardíaca de Apple Health para completar tus registros y tu perfil."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Waterline lit votre poids, votre tension artérielle et votre fréquence cardiaque dans Apple Health pour remplir vos bilans et votre profil."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Waterline चेक-इन और आपकी प्रोफ़ाइल भरने के लिए Apple Health से आपका वज़न, ब्लड प्रेशर और हार्ट रेट पढ़ता है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Waterline membaca berat badan, tekanan darah, dan detak jantung Anda dari Apple Health untuk mengisi cek kondisi dan profil Anda."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Waterline legge il tuo peso, la pressione arteriosa e la frequenza cardiaca da Apple Health per compilare le rilevazioni e il tuo profilo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Waterlineは、チェックインとプロフィールに入力するために、Apple Healthから体重、血圧、心拍数を読み取ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Waterline은 Apple Health에서 체중, 혈압, 심박수를 읽어 와 체크인과 프로필을 채워요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Waterline membaca berat badan, tekanan darah dan kadar denyutan jantung anda daripada Apple Health untuk mengisi pemeriksaan dan profil anda."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Waterline leest je gewicht, bloeddruk en hartslag uit Apple Health om check-ins en je profiel in te vullen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Waterline odczytuje masę ciała, ciśnienie krwi i tętno z Apple Health, aby uzupełniać kontrole i twój profil."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Waterline lê seu peso, sua pressão arterial e sua frequência cardíaca do Apple Health para preencher os registros e seu perfil."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Waterline считывает ваш вес, давление и частоту пульса из Apple Health, чтобы заполнять проверки и ваш профиль."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Waterline läser din vikt, ditt blodtryck och din puls från Apple Health för att fylla i incheckningar och din profil."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Waterline husoma uzito wako, shinikizo lako la damu na mapigo yako ya moyo kutoka Apple Health ili kujaza ukaguzi na wasifu wako."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "Waterline อ่านน้ำหนัก ความดันโลหิต และอัตราการเต้นของหัวใจของคุณจาก Apple Health เพื่อกรอกข้อมูลการเช็กอินและโปรไฟล์ของคุณ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Waterline, kontrolleri ve profilinizi doldurmak için Apple Health'ten kilonuzu, kan basıncınızı ve kalp atış hızınızı okur."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Waterline đọc cân nặng, huyết áp và nhịp tim của bạn từ Apple Health để điền vào các lần ghi nhận và hồ sơ của bạn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Waterline 会从 Apple Health 读取你的体重、血压和心率，用于填写自查和“我的”页面中的信息。"
          }
        }
      }
    },
    "NSHealthUpdateUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يحفظ Waterline الوزن وضغط الدم من تسجيلات حالتك في Apple Health."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Waterline speichert Gewicht und Blutdruck aus Ihren Kontrollen in Apple Health."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Waterline saves the weight and blood pressure from your check-ins to Apple Health."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Waterline guarda en Apple Health el peso y la presión arterial de tus registros."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Waterline enregistre dans Apple Health le poids et la tension artérielle de vos bilans."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Waterline आपके चेक-इन का वज़न और ब्लड प्रेशर Apple Health में सेव करता है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Waterline menyimpan berat badan dan tekanan darah dari cek kondisi Anda ke Apple Health."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Waterline salva in Apple Health il peso e la pressione arteriosa delle tue rilevazioni."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Waterlineは、チェックインの体重と血圧をApple Healthに保存します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Waterline은 체크인의 체중과 혈압을 Apple Health에 저장해요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Waterline menyimpan berat badan dan tekanan darah daripada pemeriksaan anda ke Apple Health."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Waterline bewaart het gewicht en de bloeddruk uit je check-ins in Apple Health."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Waterline zapisuje masę ciała i ciśnienie krwi z twoich kontroli w Apple Health."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Waterline salva no Apple Health o peso e a pressão arterial dos seus registros."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Waterline сохраняет вес и давление из ваших проверок в Apple Health."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Waterline sparar vikt och blodtryck från dina incheckningar i Apple Health."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Waterline huhifadhi kwenye Apple Health uzito na shinikizo la damu kutoka kwenye ukaguzi wako."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "Waterline บันทึกน้ำหนักและความดันโลหิตจากการเช็กอินของคุณลงใน Apple Health"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Waterline, kontrollerinizdeki kilo ve kan basıncı değerlerini Apple Health'e kaydeder."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Waterline lưu cân nặng và huyết áp từ các lần ghi nhận của bạn vào Apple Health."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Waterline 会将自查中的体重和血压保存到 Apple Health。"
          }
        }
      }
    }
  },
  "version": "1.0"
}
