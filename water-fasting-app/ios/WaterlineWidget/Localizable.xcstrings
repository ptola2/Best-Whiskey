    "extension.widget.description": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "صيامك في لمحة: المدة المنقضية حتى الآن، ومرحلتك الأيضية، وتقدمك نحو هدفك."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ihr Fasten auf einen Blick: die bisherige Dauer, Ihre Stoffwechselphase und Ihr Fortschritt bis zum Ziel."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your fast at a glance: the time so far, your metabolic phase and progress to your target."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu ayuno de un vistazo: el tiempo transcurrido, tu fase metabólica y tu progreso hacia tu objetivo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre jeûne en un coup d’œil : le temps écoulé, votre phase métabolique et votre progression vers votre objectif."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "एक नज़र में आपका उपवास: अब तक का समय, आपका मेटाबोलिक चरण और लक्ष्य की ओर आपकी प्रगति।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pantau puasa Anda sekilas: waktu yang telah berlalu, fase metabolik, dan kemajuan menuju target Anda."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il tuo digiuno a colpo d'occhio: il tempo trascorso finora, la fase metabolica e i progressi verso l'obiettivo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "経過時間、現在の代謝の段階、目標までの進み具合をひと目で確認できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "지금까지 경과한 시간, 현재 대사 단계, 목표까지의 진행 상황을 한눈에 확인하세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Lihat puasa anda sepintas lalu: masa yang telah berlalu, fasa metabolik dan kemajuan ke arah sasaran anda."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je vasten in één oogopslag: de verstreken tijd, je stofwisselingsfase en je voortgang richting je doel."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Twój post w skrócie: czas, który już minął, faza metaboliczna i postęp w drodze do celu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Seu jejum em resumo: o tempo decorrido, sua fase metabólica e o progresso rumo à sua meta."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Главное о вашем голодании: сколько времени прошло, текущая метаболическая фаза и прогресс на пути к цели."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Din fasta i korthet: tiden hittills, din metabola fas och hur nära du är ditt mål."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Mfungo wako kwa muhtasari: muda uliopita, awamu yako ya kimetaboliki na maendeleo kuelekea lengo lako."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ภาพรวมการอดอาหารของคุณ: เวลาที่ผ่านไป ระยะเมแทบอลิซึม และความคืบหน้าสู่เป้าหมาย"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Orucunuz bir bakışta: şimdiye kadar geçen süre, metabolik evreniz ve hedefinize doğru ilerlemeniz."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Xem nhanh đợt nhịn ăn của bạn: thời gian đã qua, giai đoạn chuyển hóa và tiến độ đến mục tiêu."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "断食进展一目了然：已进行时长、所处代谢阶段和目标进度。"
          }
        }
      }
    },
