{
  "sourceLanguage": "en",
  "strings": {
    "extension.idle.body": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "افتح Waterline للتخطيط لصيام."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Öffnen Sie Waterline, um ein Fasten zu planen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open Waterline to plan a fast."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre Waterline para planificar un ayuno."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouvrez Waterline pour planifier un jeûne."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "उपवास की योजना बनाने के लिए Waterline खोलें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Buka Waterline untuk merencanakan puasa."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Apri Waterline per pianificare un digiuno."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Waterlineを開いて、断食を計画してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Waterline을 열어 단식을 계획하세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Buka Waterline untuk merancang puasa."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Open Waterline om een vastenperiode te plannen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Otwórz aplikację Waterline, aby zaplanować post."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Abra o Waterline para planejar um jejum."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Откройте Waterline, чтобы спланировать голодание."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Öppna Waterline för att planera en fasta."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Fungua Waterline ili upange mfungo."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เปิด Waterline เพื่อวางแผนการอดอาหาร"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Oruç planlamak için Waterline uygulamasını açın."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mở Waterline để lên kế hoạch nhịn ăn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "打开 Waterline 规划断食。"
          }
        }
      }
    },
    "extension.idle.title": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يوجد صيام جارٍ"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kein laufendes Fasten"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No fast running"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ningún ayuno en curso"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucun jeûne en cours"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कोई उपवास नहीं चल रहा"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tidak ada puasa berjalan"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessun digiuno in corso"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "進行中の断食はありません"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "진행 중인 단식이 없어요"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tiada puasa sedang berjalan"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Geen vasten bezig"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Brak trwającego postu"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nenhum jejum em andamento"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нет текущего голодания"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingen pågående fasta"
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Hakuna mfungo unaoendelea"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไม่มีการอดอาหารที่กำลังดำเนินอยู่"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Devam eden oruç yok"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không có đợt nhịn ăn đang diễn ra"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "没有进行中的断食"
          }
        }
      }
    },
